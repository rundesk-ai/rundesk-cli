#!/usr/bin/env python3
"""Google Antigravity CLI, as a brain behind Rundesk's provider seam.

This is a program, never a module. Rundesk gives it one turn through environment
variables and stdin; it runs Google's official ``agy`` binary and translates the
documented ``stream-json`` events into Rundesk records. Nothing outside this file knows
an Antigravity flag, event name, permission mode, or authentication detail.

The measured facts are in
``.knowledge/research/2026-07-28-antigravity-cli-as-a-brain.md`` and the sanitized stream
fixture is ``tests/samples/antigravity-stream.jsonl``.

Four details are easy to get subtly wrong:

* A piped prompt selects print mode by itself. ``-p`` consumes the next argument, so using
  it as a switch leaks or replaces the real prompt. The prompt stays on stdin here.
* A fresh turn uses ``--new-project``. Without it an unseen working directory can keep
  the stream's stated cwd while tools actually stand in Antigravity's scratch project.
* A resumed ``result.usage`` is cumulative. The usage blocks on step updates are this
  invocation's deltas, so only those are added.
* The last parent ``agent_response`` usage is the end-of-session context level. Earlier
  responses are neither added nor allowed to replace it from a child conversation.
* ``plan`` is a mode, not containment. Read posture combines it with the OS sandbox and
  leaves permission prompts unapproved; work posture uses the sandbox but approves tools.

Authentication remains Google's. This adapter reads, copies, links, and exports no token:
``agy`` uses the owner-established login in the native keyring.
"""

from __future__ import annotations

import getpass
import json
import os
import shutil
import subprocess
import sys
import threading

AGY = os.environ.get("RUNDESK_ANTIGRAVITY_BIN", "agy")

CAN = {"tools": True, "resume": True, "usage": True, "model": True, "steer": False}

DID = {
    # Measured against official agy 1.1.8. Unknown names remain useful as vendor names
    # but deliberately receive no Rundesk verb.
    "view_file": "read",
    "sed_file": "read",
    "read_resource": "read",
    "read_url_content": "read",
    "read_browser_page": "read",
    "list_dir": "list",
    "list_resources": "list",
    "grep_search": "search",
    "code_search": "search",
    "moma_search": "search",
    "search_web": "search",
    "run_command": "run",
    "command_status": "run",
    "send_command_input": "run",
    "replace_file_content": "edit",
    "multi_replace_file_content": "edit",
    "write_to_file": "edit",
    "notebook_edit": "edit",
    "generate_image": "make",
    "define_subagent": "delegate",
    "invoke_subagent": "delegate",
    "browser_subagent": "delegate",
}

SUMMARY_CHARS = 200
TROUBLE_KEPT = 20
GOING_SECONDS = 5.0
SKILLS_ROOT = os.path.join(".agents", "skills")

# Settings may expose new vendor options without a Rundesk release, but these flags own
# the seam or its safety posture and therefore cannot be overridden through passthrough.
OWNED_FLAGS = {
    "-p", "--print", "--prompt", "-i", "--prompt-interactive",
    "--output-format", "--conversation", "--continue", "-c", "--new-project",
    "--project", "--mode", "--sandbox", "--dangerously-skip-permissions",
    "--model", "--log-file",
}


def say(**record) -> None:
    """Write one complete, flushed Rundesk record."""
    sys.stdout.write(json.dumps(record) + "\n")
    sys.stdout.flush()


def went_wrong(message: str) -> None:
    """Keep diagnostics off the protocol stream."""
    sys.stderr.write(message.rstrip() + "\n")
    sys.stderr.flush()


def _settings() -> dict:
    try:
        given = json.loads(os.environ.get("RUNDESK_SETTINGS") or "{}")
    except ValueError:
        went_wrong("what was set for this brain is not readable JSON, so none of it was used")
        return {}
    if not isinstance(given, dict):
        went_wrong("what was set for this brain is not a JSON object, so none of it was used")
        return {}
    return given


def _flags(extra: dict) -> list:
    """Return safe vendor passthrough flags, preserving each value as its own argv word."""
    given = extra.get("flags")
    if given is None:
        return []
    if not isinstance(given, list) or not all(isinstance(one, str) for one in given):
        went_wrong("`flags` is passed to this brain as a list of strings; it was not, "
                   "so it was ignored")
        return []

    kept = []
    skip_value = False
    for one in given:
        if skip_value:
            skip_value = False
            continue
        name = one.split("=", 1)[0]
        if name in OWNED_FLAGS:
            went_wrong(f"`{name}` is controlled by Rundesk and was ignored")
            # Values supplied as a following word belong to these options. Boolean flags
            # have no following value and therefore must not eat the next custom flag.
            if "=" not in one and name in {
                    "-p", "--print", "--prompt", "-i", "--prompt-interactive",
                    "--output-format", "--conversation", "--project", "--mode",
                    "--model", "--log-file"}:
                skip_value = True
            continue
        kept.append(one)
    return kept


def opening(posture: str, model, resume, extra: dict) -> list:
    """Build an offline-testable agy command line, excluding the program name."""
    argv = ["--output-format", "stream-json", "--log-file", os.devnull]
    argv += _flags(extra)

    if resume:
        argv += ["--conversation", resume]
    else:
        # Measured at 1.1.8: without this, an unseen cwd can execute tools in the
        # persistent scratch project even though init.cwd names the requested directory.
        argv += ["--new-project"]

    if model:
        argv += ["--model", model]

    argv += ["--mode", "plan" if posture == "read" else "accept-edits", "--sandbox"]
    if posture == "work":
        argv += ["--dangerously-skip-permissions"]
    return argv


def _prompt(asked: str) -> str:
    """Add standing context without replacing the brain's built-in instructions."""
    preface = (os.environ.get("RUNDESK_PREFACE") or "").strip()
    if not preface:
        return asked
    return (
        f"<rundesk-standing-instructions>\n{preface}\n"
        f"</rundesk-standing-instructions>\n\n{asked}"
    )


def _n(counted: dict, key: str) -> int:
    value = counted.get(key)
    return int(value) if isinstance(value, int) and not isinstance(value, bool) else 0


def _usage(counted: dict, seen: dict) -> None:
    """Accumulate per-step deltas; result usage is cumulative on resumed conversations."""
    if not isinstance(counted, dict):
        return
    seen["usage_seen"] = True
    seen["input"] += _n(counted, "input_tokens")
    seen["output"] += _n(counted, "output_tokens")
    seen["cached"] += _n(counted, "cache_read_tokens")


def _tool_id(step: dict) -> str:
    return "agy:" + str(step.get("step_index", ""))


def _safe_error(step: dict) -> str:
    """Describe a tool failure without relaying its paths, commands, URLs, or contents."""
    info = step.get("tool_info") if isinstance(step.get("tool_info"), dict) else {}
    error = info.get("error") if isinstance(info.get("error"), dict) else {}
    kind = str(error.get("type") or "").strip()
    return (kind + ": the tool failed" if kind else "the tool failed")[:SUMMARY_CHARS]


def records(line: str, seen: dict) -> list:
    """Translate one official stream-json line into zero or more Rundesk records."""
    try:
        event = json.loads(line)
    except ValueError:
        return []
    if not isinstance(event, dict):
        return []

    kind = event.get("event")
    if kind == "init":
        init = event.get("init") if isinstance(event.get("init"), dict) else {}
        session = str(event.get("conversation_id") or "")
        seen["session"] = session or seen.get("session")
        seen["model"] = init.get("model") or seen.get("model")
        wanted = seen.get("wanted_session")
        if wanted and session and session != wanted:
            seen["resume_missed"] = True
        return []

    if kind == "step_update":
        step = (event.get("step_update")
                if isinstance(event.get("step_update"), dict) else {})
        _usage(step.get("usage"), seen)
        step_type = step.get("step_type")

        if step_type == "agent_response":
            counted = step.get("usage")
            belongs_to = str(step.get("conversation_id") or "")
            parent = str(seen.get("session") or "")
            if step.get("state") == "DONE" and isinstance(counted, dict) \
                    and (not belongs_to or not parent or belongs_to == parent):
                pieces = ("input_tokens", "cache_read_tokens")
                if any(isinstance(counted.get(piece), int)
                       and not isinstance(counted.get(piece), bool) for piece in pieces):
                    # One response's prompt, not the accumulated turn bill. Assignment
                    # preserves a decrease after compaction (R-USE-14, R-USE-15).
                    seen["session_tokens"] = sum(_n(counted, piece) for piece in pieces)
            text = str(step.get("text_delta") or "")
            if text:
                seen["text_seen"] = True
                return [{"type": "text", "text": text}]
            return []

        if step_type == "tool":
            info = step.get("tool_info") if isinstance(step.get("tool_info"), dict) else {}
            name = str(step.get("tool_name") or info.get("name") or "")
            tool_id = _tool_id(step)
            state = step.get("state")
            if state == "ACTIVE":
                record = {"type": "tool", "id": tool_id, "name": name}
                did = DID.get(name)
                if did:
                    record["did"] = did
                return [record]
            if state in ("DONE", "ERROR"):
                ok = state == "DONE"
                record = {"type": "result", "id": tool_id, "ok": ok,
                          "summary": f"{name or 'tool'} completed" if ok
                          else _safe_error(step)}
                if not ok:
                    seen["tool_error"] = record["summary"]
                return [record]
        return []

    if kind == "result":
        result = event.get("result") if isinstance(event.get("result"), dict) else {}
        seen["ended"] = True
        seen["session"] = str(result.get("conversation_id") or seen.get("session") or "")
        status = str(result.get("status") or "")
        response = str(result.get("response") or "")

        out = []
        # Normally the response already arrived as deltas. Keep the terminal response as
        # a fallback for error and schema paths that do not stream those deltas.
        if response and not seen.get("text_seen"):
            out.append({"type": "text", "text": response, "whole": True})

        # A fresh failure can omit step usage. A resumed success must never use result
        # usage as its fallback because that block is the conversation's running total.
        if not seen.get("usage_seen") and not seen.get("wanted_session"):
            counted = result.get("usage")
            if isinstance(counted, dict):
                _usage(counted, seen)

        usage = {"type": "usage", "input": seen["input"],
                 "output": seen["output"], "cached": seen["cached"]}
        if seen.get("model"):
            usage["model"] = seen["model"]
        if isinstance(seen.get("session_tokens"), int):
            usage["session"] = seen["session_tokens"]
        out.append(usage)

        ok = status == "SUCCESS"
        # agy 1.1.8 can report SUCCESS with an empty response after headless permission
        # denial. A failed tool plus no answer is not a successful Rundesk turn.
        if ok and seen.get("tool_error") and not response and not seen.get("text_seen"):
            ok = False
        done = {"type": "done", "ok": ok}
        if ok:
            done["session"] = seen.get("session") or ""
        else:
            done["why"] = str(result.get("error") or seen.get("tool_error")
                              or status or "the turn failed")[:SUMMARY_CHARS]
        out.append(done)
        return out

    return []


def _new_seen(resume=None) -> dict:
    return {
        "wanted_session": resume,
        "session": None,
        "model": None,
        "ended": False,
        "resume_missed": False,
        "text_seen": False,
        "tool_error": None,
        "usage_seen": False,
        "input": 0,
        "output": 0,
        "cached": 0,
        "session_tokens": None,
    }


def _present(where: str) -> None:
    """Present only this agent's granted skills at Antigravity's documented workspace root."""
    granted = os.environ.get("RUNDESK_SKILLS")
    standing = []
    if granted and os.path.isdir(granted):
        standing = sorted(one for one in os.listdir(granted) if not one.startswith("."))
    root = os.path.join(where, SKILLS_ROOT)
    if not standing and not os.path.isdir(root):
        return
    try:
        os.makedirs(root, exist_ok=True)
        for name in standing:
            link = os.path.join(root, name)
            target = os.path.relpath(os.path.join(granted, name), root)
            if os.path.islink(link):
                if os.readlink(link) == target:
                    continue
                os.unlink(link)
            elif os.path.exists(link):
                continue
            os.symlink(target, link)
        for name in os.listdir(root):
            link = os.path.join(root, name)
            if not os.path.islink(link) or os.path.exists(link):
                continue
            points_at = os.readlink(link)
            if not os.path.isabs(points_at):
                points_at = os.path.normpath(os.path.join(root, points_at))
            if granted and os.path.commonpath(
                    [os.path.abspath(granted), os.path.abspath(points_at)]) == \
                    os.path.abspath(granted):
                os.unlink(link)
    except (OSError, ValueError) as gone:
        went_wrong(f"this agent's skills could not be presented: {gone}")


def _raw():
    at = os.environ.get("RUNDESK_RAW")
    if not at:
        return None
    try:
        os.makedirs(os.path.dirname(at) or ".", exist_ok=True)
        return open(at, "a", encoding="utf-8")
    except OSError as gone:
        went_wrong(f"what this brain said could not be kept at {at}: {gone}")
        return None


def _drained(stream, keep: list) -> None:
    for line in stream:
        went_wrong(line)
        keep.append(line.rstrip())
        if len(keep) > TROUBLE_KEPT:
            del keep[0]
    stream.close()


def _why(trouble: list, code: int) -> str:
    for message in reversed(trouble):
        first = message.strip().splitlines()[0].strip() if message.strip() else ""
        if first:
            return first[:SUMMARY_CHARS]
    return f"the Antigravity CLI stopped without finishing the turn (exit {code})"


def _turn(argv: list, where: str, asked: str, env: dict, resume=None):
    """Run one agy process. Return ``(exit_code, resume_was_missing)``."""
    raw = _raw()
    seen = _new_seen(resume)
    trouble = []
    try:
        brain = subprocess.Popen(
            argv, cwd=where, env=env, text=True, bufsize=1,
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as gone:
        went_wrong(f"the Antigravity CLI would not start: {gone}")
        say(type="done", ok=False, why="the Antigravity CLI would not start")
        return 1, False

    draining = threading.Thread(target=_drained, args=(brain.stderr, trouble), daemon=True)
    draining.start()
    try:
        brain.stdin.write(asked)
        brain.stdin.close()
    except (OSError, ValueError):
        pass

    for line in brain.stdout:
        if raw:
            raw.write(line)
            raw.flush()
        translated = records(line, seen)
        if seen["resume_missed"]:
            # v1.1.8 silently starts a new conversation in its scratch project for an
            # unknown id. Stop before the model works there and retry with --new-project.
            brain.terminate()
            continue
        for record in translated:
            say(**record)

    brain.stdout.close()
    draining.join(timeout=GOING_SECONDS)
    if raw:
        raw.close()
    code = brain.wait()

    if seen["resume_missed"]:
        return code, True
    if not seen["ended"]:
        say(type="done", ok=False, why=_why(trouble, code))
        return code or 1, False
    return code, False


def _whose(env: dict) -> dict:
    """Supply the OS account name the native keyring lookup needs; never move credentials."""
    child = dict(env)
    if not child.get("USER"):
        try:
            child["USER"] = getpass.getuser()
        except (KeyError, OSError):
            pass
    child["AGY_CLI_DISABLE_AUTO_UPDATE"] = "true"
    child["AGY_CLI_HIDE_ACCOUNT_INFO"] = "true"
    return child


def carry() -> int:
    where = os.environ.get("RUNDESK_CWD") or os.getcwd()
    posture = os.environ.get("RUNDESK_POSTURE") or "work"
    if posture not in ("read", "work"):
        posture = "work"

    if shutil.which(AGY) is None and not (os.sep in AGY and os.access(AGY, os.X_OK)):
        went_wrong(f"there is no {AGY} on this machine's path — install Google's "
                   "Antigravity CLI, or point RUNDESK_ANTIGRAVITY_BIN at where it stands")
        say(type="done", ok=False, why="the Antigravity CLI is not on this machine's path")
        return 1

    asked = sys.stdin.read()
    if not asked.strip():
        say(type="done", ok=False, why="nothing was asked")
        return 1
    asked = _prompt(asked)

    _present(where)
    extra = _settings()
    resume = os.environ.get("RUNDESK_RESUME")
    argv = [AGY] + opening(posture, os.environ.get("RUNDESK_MODEL"), resume, extra)
    code, lost = _turn(argv, where, asked, _whose(os.environ), resume)
    if lost:
        went_wrong("that Antigravity conversation was no longer available; starting fresh")
        argv = [AGY] + opening(posture, os.environ.get("RUNDESK_MODEL"), None, extra)
        code, _ = _turn(argv, where, asked, _whose(os.environ))
    return code


if __name__ == "__main__":
    if "--capabilities" in sys.argv:
        print(json.dumps(CAN))
        raise SystemExit(0)
    raise SystemExit(carry())
