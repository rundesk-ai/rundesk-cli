#!/usr/bin/env python3
"""Grok, as a brain behind rundesk's provider seam.

A program, never a module. Rundesk runs this, hands it a turn through the environment and
stdin, reads whole records off stdout and ends it — nothing here is imported by anything,
and nothing here imports rundesk. Every fact about this vendor lives in this file.

The contract is `.knowledge/guides/write-a-provider-adapter.md`. What is measured about
this CLI is `.knowledge/research/2026-07-26-grok-cli-as-a-brain.md`.

Grok's one-shot `streaming-json` is deliberately not used. Measured at 0.2.112: a turn
that ran `list_dir` emitted only `thought`, `text` and `end`, while the same session's ACP
updates carried `tool_call` and `tool_call_update` records with a stable id, input, status
and output. `grok agent stdio` is the vendor's documented integration surface and preserves
those records while keeping the prompt off the process list.

Four flags decide whether this adapter is honest, and three of them are traps:

**`--permission-mode dontAsk` is accepted and silently ignored.** It shipped once in the
build this replaces: an agent given every write tool was then denied all of them, wrote
nothing, explained itself in prose, and the turn reported success. Nothing in a test suite
could see it. `session/new._meta.agentProfile` scopes what the CLI may do;
`bypassPermissions` lets those tools run headlessly instead of cancelling when nobody is
there to approve them.

**`--tools` is accepted by this process and reaches no ACP turn.** The vendor documents it
as headless-only; `grok agent stdio` prints no warning and hands the turn every built-in.
It shipped that way, so a read-posture turn ran `run_terminal_command` and returned the
working directory while the argv looked deliberate (#250) — the `dontAsk` failure exactly,
on the flag that had been the fix for it. The same is true of the `--allow` / `--deny`
permission rules, measured in the same run. What holds is an agent profile handed over
where the conversation is created, which is `scoped` below.

**`--sandbox` is a no-op headless.** Under `read-only` it created a file through its own
tool and through a shell redirect; under `strict` it read a planted marker well outside the
working directory. It is never passed, because a flag that reads like a guarantee and
enforces nothing is worse than no flag.

**`--no-memory` is not optional.** Measured while probing the resume round trip: a turn in
a *fresh* session answered a question only the previous conversation could have set up,
saying so as it went — "checking recent sessions for what 'the second one' refers to". One
conversation reading another's contents is what a per-conversation handle exists to
prevent, and a private home does not stop it because both conversations live in the same
home.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import threading

GROK = os.environ.get("RUNDESK_GROK_BIN", "grok")

#: What this brain can do, and only what was measured of it.
#:
#: `tools` is true because the ACP stream reports each call and its terminal update with
#: the same `toolCallId`. The one-shot streaming format still reports none; using it would
#: make this claim false.
#:
#: `resume` is true because the round trip was run and controlled, not because a flag
#: exists: turn two, told only "the second one", named a codeword from turn one that a
#: control session could not. Claiming it on a flag would cost the next turn its context
#: silently.
CAN = {"tools": True, "resume": True, "usage": True, "model": True, "steer": False}

#: What a Grok tool did, in Rundesk's words rather than the vendor's. This is deliberately
#: not the whole tool list: an unknown tool still gets a `tool` record, with no `did`, so a
#: new built-in never gets assigned a meaning somebody guessed.
DID = {
    "read_file": "read",
    "list_dir": "list",
    "grep": "search",
    "search": "search",
    "web_search": "search",
    "run_terminal_command": "run",
    "edit_file": "edit",
    "search_replace": "edit",
    # Measured creating a new file; existing-file changes used `search_replace`.
    "write": "make",
    "create_file": "make",
}

#: Which tools a turn may reach for, per posture (R-PRV-18).
#:
#: `run_terminal_command` is deliberately absent from `read`: it is the only shell this CLI
#: offers and it cannot be scoped to a command prefix the way another brain scopes its
#: shell, so there is no partial version of it to grant — and the sandbox that would have
#: contained it does not hold.
#:
#: **Delivered through ACP, never through the root command line.** Root `--tools` is this
#: CLI's own documented headless-only flag: `grok agent stdio` accepts it, says nothing,
#: and hands the turn every built-in anyway. Measured 2026-08-02 against 0.2.112 — a read
#: turn opened with `--tools read_file,list_dir,grep` listed all 31 built-ins, called
#: `run_terminal_command` and returned the working directory (#250). What holds is
#: `session/new._meta.agentProfile`, below.
ALLOWED = {
    "read": ("read_file", "list_dir", "grep"),
}

#: The two an allowlist alone leaves standing. Documented as the always-on MCP meta-tools
#: and measured to survive `tools`: a scoped turn came back naming `read_file, list_dir,
#: grep, search_tool, use_tool`. They are the route an owner's globally configured MCP
#: server would still be reachable through, so they are named to `disallowedTools` — which
#: this vendor documents as winning over the allowlist — and the same turn then named
#: exactly the three. They are asked for by their built-in ids: `MCPTool` is a
#: permission-rule class, and permission rules do not reach this transport either.
BESIDES = ("search_tool", "use_tool")

#: The posture that is not a list. `work` opens its conversation as no agent of ours at
#: all, which is this CLI's way of saying "every built-in". A list of names cannot stay
#: complete, and a tool this CLI gains next release would be one a working turn was
#: silently refused.
FULLY = "work"

#: What this CLI says when the home it was given has no login in it. Measured against a
#: fresh `GROK_HOME`: it exits 1 and names the command to run, which is what an owner needs
#: to hear rather than a credential quietly copied in on their behalf.
LOGGED_OUT = "not signed in"

#: How a turn ends when nothing went wrong. Anything else — a limit, an interruption, an
#: error — is a turn that did not finish, and is reported as one.
FINISHED = "end_turn"

#: How much of anything this brain hands back is passed on, and how many of its last
#: complaints are kept to explain a turn that stopped without saying it had.
SUMMARY_CHARS = 200
TROUBLE_KEPT = 20

#: How long to wait for the last of what the brain said went wrong, once its records have
#: run out. Short: the program has already finished, and this is a pipe emptying.
GOING_SECONDS = 5.0


def say(**it) -> None:
    """One record, one line, flushed — because a turn is watched while it happens."""
    sys.stdout.write(json.dumps(it) + "\n")
    sys.stdout.flush()


def went_wrong(said: str) -> None:
    """Something to tell whoever is reading the run, on the stream that is ours."""
    sys.stderr.write(said.rstrip() + "\n")
    sys.stderr.flush()


def _settings() -> dict:
    """Whatever the owner set, as they set it."""
    try:
        given = json.loads(os.environ.get("RUNDESK_SETTINGS") or "{}")
    except ValueError:
        went_wrong("what was set for this brain is not readable JSON, so none of it was used")
        return {}
    if not isinstance(given, dict):
        went_wrong("what was set for this brain is not a JSON object, so none of it was used")
        return {}
    return given


def _flags(extra: dict) -> list:
    """The owner's own flags, passed through as they gave them."""
    given = extra.get("flags")
    if given is None:
        return []
    if not isinstance(given, list) or not all(isinstance(one, str) for one in given):
        went_wrong("`flags` is passed to this brain as a list of strings; it was not, "
                   "so it was ignored")
        return []
    return list(given)


def opening(model, extra: dict) -> list:
    """Everything after the program's name, and why each part of it is there.

    Kept in one function with no side effects so a test can read the whole command line
    without starting anything — which is what holds the two silent traps above to what was
    measured rather than to what somebody remembered.

    **The posture is deliberately not an argument.** Nothing this command line can carry
    scopes an ACP turn, so a parameter here would read like a boundary and be none.
    """
    argv = ["--no-auto-update"]

    # Not optional, and not a preference. Without it this brain answers from conversations
    # it was never handed, which makes a resume handle mean nothing and lets one agent's
    # turn read another's.
    argv += ["--no-memory"]

    # Headless means there is nobody at a terminal to approve a tool. Without this, Grok
    # emits `stopReason: Cancelled` with exit 0 as soon as a turn reaches one — a working
    # posture that cannot inspect a file. This mode is measured to apply; `dontAsk` is not.
    # What the turn may touch is decided where the conversation is created, by `scoped`
    # below, because nothing on this command line reaches ACP to decide it.
    argv += ["--permission-mode", "bypassPermissions"]

    if model:
        argv += ["-m", model]

    argv += _flags(extra)
    # ACP is the vendor's integration surface. `--always-approve` belongs after `agent`
    # and before its transport; the root permission mode above is kept too because it is
    # the exact headless policy measured to prevent a tool turn ending as Cancelled.
    argv += ["agent", "--always-approve", "stdio"]
    return argv


def scoped(posture: str):
    """The agent an ACP conversation is opened as, when its posture is narrower than
    every built-in — or nothing at all, which is how `work` says "every built-in".

    This is the whole of how a posture is honoured on this brain (R-PRV-18). ACP resolves
    a session's agent definition when the conversation is made, and `_meta.agentProfile`
    is where a client hands one over — the same seam standing rules already arrive by
    (R-PRV-23), and for the same reason: the root command line does not reach this
    transport. Measured 2026-08-02 against 0.2.112, on both `session/new` and
    `session/load`.

    `injectDefaultTools` is what makes `tools` an allowlist rather than an addition: this
    vendor documents a stock profile as injecting its optional tools *before* the
    allowlist is applied, and only a curated one as staying strict.

    Pure and side-effect free, so the exact object crossing the seam is readable offline.

    **Its one drift signal is on stderr and nowhere else.** A profile this vendor cannot
    parse is not refused — `session/new` succeeds and the conversation quietly gets the
    default agent, which is every tool there is. The only thing said is
    `Failed to parse _meta.agentProfile JSON object, falling back to default agent`, on
    the stream `_drained` passes straight on. Re-probe with
    `.knowledge/scripts/probe-grok --acp-tools` when this CLI's version moves.
    """
    if posture not in ALLOWED:
        return None
    return {
        "name": f"rundesk-{posture}",
        "description": f"A Rundesk turn admitted to {posture} only.",
        # Added to what this brain was built with, never in place of it. The neighbouring
        # trap on Codex — an instruction field that silently replaced the vendor's own
        # prompt and left the model looking broken — is the same shape.
        "promptMode": "extend",
        "injectDefaultTools": False,
        "tools": list(ALLOWED[posture]),
        "disallowedTools": list(BESIDES),
    }


def records(line: str, seen: dict) -> list:
    """One line of this brain's stream, as the records rundesk understands — or none.

    Pure, so the mapping is driven offline against captured ACP notifications. Anything
    else is dropped and kept in the raw beside the run, so vendor drift remains evidence
    rather than becoming a meaning invented here.
    """
    try:
        one = json.loads(line)
    except ValueError:
        return []
    if not isinstance(one, dict):
        return []
    if one.get("method") not in (
            "session/update", "_x.ai/session/update", "_x.ai/session_notification"):
        return []
    params = one.get("params") or {}
    update = params.get("update")
    if not isinstance(update, dict):
        return []
    # ACP reports the parent conversation's current context as a gauge on each update.
    # Keep the last value, including a lower one after compaction, and accept it only
    # from the session this process was asked to carry (R-USE-14, R-USE-15).
    meta = params.get("_meta")
    value = meta.get("totalTokens") if isinstance(meta, dict) else None
    belongs_to = str(params.get("sessionId") or "")
    if isinstance(value, int) and not isinstance(value, bool) \
            and (not seen.get("session") or belongs_to == str(seen["session"])):
        seen["session_tokens"] = value
    kind = update.get("sessionUpdate")

    if kind == "agent_message_chunk":
        # A fragment, and never `whole`: this brain writes its reply a token at a time and
        # nothing in the stream ever restates it, so nothing it says is finished until the
        # turn is. Marking one `whole` would show a sentence that then changed underneath
        # whoever was reading it.
        seen["thinking"] = False
        return [{"type": "text", "text": _content(update)}]

    if kind == "agent_thought_chunk":
        # One contiguous block is one activity, not one per token-sized fragment. A tool
        # or spoken chunk resets it, so reasoning on each side of visible work remains two
        # phases rather than disappearing behind the first one.
        if seen.get("thinking"):
            return []
        seen["thinking"] = True
        return [{"type": "think", "text": _content(update)}]

    if kind == "tool_call":
        return _tool(update, seen)
    if kind == "tool_call_update":
        return _result(update, seen)
    if kind == "turn_completed":
        return _ended(update, seen)

    return []


def _content(update: dict) -> str:
    content = update.get("content")
    if isinstance(content, dict):
        return str(content.get("text") or "")
    return str(content or "")


def _tool(update: dict, seen: dict) -> list:
    """A tool as it starts, once, with the vendor name translated where measured."""
    at = str(update.get("toolCallId") or "")
    if not at:
        return []
    tools = seen.setdefault("tools", {})
    if at in tools:
        return []
    name = str(update.get("title") or "")
    tools[at] = name
    seen["thinking"] = False
    said = {"type": "tool", "id": at, "name": name}
    if name in DID:
        said["did"] = DID[name]
    return [said]


def _result(update: dict, seen: dict) -> list:
    """A tool's one terminal update, paired to the call by Grok's stable id."""
    status = update.get("status")
    if status not in ("completed", "failed", "cancelled"):
        return []
    at = str(update.get("toolCallId") or "")
    if not at:
        return []
    results = seen.setdefault("results", set())
    if at in results:
        return []
    results.add(at)
    said = []
    if at not in seen.setdefault("tools", {}):
        said.extend(_tool(update, seen))
    seen["thinking"] = False
    said.append({"type": "result", "id": at, "ok": status == "completed",
                 "summary": _summary(update.get("rawOutput"))})
    return said


def _summary(value) -> str:
    """A bounded account of a result; surfaces still keep successful results quiet."""
    if isinstance(value, (dict, list)):
        try:
            return json.dumps(value, sort_keys=True)[:SUMMARY_CHARS]
        except (TypeError, ValueError):
            pass
    return str(value or "")[:SUMMARY_CHARS]


def _ended(one: dict, seen: dict) -> list:
    """What the turn cost and that it is over — the only line either is taken from."""
    if seen.get("ended"):
        return []
    counted = one.get("usage") or {}

    # ACP's camel-case `inputTokens` includes `cachedReadTokens`, unlike the one-shot
    # stream's snake-case input count. Measured on the same 0.2.112 build: 26,797 input,
    # 24,448 cached and 81 output made 26,878 total, so fresh is their difference.
    #
    # There is no cache-*creation* figure at all. It is left out rather than guessed: an
    # absent number means we could not tell, which is different from zero.
    cached = _n(counted, "cachedReadTokens")
    usage = {"type": "usage", "input": max(0, _n(counted, "inputTokens") - cached),
             "output": _n(counted, "outputTokens"), "cached": cached}
    named = _model(counted)
    if named:
        usage["model"] = named
    if isinstance(seen.get("session_tokens"), int):
        usage["session"] = seen["session_tokens"]

    return [usage, _finished(one.get("stop_reason"), seen)]


def _finished(stopped, seen: dict) -> dict:
    """The terminal record, also usable when ACP omits its optional usage update."""
    seen["ended"] = True
    ended = {"type": "done", "ok": stopped == FINISHED,
             "session": seen.get("session") or ""}
    if stopped != FINISHED:
        ended["why"] = f"the turn ended as {stopped}" if stopped else "the turn did not finish"
    return ended


def _model(counted: dict) -> str:
    """Which model answered, as this brain reported it rather than as it was asked for.

    A silent substitution would show up here and nowhere else, which is the whole reason
    this is read back rather than echoed from `RUNDESK_MODEL`.
    """
    used = counted.get("modelUsage")
    if not isinstance(used, dict):
        return ""
    for named in used:
        return str(named)
    return ""


def _n(counted: dict, what: str) -> int:
    value = counted.get(what)
    return int(value) if isinstance(value, int) and not isinstance(value, bool) else 0


#: Where this brain looks for skills, relative to the directory a turn stands in.
#:
#: **Measured, not read off the documentation** — one canary planted per candidate
#: directory, each declaring its own unguessable code. This brain reads its own `.grok/skills` and, unusually, three other vendors'
#: roots as well — `.agents`, `.claude` and `.cursor` — deduplicating by name. Only its
#: own is written to: a skill placed for another brain is that brain's adapter's to
#: place, and relying on this one reading it would couple two files that must not know
#: about each other. It does not read `.codex/skills`, and no brain reads a bare
#: `skills/`. Measured 2026-07-27 against 0.2.112.
#: Re-probe with `.knowledge/scripts/probe-skills` when the version moves.
#:
#: Relative to `RUNDESK_CWD`, which is the agent's own home — so what one agent is given
#: is inside that agent's directory and no other agent stands anywhere near it.
SKILLS_ROOT = os.path.join(".grok", "skills")


def _present(where: str) -> None:
    """Stand this agent's granted skills where this brain will find them (R-PRV-24).

    Links rather than copies, so an owner editing the library edits what every agent
    holding that skill reads, with nothing to re-run. Measured: this brain follows a
    symlink, follows a link to a link, and indexes a skill once even when the same target
    is reachable from more than one place.

    **Never a link to the whole directory.** That would make a path this vendor owns an
    alias for the library itself — so its own skill-installer would write into the source
    of truth, and anything aimed at this directory would destroy it.

    Idempotent, and the pruning is deliberately narrow: an entry goes only when it is a
    link *we* made whose skill is no longer granted. A directory somebody wrote by hand
    and a link pointing somewhere else are things this did not put there.
    """
    granted = os.environ.get("RUNDESK_SKILLS")
    standing = []
    if granted and os.path.isdir(granted):
        standing = sorted(one for one in os.listdir(granted)
                          if not one.startswith("."))
    root = os.path.join(where, SKILLS_ROOT)
    # Nothing granted and nothing placed before: make no directory at all. An agent with
    # no skills should not have a vendor's directory in its home to explain.
    if not standing and not os.path.isdir(root):
        return
    try:
        os.makedirs(root, exist_ok=True)
        for name in standing:
            link = os.path.join(root, name)
            target = os.path.relpath(os.path.join(granted, name), root)
            if os.path.islink(link):
                if os.readlink(link) == target:
                    continue
                os.unlink(link)
            elif os.path.exists(link):
                continue          # somebody else's, and not ours to replace
            os.symlink(target, link)
        for name in os.listdir(root):
            link = os.path.join(root, name)
            if not os.path.islink(link) or os.path.exists(link):
                continue
            # **Ours is decided by where it points, not by it being broken.** An owner may
            # hand-place a link here to a skill of their own, and a target that is briefly
            # away — an unmounted drive, a file mid-move — makes it look exactly like a
            # grant that was revoked. Deleting on dangling alone took those. What is ours
            # is a link into the directory rundesk was told to present from.
            points_at = os.readlink(link)
            if not os.path.isabs(points_at):
                points_at = os.path.normpath(os.path.join(root, points_at))
            if granted and os.path.commonpath([os.path.abspath(granted), points_at]) == \
                    os.path.abspath(granted):
                os.unlink(link)   # granted once, revoked since
    except OSError as gone:
        # A turn without its skills is a whole turn. Say so and carry on rather than
        # failing a turn over what is, at worst, a brain that is less well informed.
        went_wrong(f"this agent's skills could not be presented: {gone}")


def carry() -> int:
    """One turn, from what rundesk set to what this brain said about it."""
    where = os.environ.get("RUNDESK_CWD") or os.getcwd()
    posture = os.environ.get("RUNDESK_POSTURE") or FULLY
    if posture not in ALLOWED and posture != FULLY:
        posture = FULLY

    if shutil.which(GROK) is None and not (os.sep in GROK and os.access(GROK, os.X_OK)):
        went_wrong(f"there is no {GROK} on this machine's path — install the Grok CLI, or "
                   f"point RUNDESK_GROK_BIN at where it stands")
        say(type="done", ok=False, why="the Grok CLI is not on this machine's path")
        return 1

    asked = sys.stdin.read()
    if not asked.strip():
        say(type="done", ok=False, why="nothing was asked")
        return 1

    argv = [GROK] + opening(os.environ.get("RUNDESK_MODEL"), _settings())

    # **`GROK_HOME` is deliberately not set, and the working directory is why.** Measured:
    # this brain files its conversations under the directory a turn was run in —
    # `~/.grok/sessions/%2FUsers%2F…%2F<agent home>` — exactly as Claude files them under
    # `~/.claude/projects/<cwd slug>`. Rundesk already stands each turn in its own agent's
    # home, so conversations, project state and the files a brain auto-loads are separated
    # by that alone. Relocating the *home* on top of it adds nothing except a second login
    # to create, and the shipped codex adapter has never set its own either.
    #
    # An owner who wants a genuinely separate identity passes one through `--set`, which
    # reaches this brain unread like any other flag.
    _present(where)

    preface = (os.environ.get("RUNDESK_PREFACE") or "").strip()
    return _turn(
        argv, where, dict(os.environ), asked, os.environ.get("RUNDESK_RESUME"), preface,
        scoped(posture),
    )


class _ACP:
    """The one sequential ACP conversation a Rundesk turn needs."""

    def __init__(self, brain, raw, seen: dict):
        self.brain = brain
        self.raw = raw
        self.seen = seen
        self.next_id = 0

    def request(self, method: str, params: dict, emit: bool = True) -> dict:
        self.next_id += 1
        wanted = self.next_id
        self._send({"jsonrpc": "2.0", "id": wanted, "method": method, "params": params})
        for line in self.brain.stdout:
            if self.raw:
                self.raw.write(line)
                self.raw.flush()
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if not isinstance(message, dict):
                continue
            if emit:
                for it in records(line, self.seen):
                    say(**it)
            # No client-side filesystem or terminal service was advertised. Refuse any
            # extension request explicitly instead of leaving Grok waiting forever.
            if message.get("method") and "id" in message:
                self._send({"jsonrpc": "2.0", "id": message["id"],
                            "error": {"code": -32601, "message": "method not supported"}})
                continue
            if message.get("id") != wanted:
                continue
            if isinstance(message.get("error"), dict):
                detail = str(message["error"].get("message") or message["error"])
                raise RuntimeError(f"{method}: {detail}")
            result = message.get("result")
            return result if isinstance(result, dict) else {}
        raise RuntimeError(f"Grok closed its ACP stream during {method}")

    def _send(self, message: dict) -> None:
        if self.brain.stdin is None:
            raise RuntimeError("Grok's ACP input is not available")
        self.brain.stdin.write(json.dumps(message) + "\n")
        self.brain.stdin.flush()


def _turn(argv: list, where: str, env: dict, asked: str, resume, preface: str,
          profile) -> int:
    """Run one ACP session, and report what it said as it says it."""
    raw = _raw()
    seen = {"session": str(resume or ""), "ended": False}
    trouble = []
    try:
        brain = subprocess.Popen(
            argv, cwd=where, env=env, text=True, bufsize=1,
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as gone:
        went_wrong(f"the Grok CLI would not start: {gone}")
        say(type="done", ok=False, why="the Grok CLI would not start")
        if raw:
            raw.close()
        return 1

    # Drained for the brain's whole life, in its own thread. A second pipe with nothing
    # reading it fills its buffer and stops the program dead — which presents half an hour
    # later as a brain that simply went quiet, and sends you looking anywhere but here.
    draining = threading.Thread(target=_drained, args=(brain.stderr, trouble), daemon=True)
    draining.start()
    acp = _ACP(brain, raw, seen)
    try:
        initialized = acp.request("initialize", {
            "protocolVersion": 1,
            # Advertising client filesystem or terminal services makes Grok send requests
            # back and wait for us to execute them. Rundesk wants Grok's own scoped tools,
            # which are what `scoped` above controls, so the client offers none.
            "clientCapabilities": {},
        })
        _authenticate(acp, initialized)

        session_params = {"cwd": where, "mcpServers": []}
        if resume:
            session_params["sessionId"] = str(resume)
            # R-PRV-18 — and unlike the rules below, this is sent again. A posture is the
            # owner's current answer about the machine, not the conversation's: an agent
            # narrowed to `read` after a working conversation was opened would otherwise
            # carry that conversation's whole tool set for as long as it is resumed.
            # Measured on `session/load`: a conversation created with no agent of ours came
            # back naming exactly the three read tools and could not run a shell command.
            if profile:
                session_params["_meta"] = {"agentProfile": profile}
            # Loading replays the saved turn as ordinary session updates, including its
            # text and `turn_completed`. They belong in the raw evidence, not in this new
            # turn's live records; emitting them repeats the prior reply and marks this
            # turn finished before its prompt is even sent.
            acp.request("session/load", session_params, emit=False)
            session = str(resume)
        else:
            # R-PRV-23 — ACP owns conversation creation, so its session metadata is the
            # only place Grok applies standing instructions separately from the prompt.
            # Root `--rules` is accepted by the process but ignored by `agent stdio`.
            # `_meta.rules` appends to the built-in system prompt; the replacement field
            # is deliberately never used. A resumed conversation already keeps the rules
            # it was opened with and therefore receives none again.
            meta = {}
            if preface:
                meta["rules"] = preface
            if profile:
                meta["agentProfile"] = profile
            if meta:
                session_params["_meta"] = meta
            made = acp.request("session/new", session_params)
            session = str(made.get("sessionId") or "")
            if not session:
                raise RuntimeError("Grok created no ACP session")
        seen["session"] = session

        completed = acp.request("session/prompt", {
            "sessionId": session,
            "prompt": [{"type": "text", "text": asked}],
        })
        if not seen["ended"]:
            # `turn_completed` carries the measured usage. If a compatible ACP server
            # returns only the prompt response, finish honestly without inventing zeros.
            say(**_finished(completed.get("stopReason"), seen))
        return 0
    except (BrokenPipeError, OSError, RuntimeError) as gone:
        said = " ".join(trouble + [str(gone)]).lower()
        if LOGGED_OUT in said or "authenticate" in said:
            went_wrong(f"this machine has no Grok login — run:\n  {GROK} login --device-code")
        if not seen["ended"]:
            say(type="done", ok=False, why=str(gone)[:SUMMARY_CHARS])
        return 1
    finally:
        if brain.stdin is not None and not brain.stdin.closed:
            try:
                brain.stdin.close()
            except OSError:
                pass
        try:
            brain.wait(timeout=GOING_SECONDS)
        except subprocess.TimeoutExpired:
            brain.terminate()
            try:
                brain.wait(timeout=GOING_SECONDS)
            except subprocess.TimeoutExpired:
                brain.kill()
                brain.wait()
        if brain.stdout is not None:
            brain.stdout.close()
        draining.join(timeout=GOING_SECONDS)
        if raw:
            raw.close()


def _authenticate(acp: _ACP, initialized: dict) -> None:
    """Use the login Grok itself advertises, without reading or copying a credential."""
    methods = initialized.get("authMethods")
    if not isinstance(methods, list) or not methods:
        return
    offered = {
        str(one.get("id")) for one in methods
        if isinstance(one, dict) and one.get("id")
    }
    preferred = str((initialized.get("_meta") or {}).get("defaultAuthMethodId") or "")
    if preferred not in offered:
        preferred = "cached_token" if "cached_token" in offered else ""
    if not preferred and os.environ.get("XAI_API_KEY") and "xai.api_key" in offered:
        preferred = "xai.api_key"
    if not preferred:
        raise RuntimeError("Grok offered no usable authentication method")
    acp.request("authenticate", {"methodId": preferred, "_meta": {"headless": True}})


def _drained(stream, keep: list) -> None:
    """Everything the brain says went wrong, passed straight on and the tail of it kept.

    Passed on as it arrives rather than at the end, because it is the only thing an owner
    has to read while a turn is still running — and because anything written to either
    stream is what tells rundesk this turn has not gone quiet.
    """
    for line in stream:
        went_wrong(line)
        keep.append(line.rstrip())
        if len(keep) > TROUBLE_KEPT:
            del keep[0]
    stream.close()


def _raw():
    """Where this brain's own stream is kept, if rundesk offered somewhere."""
    at = os.environ.get("RUNDESK_RAW")
    if not at:
        return None
    try:
        os.makedirs(os.path.dirname(at) or ".", exist_ok=True)
        return open(at, "a", encoding="utf-8")
    except OSError as gone:
        went_wrong(f"what this brain said could not be kept at {at}: {gone}")
        return None


