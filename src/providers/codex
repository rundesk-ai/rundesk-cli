#!/usr/bin/env python3
"""The Codex CLI, behind a Rundesk agent.

**Everything about this vendor is in this file and nowhere else.** Its protocol, the order
of its handshake, the shape of its notifications, where it keeps its sign-in and what its
counts mean are all here — nothing outside knows this brain exists, which is the point of
the seam. Read `.knowledge/guides/write-a-provider-adapter.md` and you can write another of
these for any brain at all, in any language; this one happens to be Python because Python
is what this repository already has.

An adapter is a *program*, not a plugin. Nothing here is imported by Rundesk, and nothing
here imports Rundesk.

**It speaks `codex app-server` rather than `codex exec`, and that is the whole reason it is
shaped like this.** `exec` is one command that reads a prompt and runs to the end: it cannot
be told anything once it has started, and its only usage figure is the whole thread's
running total. `app-server` is a conversation over stdin and stdout, and it gives three
things `exec` cannot:

**It uses the Codex this machine already has.** It does not give Codex a directory of its
own: pointed at one, Codex materialises its entire state tree there — sqlite databases,
caches, shell snapshots, sessions — at eighty megabytes an agent, and starts out logged out
so every agent needs its own `codex login`. Reaching the brain the machine already has is
the whole job. One sign-in, one copy of it.

1. **A turn can be steered.** `turn/steer` adds words to a turn that is *already running*,
   with the running turn's id as a precondition so a word cannot land in a turn nobody
   meant. Measured: a turn counting to twenty took a change of plan mid-count and finished
   on the new instruction, without being interrupted and started again.
2. **This turn's own cost, reported as such.** `thread/tokenUsage/updated` carries `last`
   beside `total`, so there is no running total to subtract and nothing to remember between
   turns — the trap `exec` forces every adapter to work around, and that the build this
   replaces got wrong across every restart.
3. **Cache writes already apart from cache reads.** `cacheWriteInputTokens` and
   `cachedInputTokens` are separate fields, and cache creation is billed above the standard
   rate, so folding them would misprice most of the volume.

Its cost: `app-server` is marked experimental at 0.145.0, and it is a protocol with a
lifecycle rather than one command. The measurements are in
`.knowledge/research/2026-07-26-codex-cli-as-a-brain.md`, and
`.knowledge/scripts/probe-codex` asks the same questions of the next version.
"""

from __future__ import annotations

import base64
import binascii
import hashlib
import json
import os
import shutil
import subprocess
import sys
import threading
from pathlib import Path

#: What to run. Overridable so a machine keeping it somewhere unusual — and the probes —
#: can point at it without this file being edited.
CODEX = os.environ.get("RUNDESK_CODEX_BIN", "codex")

#: What Codex says when it is not signed in. Recognised so this adapter can say what to do
#: about it, and for no other reason: **nothing here ever reads, writes, copies or links a
#: credential.** It uses the Codex this machine already has, signed in the way its owner
#: signed it in — `codex login`, once, for the machine rather than once per agent.
LOGGED_OUT = "401 Unauthorized"

#: How much of the machine a turn may touch, in this brain's words. Rundesk says `read` or
#: `work`; what those mean to Codex is this file's business and nobody else's. Named the
#: way its protocol names them — measured, because the schema calls the same idea three
#: things and only one of them is what the wire accepts here (see the research note:
#: externally tagged and kebab-case, not `{"mode": …}` and not a bare string).
#:
#: **`work` is full access, and that is a deliberate widening.** It was `workspace-write`,
#: which is an operating-system sandbox: no network from the shell, no reaching the
#: keychain, and no writing outside the workspace. That made this brain the odd one of the
#: three — `claude` and `grok` apply no sandbox at all and their `work` already grants a
#: shell, an editor and a writer, so the same word meant two very different things
#: depending on which brain answered. It also overrode an owner who had set
#: `sandbox_mode = "danger-full-access"` in their own `~/.codex/config.toml`, silently and
#: on every turn.
#:
#: So `work` now means what it says on every brain: the agent may do the work. What is
#: given up is real and is worth naming — a `work` turn on Codex can now reach the network
#: and write anywhere the person running rundesk can. `read` is unchanged and is still the
#: constrained posture, and it is the one to reach for when that matters.
SANDBOX = {"read": "read-only", "work": "danger-full-access"}

#: What Codex calls the things it does, said in words no brain owns. Anything not here is
#: reported without a `did` at all rather than in this vendor's vocabulary.
DID = {
    "commandExecution": "run",
    "fileChange": "edit",
    "webSearch": "search",
    "mcpToolCall": "run",
    "fileRead": "read",
    "listFiles": "list",
    "imageGeneration": "make",
    # The child activity is canonical because it names the child thread whose eventual
    # turn completion means the helper really finished. The spawn call completing only
    # means Codex managed to start it (measured 2026-07-27 against codex-cli 0.145.0).
    "subAgentActivity": "delegate",
}

#: Item kinds that are not tools: what the brain said, what it thought, and the echo of
#: what we ourselves sent it.
SPOKEN = {"agentMessage": "text", "reasoning": "think"}
OURS = "userMessage"

#: How long to wait on one answer in the handshake. A window on a *reply*, never on a turn:
#: a turn takes as long as the work takes, and nothing here bounds that.
ANSWER_SECONDS = 120.0

#: What this brain can do. Asked before a turn, offline, and the same every time.
CAN = {"tools": True, "resume": True, "usage": True, "model": False, "steer": True}


def say(**it) -> None:
    """One record, one line, flushed — because a turn is watched while it happens."""
    sys.stdout.write(json.dumps(it) + "\n")
    sys.stdout.flush()


class Codex:
    """One `codex app-server`, spoken to and listened to at the same time.

    Its own class because a protocol has a lifecycle: a request carries an id and its
    answer arrives later, notifications arrive whenever they like, and both share one pipe.
    """

    def __init__(self, where: str, raw):
        self._raw = raw
        self._asked = 0
        self._answers: dict = {}
        self._writing = threading.Lock()
        self.thread = None
        self.turn = None
        self.finished = threading.Event()
        self.ok = None
        self.why = None
        self.tokens = None
        self.session_tokens = None
        self._tools: dict = {}
        self._helpers: dict = {}  # child thread -> synthetic tool id, until it really ends
        self._proc = subprocess.Popen(
            [CODEX, "app-server"], cwd=where,
            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=None,          # straight through: rundesk keeps it, apart, as ours
            text=True, bufsize=1,
            # **The Codex that is installed, as it is installed.** Pointed at a directory
            # of its own, Codex does not merely keep a sign-in there — it materialises its
            # whole state tree, sqlite databases and caches and shell snapshots included,
            # to eighty megabytes per agent, and starts out logged out so nothing works
            # until somebody signs each one in separately. An adapter's job is to reach the
            # brain the machine already has, not to build it a second one.
            env=dict(os.environ),
        )
        threading.Thread(target=self._listen, daemon=True).start()

    # -- speaking ----------------------------------------------------------------------

    def ask(self, method: str, params=None) -> int:
        """One request, whose answer arrives later and is matched by its id."""
        with self._writing:
            self._asked += 1
            at = self._asked
            self._write({"jsonrpc": "2.0", "id": at, "method": method,
                         "params": params or {}})
        return at

    def tell(self, method: str, params=None) -> None:
        """One notification — nothing comes back, and nothing waits for it."""
        with self._writing:
            self._write({"jsonrpc": "2.0", "method": method, "params": params or {}})

    def _write(self, message: dict) -> None:
        if self._proc.stdin is None or self._proc.stdin.closed:
            return
        try:
            self._proc.stdin.write(json.dumps(message) + "\n")
            self._proc.stdin.flush()
        except (BrokenPipeError, ValueError, OSError):
            self.finished.set()   # it has gone, and nothing more will be answered

    def answered(self, at: int, patience: float = ANSWER_SECONDS) -> dict | None:
        """Wait for the answer to one request, and no longer than it is worth waiting."""
        waiting = threading.Event()
        waited = 0.0
        while waited < patience:
            if at in self._answers:
                return self._answers.pop(at)
            if self._proc.poll() is not None and at not in self._answers:
                return None
            waiting.wait(0.02)
            waited += 0.02
        return None

    # -- listening ---------------------------------------------------------------------

    def _listen(self) -> None:
        """Everything Codex says, turned into records as it arrives.

        The whole of it is kept first, exactly as it came. Rundesk sees what this adapter
        reports and never what it was made from, so without this a change to Codex's
        protocol would show up as records quietly going missing rather than as drift
        anybody can read.
        """
        assert self._proc.stdout is not None
        for line in self._proc.stdout:
            if self._raw is not None:
                self._raw.write(line.encode("utf-8", "replace"))
                self._raw.flush()
            try:
                said = json.loads(line)
            except ValueError:
                continue  # not everything on its stdout is a message, and what is not is not ours
            if "id" in said and ("result" in said or "error" in said):
                self._answers[said["id"]] = said
                if "error" in said:
                    _went_wrong(json.dumps(said["error"]))
                continue
            self._heard(said.get("method"), said.get("params") or {})
        self.finished.set()

    def _heard(self, method, params: dict) -> None:
        # Codex multiplexes child-agent threads onto this same app-server stream. A
        # child's completion is not this turn's completion: accepting the first
        # `turn/completed` ended the parent the moment a reviewer finished and published
        # whatever commentary the parent had written so far as its answer. Keep the
        # parent thread's own lifecycle, usage, prose and tools; its `subAgentActivity`
        # item still reports the delegation on the parent thread (R-PRV-25).
        belongs_to = params.get("threadId")
        if self.thread is not None and belongs_to is not None and belongs_to != self.thread:
            self._child_ended(method, params)
            return
        if method == "turn/started":
            self.turn = (params.get("turn") or {}).get("id")
        elif method == "turn/completed":
            became = params.get("turn") or {}
            self.ok = became.get("status") != "failed"
            self.why = ((became.get("error") or {}) or {}).get("message")
            self.finished.set()
        elif method == "turn/failed":
            self.ok, self.why = False, str((params.get("error") or {}).get("message", ""))
            self.finished.set()
        elif method == "thread/tokenUsage/updated":
            # `last` is this turn's own, reported as such — so there is no running total
            # to subtract, and nothing to carry between turns to subtract it from.
            self.tokens = (params.get("tokenUsage") or {}).get("last")
        elif method == "rawResponse/completed" and params.get("turnId") == self.turn:
            # One upstream response, not the turn's aggregate bill. The final response's
            # input is the context level this parent conversation ended on (R-USE-15).
            # Replace rather than maximize or add: compaction is allowed to make it fall.
            value = (params.get("usage") or {}).get("inputTokens")
            if isinstance(value, int) and not isinstance(value, bool):
                self.session_tokens = value
        elif method == "item/started":
            self._began(params.get("item") or {})
        elif method == "item/completed":
            self._ended(params.get("item") or {})
        elif method == "error":
            _went_wrong(str(params.get("message", "")))

    def _began(self, item: dict) -> None:
        kind = item.get("type")
        if not kind or kind in SPOKEN or kind == OURS or kind == "subAgentActivity" \
                or _quiet_activity(item):
            return
        at = str(item.get("id") or len(self._tools) + 1)
        self._tools[at] = kind
        said = {"type": "tool", "id": at, "name": kind}
        if kind in DID:
            say(**said, did=DID[kind])
        else:
            say(**said)   # one we have no word for is said without one, never with its

    def _ended(self, item: dict) -> None:
        kind = item.get("type")
        if not kind or kind == OURS:
            return  # the echo of what we sent; the run's account already holds it
        if kind == "subAgentActivity":
            self._helper_activity(item)
            return
        if _quiet_activity(item):
            # Successful send/resume/wait/close records are bookkeeping for the one helper
            # already announced by spawn. A failure is still something the owner needs to
            # see, without pretending another helper was delegated first.
            if item.get("status") == "failed":
                say(type="result", id=str(item.get("id") or "1"), ok=False,
                    summary=_summary(item))
            return
        if kind in SPOKEN:
            # `whole`, because this arrives on the item having *completed*: what this
            # brain says is finished by the time it says it, never a piece of something
            # still being written. So a surface may show each as it is said rather than
            # holding every one of them to the end.
            say(type=SPOKEN[kind], text=item.get("text") or "", whole=True)
            return
        at = str(item.get("id") or "1")
        if at not in self._tools:
            self._began(item)   # one that finished without ever having started
        self._tools.pop(at, None)
        worked = item.get("exit_code") in (0, None) and item.get("status") != "failed"
        say(type="result", id=at, ok=bool(worked), summary=_summary(item))
        if worked:
            for made in _files(item, os.environ.get("RUNDESK_CWD") or "."):
                # Said, so a surface can actually send it. Codex names what it wrote in
                # the item that finished; without this a brain that generates a picture
                # can only mention it in a sentence, and the picture never arrives.
                say(type="file", at=made)

    def _helper_activity(self, item: dict) -> None:
        """Start one visible helper lifecycle; incidental interactions remain quiet."""
        state = item.get("kind")
        thread = str(item.get("agentThreadId") or "")
        if state == "started":
            if thread and thread in self._helpers:
                return
            at = f"subagent:{thread}" if thread else str(item.get("id") or "subagent")
            if thread:
                self._helpers[thread] = at
            say(type="tool", id=at, name="subAgentActivity", did="delegate",
                who=str(item.get("agentPath") or "").rsplit("/", 1)[-1])
        elif state in ("errored", "interrupted", "shutdown"):
            self._finish_helper(thread, False, str(state))

    def _child_ended(self, method: str, params: dict) -> None:
        """Finish a helper without ever treating its turn as the parent's completion."""
        thread = str(params.get("threadId") or "")
        if method == "turn/completed":
            became = params.get("turn") or {}
            status = str(became.get("status") or "completed")
            self._finish_helper(thread, status == "completed", status)
        elif method == "turn/failed":
            error = params.get("error") or {}
            self._finish_helper(thread, False, str(error.get("message") or "failed"))

    def _finish_helper(self, thread: str, ok: bool, summary: str) -> None:
        at = self._helpers.pop(thread, None) if thread else None
        if at is not None:
            say(type="result", id=at, ok=ok, summary=summary)

    def end(self) -> None:
        if self._proc.stdin is not None and not self._proc.stdin.closed:
            try:
                self._proc.stdin.close()
            except (BrokenPipeError, ValueError, OSError):
                pass
        try:
            self._proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self._proc.terminate()


def _quiet_activity(item: dict) -> bool:
    """Provider bookkeeping that would over-count one delegation.

    Child activity owns the visible lifecycle because it can be correlated with the child
    turn. Spawn/send/resume/wait/close operate that same child; none means another helper
    began or finished.
    """
    kind = item.get("type")
    return kind == "collabAgentToolCall"


#: Where this brain puts a thing it made, and the field it says so in. **Measured, not
#: guessed** — an earlier version of this looked for `changes`, `files`, `artifacts` and
#: `outputs`, none of which Codex has ever emitted, so a generated picture was reported
#: by nobody and quietly never sent. The name below came from reading a real
#: `imageGeneration` item; `.knowledge/scripts/probe-codex` asks the next version.
MADE_AT = "savedPath"

#: Image content a dynamic tool may return inline. Measured from the app-server 0.145.0
#: schema: contentItems holds inputImage records whose imageUrl may be a data URL. Only
#: formats Discord can upload unchanged are materialised.
IMAGE_TYPES = {
    "image/jpeg": ".jpg",
    "image/png": ".png",
    "image/webp": ".webp",
}


def _files(item: dict, workspace: str) -> list:
    """Anything this item says it made, brought to where the agent actually works.

    Codex writes a generated image under its own home — beside a sign-in, among files
    that are the owner's and not this agent's. Rundesk will only send what is inside the
    agent's own directories, and rightly: "the brain made it" is not a reason to reach
    into everything the brain can see. So it is copied in, which is this file's job,
    because where this vendor puts things is a Codex-shaped fact.

    Dynamic tools report inline images instead of paths. Those are decoded into the same
    workspace directory (R-PRV-26). Remote URLs are deliberately not fetched: a tool
    returning a reference is not authority for the gateway to make a network request.
    """
    found = []
    where = os.path.join(workspace, "made")
    at = item.get(MADE_AT)
    if isinstance(at, str) and at and os.path.isfile(at):
        try:
            os.makedirs(where, exist_ok=True)
            landed = os.path.join(where, os.path.basename(at))
            shutil.copyfile(at, landed)
            found.append(landed)
        except OSError as why:
            sys.stderr.write(f"could not bring {at} into the workspace: {why}\n")
    for content in item.get("contentItems") or []:
        if not isinstance(content, dict) or content.get("type") != "inputImage":
            continue
        landed = _inline_image(content.get("imageUrl"), where)
        if landed and landed not in found:
            found.append(landed)
    return found


def _inline_image(image_url, where: str) -> str | None:
    """One explicit inline image, or nothing for a reference or malformed content."""
    if not isinstance(image_url, str):
        return None
    header, comma, encoded = image_url.partition(",")
    if not comma or not header.startswith("data:") or not header.endswith(";base64"):
        return None
    mime = header[5:-7].lower()
    extension = IMAGE_TYPES.get(mime)
    if not extension:
        return None
    try:
        payload = base64.b64decode(encoded, validate=True)
    except (binascii.Error, ValueError):
        return None
    if not payload:
        return None
    try:
        os.makedirs(where, exist_ok=True)
        digest = hashlib.sha256(payload).hexdigest()[:16]
        for number in range(1000):
            suffix = "" if number == 0 else f"-{number + 1}"
            landed = os.path.join(where, f"tool-image-{digest}{suffix}{extension}")
            try:
                descriptor = os.open(landed, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            except FileExistsError:
                try:
                    if not os.path.islink(landed) and Path(landed).read_bytes() == payload:
                        return landed
                except OSError:
                    pass
                continue
            with os.fdopen(descriptor, "wb") as made:
                made.write(payload)
            return landed
    except OSError as why:
        sys.stderr.write(f"could not bring an inline tool image into the workspace: {why}\n")
    return None


def _summary(item: dict) -> str:
    """What a tool did, short enough to read and never the whole of its output.

    Deliberately not the output itself: it can hold file contents, credentials and private
    paths, and what a channel shows is not this adapter's to decide.
    """
    for what in ("command", "path", "query", "name"):
        if item.get(what):
            return str(item[what])[:200]
    return str(item.get("status") or "done")


def _went_wrong(said: str) -> None:
    """What Codex said went wrong, and — when it is the one thing an owner can fix — how.

    **Nothing here reads, writes, copies or links a credential.** Codex keeps its sign-in
    inside the home it is given rather than in a keychain, so the private home this agent
    was given starts out logged out. Whether to sign that home in on its own, or to point
    it at one the owner already has, is theirs to decide: an adapter that quietly arranged
    either would be making a decision about somebody's credentials on their behalf, and it
    would be sharing them between agents without anyone having said so.
    """
    sys.stderr.write(said + "\n")
    # Once per turn. A failed request is retried several times and every attempt says the
    # same thing, so the advice would arrive five times for one fixable problem.
    if LOGGED_OUT in said and not _went_wrong.said_it:
        _went_wrong.said_it = True
        sys.stderr.write("this machine's Codex is not signed in — run:  codex login\n")


_went_wrong.said_it = False


def _findable():
    """Codex, if this machine can find it — said plainly rather than discovered at runtime.

    A gateway is started by the machine's own supervisor with a bare environment, so a name
    that resolves in an owner's shell may resolve to nothing there. Checked rather than
    guessed at: no list of the places Codex might have been installed, because such a list
    is wrong on the first machine that did something else.
    """
    from shutil import which
    return CODEX if os.path.isabs(CODEX) else which(CODEX)


def _settings() -> dict:
    """Whatever the owner set, as this brain's own options.

    Rundesk hands it over without reading it, so this is the only place it means anything.
    Two shapes: `config` becomes Codex's own dotted overrides, and `effort` is how hard it
    thinks. Anything else is ignored rather than guessed at, and said on stderr so an owner
    who mistyped hears about it.
    """
    try:
        said = json.loads(os.environ.get("RUNDESK_SETTINGS") or "{}")
    except ValueError:
        sys.stderr.write("RUNDESK_SETTINGS was not readable as JSON; ignoring it\n")
        return {}
    if not isinstance(said, dict):
        return {}
    for unknown in sorted(set(said) - {"config", "effort"}):
        sys.stderr.write(f"'{unknown}' is not a setting this adapter understands\n")
    return said


#: Where this brain looks for skills, relative to the directory a turn stands in.
#:
#: **Measured, not read off the documentation** — one canary planted per candidate
#: directory, each declaring its own unguessable code. This brain reads `.agents/skills` and `.codex/skills`, both as repo scope, and
#: neither `.claude`, `.grok`, `.cursor` nor a bare `skills/`. `.agents` is chosen of the
#: two because it is the cross-vendor convention rather than this vendor's own corner.
#: Measured 2026-07-27 against codex-cli 0.145.0, confirmed by its own `skills/list`,
#: which reported exactly the two roots. Project trust is not needed: it says so itself
#: — project-local config is disabled until a project is trusted, but skills still load.
#: Re-probe with `.knowledge/scripts/probe-skills` when the version moves.
#:
#: Relative to `RUNDESK_CWD`, which is the agent's own home — so what one agent is given
#: is inside that agent's directory and no other agent stands anywhere near it.
SKILLS_ROOT = os.path.join(".agents", "skills")


def _present(where: str) -> None:
    """Stand this agent's granted skills where this brain will find them (R-PRV-24).

    Links rather than copies, so an owner editing the library edits what every agent
    holding that skill reads, with nothing to re-run. Measured: this brain follows a
    symlink, follows a link to a link, and indexes a skill once even when the same target
    is reachable from more than one place.

    **Never a link to the whole directory.** That would make a path this vendor owns an
    alias for the library itself — so its own skill-installer would write into the source
    of truth, and anything aimed at this directory would destroy it.

    Idempotent, and the pruning is deliberately narrow: an entry goes only when it is a
    link *we* made whose skill is no longer granted. A directory somebody wrote by hand
    and a link pointing somewhere else are things this did not put there.
    """
    granted = os.environ.get("RUNDESK_SKILLS")
    standing = []
    if granted and os.path.isdir(granted):
        standing = sorted(one for one in os.listdir(granted)
                          if not one.startswith("."))
    root = os.path.join(where, SKILLS_ROOT)
    # Nothing granted and nothing placed before: make no directory at all. An agent with
    # no skills should not have a vendor's directory in its home to explain.
    if not standing and not os.path.isdir(root):
        return
    try:
        os.makedirs(root, exist_ok=True)
        for name in standing:
            link = os.path.join(root, name)
            target = os.path.relpath(os.path.join(granted, name), root)
            if os.path.islink(link):
                if os.readlink(link) == target:
                    continue
                os.unlink(link)
            elif os.path.exists(link):
                continue          # somebody else's, and not ours to replace
            os.symlink(target, link)
        for name in os.listdir(root):
            link = os.path.join(root, name)
            if not os.path.islink(link) or os.path.exists(link):
                continue
            # **Ours is decided by where it points, not by it being broken.** An owner may
            # hand-place a link here to a skill of their own, and a target that is briefly
            # away — an unmounted drive, a file mid-move — makes it look exactly like a
            # grant that was revoked. Deleting on dangling alone took those. What is ours
            # is a link into the directory rundesk was told to present from.
            points_at = os.readlink(link)
            if not os.path.isabs(points_at):
                points_at = os.path.normpath(os.path.join(root, points_at))
            if granted and os.path.commonpath([os.path.abspath(granted), points_at]) == \
                    os.path.abspath(granted):
                os.unlink(link)   # granted once, revoked since
    except OSError as gone:
        # A turn without its skills is a whole turn. Say so and carry on rather than
        # failing a turn over what is, at worst, a brain that is less well informed.
        _went_wrong(f"this agent's skills could not be presented: {gone}")


def carry() -> int:
    """One turn: run Codex, report what it does, and steer anything said into it."""
    where = os.environ.get("RUNDESK_CWD") or "."

    _present(where)

    if _findable() is None:
        sys.stderr.write(
            f"'{CODEX}' is not on this machine's path as this agent runs — install the "
            f"Codex CLI, or point RUNDESK_CODEX_BIN at where it stands.\n")
        say(type="done", ok=False, why="the Codex CLI is not on this machine's path")
        return 1

    keeping = None
    at = os.environ.get("RUNDESK_RAW")
    if at:
        try:
            keeping = open(at, "ab")
        except OSError as why:
            sys.stderr.write(f"could not keep what the brain said: {why}\n")

    codex = Codex(where, keeping)
    try:
        return _turn(codex, where)
    finally:
        codex.end()
        if keeping is not None:
            keeping.close()


def _turn(codex, where: str) -> int:
    """The handshake, the turn, and everything said into it while it is still running."""
    resume = os.environ.get("RUNDESK_RESUME")
    model = os.environ.get("RUNDESK_MODEL")
    # Anything unrecognised falls back to what `work` means rather than to a value written
    # here, which would be a third copy of the mapping and would go stale the first time
    # what a posture means changes — as it just did.
    posture = SANDBOX.get(os.environ.get("RUNDESK_POSTURE", "work"), SANDBOX["work"])
    extra = _settings()

    if codex.answered(codex.ask("initialize", _initializing())) is None:
        say(type="done", ok=False, why="Codex would not start")
        return 1
    codex.tell("initialized")

    opening = _opening(where, posture, model, extra)
    started = _opened(codex, opening, resume)
    if started is None:
        say(type="done", ok=False, why="Codex would not open a conversation")
        return 1
    codex.thread = (started.get("thread") or {}).get("id")

    # The posture belongs to the conversation and is set when it is opened, so a turn
    # inside it does not restate it — two places to say one thing is two places to be
    # wrong in.
    beginning = {"threadId": codex.thread, "cwd": where}
    if model:
        beginning["model"] = model
    if extra.get("effort"):
        beginning["effort"] = extra["effort"]

    # Everything rundesk says, for as long as it is saying it. The first record starts the
    # turn and every one after it is steered into the turn already running — the running
    # turn's id is a precondition, so a word cannot land in a turn nobody meant.
    #
    # **Read on a thread, never in the way of the turn ending.** Read inline, this loop
    # ran until stdin *closed*, and only then looked at whether the brain had finished. A
    # terminal closes stdin when the person stops typing, so every turn ended and the
    # fault was invisible — but a surface holding a conversation open never closes it, so
    # the brain answered, Codex reported the turn complete, and this adapter sat waiting
    # for a word that was never coming. The guide is explicit: a turn ends when the brain
    # is finished, whatever the input is doing.
    started = threading.Event()

    def listen() -> None:
        asked = False
        for line in sys.stdin:
            word = _word(line)
            if word is None:
                continue
            if not asked:
                codex.ask("turn/start", {**beginning, "input": [_text(word)]})
                asked = True
                # Said *after* the turn is really under way, never before. Set first, the
                # waiter woke while the turn id was still on its way and read a turn that
                # had begun as one that was never asked for.
                _until(lambda: codex.turn is not None or codex.finished.is_set())
                started.set()
                continue
            if codex.finished.is_set():
                sys.stderr.write("the turn had already finished, so that was not sent\n")
                continue
            codex.ask("turn/steer", {"threadId": codex.thread, "expectedTurnId": codex.turn,
                                     "input": [_text(word)]})
        # Nothing more is coming. Said so the wait below ends for a caller that closed
        # its input without ever asking anything.
        started.set()

    heard = threading.Thread(target=listen, daemon=True)
    heard.start()
    # Wait for the turn to be asked for at all before waiting for it to finish, or an
    # empty `finished` reads as a turn that ended before it began.
    started.wait()
    if codex.turn is None and not codex.finished.is_set():
        say(type="done", ok=False, why="nothing was asked")
        return 1
    # No deadline. A turn takes as long as the work takes, and rundesk ends one that has
    # gone silent — which is its decision to make and never this adapter's.
    codex.finished.wait()
    if codex.tokens:
        say(**_usage(codex.tokens, codex.session_tokens))
    # No model: this brain names none in what it reports, so none is claimed. Saying the
    # one that was asked for would be reporting a request as a measurement.
    ended = {"type": "done", "ok": bool(codex.ok), "session": codex.thread or ""}
    if not codex.ok and codex.why:
        ended["why"] = codex.why
    say(**ended)
    return 0 if codex.ok else 1


def _initializing() -> dict:
    """Opt into the notification carrying one upstream response's exact usage."""
    return {
        "clientInfo": {"name": "rundesk", "version": "1"},
        "capabilities": {"experimentalApi": True},
    }


def _usage(counted: dict, session=None) -> dict:
    """Codex's billing slots and terminal context level (R-USE-13, R-USE-15)."""
    cached = _n(counted, "cachedInputTokens")
    written = _n(counted, "cacheWriteInputTokens")
    usage = {
        "type": "usage",
        "input": max(0, _n(counted, "inputTokens") - cached - written),
        "output": _n(counted, "outputTokens"),
        "cached": cached,
    }
    if "cacheWriteInputTokens" in counted:
        usage["written"] = written
    if isinstance(session, int) and not isinstance(session, bool):
        usage["session"] = session
    return usage


def _opening(where: str, posture: str, model, extra: dict) -> dict:
    """What codex is given to open a conversation with.

    **Standing instructions go in `developerInstructions`, and never in
    `baseInstructions`.** They sit next to each other in the protocol and one of them is a
    trap: "base" means base, and what is put there stands in place of the instructions
    codex was built with — including the ones telling it how to use its own tools. Nothing
    reports that; the turn merely behaves strangely and the model gets the blame. Both were
    probed against a real codex: given standing instructions here it obeyed them *and* its
    shell tool still worked, which is the whole test.

    Set only where a conversation is *opened*, because that is the only place codex reads
    it — see `_opened`.
    """
    opening = {"cwd": where, "sandbox": {posture: {}}}
    if model:
        opening["model"] = model
    if extra.get("config"):
        opening["config"] = extra["config"]
    preface = (os.environ.get("RUNDESK_PREFACE") or "").strip()
    if preface:
        opening["developerInstructions"] = preface
    return opening


def _opened(codex, opening: dict, resume):
    """The conversation this turn belongs to — the one being carried on, or a new one.

    A conversation we were asked to carry on may simply be gone: a home that was purged, a
    thread that was archived. Starting a new one costs this turn its context and nothing
    else, which is exactly what losing a handle is supposed to cost, and it is a great deal
    better than refusing to answer at all.
    """
    if resume:
        # **Without the standing instructions.** Passed here they are accepted and then
        # ignored — probed with a rule the conversation's own history could not supply,
        # obeyed at `thread/start` and absent after a resume, in a fresh process, which is
        # the shape rundesk actually runs. An argument that is quietly dropped is worse
        # than one that was never sent, because it reads like it works. A conversation
        # keeps the wording it was opened with, which is part of what makes it one.
        carried = {one: it for one, it in opening.items() if one != "developerInstructions"}
        said = codex.answered(codex.ask("thread/resume", {**carried, "threadId": resume}))
        if said and "result" in said:
            return said["result"]
        sys.stderr.write("that conversation could not be carried on; starting a new one\n")
    said = codex.answered(codex.ask("thread/start", opening))
    return said["result"] if said and "result" in said else None


def _word(line: str):
    """One thing rundesk said, out of the record it said it in.

    Records, because this adapter says it can be steered: its input stays open for as long
    as the turn does, so nothing can mean "the prompt ended" any more. A line that is not
    a record is taken as the words themselves, so a person driving this by hand is not
    made to write JSON.
    """
    line = line.strip()
    if not line:
        return None
    if not line.startswith("{"):
        return line
    try:
        return (json.loads(line) or {}).get("text") or None
    except ValueError:
        return line


def _text(word: str) -> dict:
    return {"type": "text", "text": word}



def _until(ready, patience: float = ANSWER_SECONDS) -> None:
    waiting = threading.Event()
    waited = 0.0
    while waited < patience and not ready():
        waiting.wait(0.02)
        waited += 0.02


def _n(said: dict, what: str) -> int:
    value = said.get(what)
    return value if isinstance(value, int) and not isinstance(value, bool) else 0


if __name__ == "__main__":
    if "--capabilities" in sys.argv:
        print(json.dumps(CAN))
        raise SystemExit(0)
    raise SystemExit(carry())
