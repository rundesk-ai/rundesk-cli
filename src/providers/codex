#!/usr/bin/env python3
"""Codex, as an agent thinks with it.

Everything about this brain is in this file and nowhere else. A JSON-RPC method name, a thread id, a
sandbox spelling, the fact that its token counts are a running total for the whole conversation —
none of it appears anywhere under `src/rundesk/`, nothing there imports this, and nothing here
imports rundesk. The seam is a pipe carrying newline-delimited records, and it is what lets a
product that names no vendor reach one.

**rundesk runs the vendor's own published CLI, as the owner, through the interface the vendor
documents.** `codex app-server` is that interface — its protocol is generated by `codex app-server
generate-json-schema`, and this adapter was written against the bundle 0.146.0 emits. Nothing here
impersonates a first-party client: `initialize` carries `clientInfo: rundesk`, which is what the
server puts in its own user agent, and `threadSource` says `rundesk` so the owner's own thread list
shows where a thread came from. No credential is read, copied or moved; the owner signs in with
`codex login` and this never learns how that worked.

Two invocations, sharing almost nothing:

    --capabilities   what this can do — offline, no account, the same answer every time
    (no argument)    one turn: the prompt arrives as records on stdin, records come back on stdout

## What was measured rather than assumed

Four things decide whether this is correct, and each was probed against 0.146.0 rather than read
out of a schema that does not say:

- **Token counts are the conversation's running total, not the turn's.** `thread/tokenUsage/updated`
  carries `total` (the thread, since it began) and `last` (the most recent model request). Neither
  is what a turn cost. The turn's share is `total` at the end minus `total` before it started — and
  the baseline is recovered from the turn's own first update as `total - last`, which needs no file,
  no memory between runs and nothing that can go stale. Measured: turn one 15,428 → 30,890, turn two
  30,890 → 46,376, and the baseline the arithmetic recovers for turn two is exactly turn one's end.
  The build this replaces kept the baseline in memory and over-reported the first turn of every
  existing thread after a restart.

- **`developerInstructions` is bound when a thread is created and ignored on resume.** Probed three
  ways: sent at `thread/start` it is obeyed; after a resume that does not re-send it, a fact from it
  that was never said aloud still comes back; and a *different* one sent at `thread/resume` is
  accepted and has no effect at all. So the preface goes on `thread/start` and is deliberately left
  off a resume. **An argument accepted and then dropped is worse than one never sent.**

- **It is `developerInstructions` and never `baseInstructions`.** The second replaces the
  instructions the brain was built with — send an owner's paragraph there and you have not added a
  paragraph, you have deleted the brain and left the paragraph. Nothing reports it and the turn
  merely behaves oddly.

- **What the agent says arrives in two phases.** `agentMessage` items carry `phase`, and a turn that
  uses a tool says something in `commentary` first and answers in `final_answer` at the end. Both
  are text the agent said, so both are reported; the tool records between them are what let rundesk
  tell the working-out from the answer.

## What this deliberately does not report

**No `file` records.** Codex reports a file *changed*, and nothing in its stream tells a picture
somebody asked for from a source file it happened to edit on the way. A `file` record is what gets
attached to a message on a channel, so guessing here would mail somebody their own repository.
Changes are reported as `edit` tools, which is what they are.
"""

import contextlib
import json
import os
import re
import subprocess
import sys
import threading
import time
from pathlib import Path

#: The program, and the surface. `--stdio` is explicit rather than defaulted so an upgrade that
#: changes the default transport fails loudly here instead of hanging with nothing on the pipe.
CODEX = "codex"
APP_SERVER = ("app-server", "--stdio")

#: What this says it is, and what the server puts in its own user agent. Honest identification is
#: the point — see the module docstring on why nothing here pretends to be somebody else.
CLIENT = "rundesk"

#: How long `codex --version` may take when `--capabilities` is asked. It is a local exec with no
#: network in it; a machine where that takes longer has something else wrong.
VERSION_WITHIN = 10.0

#: How long to wait for the server to answer `initialize` and `thread/start`. Not a turn timeout —
#: rundesk owns the silence window and the ceiling, and duplicating them here would mean two
#: policies disagreeing. This covers only the handshake, where a hang has no records to explain it.
HANDSHAKE_WITHIN = 120.0

#: How much of what a tool printed goes in its `result` summary. The whole of it is in the raw
#: stream; this is what belongs on a line somebody is watching go past.
A_SUMMARY_AT_MOST = 400

#: How rundesk's two access modes are spelled here. **A request, not containment** — this is what
#: the brain is asked for, and what it really enforces is the brain's own business.
SANDBOX_FOR = {"read": "read-only", "work": "workspace-write"}

#: What a command a brain ran actually did, in rundesk's words. Codex parses the command line itself
#: and says which of four things it recognised; anything else is a command that ran.
DID_FOR_COMMAND = {"read": "read", "listFiles": "list", "search": "search", "unknown": "run"}

#: Which of the closed words each of the brain's own error names means. **Nothing is inferred from
#: the prose beside it** — a word guessed from a message is a word that is wrong on the first vendor
#: that rewords one. A name absent from here is reported with no word at all rather than a wrong one.
FAILURE_FOR = {
    "unauthorized": "signed_out",
    "usageLimitExceeded": "usage_exhausted",
    "sessionBudgetExceeded": "usage_exhausted",
    "contextWindowExceeded": "context_exceeded",
    "serverOverloaded": "rate_limited",
    "internalServerError": "upstream_error",
    "badRequest": "upstream_error",
    "threadRollbackFailed": "upstream_error",
    "cyberPolicy": "refused",
    "sandboxError": "no_access",
    "other": "upstream_error",
    # The object-shaped ones, keyed by the single field that names them.
    "httpConnectionFailed": "offline",
    "responseStreamConnectionFailed": "upstream_error",
    "responseStreamDisconnected": "upstream_error",
    "responseTooManyFailedAttempts": "upstream_error",
    "activeTurnNotSteerable": "upstream_error",
}

#: Which HTTP statuses on a connection failure mean something more specific than *offline*. A 401 is
#: a credential and a 402 is a card, and both need a person rather than another attempt.
FAILURE_FOR_STATUS = {401: "signed_out", 402: "no_credit", 403: "no_access", 429: "rate_limited"}

#: The notification methods this release reads. Everything else the server says is written to the
#: raw stream and reported to nobody, which is what keeps a vendor adding one from breaking a turn.
LISTENED = ("thread/started", "turn/started", "turn/completed", "item/started", "item/completed",
            "thread/tokenUsage/updated", "account/rateLimits/updated", "error")


def main() -> int:
    if "--capabilities" in sys.argv[1:]:
        say(what_this_can_do())
        return 0
    return one_turn()


# ── What this can do ──────────────────────────────────────────────────────────────────────────

def what_this_can_do() -> dict:
    """Asked offline, with no account and no network, and the same answer every time.

    `model` is true because `thread/start` answers with the model that will actually run — which is
    a name nobody asked for and the only honest answer to *which brain replied*. The version is
    volunteered beside the five: rundesk keeps whatever an adapter says here against every turn, so
    a vendor upgrade that changes behaviour is visible in the record afterwards rather than being a
    thing somebody has to remember.
    """
    can = {"tools": True, "resume": True, "model": True, "usage": True, "steer": True}
    version = the_version()
    if version:
        can["codex_cli"] = version
    return can


def the_version() -> str:
    """What `codex --version` says, or nothing. **Never a reason to fail** — a version this could
    not read does not change what the adapter can do."""
    try:
        got = subprocess.run([CODEX, "--version"], capture_output=True, text=True,
                             timeout=VERSION_WITHIN, check=False)
    except (OSError, subprocess.SubprocessError):
        return ""
    return got.stdout.strip().splitlines()[0] if got.stdout.strip() else ""


# ── One turn ──────────────────────────────────────────────────────────────────────────────────

def one_turn() -> int:
    """Start the server, open or carry on a thread, run the turn, and report what happened.

    **A turn always ends with a `done`**, whatever went wrong, because rundesk reading no `done` at
    all is a turn nobody can explain. The one exception is a process killed outright, which is
    rundesk's own to classify and the only case it can classify correctly.
    """
    where = os.environ.get("RUNDESK_CWD") or os.getcwd()
    raw = os.environ.get("RUNDESK_RAW")
    try:
        server = subprocess.Popen(
            [CODEX, *APP_SERVER], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=None, text=True, bufsize=1, cwd=where, env=os.environ.copy())
    except OSError as why:
        finished(False, failure_code="crashed",
                 failure_message=f"codex could not be started: {why}")
        return 1
    turn = Turn(server, where, raw)
    try:
        return turn.run()
    except Exception as why:                       # noqa: BLE001 — a turn that dies silently is a
        # turn rundesk can only call `crashed` with nothing to read. Whatever this was, it is said.
        finished(False, failure_code="crashed",
                 failure_message=f"the codex adapter went wrong: {type(why).__name__}: {why}")
        return 1
    finally:
        turn.take_the_server_away()


class Turn:
    """One turn on one thread, from `initialize` to `done`."""

    def __init__(self, server, where: str, raw):
        self.server = server
        self.where = where
        # Held open for the length of the turn and closed in `take_the_server_away`: a file
        # reopened per line is a turn that spends its time on `open` rather than on work.
        self.raw = open(raw, "a", encoding="utf-8") if raw else None
        self.asked = 0
        self.answers = {}
        self.saying = threading.Lock()

        self.thread_id = None
        self.turn_id = None
        self.model_name = None
        self.ended = threading.Event()

        #: What the turn cost, in the only arithmetic that gives a turn's own share. See the module
        #: docstring: the baseline is recovered from the first update rather than remembered.
        self.usage_before = None
        self.usage_now = None
        self.context_tokens = None

        self.allowance = None
        self.failure_code = None
        self.failure_message = None
        self.tools = {}
        self.steers = []

    # ── the wire ──────────────────────────────────────────────────────────────────────────────

    def send(self, method: str, params=None, wants_reply: bool = True):
        """One request or notification to the server. Returns the id, or `None` for a notification.

        Behind a lock because two threads write here — the one draining the server and the one
        reading what rundesk is saying — and two interleaved halves of two JSON objects is a stream
        neither end can recover.
        """
        said = {"method": method}
        if params is not None:
            said["params"] = params
        if wants_reply:
            self.asked += 1
            said["id"] = self.asked
        with self.saying:
            self.server.stdin.write(json.dumps(said) + "\n")
            self.server.stdin.flush()
        return said.get("id")

    def waited_for(self, asked: int, within: float):
        """The reply to one request, or `None` if the server never sent one."""
        until = time.monotonic() + within
        while time.monotonic() < until:
            if asked in self.answers:
                return self.answers.pop(asked)
            if self.server.poll() is not None:
                return None
            time.sleep(0.01)
        return None

    def heard(self):
        """Every line the server says, forever, on a thread of its own.

        **Written to the raw stream before it is read**, so a line this release cannot understand is
        still on disk to compare against when somebody asks why records went missing.
        """
        for line in self.server.stdout:
            line = line.rstrip("\n")
            if self.raw is not None:
                with contextlib.suppress(OSError):
                    self.raw.write(line + "\n")
                    self.raw.flush()
            try:
                said = json.loads(line)
            except ValueError:
                continue
            if "id" in said and ("result" in said or "error" in said):
                self.answers[said["id"]] = said
            elif said.get("method") in LISTENED:
                with contextlib.suppress(Exception):
                    self.a_notification(said["method"], said.get("params") or {})
        self.ended.set()

    # ── the turn ──────────────────────────────────────────────────────────────────────────────

    def run(self) -> int:
        threading.Thread(target=self.heard, name="codex-out", daemon=True).start()

        got = self.waited_for(self.send("initialize", {
            "clientInfo": {"name": CLIENT, "version": rundesk_version()}}), HANDSHAKE_WITHIN)
        if got is None or "error" in got:
            return self.could_not_start("codex app-server did not answer initialize", got)
        self.send("initialized", wants_reply=False)

        asked = self.opening_the_thread()
        got = self.waited_for(asked, HANDSHAKE_WITHIN)
        if got is None or "error" in got:
            return self.could_not_start("codex would not open a conversation", got)
        self.read_the_thread(got["result"])
        self.offer_the_skills()

        prompt = self.first_thing_rundesk_says()
        if prompt is None:
            finished(False, failure_code="crashed",
                     failure_message="rundesk sent no prompt", session_id=self.thread_id)
            return 1
        threading.Thread(target=self.what_rundesk_says_next, name="codex-in", daemon=True).start()

        got = self.waited_for(self.send("turn/start", self.a_turn(prompt)), HANDSHAKE_WITHIN)
        if got is None or "error" in got:
            return self.could_not_start("codex would not start the turn", got)
        self.ended.wait()
        return 0

    def opening_the_thread(self) -> int:
        """`thread/resume` when rundesk gave a handle, and `thread/start` when it did not.

        **The preface goes on the start and never on the resume**, which is the third measured fact
        in the module docstring: a resume takes the argument and ignores it, so sending one would
        read as working while changing nothing.
        """
        access = os.environ.get("RUNDESK_ACCESS_MODE", "work")
        common = {"cwd": self.where, "sandbox": SANDBOX_FOR.get(access, "workspace-write"),
                  "approvalPolicy": "never"}
        model = os.environ.get("RUNDESK_MODEL")
        if model:
            common["model"] = model
        resume = os.environ.get("RUNDESK_RESUME")
        if resume:
            return self.send("thread/resume", dict(common, threadId=resume))
        common["threadSource"] = CLIENT
        preface = os.environ.get("RUNDESK_PREFACE", "").strip()
        if preface:
            common["developerInstructions"] = preface
        return self.send("thread/start", common)

    def read_the_thread(self, result: dict) -> None:
        """The handle to carry this conversation on with, and the model that will actually answer."""
        thread = result.get("thread") or {}
        self.thread_id = thread.get("id") or result.get("threadId")
        self.model_name = result.get("model")

    def offer_the_skills(self) -> None:
        """Point codex at the agent's own skills, and **make nothing anywhere**.

        The brain has a call for exactly this, so there is no directory of ours in somebody's home
        to explain, nothing written into `~/.codex`, and nothing to remove afterwards. An agent
        granted no skills is offered none rather than an empty root.
        """
        skills = os.environ.get("RUNDESK_SKILLS")
        if not skills:
            return
        at = Path(skills)
        with contextlib.suppress(OSError):
            if at.is_dir() and any(at.iterdir()):
                self.send("skills/extraRoots/set", {"extraRoots": [str(at.resolve())]},
                          wants_reply=False)

    def a_turn(self, prompt: str) -> dict:
        """What one turn is started with.

        `summary: auto` is what makes the brain report its reasoning at all — without it a turn
        thinks in silence and the `think` records this seam exists to carry never arrive.
        """
        access = os.environ.get("RUNDESK_ACCESS_MODE", "work")
        return {"threadId": self.thread_id, "input": [{"type": "text", "text": prompt}],
                "cwd": self.where, "approvalPolicy": "never", "summary": "auto",
                "sandboxPolicy": {"type": "readOnly"} if access == "read"
                else {"type": "workspaceWrite"}}

    def could_not_start(self, said: str, got) -> int:
        """A turn that never began, said in the one way rundesk can act on."""
        trouble = (got or {}).get("error") or {}
        message = trouble.get("message") or ""
        finished(False, failure_code="crashed",
                 failure_message=f"{said}{': ' + message if message else ''}",
                 session_id=self.thread_id)
        return 1

    # ── what rundesk says ─────────────────────────────────────────────────────────────────────

    def first_thing_rundesk_says(self):
        """The prompt. Records rather than plain text, because this adapter said it can be steered
        and its input therefore stays open for the length of the turn."""
        for said in a_record_from(sys.stdin):
            if said.get("type") == "say":
                return with_context(said)
        return None

    def what_rundesk_says_next(self) -> None:
        """Words that arrive while the turn is already running, sent to the brain as they come.

        **`expectedTurnId` is a precondition and not a label.** A steer aimed at a turn that has
        already finished is refused by the server rather than silently starting a new one, which is
        exactly the behaviour wanted: a word that arrived too late is a word that was not said.
        """
        for said in a_record_from(sys.stdin):
            if said.get("type") != "say" or self.ended.is_set():
                continue
            if self.turn_id is None:
                self.steers.append(with_context(said))
                continue
            self.steer(with_context(said))

    def steer(self, text: str) -> None:
        with contextlib.suppress(Exception):
            self.send("turn/steer", {"threadId": self.thread_id, "expectedTurnId": self.turn_id,
                                     "input": [{"type": "text", "text": text}]})

    # ── what the brain says ───────────────────────────────────────────────────────────────────

    def a_notification(self, method: str, params: dict) -> None:
        if method == "thread/started":
            # **Taken from whichever says it first.** The reply to `thread/start` also carries it,
            # and a turn that settled before that reply had been read reported no handle at all —
            # so a conversation would have started again from nothing on its next turn.
            self.thread_id = self.thread_id or (params.get("thread") or {}).get("id")
        elif method == "turn/started":
            self.turn_id = (params.get("turn") or {}).get("id")
            for waiting in self.steers:
                self.steer(waiting)
            self.steers = []
        elif method == "item/started":
            self.an_item(params.get("item") or {}, started=True)
        elif method == "item/completed":
            self.an_item(params.get("item") or {}, started=False)
        elif method == "thread/tokenUsage/updated":
            self.counted(params.get("tokenUsage") or {})
        elif method == "account/rateLimits/updated":
            self.an_allowance(params.get("rateLimits") or {})
        elif method == "error":
            self.went_wrong(params)
        elif method == "turn/completed":
            self.that_is_the_turn(params.get("turn") or {})

    def an_item(self, item: dict, started: bool) -> None:
        """One thing the brain did, in rundesk's words. Unknown kinds are reported to nobody."""
        kind = item.get("type")
        if kind == "agentMessage" and not started:
            text = str(item.get("text") or "")
            if text.strip():
                say({"type": "text", "text": text, "whole": True})
        elif kind == "reasoning" and not started:
            # One record per finished thought rather than one per turn: the brain writes several,
            # and joining them would make one long paragraph out of separate pieces of thinking.
            for thought in (item.get("summary") or []):
                if str(thought).strip():
                    say({"type": "think", "text": str(thought), "whole": True})
        elif kind in ("commandExecution", "fileChange", "mcpToolCall", "dynamicToolCall",
                      "webSearch"):
            self.a_tool(kind, item, started)

    def a_tool(self, kind: str, item: dict, started: bool) -> None:
        """A tool starting, and what it came to. Paired by the brain's own id for the item."""
        given = str(item.get("id") or "")
        if started:
            did, name = self.what_it_did(kind, item)
            self.tools[given] = did
            say({"type": "tool", "id": given, "name": name, **({"did": did} if did else {})})
            return
        status = item.get("status")
        record = {"type": "result", "id": given,
                  "ok": status in (None, "completed") and not item.get("error")}
        summary = self.what_it_reported(kind, item)
        if summary:
            record["summary"] = summary
        say(record)

    def what_it_did(self, kind: str, item: dict):
        """Which of the ten words this was, and what to call it on a line somebody reads.

        **A word left out is better than a wrong one.** A brain doing something outside the closed
        set gets no `did` at all rather than the nearest fit, because a reader shown nothing is
        better off than one taught to believe a word that means something else here.
        """
        if kind == "commandExecution":
            actions = item.get("commandActions") or []
            first = actions[0].get("type") if actions and isinstance(actions[0], dict) else None
            return DID_FOR_COMMAND.get(first, "run"), one_line(item.get("command") or "a command")
        if kind == "fileChange":
            changes = item.get("changes") or []
            return self.what_a_change_was(changes), one_line(
                ", ".join(Path(str(one.get("path") or "")).name for one in changes) or "files")
        if kind == "webSearch":
            return "search", one_line(str(item.get("query") or "the web"))
        return "run", one_line(f"{item.get('server') or item.get('namespace') or ''}"
                               f"{'/' if item.get('server') else ''}{item.get('tool') or 'a tool'}")

    def what_a_change_was(self, changes) -> str:
        """`edit`, unless what changed is one of the files the agent lives by.

        **A file's name is not the test.** Every checkout on the machine has an `AGENTS.md`, and an
        agent editing one in a repository has not rewritten its own rules — saying it did would be
        worse than the plain `edit`, because it is untrue. What qualifies is a path standing
        directly in the agent's own home.
        """
        lives_by = what_the_agent_lives_by()
        for one in changes:
            at = Path(str(one.get("path") or ""))
            if str(at.parent) == str(Path(self.where)) and at.name in lives_by:
                return lives_by[at.name]
        if changes and all((one.get("kind") or {}).get("type") == "add" for one in changes):
            return "make"
        return "edit"

    def what_it_reported(self, kind: str, item: dict) -> str:
        if kind == "commandExecution":
            code = item.get("exitCode")
            out = one_line(str(item.get("aggregatedOutput") or ""))
            return f"exit {code}{': ' + out if out else ''}" if code is not None else out
        if kind == "fileChange":
            return one_line(", ".join(f"{(one.get('kind') or {}).get('type') or 'change'} "
                                      f"{Path(str(one.get('path') or '')).name}"
                                      for one in (item.get("changes") or [])))
        if kind == "webSearch":
            found = item.get("results")
            return f"{len(found)} results" if isinstance(found, list) else ""
        trouble = item.get("error") or {}
        return one_line(str(trouble.get("message") or "")) or ""

    def counted(self, usage: dict) -> None:
        """What the conversation has cost so far, kept so the turn's own share can be worked out.

        The baseline is taken from the **first** update of this turn and never afterwards, because
        `total - last` is only the moment before this turn began while `last` is still this turn's
        first request.
        """
        total = usage.get("total") or {}
        last = usage.get("last") or {}
        if self.usage_before is None:
            self.usage_before = {name: whole(total.get(name)) - whole(last.get(name))
                                 for name in ("inputTokens", "outputTokens", "cachedInputTokens",
                                              "cacheWriteInputTokens")}
        self.usage_now = total
        # A level rather than a quantity: what the last request actually carried, which goes *down*
        # when the conversation is compacted.
        if whole(last.get("inputTokens")):
            self.context_tokens = whole(last.get("inputTokens"))

    def an_allowance(self, limits: dict) -> None:
        """News about the account, never about the work. A turn carrying one may have succeeded.

        **Said only when it changed.** The brain reports the allowance after every model request, so
        a turn that thought twice reported the same unchanged percentage twice — two rows in the
        records and two identical lines in front of whoever was watching, neither of which is news.
        """
        window = limits.get("primary") or {}
        used = window.get("usedPercent")
        record = {"type": "limit"}
        if isinstance(used, int):
            record["percent_left"] = max(0, 100 - used)
        resets = window.get("resetsAt")
        if isinstance(resets, int):
            record["resets_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(resets))
        if len(record) > 1 and record != self.allowance:
            self.allowance = record
            say(record)

    def went_wrong(self, params: dict) -> None:
        """A failure the brain reported. Kept rather than acted on: `turn/completed` still arrives,
        and a turn the brain is going to retry itself has not failed."""
        if params.get("willRetry"):
            return
        trouble = params.get("error") or {}
        self.failure_code = self.failure_code or a_failure_word(trouble.get("codexErrorInfo"))
        self.failure_message = self.failure_message or str(trouble.get("message") or "") or None

    def that_is_the_turn(self, turn: dict) -> None:
        """The turn ended. Say what it cost, then say what became of it, then stop reading."""
        self.the_bill()
        status = turn.get("status")
        trouble = turn.get("error") or {}
        message = self.failure_message or str(trouble.get("message") or "") or None
        code = self.failure_code or a_failure_word(trouble.get("codexErrorInfo"))
        if status == "interrupted":
            code = code or "cancelled"
        elif status not in ("completed", None) and code is None and message is None:
            message = f"codex ended the turn as {status}"
        finished(status == "completed", session_id=self.thread_id,
                 failure_code=code, failure_message=message)
        self.ended.set()

    def the_bill(self) -> None:
        """This turn's share of the conversation's running total, or nothing at all.

        **Nothing is reported when nothing was measured**, because a cost of zero and a cost nobody
        counted are different answers and only one of them is true here.
        """
        if self.usage_now is None:
            return
        before = self.usage_before or {}
        record = {"type": "usage"}
        for ours, theirs in (("input_tokens", "inputTokens"), ("output_tokens", "outputTokens"),
                             ("cache_read_tokens", "cachedInputTokens"),
                             ("cache_write_tokens", "cacheWriteInputTokens")):
            if theirs in self.usage_now:
                record[ours] = max(0, whole(self.usage_now.get(theirs)) - whole(before.get(theirs)))
        if self.context_tokens:
            record["context_tokens"] = self.context_tokens
        if self.model_name:
            record["model_name"] = self.model_name
        if len(record) > 1:
            say(record)

    def take_the_server_away(self) -> None:
        """End the server, whatever happened. A brain left running is a brain nobody will reap."""
        with contextlib.suppress(Exception):
            if self.server.stdin and not self.server.stdin.closed:
                self.server.stdin.close()
        with contextlib.suppress(Exception):
            self.server.terminate()
            self.server.wait(timeout=5)
        with contextlib.suppress(Exception):
            self.server.kill()
        if self.raw is not None:
            with contextlib.suppress(OSError):
                self.raw.close()


# ── small things ──────────────────────────────────────────────────────────────────────────────

def a_record_from(stream):
    """Every record rundesk sends, as it arrives. A line that will not parse is skipped, never fatal."""
    for line in stream:
        try:
            said = json.loads(line)
        except ValueError:
            continue
        if isinstance(said, dict):
            yield said


def with_context(said: dict) -> str:
    """A thing rundesk said, with its own context marked as rundesk's rather than the person's.

    Carried apart on the wire and joined here, because a brain has one input: what matters is that
    the person's recorded words are not altered, and that the brain is told this is genuine mid-turn
    guidance. A bare line appended to a running turn reads as suspected prompt injection.
    """
    text = str(said.get("text") or "")
    context = str(said.get("context") or "").strip()
    return f"[rundesk] {context}\n\n{text}" if context else text


def a_failure_word(info):
    """Which closed word the brain's own error name means, or none at all.

    Two shapes: a bare string, and an object whose single key names the kind and whose value may
    carry the HTTP status behind it. A status is more specific than the kind — a 401 on a failed
    connection is a credential and not a network — so it wins where there is one.
    """
    if isinstance(info, str):
        return FAILURE_FOR.get(info)
    if not isinstance(info, dict) or not info:
        return None
    named = next(iter(info))
    behind = info.get(named)
    status = behind.get("httpStatusCode") if isinstance(behind, dict) else None
    if isinstance(status, int) and status in FAILURE_FOR_STATUS:
        return FAILURE_FOR_STATUS[status]
    return FAILURE_FOR.get(named)


def what_the_agent_lives_by() -> dict:
    """`NAME=verb` pairs, as rundesk names them. Read rather than held, so a file renamed there does
    not silently stop being reported here."""
    said = {}
    for pair in (os.environ.get("RUNDESK_CONTINUITY") or "").split(","):
        name, _, verb = pair.partition("=")
        if name.strip() and verb.strip():
            said[name.strip()] = verb.strip()
    return said


def rundesk_version() -> str:
    """What to call this client's version. rundesk does not tell an adapter its own, so this says
    what the adapter is rather than inventing a number nobody can check."""
    return "1"


def one_line(said: str) -> str:
    """A thing to put on a line somebody reads: no newlines, and bounded."""
    said = re.sub(r"\s+", " ", str(said)).strip()
    return said if len(said) <= A_SUMMARY_AT_MOST else said[:A_SUMMARY_AT_MOST - 1] + "…"


def whole(value) -> int:
    """A count, or zero. A boolean is not a count, whatever Python thinks."""
    return value if isinstance(value, int) and not isinstance(value, bool) else 0


def finished(ok: bool, session_id=None, failure_code=None, failure_message=None) -> None:
    """The record that ends a turn. Exactly one is said, and one always is."""
    record = {"type": "done", "ok": bool(ok)}
    for name, value in (("session_id", session_id), ("failure_code", failure_code),
                        ("failure_message", failure_message)):
        if value:
            record[name] = value
    say(record)


def say(record: dict) -> None:
    """One record to rundesk, flushed, because a record held in a buffer is a record nobody saw."""
    with contextlib.suppress(OSError, ValueError):
        sys.stdout.write(json.dumps(record) + "\n")
        sys.stdout.flush()


