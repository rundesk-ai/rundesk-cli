#!/usr/bin/env python3
"""Claude Code, as a brain behind rundesk's provider seam.

A program, never a module. Rundesk runs this, hands it a turn through the environment and
stdin, reads whole records off stdout and ends it — nothing here is imported by anything,
and nothing here imports rundesk. Every fact about this vendor lives in this file.

The contract is `.knowledge/guides/write-a-provider-adapter.md`. What is measured about
this CLI is `.knowledge/research/2026-07-26-claude-cli-as-a-brain.md`, and the stream it
is measured against is `tests/samples/claude-stream.jsonl` — 184 real lines that cost real
money and cannot be re-derived by reading anything.

Five decisions in here are the whole of the difficulty, and each one reads plausible when
it is wrong:

**Streaming input queues; steering interrupts first.** Anthropic's CLI reference says a user
message sent during work stays queued as its own turn. The native SDK client gets different
behaviour by sending an `interrupt` control request, draining that request's result, and then
sending the replacement message on the same process and session. That is what this adapter does;
merely holding stdin open would reproduce the queue this capability exists to avoid.

**The reply arrives twice, and this takes the second copy.** Ten `text_delta` fragments and
three whole `assistant` blocks carry the same 574 bytes; reporting both reports every
answer twice, because a turn joins every `text` record it is given. The whole blocks are
what is reported, marked `whole`, because our seam has a word for the distinction and the
fragments do not survive it: a fragment is held to the end of the turn either way, while a
completed thought can be shown the moment the next one lands. Claude says several complete
things as it works, so this is the brain that is *better* read whole.

**Usage comes from the `result` line and nowhere else.** `message_start` and
`message_delta` each carry a full usage block too, and counting them is how a turn ends up
reporting three times what it cost.

**Fresh and cached are never added together.** A captured turn shows 20 fresh tokens
against 302,567 cache reads. Cache *creation* is billed above standard input, so it belongs
with fresh; cache *reads* are the cheap volume and go on their own. Summing them reports
320,020 tokens at one price, which is real and misleading.

**A posture is the allowlist, not the mode.** `--permission-mode` is a prompting policy —
measured: under `plan` with no allowlist this CLI reached for `Write` and wrote a file
outside the repository, and `plan` never returned. The allowlist is what this adapter sets,
but it is a *pre-approval* list rather than the tool list, and the thing that actually
refuses a write is the vendor's permission system behind it — re-measured 2026-07-28, and
written out in full at `ALLOWED`, because the previous wording here claimed the list was
the whole of the guard and it is not.
"""

from __future__ import annotations

import getpass
import json
import os
import shutil
import subprocess
import sys
import threading
import uuid

CLAUDE = os.environ.get("RUNDESK_CLAUDE_BIN", "claude")

#: What this brain can do, and only what was measured of it.
#:
#: `--input-format stream-json` alone is *not* steering: the CLI documents later user
#: messages as queued turns. Its SDK control protocol is the missing half. This adapter
#: sends `control_request: interrupt`, waits for the acknowledgement, then sends the new
#: user message on the same process and session. That changes the work in flight instead
#: of letting the old answer finish before the new words are considered.
CAN = {"tools": True, "resume": True, "usage": True, "model": True, "steer": True}

#: What a tool *did*, in rundesk's words rather than this vendor's. The list is closed and
#: short on purpose, and a tool whose work is not one of these leaves `did` out rather than
#: stretching one to fit — `name` still carries Claude's own word for it.
#:
#: **This is not the whole tool list and must not become one.** Measured: the offered tools
#: vary with the machine's plugins, skills and MCP servers — 31 on one run of this build and
#: 29 on another — so anything absent here is a tool reported by name with no verb, which is
#: exactly the honest outcome.
DID = {
    "Read": "read",
    "NotebookRead": "read",
    "Glob": "list",
    "LS": "list",
    "Grep": "search",
    "WebSearch": "search",
    "WebFetch": "search",
    "ToolSearch": "search",
    "Bash": "run",
    "BashOutput": "run",
    "Edit": "edit",
    "Write": "edit",
    "NotebookEdit": "edit",
    # **Measured, because delegation answers to two different names and both are right.**
    # A subagent spawn *arrives on the stream* as `Agent`, so that is the name a `did`
    # mapping must key on; the *permission* surface calls the same thing `Task`, so that is
    # the name `ALLOWED` must carry. Re-probed 2026-07-28 against 2.1.220: the init line
    # advertises `Task` and no `Agent`, and the `tool_use` block for a spawn says `Agent`.
    # Renaming either to match the other looks like a tidy-up and silently breaks it.
    "Agent": "delegate",
}

#: Which tools a turn is granted without being asked, per posture (R-PRV-18).
#:
#: **This is a pre-approval list, not the tool list, and it is not the whole of how a
#: posture is honoured.** Measured 2026-07-28 against 2.1.220, correcting what was written
#: here before: the brain is offered every tool it has whatever this says, and a tool
#: missing from this list is not withheld — it is merely not pre-approved, so calling it
#: raises a permission request that nothing answers headlessly and is therefore refused.
#:
#: What that means in each direction, all of it measured rather than reasoned:
#:
#: - A tool that needs no permission runs under `read` whether or not it is named here.
#:   `Skill` is not on this list and a granted skill invokes fine; read-only `Bash` is not
#:   on this list and runs. So `read` permits arbitrary *read-only* shell.
#: - Containment against writes comes from the vendor's permission system and its sandbox,
#:   not from this list: under `read` a `Write` is denied, a `Write` from a delegated
#:   subagent is denied, and a shell redirection is blocked by the sandbox's own guard.
#: - `read` means read *this machine*, not read this workspace: `Read` reaches a file
#:   outside the agent's home and returns it.
#:
#: The list is still worth having — it is what keeps a permission request from being raised
#: for the ordinary read tools, and `Task` is here so a delegated read is not refused — but
#: nothing should be inferred from a tool's absence from it.
ALLOWED = {
    "read": ("Read", "NotebookRead", "Glob", "LS", "Grep", "WebSearch", "WebFetch",
             "ToolSearch", "Task"),
}

#: The narrowest posture there is, and where an unrecognised one lands (R-PRV-27).
READ = "read"

#: The posture that is not a list. `work` grants everything this brain has rather than the
#: fourteen tools somebody thought of: an allowlist cannot be complete, so every tool the CLI
#: gains next release — and every tool an MCP server brings — would be one a working turn was
#: refused, silently and with the model taking the blame.
FULLY = "work"

#: How much of a tool's own output is passed on. A `tool_result` can hold a whole file,
#: a command's entire output, a credential or a private path; the account keeps what we
#: were given and a surface decides separately what it shows.
SUMMARY_CHARS = 200

#: How many of the brain's last complaints are kept to explain a turn that stopped without
#: saying it had. Every one of them has already been passed straight on; this is only what
#: is still to hand when a reason is needed.
TROUBLE_KEPT = 20

#: How long to wait for the last of what the brain said went wrong, once its records have
#: run out. Short: the program has already finished, and this is a pipe emptying.
GOING_SECONDS = 5.0

#: What this CLI says when the home it was given has no login in it.
LOGGED_OUT = ("not logged in", "please run /login", "invalid api key", "unauthorized")

#: What this CLI says when the conversation it was told to carry on is not there. Losing
#: a handle costs a turn its context, which is what losing one is supposed to cost; it
#: must not cost the turn.
GONE = "no conversation found"

#: How this brain is asked whether it has a login, rather than guessed at. Offline, about
#: two tenths of a second, and it answers `{"loggedIn": true|false, …}` — the vendor's own
#: answer to the only question that decides which configuration directory a turn can use.
ASKING_AUTH = ("auth", "status")
ASKING_AUTH_SECONDS = 30.0

#: How long one answer on Claude's SDK control protocol is worth waiting for. A window on
#: the acknowledgement, never on the turn itself.
CONTROL_SECONDS = 120.0


def say(**it) -> None:
    """One record, one line, flushed — because a turn is watched while it happens."""
    sys.stdout.write(json.dumps(it) + "\n")
    sys.stdout.flush()


def went_wrong(said: str) -> None:
    """Something to tell whoever is reading the run, on the stream that is ours.

    Never stdout: what an adapter reports and what it says went wrong are kept apart, and
    a line of this on stdout would be a record of a kind nobody knows.
    """
    sys.stderr.write(said.rstrip() + "\n")
    sys.stderr.flush()


def _settings() -> dict:
    """Whatever the owner set, as they set it. Never read on the way past except for the
    handful of keys this adapter knows how to honour."""
    try:
        given = json.loads(os.environ.get("RUNDESK_SETTINGS") or "{}")
    except ValueError:
        went_wrong("what was set for this brain is not readable JSON, so none of it was used")
        return {}
    if not isinstance(given, dict):
        went_wrong("what was set for this brain is not a JSON object, so none of it was used")
        return {}
    return given


def _flags(extra: dict) -> list:
    """The owner's own flags, passed through as they gave them.

    Their words for their brain: a new option on this CLI is theirs to reach today rather
    than after a rundesk release. Anything unrecognised is left alone, and something
    recognised but malformed is said on stderr so a mistyped setting is heard about.
    """
    given = extra.get("flags")
    if given is None:
        return []
    if not isinstance(given, list) or not all(isinstance(one, str) for one in given):
        went_wrong("`flags` is passed to this brain as a list of strings; it was not, "
                   "so it was ignored")
        return []
    return list(given)


def opening(posture: str, model, resume, extra: dict, session: str) -> list:
    """Everything after the program's name, and why each part of it is there.

    Kept in one function with no side effects so a test can read the whole command line
    without starting anything — which is the only way the traps below stay proven rather
    than remembered.
    """
    argv = ["-p", "--input-format", "stream-json",
            "--output-format", "stream-json", "--verbose"]

    # Measured: `--output-format stream-json` exits 1 under `-p` without `--verbose`. It is
    # above every branch below because there is no turn shape that does not need it.

    # A conversation this brain already has, or a handle minted here before the first byte
    # so that a turn dying mid-stream still leaves something to carry on from.
    argv += ["--resume", resume] if resume else ["--session-id", session]

    if model:
        argv += ["--model", model]

    # The posture. **`work` is not an allowlist at all** — it is the bypass, because an
    # allowlist is a list and a list cannot be complete: every tool this CLI gains next
    # release, and every tool an MCP server brings, is one a working turn would be refused.
    # Measured 2026-07-27 against 2.1.220: with the work list passed and `TodoWrite` asked
    # for, the turn was refused it; with the bypass and no list at all, a `Write` that is on
    # no list succeeded. `read` keeps its list and was measured again on 2026-07-28 to still
    # refuse `Write` — directly and through a delegated subagent — which is the guard that
    # makes widening `work` defensible. What holds that guard is the vendor's permission
    # system rather than the list itself; see `ALLOWED` for what the list does and does not
    # do, and for the read-only shell it does not stop.
    #
    # Passed as one comma-separated value rather than as many words: `--allowedTools` is
    # variadic and would otherwise swallow whatever came next — measured again while probing
    # this, where it ate the prompt and the CLI exited saying none had been given.
    if posture == FULLY:
        argv += ["--dangerously-skip-permissions"]
    else:
        argv += ["--allowedTools", ",".join(ALLOWED[posture])]

    preface = (os.environ.get("RUNDESK_PREFACE") or "").strip()
    if preface:
        # **Never `--system-prompt`.** Measured: it takes about 6,100 tokens of what this
        # brain was built with away with it, while the rule still lands and the tools still
        # work — so nothing reports the loss and the turn merely behaves differently. The
        # append form adds, and adding is what standing instructions are.
        argv += ["--append-system-prompt", preface]

    argv += _flags(extra)
    return argv


def _text(block: dict) -> str:
    return str(block.get("text") or "")


def _summary(said) -> str:
    """What a tool returned, shortened to something a person could be shown."""
    if isinstance(said, list):
        said = " ".join(_text(one) for one in said if isinstance(one, dict))
    return str(said or "")[:SUMMARY_CHARS]


def records(line: str, seen: dict) -> list:
    """One line of this brain's stream, as the records rundesk understands — or none.

    Pure, so the whole mapping is driven offline against a captured stream and none of it
    is believed on the strength of having been written down. `seen` carries the two things
    a later line needs: the conversation's handle and the model that answered.

    A line kind that is not here is dropped **deliberately**, and the raw stream is kept
    beside the run either way — so a vendor changing shape shows up as drift somebody can
    read rather than as records quietly going missing.
    """
    try:
        one = json.loads(line)
    except ValueError:
        return []
    if not isinstance(one, dict):
        return []
    kind = one.get("type")

    if kind == "system" and one.get("subtype") == "init":
        # Nothing to report. It is the only line that names the model, and the session id
        # is taken here too so a stream that stops early still has one.
        seen["model"] = one.get("model") or seen.get("model")
        seen["session"] = one.get("session_id") or seen.get("session")
        return []

    if kind == "assistant":
        return _assistant(one, seen)

    if kind == "user":
        return _returned(one)

    if kind == "result":
        return _ended(one, seen)

    if kind == "rate_limit_event":
        return _allowance(one)

    # `stream_event` in all its forms, `system/status` and `system/thinking_tokens`. The
    # first is framing and duplicated text; the others say nothing this seam has a word for.
    return []


#: What this vendor calls each allowance window, in rundesk's word for what kind of limit it
#: is. Only the ones seen on a real stream — a window named here that this brain never sends
#: is a guess, and guessing a vendor's shape is what costs a feature silently.
OF = {"five_hour": "rate", "seven_day": "rate", "opus_seven_day": "rate"}


def _allowance(one: dict) -> list:
    """The account's own state, which this turn happened to be told about (R-PRV-28).

    **Not this turn's activity, and not a failure.** A turn carrying one of these may have
    succeeded perfectly; it is how much of an allowance is left and when the window resets.
    This used to be dropped, on reasoning that was right as far as it went — it *is* account
    state rather than activity — and the gap was that account state had nowhere to go, so
    what reached an owner was whatever prose an adapter scraped after the fact.

    Captured shape, from `tests/samples/claude-stream.jsonl`:

        {"type": "rate_limit_event", "rate_limit_info": {
            "status": "allowed", "resetsAt": 1784920200,
            "rateLimitType": "five_hour", "overageStatus": "allowed", ...}}

    Everything below is left out where this brain did not send it, rather than defaulted.
    """
    said = one.get("rate_limit_info")
    if not isinstance(said, dict):
        return []
    scope = str(said.get("rateLimitType") or "")
    it = {"type": "limit", "of": OF.get(scope, "rate")}
    if scope:
        it["scope"] = scope
    # `allowed` is the ordinary state and says nothing worth reporting a state for; the
    # other two are what an owner would want to hear about. A word this adapter has not
    # seen leaves `state` out rather than being passed through as though it were ours.
    state = {"allowed_warning": "near", "rejected": "reached"}.get(str(said.get("status")))
    if state:
        it["state"] = state
    resets = said.get("resetsAt")
    if isinstance(resets, int) and not isinstance(resets, bool):
        it["resets_at"] = resets
    if said.get("isUsingOverage") is True:
        it["why"] = "this account is into its overage allowance"
    return [it]


def _assistant(one: dict, seen: dict) -> list:
    """What the brain said and what it reached for, from the line that carries both whole."""
    said = []
    seen["session"] = one.get("session_id") or seen.get("session")
    for block in one.get("message", {}).get("content", []):
        if not isinstance(block, dict):
            continue
        what = block.get("type")
        if what == "text":
            # `whole`, because this is a finished thought and not a piece of one. It is
            # what lets a surface show each thing as it is said instead of delivering the
            # lot at the end.
            if _text(block).strip():
                said.append({"type": "text", "text": _text(block), "whole": True})
        elif what == "thinking":
            # Measured: every captured thinking block carries an empty string, so the
            # shape is proven and the content is not. An empty one is nothing to report.
            thought = str(block.get("thinking") or "")
            if thought.strip():
                said.append({"type": "think", "text": thought, "whole": True})
        elif what == "tool_use":
            it = {"type": "tool", "id": str(block.get("id") or ""),
                  "name": str(block.get("name") or "")}
            did = DID.get(it["name"])
            if did:
                it["did"] = did
            if did == "delegate":
                inputs = block.get("input") if isinstance(block.get("input"), dict) else {}
                who = str(inputs.get("subagent_type") or "").strip()
                if who:
                    it["who"] = who
            said.append(it)
    return said


def _returned(one: dict) -> list:
    """What each tool gave back, paired to the call by the id this brain minted."""
    said = []
    for block in one.get("message", {}).get("content", []):
        if not isinstance(block, dict) or block.get("type") != "tool_result":
            continue
        said.append({"type": "result", "id": str(block.get("tool_use_id") or ""),
                     "ok": not block.get("is_error"),
                     "summary": _summary(block.get("content"))})
    return said


def _without_cancelled(one: dict) -> dict:
    """Remove only tool results Claude made to account for a user interrupt.

    Native interruption stops an in-flight tool by first emitting an ordinary-looking
    failed `tool_result`. Its separate metadata is the distinction between that synthetic
    result and a command that genuinely failed. The caller additionally requires an
    interrupt to be pending, so a real permission refusal outside steering remains visible.

    One vendor message may contain several parallel tools' results. Filtering blocks rather
    than dropping the message preserves work that completed beside the canceled tool.
    """
    metadata = one.get("tool_result_meta")
    if not isinstance(metadata, list):
        return one
    cancelled = {
        str(meta.get("id") or "")
        for meta in metadata
        if isinstance(meta, dict) and meta.get("non_execution_kind") == "user-rejected"
    }
    if not cancelled:
        return one
    message = one.get("message")
    if not isinstance(message, dict) or not isinstance(message.get("content"), list):
        return one
    content = [
        block for block in message["content"]
        if not (
            isinstance(block, dict)
            and block.get("type") == "tool_result"
            and block.get("is_error")
            and str(block.get("tool_use_id") or "") in cancelled
        )
    ]
    return {
        **one,
        "message": {**message, "content": content},
        "tool_result_meta": [
            meta for meta in metadata
            if not (isinstance(meta, dict) and str(meta.get("id") or "") in cancelled)
        ],
    }


def _ended(one: dict, seen: dict) -> list:
    """What the turn cost and that it is over — the only line either is taken from."""
    seen["ended"] = True
    seen["session"] = one.get("session_id") or seen.get("session")
    counted = one.get("usage") or {}

    # **Four quantities, four slots, none of them added together.** This vendor bills fresh
    # input, cache writes, cache reads and output at three different rates, and this used to
    # report the first two as one number — so a turn whose fresh input was 2 tokens was
    # recorded, and shown in a chat footer, as 5,552. A cache write bills *above* standard
    # input and a cache read at roughly a tenth of it, which is the same reasoning that
    # already kept reads apart, applied in the other direction.
    usage = {"type": "usage",
             "input": _n(counted, "input_tokens"),
             "output": _n(counted, "output_tokens"),
             "cached": _n(counted, "cache_read_input_tokens"),
             "written": _n(counted, "cache_creation_input_tokens")}
    if seen.get("model"):
        usage["model"] = seen["model"]

    # The handle is reported only when the turn worked. A conversation that failed may
    # never have been created at all — this brain mints an id and answers `No conversation
    # found with session ID` on the next resume — so handing one back for a turn that did
    # not happen poisons the conversation for every turn after it. Not reporting one costs
    # the next turn its context and nothing else, which is the cheaper of the two.
    ended = {"type": "done", "ok": not one.get("is_error")}
    if not one.get("is_error"):
        ended["session"] = seen.get("session") or ""
    if one.get("is_error"):
        ended["why"] = str(one.get("result") or one.get("subtype") or "the turn failed")
        # Kept for the caller, because being logged out arrives here as an ordinary failed
        # turn — a `result` line like any other — rather than on stderr where a reader
        # would look for it.
        seen["why"] = ended["why"]
        word = _classified(ended["why"])
        if word:
            ended["because"] = word
    return [usage, ended]


#: What this brain says when a turn stopped for a reason the seam has a word for, and the
#: word. **Read off the failure prose, because that is the only place this vendor puts it**
#: — a limit-stopped turn arrives as an ordinary `result` line with `is_error`, exactly like
#: any other failure, and there is no field on it saying which kind it was.
#:
#: Matching prose is the weaker kind of evidence and is treated as such: an unrecognised
#: failure simply leaves `because` out and behaves exactly as it did before, which is the
#: same choice this adapter makes everywhere it cannot measure something. The phrases are
#: kept narrow for that reason — a loose one costs a wrong word in a total, which is worse
#: than an absent one because nothing can see it.
CLASSIFIED = (
    (("rate limit", "rate_limit", "too many requests"), "rate_limited"),
    (("usage limit", "usage_limit", "quota", "allowance"), "usage_exhausted"),
    (("credit balance", "insufficient credit", "out of credit"), "no_credit"),
    (LOGGED_OUT, "signed_out"),
    (("prompt is too long", "context low", "exceeds the context", "context window"),
     "context_exceeded"),
)


def _classified(said: str) -> str | None:
    """One of the seam's closed words for why this stopped, or none rather than a guess."""
    lowered = said.lower()
    for phrases, word in CLASSIFIED:
        if any(phrase in lowered for phrase in phrases):
            return word
    return None


def _n(counted: dict, what: str) -> int:
    value = counted.get(what)
    return int(value) if isinstance(value, int) and not isinstance(value, bool) else 0


def _word(line: str):
    """One thing Rundesk said, whether carried as its record or typed by hand."""
    line = line.strip()
    if not line:
        return None
    if not line.startswith("{"):
        return line
    try:
        record = json.loads(line) or {}
        word = record.get("text") or None
        context = record.get("context") or None
        if word is not None and context is not None:
            return f"{word}\n\n{context}"
        return word
    except (AttributeError, ValueError):
        return line


def _first(stream):
    """The first non-empty thing said, or none when input ended without one."""
    for line in stream:
        word = _word(line)
        if word is not None:
            return word
    return None


def _message(word: str) -> dict:
    """One user message in Claude's SDK streaming-input shape."""
    return {"type": "user", "message": {
        "role": "user", "content": word,
    }, "parent_tool_use_id": None, "session_id": ""}


class Control:
    """Claude's small bidirectional control protocol, kept vendor-side.

    Ordinary stream-json input queues. The cooperative operation exposed by
    `ClaudeSDKClient.interrupt()` is a JSONL control request to the same CLI process. The
    stdout reader calls `heard`; the stdin feeder waits on the matching acknowledgement.
    Interrupted result records are counted so the reader can keep the process open for the
    replacement message rather than mistaking the interrupted subturn for Rundesk's end.
    """

    def __init__(self):
        self._condition = threading.Condition()
        self._next = 0
        self._answers = {}
        self._interrupted_results = 0
        self.usage = {}

    def request(self, stream, subtype: str) -> bool:
        with self._condition:
            self._next += 1
            request = f"rundesk_{self._next}"
            self._answers[request] = None
            if subtype == "interrupt":
                # Mark before writing: Claude may finish the interrupted request before
                # the acknowledgement reaches the stdout reader.
                self._interrupted_results += 1
        try:
            _write(stream, {"type": "control_request", "request_id": request,
                            "request": {"subtype": subtype,
                                        **({"hooks": None} if subtype == "initialize" else {})}})
        except (OSError, ValueError):
            with self._condition:
                self._answers.pop(request, None)
                if subtype == "interrupt" and self._interrupted_results > 0:
                    self._interrupted_results -= 1
            return False
        with self._condition:
            answered = self._condition.wait_for(
                lambda: self._answers.get(request) is not None, timeout=CONTROL_SECONDS)
            response = self._answers.pop(request, None)
            accepted = bool(answered and response and response.get("subtype") == "success")
            if not accepted and subtype == "interrupt":
                # The result may have raced the failed acknowledgement and consumed this
                # mark already. Never let the count go negative: a negative count is
                # truthy and would make every later result look interrupted.
                if self._interrupted_results > 0:
                    self._interrupted_results -= 1
            if accepted and subtype == "interrupt":
                # Match the native SDK's sequence exactly: acknowledgement says the
                # interrupt was accepted; the result says the interrupted request has
                # actually drained. A replacement sent between those two is merely queued.
                accepted = self._condition.wait_for(
                    lambda: self._interrupted_results == 0, timeout=CONTROL_SECONDS)
            return accepted

    def heard(self, one: dict) -> bool:
        """Accept one control response, and say whether it belonged to us."""
        if one.get("type") != "control_response":
            return False
        response = one.get("response")
        if not isinstance(response, dict):
            return True
        request = response.get("request_id")
        with self._condition:
            if request in self._answers:
                self._answers[request] = response
                self._condition.notify_all()
        return True

    def interrupted(self) -> bool:
        """Whether this result ends the request that steering deliberately stopped."""
        with self._condition:
            if self._interrupted_results <= 0:
                return False
            self._interrupted_results -= 1
            self._condition.notify_all()
            return True

    def interrupting(self) -> bool:
        """Whether vendor records still belong to an accepted-or-pending interruption."""
        with self._condition:
            return self._interrupted_results > 0

    def counted(self, one: dict) -> None:
        """Accumulate one subturn's usage into this Rundesk turn."""
        for name, value in (one.get("usage") or {}).items():
            if isinstance(value, int) and not isinstance(value, bool):
                self.usage[name] = self.usage.get(name, 0) + value

    def with_usage(self, one: dict) -> dict:
        """Put all interrupted and final work onto the one final result record."""
        self.counted(one)
        return {**one, "usage": dict(self.usage)}


class Words:
    """Every word sent to this adapter, retained so a lost session can be retried.

    One thread owns the outer input for the adapter's whole life. Each Claude process gets
    a reader starting at zero, so reopening a conversation after a stale `--resume` replays
    the prompt and any steering that already arrived rather than losing the latter between
    two processes.
    """

    def __init__(self, first: str, stream):
        self.words = [first]
        self.closed = False
        self._condition = threading.Condition()
        self._reader = threading.Thread(target=self._read, args=(stream,), daemon=True)
        self._reader.start()

    def _read(self, stream) -> None:
        try:
            for line in stream:
                word = _word(line)
                if word is None:
                    continue
                with self._condition:
                    self.words.append(word)
                    self._condition.notify_all()
        finally:
            with self._condition:
                self.closed = True
                self._condition.notify_all()

    def each(self, stopping: threading.Event):
        at = 0
        while True:
            with self._condition:
                self._condition.wait_for(
                    lambda: at < len(self.words) or self.closed or stopping.is_set())
                if stopping.is_set():
                    return
                if at >= len(self.words):
                    return
                word = self.words[at]
                at += 1
            yield word

    def wake(self) -> None:
        with self._condition:
            self._condition.notify_all()


#: Where this brain looks for skills, relative to the directory a turn stands in.
#:
#: **Measured, not read off the documentation** — 2026-07-27 against 2.1.220, one canary
#: planted per candidate directory each declaring its own unguessable code, with file
#: tools denied so the answer could only have come from the skill index. This brain reads
#: `.claude/skills` and **only** that: not `.agents/skills`, not `.grok/skills`, not
#: `.cursor/skills`, and not a bare `skills/`, which no brain reads at all. Re-probe with
#: `.knowledge/scripts/probe-skills` when the version moves.
#:
#: Relative to `RUNDESK_CWD`, which is the agent's own home — so what one agent is given
#: is inside that agent's directory and no other agent stands anywhere near it.
SKILLS_ROOT = os.path.join(".claude", "skills")


def _present(where: str) -> None:
    """Stand this agent's granted skills where this brain will find them (R-PRV-24).

    Links rather than copies, so an owner editing the library edits what every agent
    holding that skill reads, with nothing to re-run. Measured: this brain follows a
    symlink, follows a link to a link, and indexes a skill once even when the same target
    is reachable from more than one place.

    **Never a link to the whole directory.** That would make a path this vendor owns an
    alias for the library itself — so its own skill-installer would write into the source
    of truth, and anything aimed at this directory would destroy it.

    Idempotent, and the pruning is deliberately narrow: an entry goes only when it is a
    link *we* made whose skill is no longer granted. A directory somebody wrote by hand
    and a link pointing somewhere else are things this did not put there.
    """
    granted = os.environ.get("RUNDESK_SKILLS")
    standing = []
    if granted and os.path.isdir(granted):
        standing = sorted(one for one in os.listdir(granted)
                          if not one.startswith("."))
    root = os.path.join(where, SKILLS_ROOT)
    # Nothing granted and nothing placed before: make no directory at all. An agent with
    # no skills should not have a vendor's directory in its home to explain.
    if not standing and not os.path.isdir(root):
        return
    try:
        os.makedirs(root, exist_ok=True)
        for name in standing:
            link = os.path.join(root, name)
            target = os.path.relpath(os.path.join(granted, name), root)
            if os.path.islink(link):
                if os.readlink(link) == target:
                    continue
                os.unlink(link)
            elif os.path.exists(link):
                continue          # somebody else's, and not ours to replace
            os.symlink(target, link)
        for name in os.listdir(root):
            link = os.path.join(root, name)
            if not os.path.islink(link) or os.path.exists(link):
                continue
            # **Ours is decided by where it points, not by it being broken.** An owner may
            # hand-place a link here to a skill of their own, and a target that is briefly
            # away — an unmounted drive, a file mid-move — makes it look exactly like a
            # grant that was revoked. Deleting on dangling alone took those. What is ours
            # is a link into the directory rundesk was told to present from.
            points_at = os.readlink(link)
            if not os.path.isabs(points_at):
                points_at = os.path.normpath(os.path.join(root, points_at))
            if granted and os.path.commonpath([os.path.abspath(granted), points_at]) == \
                    os.path.abspath(granted):
                os.unlink(link)   # granted once, revoked since
    except OSError as gone:
        # A turn without its skills is a whole turn. Say so and carry on rather than
        # failing a turn over what is, at worst, a brain that is less well informed.
        went_wrong(f"this agent's skills could not be presented: {gone}")


def posture_for(named) -> str:
    """Which posture this turn runs under, given what the seam said (R-PRV-27).

    **A posture this adapter has no answer for fails closed, to `read`.** It used to fall
    back to `work`, on the reasoning that `work` is the seam's own default — but `work`
    here is `--dangerously-skip-permissions`, so a typo, a posture the seam gains before
    this adapter learns it, or a mangled environment turned the *narrowest* intent into a
    full permission bypass, silently and on an unattended schedule. The two failures are
    not equal: falling closed costs a turn some tools and says so, and falling open costs
    the machine its guard and says nothing.

    An empty or absent posture is not unrecognised — the seam's stated default is `work`,
    and that is a decision rather than a mistake.

    A pure function with the environment passed in, so the whole decision is testable
    without starting a brain. Asked against both of the postures there are rather than
    against `ALLOWED`, which no longer holds one of them: reading membership of the list
    would have sent `work` down the unrecognised branch.
    """
    posture = (named or "").strip() or FULLY
    if posture != FULLY and posture not in ALLOWED:
        went_wrong(f"this adapter does not know the posture {posture!r}, so this turn ran "
                   f"as {READ!r} — the narrowest posture it has, rather than the most "
                   f"permissive one. Tools beyond reading were refused.")
        return READ
    return posture


def carry() -> int:
    """One turn, from what rundesk set to what this brain said about it."""
    where = os.environ.get("RUNDESK_CWD") or os.getcwd()
    home = os.environ.get("RUNDESK_PROVIDER_HOME")
    posture = posture_for(os.environ.get("RUNDESK_POSTURE"))

    if shutil.which(CLAUDE) is None and not (os.sep in CLAUDE and os.access(CLAUDE, os.X_OK)):
        went_wrong(f"there is no {CLAUDE} on this machine's path — install the Claude Code "
                   f"CLI, or point RUNDESK_CLAUDE_BIN at where it stands")
        say(type="done", ok=False, why="the Claude Code CLI is not on this machine's path")
        return 1

    first = _first(sys.stdin)
    if first is None:
        say(type="done", ok=False, why="nothing was asked")
        return 1
    words = Words(first, sys.stdin)

    session = str(uuid.uuid4())
    resume = os.environ.get("RUNDESK_RESUME")
    argv = [CLAUDE] + opening(posture, os.environ.get("RUNDESK_MODEL"),
                              resume, _settings(), session)

    _present(where)

    env = _whose(os.environ)
    config = _config_dir(home)
    if config:
        env["CLAUDE_CONFIG_DIR"] = config
    else:
        env.pop("CLAUDE_CONFIG_DIR", None)

    code, lost = _turn(argv, where, words, env, session, may_start_again=bool(resume))
    if lost and resume:
        # The conversation this turn was told to carry on is gone — cleaned up, or never
        # created because the turn that reported the handle had failed. Losing a handle
        # costs this turn its context, which is what losing a handle is supposed to cost;
        # it must not cost the turn itself. The shipped codex adapter does the same.
        went_wrong("that conversation could not be carried on; starting a new one")
        session = str(uuid.uuid4())
        argv = [CLAUDE] + opening(posture, os.environ.get("RUNDESK_MODEL"), None,
                                  _settings(), session)
        code, _ = _turn(argv, where, words, env, session)
    return code


def _config_dir(home, signed_in=None):
    """Which configuration directory this turn should use, and why it may be the machine's.

    **Setting `CLAUDE_CONFIG_DIR` does not redirect this brain's login — it removes one.**
    Measured at 2.1.220 with the vendor's own tool: `claude auth status` answers
    `loggedIn: true` with the variable unset and `loggedIn: false` with it set to
    `~/.claude`, the very directory it defaults to. The sign-in is in the login keychain,
    and setting the variable at all stops it being read. So isolating an agent into a
    private home is, on this brain, the same act as logging it out.

    The decision is therefore asked rather than assumed, once, before the turn:

    - the private home has a login of its own -> use it, and the agent is isolated;
    - it does not, but the machine does -> use the machine's, and say so. This is what the
      shipped codex adapter does unconditionally, so it is the repository's precedent
      rather than a new liberty, and it is the difference between an agent that answers
      and one that cannot start;
    - neither has one -> keep the private home, so the turn fails saying what to run there.

    Nothing is copied or linked either way. `signed_in` is an argument so this whole
    decision is testable without a brain, a network or an account.
    """
    if not home:
        return None
    asking = _signed_in if signed_in is None else signed_in
    if asking(home):
        return home
    if asking(None):
        went_wrong(
            "this agent has no Claude login of its own, so this turn used the machine's. "
            "Its conversations and configuration are shared with anything else that does "
            "the same.\nTo give it one of its own, run:\n"
            f"  CLAUDE_CONFIG_DIR={home} {CLAUDE} auth login")
        return None
    return home


def _whose(env: dict) -> dict:
    """The environment this brain is run in, with the one thing it needs and is not given.

    **`USER` is what its keychain lookup is keyed on, and rundesk does not pass it.** The
    environment a program here gets is built rather than inherited — `HOME`, `PATH`,
    `RUNDESK_*`, `TERM`, `LANG` and nothing else — which is deliberate and right. But this
    brain keeps its sign-in in the macOS login keychain under an account name, and with
    `USER` absent it reports `loggedIn: false` on a machine that is signed in, with no
    `CLAUDE_CONFIG_DIR` involved at all. Measured by bisecting the environment: `USER`
    alone flips it, and `LOGNAME`, `SHELL`, `TMPDIR`, `XPC_SERVICE_NAME` and
    `__CF_USER_TEXT_ENCODING` all leave it false.

    Resolved from the process rather than read from an environment that does not have it,
    which is the whole point — `getpass.getuser()` falls through to the password database.
    This belongs here and not in the core: which variable a brain wants is that brain's
    adapter's business, and putting it in front of every adapter would put this vendor in
    the seam.
    """
    said = dict(env)
    if not said.get("USER"):
        try:
            said["USER"] = getpass.getuser()
        except (KeyError, OSError):
            pass
    return said


def _signed_in(where) -> bool:
    """Whether this brain has a login to reach, asked of it rather than worked out.

    Guessing the name of the file a credential lives in is what `MEMORY.md` records as
    costing a whole feature silently, and on this brain there is no such file to guess at
    — the sign-in is in a keychain. So the CLI is asked, and anything unreadable is read
    as *no*, which fails towards saying what to run.
    """
    env = _whose(os.environ)
    if where:
        env["CLAUDE_CONFIG_DIR"] = where
    else:
        env.pop("CLAUDE_CONFIG_DIR", None)
    try:
        said = subprocess.run([CLAUDE] + list(ASKING_AUTH), env=env, text=True,
                              capture_output=True, timeout=ASKING_AUTH_SECONDS)
        return bool(json.loads(said.stdout or "{}").get("loggedIn"))
    except (OSError, ValueError, subprocess.SubprocessError):
        return False


def _lost(said: dict) -> bool:
    """Whether this turn failed only because the conversation it was told to carry on is
    not there — which is recoverable, and is not the same as the turn failing."""
    return not said.get("ok") and GONE in str(said.get("why") or "").lower()


def _turn(argv: list, where: str, words: Words, env: dict, session: str,
          may_start_again: bool = False) -> tuple:
    """Run the brain, and report what it said as it says it.

    Returns what became of the program and whether the only thing wrong was a conversation
    that has gone. When it may start again, the failing pair is held back rather than
    reported — a turn that is about to be retried has not finished, and saying it had
    would put an outcome in the account that the next attempt then contradicts.
    """
    raw = _raw()
    seen = {"session": session, "model": None, "ended": False}
    control = Control()
    trouble = []
    try:
        brain = subprocess.Popen(
            argv, cwd=where, env=env, text=True, bufsize=1,
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as gone:
        went_wrong(f"the Claude Code CLI would not start: {gone}")
        say(type="done", ok=False, why="the Claude Code CLI would not start")
        return 1, False

    # Drained for the brain's whole life, in its own thread. A second pipe with nothing
    # reading it fills its buffer and stops the program dead — which presents half an hour
    # later as a brain that simply went quiet, and sends you looking anywhere but here.
    draining = threading.Thread(target=_drained, args=(brain.stderr, trouble), daemon=True)
    draining.start()

    finished = threading.Event()
    feeding = threading.Thread(
        target=_fed, args=(brain.stdin, words, finished, control), daemon=True)
    feeding.start()

    # Everything streams as it arrives except the pair that ends a turn. Those are held
    # until the program is gone, because whether the conversation was lost is a thing this
    # brain says on **stderr** — `No conversation found with session ID: …` — while its
    # `result` line says only `error_during_execution`. Deciding on the stream alone would
    # have missed it, which is exactly what it did.
    ending = []
    for line in brain.stdout:
        if raw:
            raw.write(line)
            raw.flush()
        try:
            vendor = json.loads(line)
        except ValueError:
            vendor = {}
        if isinstance(vendor, dict) and control.heard(vendor):
            continue
        if isinstance(vendor, dict) and control.interrupting():
            # The native interrupt accounts for its canceled tool as `user-rejected`.
            # Remove only that block: parallel tools may have completed in the same record.
            vendor = _without_cancelled(vendor)
            line = json.dumps(vendor)
        if isinstance(vendor, dict) and vendor.get("type") == "result":
            if control.interrupted():
                control.counted(vendor)
                seen["ended"] = False
                continue
            line = json.dumps(control.with_usage(vendor))
        for it in records(line, seen):
            if it["type"] == "done":
                # Stream input can carry several user turns in one Claude process, so the
                # process waits for another until its input closes. Rundesk asked for one
                # turn. Close on that turn's result, not on the outer input: a channel
                # deliberately keeps the latter open so it can steer.
                finished.set()
                words.wake()
                _close(brain.stdin)
            if may_start_again and it["type"] in ("usage", "done"):
                ending.append(it)
            else:
                say(**it)

    finished.set()
    words.wake()
    _close(brain.stdin)
    brain.stdout.close()
    feeding.join(timeout=GOING_SECONDS)
    draining.join(timeout=GOING_SECONDS)
    if raw:
        raw.close()

    code = brain.wait()
    said = " ".join(trouble + [seen.get("why") or ""]).lower()
    if may_start_again and (GONE in said or any(_lost(one) for one in ending)):
        return code, True
    for it in ending:
        say(**it)
    _said_how_to_sign_in(" ".join(trouble + [seen.get("why") or ""]), env)
    if not seen["ended"]:
        # A child that dies before its `result` line has said nothing terminal, and
        # whatever is waiting on this turn would wait for ever.
        say(type="done", ok=False, why=_why(trouble, code))
        return code or 1, False
    return code, False


def _fed(stream, words: Words, stopping: threading.Event, control: Control) -> None:
    """Start Claude's SDK protocol, then interrupt before every later word."""
    try:
        if not control.request(stream, "initialize"):
            went_wrong("Claude did not accept its streaming control protocol")
            return
        first = True
        for word in words.each(stopping):
            later = not first
            if later and not control.request(stream, "interrupt"):
                went_wrong("Claude did not complete the native mid-turn interrupt")
                return
            _write(stream, _message(word))
            first = False
    except (OSError, ValueError):
        pass  # the result raced the last word; the provider has already finished
    finally:
        _close(stream)


def _write(stream, record: dict) -> None:
    stream.write(json.dumps(record, separators=(",", ":")) + "\n")
    stream.flush()


def _close(stream) -> None:
    try:
        stream.close()
    except (OSError, ValueError):
        pass


def _said_how_to_sign_in(said: str, env: dict) -> None:
    """Say what to run when this brain has no login to reach, and say it once.

    Worth its own function because being logged out does **not** arrive on stderr: it comes
    back as an ordinary failed turn on the `result` line, which is where nobody looks for
    it. Measured on macOS at 2.1.220, and it is sharper than it reads: the sign-in lives in
    the login keychain rather than in any config directory, and this CLI stops consulting
    the keychain the moment `CLAUDE_CONFIG_DIR` is set **at all** — pointing it at the very
    directory it defaults to is enough to be logged out.

    So an agent's private home cannot borrow the machine's login, and there is nothing to
    copy in even if that were allowed. One `/login` per agent is the whole of the answer.
    """
    if not any(one in said.lower() for one in LOGGED_OUT):
        return
    where = env.get("CLAUDE_CONFIG_DIR", "<this agent's provider home>")
    went_wrong(f"this agent has no Claude login of its own — run:\n"
               f"  CLAUDE_CONFIG_DIR={where} {CLAUDE} /login\n"
               f"The machine's own login cannot be borrowed: it is in the login keychain, "
               f"and this CLI stops reading it as soon as CLAUDE_CONFIG_DIR is set.")


def _drained(stream, keep: list) -> None:
    """Everything the brain says went wrong, passed straight on and the tail of it kept.

    Passed on as it arrives rather than at the end, because it is the only thing an owner
    has to read while a turn is still running — and because anything written to either
    stream is what tells rundesk this turn has not gone quiet.
    """
    for line in stream:
        went_wrong(line)
        keep.append(line.rstrip())
        if len(keep) > TROUBLE_KEPT:
            del keep[0]
    stream.close()


def _why(trouble: list, code: int) -> str:
    """One actionable line about a turn that stopped without saying it had."""
    for said in reversed(trouble):
        first = said.strip().splitlines()[0].strip() if said.strip() else ""
        if first:
            return first[:SUMMARY_CHARS]
    return f"the Claude Code CLI stopped without finishing the turn (exit {code})"


def _raw():
    """Where this brain's own stream is kept, if rundesk offered somewhere.

    Append only, verbatim, and nothing reads it — so a vendor changing shape is visible as
    drift beside the run rather than as records that quietly stopped arriving.
    """
    at = os.environ.get("RUNDESK_RAW")
    if not at:
        return None
    try:
        os.makedirs(os.path.dirname(at) or ".", exist_ok=True)
        return open(at, "a", encoding="utf-8")
    except OSError as gone:
        went_wrong(f"what this brain said could not be kept at {at}: {gone}")
        return None


if __name__ == "__main__":
    if "--capabilities" in sys.argv:
        print(json.dumps(CAN))
        raise SystemExit(0)
    raise SystemExit(carry())
