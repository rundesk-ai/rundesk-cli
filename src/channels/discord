# What this is given, and what it makes of it.
# ---------------------------------------------------------------------------------------------


def the_library() -> str:
    """Bring `discord.py` in. `""` when it is here, otherwise the sentence saying it is not.

    Imported at the moment it is needed and never at module scope, so that `--capabilities` answers
    on a machine with nothing installed — which is the state rundesk asks that question in.

    **Not located, only imported.** Which interpreter runs this is decided by rundesk and handed
    over on `PATH`; an adapter that went looking for the install's own virtualenv is the defect that
    survived a whole release in the build this replaces, pointing one directory above the install
    and telling an owner to run the installer that had already put the package where it belonged.
    """
    global discord
    if discord is not None:
        return ""
    try:
        import discord as library
    except ImportError as why:
        return (f"discord.py is not installed for the interpreter running this adapter ({why}) — "
                f"it is pinned in rundesk's own requirements, so this is an install that has not "
                f"built its virtualenv rather than a channel that is misconfigured")
    discord = library
    return ""


def intents_now():
    """The gateway intents, built from names and then compared against the number.

    **Both, because they answer different questions.** The names are what a reader checks against
    the docstring on `INTENTS`; the number is what Discord is actually told. Comparing them means
    that a library which renamed a flag underneath us fails here, loudly, rather than identifying
    with a quieter mask and producing a bot that connects and never hears anything — which is the
    exact shape a missing intent already has, and the hardest failure on this platform to see.
    """
    intents = discord.Intents.none()
    intents.guilds = True
    intents.guild_messages = True
    intents.guild_reactions = True
    intents.dm_messages = True
    intents.message_content = True
    if intents.value != INTENTS:
        raise Refused(f"discord.py builds {intents.value} for the intents this needs, and Discord "
                      f"is meant to be told {INTENTS}")
    return intents


def the_token() -> str:
    """The bot token, from the one variable that carries it, or `""`.

    One place and no fallback file. What rundesk keeps is the *name*; the value lives in its sealed
    store outside `data/`; and both `--check` and `serve` are handed it under this name — so a
    second place to look would be a second thing that can silently be the wrong one.
    """
    return (os.environ.get(TOKEN_FROM) or "").strip()


def who_may_reach() -> List[str]:
    """The ids this may work for, the owner first. Never shown to anybody, and never the answer.

    An empty list authorises **nobody** — never everybody. That is the rule other people have got
    backwards at real cost, and here it means an agent that answers no one rather than one that
    answers everyone.
    """
    return [one for one in (os.environ.get("RUNDESK_ALLOW") or "").split(",") if one]


def flat(said: Any, most: int = SAID_MOST) -> str:
    """One line, clipped — for a stranger's words on their way into somebody's prompt."""
    whole = " ".join(str(said or "").split())
    return whole if len(whole) <= most else whole[:most - 1] + "…"


def _a_helper(said: Any) -> str:
    """One safe, compact name for a subagent — **the last component, and never the path above it.**

    Rundesk narrows this first, and this is not a second copy of that rule so much as the same guard
    standing on the side that actually posts. A name is written by whoever wrote the subagent, so it
    may be an absolute path; putting one into a room publishes the owner's directory layout and their
    username with it, to everybody who can read the channel. `flat` does the rest — a newline in it
    would be somebody ending our line and starting one of their own.
    """
    named = str(said or "").strip().replace("\\", "/").rsplit("/", 1)[-1]
    return flat(named, A_HELPER_AT_MOST)


def activity_line(it: Dict[str, Any]) -> str:
    """One thing the agent did, as one line of small print — **broad, and never its details.**

    Three shapes arrive on one record and are told apart by `ok`, which rundesk sets only when there
    is something to report about how a tool came back:

        no `ok`        it started doing this
        `ok` is false  it failed
        `ok` is true   a subagent finished — the one act long enough for its ending to be news

    The brain's own name for the tool never crosses the seam and is not missed. Showing it produced a
    commentary reading `commandExecution` and `imageGeneration`: one vendor's identifiers, in front
    of somebody who has never heard of that vendor and never should.
    """
    did = str(it.get("did") or "")
    who = _a_helper(it.get("who")) if did == "delegate" else ""
    ok = it.get("ok")
    if ok is False:
        return f"{SUBTEXT}⚠ {FAILED.get(did, 'tool failed')}"
    if did == "delegate":
        heading = FINISHED_HELPER if ok is True else DELEGATED
        return f"{SUBTEXT}{heading}{': ' + who if who else ''}"
    return f"{SUBTEXT}{DID.get(did, UNKNOWN)} {SHOWN.get(did, 'thinking')}"


def grouped(groups: List[Any], lines: List[Any]) -> List[Any]:
    """Fold new lines onto the ones already there, **keeping every event as a count.**

    Only lines that are *adjacent and the same* join. A different line closes the group for good, so
    `read · read · run · read` stays four groups rather than collapsing into two — the order is what
    a reader is following.

    A `None` in `lines` is a barrier and not a line: something visible was posted at that point, so
    what comes after it must start a new count even if it matches what came before. Without it, a
    burst that spanned a message the reader has already scrolled past was counted as one run.
    """
    kept = list(groups)
    may_join = True
    for line in lines:
        if line is None:
            may_join = False
            continue
        heading = _heading(line)
        if may_join and kept and _heading(kept[-1][0]) == heading:
            # Once a category repeats, its broad wording owns the count: a name is useful on one
            # helper and listing five of them defeats the point of counting at all.
            kept[-1] = (heading, kept[-1][1] + 1)
        else:
            kept.append((line, 1))
        may_join = True
    return kept


def _heading(line: str) -> str:
    """The broad line a repeat is counted under, even where one occurrence showed a name."""
    for whole in (DELEGATED, FINISHED_HELPER):
        if line.startswith(f"{SUBTEXT}{whole}"):
            return f"{SUBTEXT}{whole}"
    return line


def rendered(groups: List[Any]) -> str:
    """Groups as the commentary a person reads. **One occurrence needs no visual noise.**"""
    return "\n".join(line if count == 1 else f"{line} **(x{count})**" for line, count in groups)


def bounded(groups: List[Any]) -> Tuple[str, List[Any]]:
    """The commentary cut to one message, by dropping **whole oldest groups** and saying so.

    Whole groups rather than characters: half a line with its count sheared off reads as a different
    event. The last group is always kept, however long it is, because a commentary showing nothing at
    all is worse than one showing its most recent line and a mark that there was more.
    """
    kept = list(groups)
    clipped = False
    while len(kept) > 1:
        if len((f"{CLIPPED}\n" if clipped else "") + rendered(kept)) <= ACTIVITY_CHARS:
            break
        kept.pop(0)
        clipped = True
    shown = rendered(kept)
    return (f"{CLIPPED}\n{shown}" if clipped else shown), kept


def _under(text: str, cost: Any) -> str:
    """The answer with what it cost standing above it, in Discord's own quiet register.

    **Above and never below** (R-DIS-17). A long answer pushes anything after it off a phone screen,
    and which brain answered and what it cost are worth seeing without scrolling to the end of a
    thousand words.

    **`SUBTEXT` is why this is rendered here and not composed by rundesk.** `-# ` is Discord's, it
    only works at the start of a line, and it is what turns a line into small grey print instead of a
    sentence the agent appears to have said. Another platform has another register or none, so the
    words cross the seam and the register is put on here.

    Nothing said about the cost leaves the answer exactly as it was — a turn whose brain reported
    nothing is not given a line of empty punctuation.
    """
    said = str(cost or "").strip()
    return f"{SUBTEXT}{said}\n{text}" if said else text


def thread_name(text: Any) -> str:
    """What a thread opened by being named is called: the opening words of what was asked.

    **One line and bounded, for the same two reasons a display name is.** A thread name is a place
    somebody else's text lands, Discord refuses one past a hundred characters outright, and a
    newline in it would be somebody ending our label and starting one of their own. `flat` is
    already that rule and this is not a second copy of it.

    Falls back to a plain word rather than to nothing: a message that is only a file has nothing to
    be named from, and Discord will not take an empty name.
    """
    return flat(text, THREAD_NAME_MOST) or THREAD_UNNAMED


def content_allowed(flags: Any) -> bool:
    """Whether Discord has granted this application the content of a room's messages.

    **Two flags and not one.** A verified application carries `gateway_message_content`; one that is
    not verified yet — which every bot is until a hundred servers make verification compulsory —
    carries `gateway_message_content_limited` instead, and both mean the toggle is on. Reading only
    the first would refuse every new bot on the day it was set up correctly.

    Asked with `getattr`, because what this is being handed is the vendor library's own flag object
    and a version that renamed one must fail as *not granted* — a refusal somebody can act on —
    rather than as an `AttributeError` in the middle of a sign-in.
    """
    return bool(getattr(flags, "gateway_message_content", False)
                or getattr(flags, "gateway_message_content_limited", False))


def unreadable_without() -> str:
    """Why a channel is refused while the toggle is off, and what to do about it.

    Its own function so that the refusal is one sentence in one place: this is the whole of what a
    person at a terminal has to act on, and the same switch is named in `WILL_NOT_COME_RIGHT[4014]`
    for whoever reaches it the other way round.
    """
    return (f"this bot has not been granted the content of the messages it would be answering, so "
            f"switch on {THE_TOGGLE}. Without it Discord blanks every message in a room and in a "
            f"thread unless it names this bot, so no thread could be opened, nothing said in one "
            f"could be read, and the gateway would be closed with 4014 rather than connecting")


def invited(application_id: Any) -> str:
    """Where somebody sends this bot to a server, with the permissions already worked out.

    Reported rather than described in prose, because the whole of what makes setup easy here is that
    the adapter is signed in by the time it answers: anything the platform can tell it is something
    an owner should not have to go and look up.
    """
    permissions = 0
    for bit in PERMITS.values():
        permissions |= bit
    return (f"https://discord.com/oauth2/authorize?client_id={application_id}"
            f"&scope={'+'.join(SCOPES)}&permissions={permissions}")


# ---------------------------------------------------------------------------------------------
# A file on its way out, which is verified twice and sent from neither the path nor trust.
# ---------------------------------------------------------------------------------------------


def a_verified_file(said: Dict[str, Any]):
    """Re-open what rundesk approved, prove it is still that, and hand back those exact bytes.

    **The second of two checks, and it is the one that closes the window.** Rundesk resolved this
    explicitly declared path and fingerprinted it; between that moment and this one a
    concurrent write can replace the file, or replace a directory above it with a symlink to
    somewhere else entirely. So every component is opened with `O_NOFOLLOW` from a descriptor on the
    one above it — a path resolved twice is two different paths — and the bytes are streamed into a
    snapshot whose size and digest are compared with what was approved.

    **The declared size is also the bound on the read**, which is why there is no constant for it: a
    file that grew is refused for having grown, rather than truncated into something that would
    still hash correctly.

    `Refused` on anything at all. Nothing that did not verify is ever sent.
    """
    at = said.get("at")
    expected = said.get("bytes")
    wanted = said.get("sha256")
    if not isinstance(at, str) or not at:
        raise Refused("a file was named with no path to open")
    if isinstance(expected, bool) or not isinstance(expected, int) or expected < 0:
        raise Refused(f"could not attach {at}: it was approved without a size to check against")
    if not isinstance(wanted, str) or re.fullmatch(r"[0-9a-f]{64}", wanted) is None:
        raise Refused(f"could not attach {at}: it was approved without a digest to check against")
    path = Path(at)
    if not path.is_absolute() or not path.parts[1:]:
        raise Refused(f"could not attach {at}: it is not an absolute path to a file")

    snapshot = tempfile.TemporaryFile()
    digest = hashlib.sha256()
    size = 0
    directory = None
    descriptor = None
    try:
        directory = os.open(path.parts[0], os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        for part in path.parts[1:-1]:
            below = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
            os.close(directory)
            directory = below
        descriptor = os.open(path.parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                             dir_fd=directory)
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise OSError("it is not a regular file")
        with contextlib.suppress(OSError):
            fcntl.fcntl(descriptor, fcntl.F_SETFL,
                        fcntl.fcntl(descriptor, fcntl.F_GETFL) & ~os.O_NONBLOCK)
        with os.fdopen(descriptor, "rb") as reading:
            descriptor = None                      # the file object owns the descriptor from here
            while size <= expected:
                block = reading.read(min(A_BLOCK, expected + 1 - size))
                if not block:
                    break
                size += len(block)
                digest.update(block)
                snapshot.write(block)
    except (OSError, ValueError) as why:
        snapshot.close()
        raise Refused(f"could not attach {at}: {why}") from why
    finally:
        if directory is not None:
            os.close(directory)
        if descriptor is not None:
            os.close(descriptor)

    if size != expected or digest.hexdigest() != wanted:
        snapshot.close()
        raise Refused(f"could not attach {at}: it changed after it was approved")
    snapshot.seek(0)
    # The name is rundesk's and has already been made its own; taken as a bare name even so,
    # because a filename with a separator in it is a filename pretending to be somewhere.
    return discord.File(snapshot, filename=Path(str(said.get("name") or path.name)).name)


def an_id(said: Any, called: str) -> int:
    """A snowflake as the number Discord keeps it as, or `Refused` in words of our own.

    `int()`'s own complaint names a Python type and never the thing somebody has to fix, and every
    one of these ends up in a record that is the whole of what a person can act on.
    """
    try:
        return int(said)
    except (TypeError, ValueError) as why:
        raise Refused(f"{said!r} is not a {called} — Discord keeps its ids as numbers") from why


def closed(files: List[Any]) -> None:
    """Let go of short-lived upload snapshots after the platform consumes or refuses them."""
    for one in files:
        with contextlib.suppress(Exception):
            one.close()


# ---------------------------------------------------------------------------------------------
# Question one: what can you do?
# ---------------------------------------------------------------------------------------------


def capabilities() -> int:
    """Say what this can do, and nothing else. No network, no account, no dependency."""
    say(CAPABILITIES)
    return 0


# ---------------------------------------------------------------------------------------------
# Question two: can you reach it, and what did you find?
# ---------------------------------------------------------------------------------------------


async def check(options: List[str]) -> int:
    """Sign in, and report what was found, so that a person confirms rather than pastes.

    **`ok: false` still exits `0`.** What is read is the object and not the code: a program that
    printed `ok: false` *refused*, one that died without printing anything *failed*, and those two
    lead somewhere different. Every return below is `0` for that reason, and the only way out of
    here otherwise is by dying — which is honest, and is what rundesk's own ceiling is for.

    Nothing about this channel is written down unless this says yes, so the whole of an owner's
    diagnosis is the sentence that comes back: it says what was wrong rather than that something
    was.
    """
    if options:
        return _refused(f"this channel takes no options and was given {' '.join(options)} — a "
                        f"channel here is a connection rather than a place, so there is nothing to "
                        f"point it at and nothing to configure")
    missing = the_library()
    if missing:
        return _refused(missing)
    token = the_token()
    if not token:
        # **Named on the way out as well as on the way in.** Saying where the credential is read
        # from *here* is what lets rundesk offer to take the token without any caller having to
        # match this sentence — a platform's words are this file's, and a caller that string-matched
        # them would be the seam failing.
        return _refused(f"there is no bot token — nothing set {TOKEN_FROM}", secret=True)
    allow = who_may_reach()
    if not allow:
        return _refused("nothing said who may reach this agent, so there is nobody to open a "
                        "private conversation with — a channel needs at least the owner")
    if not allow[0].isdigit():
        return _refused(f"{allow[0]} is not a Discord user id — an id here is the number Discord "
                        f"copies from Developer Mode, never a username, which can be changed")

    try:
        client = discord.Client(intents=intents_now())
    except Refused as why:
        return _refused(str(why))
    try:
        await client.login(token)
        # **Once, and never in a loop.** Discord's own documentation says so about this call, and
        # what it answers is the one thing an owner would otherwise have to go and find: where this
        # agent writes when nobody has asked it anything.
        person = await client.fetch_user(int(allow[0]))
        place = await person.create_dm()
    except Exception as why:               # noqa: BLE001 — a platform boundary, and the diagnosis
        refused = isinstance(why, discord.LoginFailure)
        said = (f"Discord would not accept the token in {TOKEN_FROM} — it may have been reset in "
                f"the Developer Portal, or be an application id rather than a bot token"
                if refused else f"could not reach Discord: {type(why).__name__}: {why}")
        await _quietly(client.close)
        return _refused(said, secret=refused)

    # **The one thing that is fatal later and answerable now.** `serve` identifies with a privileged
    # intent; a bot without it is closed with `4014`, which is not resumable, exits `78`, and stops
    # the gateway restarting the channel for the rest of its life. `login` has just fetched the
    # application record, so whether the toggle is on is a fact this already holds — and a refusal
    # here reaches somebody standing at a terminal instead of at three in the morning.
    if not content_allowed(client.application_flags):
        await _quietly(client.close)
        return _refused(unreadable_without())

    # `login` fetches the application on the way past, so the id below costs no second call. Falling
    # back to the bot's own user id because for a bot the two are one number, and an invite URL with
    # no client id in it is a link that goes nowhere.
    # **The caveat rides on `describes`, because that is the one line of this that a person is
    # shown.** An invite grants what it asked for once, when somebody accepts it, so a bot standing
    # in a server before `open a thread` was added to `PERMITS` does not have it — and the symptom
    # is a room that goes on being answered in rather than anything that looks like a failure.
    found = {"ok": True,
             "describes": f"{client.user}, reaching {person} — a bot already in a server has to be "
                          f"sent this invite again before it may open a thread in a room",
             "notify_place": str(place.id),
             "settings": {},
             "secret": {"env": [TOKEN_FROM]},
             "invite": invited(client.application_id or client.user.id)}
    await _quietly(client.close)
    say(found)
    return 0


def _refused(why: str, secret: bool = False) -> int:
    """One shape for every way this comes back no, so that no path here has to build one."""
    said = {"ok": False, "why": why}
    if secret:
        said["secret"] = {"env": [TOKEN_FROM]}
    say(said)
    return 0


async def _quietly(closing) -> None:
    """Close a client that may never have opened. Failing to hang up is not an answer to report."""
    with contextlib.suppress(Exception):
        await closing()


# ---------------------------------------------------------------------------------------------
# Question three: carry conversations for as long as the agent is up.
# ---------------------------------------------------------------------------------------------


class Handled(NamedTuple):
    """The two facts about a message this program has already dealt with.

    Kept because a delivery names a message by its id alone, and both questions a delivery asks
    about that message — *where is it* and *did we write it* — are answerable here for nothing or
    from Discord for a round trip each.
    """

    #: The channel the message is standing in, which is **not** always the conversation it belongs
    #: to: being named in a room opens a thread, and the message that asked stays in the room above.
    place: int
    #: Whether this program wrote it. A reply that pinged the author of its own message would ping
    #: the bot and leave the person the answer is for untinted.
    ours: bool


class Growing:
    """The running commentary in one place: what it says, and whether it may still grow.

    **A commentary grows only while it is the last thing in its conversation** (R-DIS-20). A message
    something has been posted under is one the reader has already scrolled past, and editing it then
    changes history rather than showing progress — the new line appears above whatever came after
    it, where nobody is looking. So anything else being said here puts this down and the next line
    starts a message of its own.
    """

    def __init__(self) -> None:
        #: The message being grown, or `None` when the next line must start a new one.
        self.posted: Any = None
        #: Lines seen but not yet written, oldest first. A `None` among them is a barrier: something
        #: visible was posted at that point and what follows must not be counted with what preceded.
        self.pending: List[Any] = []
        #: The groups the posted message is currently showing, as `(line, count)`.
        self.groups: List[Any] = []
        #: What that message now says, so an edit that would change nothing is not sent.
        self.shown = ""
        #: The task waiting out `GROW_SECONDS` before the next write, so a burst is one write.
        self.pacing: Optional[asyncio.Task] = None
        #: Which write is the newest. **A post in flight when something buries the commentary must
        #: not become the message the next line grows into** — it comes back holding a message that
        #: is no longer last, and every line after it would be written where nobody is looking. The
        #: writer compares this number with the one it took before awaiting, and drops its result if
        #: they differ.
        self.writes = 0

    def buried(self) -> None:
        """Something else was said here, so this stops growing and the count starts again."""
        self.posted = None
        self.groups = []
        self.shown = ""
        if self.pending and self.pending[-1] is not None:
            # What is already waiting belongs above the message just posted. It may still be written
            # afterwards, but whatever follows must start a new count rather than joining across it.
            self.pending.append(None)
        self.writes += 1

    def let_go(self) -> None:
        """Stop the pacing task — for a conversation being dropped, or a program shutting down."""
        if self.pacing is not None:
            self.pacing.cancel()
            self.pacing = None


class Reaching:
    """The connection, held open for as long as this program runs, and what it is holding.

    Everything kept here is bounded, because this process runs for weeks: a map that grows by one
    per conversation and shrinks by nothing is a leak that shows up first on the machine which has
    been up the longest.
    """

    def __init__(self, allow: List[str]) -> None:
        self.allow = allow
        self.client = None
        #: The mark now standing on a message, so the next one can be added before it is taken away.
        self.marks: Dict[str, str] = {}
        #: The typing indicator being renewed in a place, by that place's own id.
        self.typing: Dict[int, asyncio.Task] = {}
        #: The running commentary in a place, by that place's own id — see `Growing`.
        self.growing: Dict[int, Growing] = {}
        #: What is known about a message this has handled, by its id — see `Handled`.
        self.handled: Dict[str, Handled] = {}
        #: The command tree, built with the client once the vendor library is bound.
        self.tree: Any = None
        #: Whether the commands have been offered to Discord. Once per process: a global sync is
        #: rate-limited hard, and a bot reconnecting through a bad hour must not spend its whole
        #: allowance re-registering nine commands that have not changed.
        self.offered = False
        #: Interactions held open while rundesk reads an answer, by the id that is their `ref`.
        self.asked: Dict[str, Any] = {}
        #: When each person was last shown the warning for something that cannot be undone.
        self.confirming: Dict[str, float] = {}
        #: Whether the note about not being able to open a thread has already been said.
        self.threadless = False
        #: Whether the socket is up, so `gone` and `ready` are said on the change rather than on
        #: every reconnection attempt behind it.
        self.connected = False
        self.stopping = asyncio.Event()
        #: What went wrong, if anything did, read as the exit code on the way out.
        self.trouble = ""
        self.unrecoverable = False

    # -- the whole of the run --------------------------------------------------------------

    async def run(self, token: str) -> int:
        """Connect, read rundesk, and keep both going until one of them ends.

        **Asked to stop rather than killed where we stand.** Rundesk ends a channel by signalling
        the whole process group and giving it a few seconds before it insists, and the default for
        those two signals is to die immediately — so the goodbye and every last write were simply
        never reached. Handled, the wait below ends and the cleanup that was always written runs.
        """
        self.client = discord.Client(intents=intents_now())
        # `Client.dispatch` looks a handler up by name on the client itself, which is exactly what
        # its own `@client.event` decorator does. Set here rather than by subclassing, so that
        # nothing in this file has to be defined after an import that may never have happened.
        self.client.on_ready = self._up
        self.client.on_resumed = self._up
        self.client.on_disconnect = self._down
        self.client.on_message = self._arrived
        self.tree = discord.app_commands.CommandTree(self.client)
        self._offers()

        loop = asyncio.get_running_loop()
        for sig in (signal.SIGTERM, signal.SIGINT):
            with contextlib.suppress(NotImplementedError, ValueError):
                loop.add_signal_handler(sig, self.stopping.set)

        reading = asyncio.ensure_future(self._reading())
        connected = asyncio.ensure_future(self.client.start(token))
        asked = asyncio.ensure_future(self.stopping.wait())
        try:
            await asyncio.wait({reading, connected, asked}, return_when=asyncio.FIRST_COMPLETED)
        except asyncio.CancelledError:
            pass
        if connected.done() and not connected.cancelled() and connected.exception() is not None:
            self._the_connection_ended(connected.exception())

        for place in list(self.typing):
            self._typing_stops(place)
        # Every clock this holds, stopped before the socket goes. A pacing task left running would
        # wake up into a closed client and write its failure across a shutdown that had gone cleanly.
        for held in self.growing.values():
            held.let_go()
        say({"say": "gone", "why": self.trouble or "rundesk asked this to stop"})
        # **Offline before the socket goes, and it has to be this way round.** Closing alone leaves
        # Discord to notice a socket that stopped answering, which takes it minutes — so an agent
        # somebody has just stopped goes on showing green in the member list, which is the one
        # question that dot is there to answer. Said while there is still a session to say it
        # through, and suppressed: a presence nobody could set is not a reason to refuse to stop.
        with contextlib.suppress(Exception):
            await asyncio.wait_for(
                self.client.change_presence(status=discord.Status.offline), GOING_OFFLINE_WITHIN)
        await _quietly(self.client.close)
        for task in (reading, connected, asked):
            task.cancel()
            with contextlib.suppress(BaseException):
                await task
        if self.unrecoverable:
            return WILL_NOT_FIX
        return 1 if self.trouble else 0

    def _the_connection_ended(self, why: BaseException) -> None:
        """Say what became of the socket, and whether coming back would ever help.

        discord.py resumes what can be resumed and raises what cannot, so arriving here means the
        connection is over. The codes below are the ones where reconnecting is not patience — it is
        a refusal repeated until this machine's address is banned outright.
        """
        code = getattr(why, "code", None)
        if isinstance(why, discord.PrivilegedIntentsRequired):
            code = 4014
        if isinstance(why, discord.LoginFailure):
            self._never_again(f"Discord refused the token in {TOKEN_FROM} (HTTP 401) — it has been "
                              f"reset or revoked, and reconnecting will not change that")
        elif code in WILL_NOT_COME_RIGHT:
            self._never_again(f"Discord closed the gateway with {code}: "
                              f"{WILL_NOT_COME_RIGHT[code]}. Reconnecting cannot fix this and "
                              f"would only repeat it")
        else:
            self.trouble = f"the connection ended: {type(why).__name__}: {why}"
            noted(self.trouble)

    def _never_again(self, said: str) -> None:
        """Record a failure that restarting cannot fix, loudly and once."""
        self.trouble = said
        self.unrecoverable = True
        noted(said, "error")

    def _final(self, why: BaseException) -> bool:
        """Whether a platform refusal is one nothing here can ever get past, and end if it is.

        Only `401`, because only `401` says the credential itself is gone. A `403` is one room this
        bot was not invited into and a `404` is one message that is no longer there; ending the
        whole connection over either would take an agent off every other room it is reachable in.
        """
        if getattr(why, "status", None) != 401:
            return False
        self._never_again(f"Discord answered 401 — the token in {TOKEN_FROM} is no longer accepted")
        self.stopping.set()
        return True

    # -- the connection itself -------------------------------------------------------------

    async def _up(self) -> None:
        """Said on connecting and on resuming, so a quiet agent is not mistaken for a deaf one.

        **The presence is set rather than left to default**, and on every resume rather than once.
        A bot's dot in the member list is the one place somebody looks to find out whether their
        agent is up, and `Status.online` is only discord.py's default *until something changes it* —
        a resumed session carries whatever the last one ended on, which after an orderly stop is
        `offline`. Set here, a gateway that came back is green again without anybody doing anything.
        """
        self.connected = True
        await self._synced()
        with contextlib.suppress(Exception):
            await self.client.change_presence(status=discord.Status.online)
        say({"say": "ready", "as": str(self.client.user)})

    async def _down(self) -> None:
        """Said once per loss, and not once per attempt behind it."""
        if not self.connected:
            return
        self.connected = False
        say({"say": "gone", "why": "the socket closed"})

    # -- what arrives ----------------------------------------------------------------------

    async def _arrived(self, message) -> None:
        """One message, if it is one this agent is reachable by, and nothing before that is settled.

        **The order is the whole of it, and every step is cheaper than the one below.** Whether
        somebody may be answered is still rundesk's decision, but in the build this replaces a
        message from anybody at all opened a real thread and pulled down as much as three hundred
        megabytes before that decision was reached — so any member of a shared server could make an
        agent litter their room and fill a disk without ever being allowed to say a word to it.

        **Three ways in, and a shared room is not one of them.** A private message, a message that
        names us, or a message inside a thread this bot opened — and nothing else. An agent in
        somebody else's server is quiet until it is spoken to, and now that `MESSAGE_CONTENT` is
        declared that is a policy rather than a consequence: every room message arrives readable,
        and answering the ones nobody addressed would be an agent that had started talking over
        people.
        """
        if message.author.bot:
            return
        # **Asked of the channel, and never of `message.guild`.** A stand-in that has never heard of
        # a guild answers `None` for one, and a room read as a private conversation is a room where
        # nobody has to name us first. `Thread` is asked the same way and for the same reason.
        direct = isinstance(message.channel, discord.DMChannel)
        in_thread = isinstance(message.channel, discord.Thread)
        me = self.client.user
        # **A thread this bot opened is its own conversation, and nobody says a name twice into
        # one.** Told by who opened it rather than by being in it: a thread somebody else started
        # and pulled this bot into is still their room, and answering every line of it would be the
        # silence rule lost through the back door.
        ours = in_thread and getattr(message.channel, "owner_id", None) == (me.id if me else None)
        if not direct and not ours and not (me and me in message.mentions):
            return
        if str(message.author.id) not in self.allow:
            return

        text = _without_our_name(message.content, me.id if me else None)
        # **After the allow check and nothing before it.** Fetching is the first expensive, visible
        # thing this program does, and in the build this replaces it happened for anybody at all —
        # and so did opening a thread, so any stranger could make an agent litter a room it was
        # never going to answer them in.
        brought = await self._brought(message)
        if not text and not brought:
            return
        replying = self._replying_to(message)
        # **A room's exchange moves into a thread; a private one and a thread's own stay put.**
        # Threads do not nest, and there is nobody in a private conversation to be out of the way
        # of. A message with nothing in it never gets this far, so no thread is ever opened for one.
        conversation = message.channel.id
        if not direct and not in_thread:
            opened = await self._a_thread(message, text)
            if opened is not None:
                conversation = opened
        # **Where the message is, said before the record that will be answered.** The one that
        # opened a thread is still standing in the room above it, and both the mark rundesk puts on
        # it and any reply that quotes it are addressed by id alone.
        self.handled[str(message.id)] = Handled(place=message.channel.id, ours=False)
        # Somebody spoke here, so the commentary is no longer the last thing in the conversation.
        self._no_longer_last(conversation)
        self._make_room()
        say({"say": "arrived",
             # **The thread's own id, and never its parent's.** A thread is a conversation of its
             # own, and the build this replaces asked about one by the channel it hung under —
             # which matched nothing when asked of the thread, and answered every thread in the
             # server when asked of the parent. Here it is only ever the key a session is kept
             # under, and this is the id that identifies the exchange somebody is actually having.
             "conversation": str(conversation),
             "place": "dm" if direct else "room",
             "user": str(message.author.id),
             "display": flat(getattr(message.author, "display_name", None) or message.author.name),
             "where": self._where_this_is(message),
             "text": text,
             "external_id": str(message.id),
             "attachments": brought,
             # Sent only when there is one, so an ordinary message carries no empty key and an
             # absent field goes on meaning what it has always meant: this replies to nothing.
             **({"reply_to": replying} if replying else {})})

    def _where_this_is(self, message) -> str:
        """Where this was said, in words a brain can repeat (R-DIS-21).

        **The platform's nouns, rundesk's sentence.** Rundesk may never name a room or a server —
        that is a layer which would have to be rewritten for the second surface — so the naming
        happens here, where the vendor's objects actually are, and what crosses the seam is one line
        of ordinary English that any adapter could produce for its own platform.

        Names, never ids. An id is what a conversation is keyed by and is already carried; what this
        is for is an agent being able to say *which* room it is answering in, to the person in it.

        Flattened and bounded like every other stranger's text on its way to a prompt: a server and a
        room are both named by whoever made them.
        """
        channel = message.channel
        if isinstance(channel, discord.DMChannel):
            return "a direct message"
        named = flat(getattr(channel, "name", None) or "", WHERE_AT_MOST)
        server = flat(getattr(getattr(message, "guild", None), "name", None) or "", WHERE_AT_MOST)
        if isinstance(channel, discord.Thread):
            where = f"a thread called {named}" if named else "a thread"
        else:
            where = f"the {named} room" if named else "a room"
        return f"{where} in {server}" if server else where

    def _replying_to(self, message) -> Optional[Dict[str, Any]]:
        """What this message replies to, or `None` when it replies to nothing (R-DIS-34).

        **Never fetched.** What Discord already handed over is used and nothing is asked for: this
        stands on the inbound path in front of every message, a fetch is a round trip, and a parent
        that cannot be resolved is an honest answer rather than a thing to chase (R-CH-30). A real
        share of replies arrive unresolved and say so.

        **A reference is not always a reply.** A forward and a pin carry one too, and presenting
        either as *this answers that* would put words in somebody's mouth. Only an ordinary reply
        counts, and the type is read through `getattr` because it is a vendor enum whose spelling is
        not this program's to depend on.

        **Nothing is invented for a parent that is not there.** An id alone says *they replied to
        something and it could not be read*, which a brain can act on honestly; an author or a body
        guessed beside it would be this adapter making something up.
        """
        reference = getattr(message, "reference", None)
        if reference is None:
            return None
        if getattr(getattr(reference, "type", None), "name", "default") not in ("default", "reply"):
            return None
        which = getattr(reference, "message_id", None)
        if not which:
            return None
        parent = getattr(reference, "resolved", None) or getattr(reference, "cached_message", None)
        author = getattr(parent, "author", None)
        if parent is None or author is None or not hasattr(parent, "content"):
            return {"id": str(which), "resolved": False}
        # Flattened here as well as by rundesk, which is not a second copy of the rule so much as
        # the same guard standing on the side that reads a stranger's account name.
        return {"id": str(which), "resolved": True,
                "author": flat(getattr(author, "display_name", None) or author.name),
                "text": parent.content or ""}

    async def _a_thread(self, message, text: str) -> Optional[int]:
        """Open a thread on this message and hand back its id, or `None` if Discord would not.

        **Degrades, never refuses.** Opening one needs `CREATE_PUBLIC_THREADS`, and a bot that was
        invited before this release was never granted it — what an invite asks for is granted once,
        when somebody accepts it, so an existing bot has to be sent the invite again. A channel that
        stopped working because it could not open a thread would be worse than one that answers in
        the room, so a refusal here costs the tidiness and never the turn.

        **Said once for the life of this process**, because a permission the bot does not have is
        one standing fact and repeating it for every message in a busy room would bury everything
        else in the log. Tried again every time even so: a permission granted while this is running
        starts working without anybody restarting anything.
        """
        try:
            return (await message.create_thread(name=thread_name(text))).id
        except Exception as why:           # noqa: BLE001 — a platform boundary
            if not self.threadless:
                self.threadless = True
                noted(f"could not open a thread, so this was answered in the room instead: "
                      f"{type(why).__name__}: {why} — opening one needs the 'open a thread' "
                      f"permission, and a bot that was already in a server when this release "
                      f"landed has to be sent its invite again to be granted it")
            return None

    async def _brought(self, message) -> List[Dict[str, Any]]:
        """Fetch what was attached onto this machine, and say where each one was put.

        **Onto the disk rather than passed on as a link.** The brain that will open these runs on
        rundesk's side, holds no credential for this platform, and handing it a URL would be handing
        it an instruction to go and fetch something on a stranger's say-so. The build this replaces
        got that right and this build had lost it: the adapter reported a name and a URL and
        downloaded nothing, so `channels/files.py` had the whole landing path built and tested with
        nothing ever reaching it.

        **Where it is put is rundesk's and where it ends up is rundesk's.** This writes into
        `RUNDESK_CHANNEL_HOME`, which rundesk hands over, under a name that is only a number —
        rundesk takes each one from there into the agent's own account of what arrived, flattening
        the platform's name and making it unused in the one place that does that. Nothing is left
        behind: a file rundesk takes is a file rundesk removes, and one it refuses is removed too.

        A file that could not be fetched is a line and never a refused message: the rest of what
        somebody sent is still worth carrying.
        """
        if not message.attachments:
            return []
        home = (os.environ.get("RUNDESK_CHANNEL_HOME") or "").strip()
        if not home:
            noted("nothing said where this channel may put what it fetches, so an attachment was "
                  "left where only Discord can reach it", "error")
            return []
        into = Path(home) / FETCHED_IN / str(message.id)
        brought: List[Dict[str, Any]] = []
        for nth, one in enumerate(message.attachments[:BROUGHT_MOST]):
            declared = int(one.size or 0)
            if declared > BROUGHT_BYTES:
                noted(f"{one.filename} is {declared} bytes, which is more than one message may "
                      f"bring in ({BROUGHT_BYTES})")
                continue
            at = into / str(nth)
            try:
                into.mkdir(parents=True, exist_ok=True)
                await one.save(at)
                # **What a platform declares and what it sends are two facts.** A save that returned
                # is not a file of the right length: a fetch cut off part way leaves a readable file
                # holding half of what somebody sent, and nothing downstream can tell that from a
                # small file. Caught here, where it can simply be dropped.
                fetched = at.stat().st_size
                if fetched > BROUGHT_BYTES:
                    raise Refused(f"it arrived as {fetched} bytes, past the {BROUGHT_BYTES} one "
                                  f"message may bring in")
                if declared and fetched != declared:
                    raise Refused(f"Discord said {declared} bytes and {fetched} arrived, so this "
                                  "is not the whole of what was sent")
            except Exception as why:       # noqa: BLE001 — a platform boundary
                # **Nothing is left behind on the way out.** A path this never reports is a path
                # rundesk never hears of, so `files.landed` — which removes every staged file it is
                # told about, taken or refused — cannot remove this one, and `files.swept` never
                # looks in here. Dropped by hand or it is debris for the life of the install.
                with contextlib.suppress(OSError):
                    at.unlink()
                noted(f"could not bring in {one.filename}: {type(why).__name__}: {why}")
                continue
            # **What the platform said, not what this measured.** Rundesk checks the declared size
            # against the file it lands, and a number this took from its own `stat()` makes that
            # check compare rundesk's measurement with rundesk's measurement — it agreed always, and
            # a documented guarantee had no way to fire. Left out entirely when Discord declared
            # nothing, because said-nothing and said-zero are different answers and `files.landed`
            # reads an absent one as the first.
            said = {"name": one.filename, "at": str(at)}
            if declared:
                said["bytes"] = declared
            brought.append(said)
        if len(message.attachments) > BROUGHT_MOST:
            noted(f"{len(message.attachments)} files were attached and only the first "
                  f"{BROUGHT_MOST} were brought in")
        return brought

    # -- what rundesk says -----------------------------------------------------------------

    async def _reading(self) -> None:
        """Everything rundesk says, a line at a time, for as long as it is saying it."""
        reader = asyncio.StreamReader(limit=READS_MOST)
        loop = asyncio.get_running_loop()
        await loop.connect_read_pipe(lambda: asyncio.StreamReaderProtocol(reader), sys.stdin)
        while True:
            try:
                line = await reader.readline()
            except ValueError as why:
                # Longer than anything this protocol carries. What was held is dropped rather than
                # kept, so this reads on instead of answering one unreadable line for ever.
                noted(f"a line too long to hold was dropped: {why}", "error")
                continue
            if not line:
                return            # rundesk has stopped speaking, so there is nothing left to carry
            try:
                it = json.loads(line)
            except ValueError:
                continue
            if not isinstance(it, dict):
                continue
            try:
                await self._told(it)
            except Exception as why:       # noqa: BLE001 — a delivery boundary
                # **Said, and then read on.** Swallowing this in silence is how a command that never
                # happened leaves no trace at all, unlike a room that could not be found. The loop
                # must not end either: one record nobody could act on is not a channel going away.
                cannot_say(traceback.format_exc())
                noted(f"could not act on {it.get('do')!r}: {type(why).__name__}: {why}", "error")

    async def _told(self, it: Dict[str, Any]) -> None:
        """One command, done the way this platform does it."""
        doing = it.get("do")
        if doing == "deliver":
            await self._deliver(it)
        elif doing == "state":
            await self._state(it)
        elif doing == "activity":
            self._doing(it)
        elif doing == "answered":
            await self._answered(it)
        elif doing == "stop":
            self.stopping.set()
        else:
            # Kept rather than refused: rundesk may be ahead of this adapter, and a command this
            # does not know is not a channel that has gone wrong.
            noted(f"nothing here does {doing!r}", "info")

    async def _deliver(self, it: Dict[str, Any]) -> None:
        """Post what the agent said and report the platform's own id for it — or say why not.

        **All of it, or none of it.** A file that would not verify refuses the whole delivery rather
        than posting the words and quietly leaving the file behind: the second reports a delivery
        that did not happen the way it was asked for, and nothing downstream could tell.
        """
        given = str(it.get("id") or "")
        text = it.get("text") or ""
        files: List[Any] = []
        try:
            if not isinstance(text, str):
                raise Refused("the text to deliver was not text")
            text = _under(text, it.get("cost"))
            if len(text) > MAX_TEXT:
                raise Refused(f"{len(text)} characters is past what Discord takes in one message "
                              f"({MAX_TEXT}) — this never re-splits what it is handed, because "
                              f"splitting happens once, on rundesk's side, for every platform")
            # Named as a number before anything is opened, because a place this platform cannot
            # parse is the one failure here that no file and no text could ever get past.
            place = an_id(it.get("place"), "channel id")
            for one in it.get("files") or []:
                # Re-opening and hashing as much as 32 MiB is filesystem work, not event-loop work.
                # Kept sequential so attachment order and all-or-none cleanup stay exact.
                files.append(await asyncio.to_thread(a_verified_file, one))
            if not text and not files:
                raise Refused("there was nothing to deliver: no text, and no file")
            reference, tint = self._quoting(it.get("reply_to"), place)
            where = self.client.get_partial_messageable(place)
        except (Refused, TypeError, ValueError) as why:
            closed(files)
            say({"say": "failed", "id": given, "why": str(why)})
            return

        try:
            sent = await where.send(content=text or None, files=files or None,
                                    reference=reference, mention_author=tint)
        except Exception as why:           # noqa: BLE001 — a platform boundary
            self._final(why)
            failed = {"say": "failed", "id": given,
                      "why": f"Discord would not take it: {type(why).__name__}: {why}"}
            # Present only where the library declined to wait a limit out itself. discord.py sleeps
            # through an ordinary rate limit, so an absent `retry_after` means *there is nothing to
            # tell you* and never *try again straight away*.
            after = getattr(why, "retry_after", None)
            if isinstance(after, (int, float)) and not isinstance(after, bool):
                failed["retry_after"] = float(after)
            say(failed)
            return
        finally:
            # The platform has consumed the upload before ``send`` returns. The snapshot is ours,
            # not durable output, and must close on success just as surely as on refusal.
            closed(files)
        # Ours, and remembered as ours: a later delivery told to quote this one must not ping its
        # author, which is this bot.
        self.handled[str(sent.id)] = Handled(place=place, ours=True)
        # Anything posted here stands under the commentary, so the commentary stops growing. This is
        # the answer, a remark said mid-turn, or a notice — every one of them a message the reader
        # scrolls to, and every one of them a reason the next activity line starts somewhere new.
        self._no_longer_last(place)
        self._make_room()
        say({"say": "delivered", "id": given, "external_id": str(sent.id)})

    def _quoting(self, reply_to: Any, place: int):
        """What this delivery quotes and whether it tints — or neither, and why.

        **The tint is the whole of what the quote is for.** A message naming somebody is drawn by
        *their own* client with an amber bar down the side of it, which is a thing no bot can draw
        for itself and the only way an answer somebody has been waiting for stops looking like the
        bookkeeping around it. A reply does it by pinging the author of the message it quotes.

        **Which delivery is an answer is rundesk's to say**, and it says so by putting a `reply_to`
        on it. Nothing here reads the text and guesses: running commentary carries none and is
        posted plainly, because a thread where every line quotes the same message is unreadable.

        **A private conversation is quoted too, and this is the correction** (R-DIS-28). It was
        dropped here on the reasoning that two people are already alone and a quote buys no
        attention — which reads well and is wrong about what the quote is *for*. The tint is not
        attention, it is the difference between the answer and the six lines of commentary above it,
        and in a one-to-one conversation the reply ping is the only thing that draws it at all. An
        answer that arrives after minutes of working, untinted, under its own running commentary,
        is the failure this exists to prevent — and it is worst in a DM, where there is nothing else
        on the screen to tell the two apart.

        Two ways this still comes back with nothing to quote.

        **A message this program wrote.** Pinging its author pings the bot, and the person the
        answer is for is left untinted — the recorded failure from the build this replaces, where a
        scheduled report was anchored to rundesk's own notice.

        **A message standing somewhere else.** Being named in a room opens a thread and the turn
        happens inside it while the message that asked stays in the room above; a reply does not
        reach across, so the quote is dropped here rather than left to Discord, which would drop it
        silently and only because `fail_if_not_exists` says so.
        """
        if not reply_to:
            return None, False
        quoted = an_id(reply_to, "message id")
        known = self.handled.get(str(quoted))
        if known is not None and known.place != place:
            return None, False
        # **`fail_if_not_exists=False`, always.** Discord refuses a whole message that quotes one it
        # cannot resolve, and a turn here runs for minutes — the asker deleting their own question
        # is enough to lose the answer to it entirely.
        return (discord.MessageReference(message_id=quoted, channel_id=place,
                                         fail_if_not_exists=False),
                not (known is not None and known.ours))

    async def _state(self, it: Dict[str, Any]) -> None:
        """Show what rundesk says a turn is doing: a mark, an indicator, and no opinion of ours."""
        state = str(it.get("state") or "")
        try:
            place = an_id(it.get("place"), "channel id")
            named = an_id(it["external_id"], "message id") if it.get("external_id") else None
        except Refused as why:
            noted(str(why))
            return
        if state == "working":
            self._typing_starts(place)
            return
        if state != "seen":
            self._typing_stops(place)
        mark = MARKS.get(state)
        if mark and named is not None:
            await self._mark(place, named, mark)

    async def _mark(self, place: int, external_id: int, mark: str) -> None:
        """Put the new mark up before taking the old one down, so nothing is ever unmarked.

        A message with no mark for a moment reads as a turn nobody picked up, and the order is the
        only thing that decides which of those somebody sees. If the new one cannot be placed then
        the old one stays, which is the failure to prefer.

        **Marked where it is standing, which is not always where its conversation is.** Being named
        in a room opens a thread and rundesk names that thread as the place — while the message it
        is marking is still in the room above, where Discord answers `404` for it. Falls back to the
        place it was told when this has never seen the message, which is every message a restart
        forgot and is the only answer available for one.
        """
        known = self.handled.get(str(external_id))
        standing_in = known.place if known is not None else place
        keyed = f"{standing_in}/{external_id}"
        standing = self.marks.get(keyed)
        if standing == mark:
            return
        where = self.client.get_partial_messageable(standing_in)
        message = where.get_partial_message(external_id)
        try:
            await message.add_reaction(mark)
        except Exception as why:           # noqa: BLE001 — a platform boundary
            self._final(why)
            noted(f"could not mark {external_id} with {mark}: {type(why).__name__}: {why}")
            return
        self.marks[keyed] = mark
        self._make_room()
        if standing:
            with contextlib.suppress(Exception):
                await message.remove_reaction(standing, self.client.user)

    # -- the gestures a person makes, which are Discord's own commands ---------------------

    def _offers(self) -> None:
        """Register every gesture this offers, described where it is offered (R-DIS-10).

        Built as closures rather than as decorated methods because the vendor library may never
        have been imported when this file is read — `discord.app_commands` is reached only here,
        after `the_library()` has bound it.
        """
        for name, describes, control in CONTROLS:
            self.tree.add_command(discord.app_commands.Command(
                name=name, description=describes, nsfw=False,
                callback=self._a_control(name, control)))
        for name, describes, query in QUERIES:
            self.tree.add_command(discord.app_commands.Command(
                name=name, description=describes, nsfw=False,
                callback=self._a_query(query)))
        self.tree.add_command(discord.app_commands.Command(
            name=CONFIGURE[0], description=CONFIGURE[1], nsfw=False,
            callback=self._the_provider()))

    async def _synced(self) -> None:
        """Offer the commands to Discord. **Global, and once per connection is too often.**

        A global sync is rate-limited hard and takes up to an hour to propagate, so it is done on
        the first connection of this process and not on every resume — a bot that reconnects
        forty times in a bad hour would otherwise spend its whole allowance re-registering nine
        commands that have not changed.
        """
        if self.offered:
            return
        self.offered = True
        try:
            await self.tree.sync()
        except Exception as why:           # noqa: BLE001 — a platform boundary
            self.offered = False
            noted(f"could not offer the commands: {type(why).__name__}: {why}. They will not "
                  f"appear until this reconnects — and if they never do, check the bot was "
                  f"invited with the applications.commands scope", "warning")

    def _a_control(self, name: str, control: str):
        """One gesture that *does* something. Acknowledged at once, and only that it was heard."""
        async def gestured(interaction: Any) -> None:
            if not await self._may(interaction):
                return
            if control == "shutdown" and not self._confirmed(interaction):
                await self._said_back(
                    interaction,
                    f"⚠️ This stops the gateway for good. Nothing here can start it again — you "
                    f"will need the machine it runs on. Run **/{name}** again within "
                    f"{int(CONFIRM_WITHIN)}s to confirm.")
                return
            # **Held open inside the three seconds Discord allows, then completed by what rundesk
            # says about it** (R-DIS-11). Answered on the spot instead, the only thing there is to
            # say is *heard* — and a person who pressed `/stop` where nothing was running, or `/new`
            # in a conversation that had none, was left looking at that for ever while the sentence
            # telling them so was thrown away for want of anywhere to put it.
            #
            # What it *did* still never comes from here (R-DIS-12): rundesk answers what was
            # **asked** — that nothing was running, that the next message starts fresh — and what a
            # turn came to arrives as that turn's own outcome.
            if not await self._deferred(interaction):
                return
            say({"say": "control", "conversation": str(interaction.channel_id),
                 "user": str(interaction.user.id), "control": control,
                 "ref": str(interaction.id)})
        return gestured

    def _a_query(self, query: str):
        """One read-only question. Deferred, because rundesk reads records to answer it."""
        async def gestured(interaction: Any) -> None:
            if not await self._may(interaction):
                return
            if not await self._deferred(interaction):
                return
            say({"say": "query", "conversation": str(interaction.channel_id),
                 "user": str(interaction.user.id), "query": query,
                 "ref": str(interaction.id)})
        return gestured

    def _the_provider(self):
        """The one gesture that takes a value."""
        async def gestured(interaction: Any, provider: str) -> None:
            if not await self._may(interaction):
                return
            if not await self._deferred(interaction):
                return
            say({"say": "configure", "conversation": str(interaction.channel_id),
                 "user": str(interaction.user.id), "provider": provider,
                 "ref": str(interaction.id)})
        gestured.__annotations__ = {"interaction": Any, "provider": str}
        return discord.app_commands.describe(
            provider="Which brain answers — a provider name, or a path to one")(gestured)

    async def _may(self, interaction: Any) -> bool:
        """Whether this gesture is worth reporting at all. **Advisory, and never the decision.**

        Rundesk refuses a stranger again on its own side and answers them with silence, which is the
        only check that counts. This one exists so a stranger is not left watching a deferred
        question that will never be answered — and because somebody a channel did not allow once
        typed `/restart` in a shared room and was told the agent was restarting, which was a promise
        nothing kept and a confirmation to a stranger that the agent was listening.
        """
        if str(interaction.user.id) in self.allow:
            return True
        with contextlib.suppress(Exception):
            await interaction.response.send_message(NOT_YOURS, ephemeral=True)
        return False

    async def _said_back(self, interaction: Any, said: str) -> bool:
        """Answer an interaction where it stands, privately. **Never in the room.**"""
        try:
            await interaction.response.send_message(said, ephemeral=True)
            return True
        except Exception as why:           # noqa: BLE001 — a platform boundary
            noted(f"could not answer a command: {type(why).__name__}: {why}")
            return False

    async def _deferred(self, interaction: Any) -> bool:
        """Hold the interaction open past Discord's three seconds, and remember it by its own id.

        **The id is rundesk's `ref` and comes back on the answer**, so one deferred question is
        completed by its own answer and never by the next one to arrive.
        """
        try:
            await interaction.response.defer(ephemeral=True)
        except Exception as why:           # noqa: BLE001 — a platform boundary
            noted(f"could not hold a command open: {type(why).__name__}: {why}")
            return False
        self.asked[str(interaction.id)] = interaction
        while len(self.asked) > ASKED_KEPT:
            self.asked.pop(next(iter(self.asked)))
        return True

    def _confirmed(self, interaction: Any) -> bool:
        """Whether this is the second press of something that cannot be undone, within the window."""
        who = str(interaction.user.id)
        asked_at = self.confirming.get(who)
        now = time.monotonic()
        if asked_at is not None and now - asked_at <= CONFIRM_WITHIN:
            self.confirming.pop(who, None)
            return True
        self.confirming[who] = now
        while len(self.confirming) > ASKED_KEPT:
            self.confirming.pop(next(iter(self.confirming)))
        return False

    async def _answered(self, it: Dict[str, Any]) -> None:
        """What rundesk said about a gesture, put back on the interaction that asked it."""
        interaction = self.asked.pop(str(it.get("ref") or ""), None)
        if interaction is None:
            return
        said = str(it.get("text") or "")
        if not said:
            return
        with contextlib.suppress(Exception):
            await interaction.followup.send(said[:MAX_TEXT], ephemeral=True)

    # -- the running commentary, which grows in place while it is still the last thing -----

    def _doing(self, it: Dict[str, Any]) -> None:
        """One thing the agent did. Gathered, and written a moment later (R-DIS-20).

        **Not written here.** A brain reaches for several tools in a second, and answering each one
        with an edit spends a rate limit saying what one edit would have said. So the line joins what
        is waiting and a single task, started once, writes the lot of them after `GROW_SECONDS`.
        """
        try:
            place = an_id(it.get("place"), "channel id")
        except Refused as why:
            noted(str(why))
            return
        line = activity_line(it)
        if not line:
            return
        held = self.growing.setdefault(place, Growing())
        held.pending.append(line)
        self._make_room()
        if held.pacing is None or held.pacing.done():
            held.pacing = asyncio.ensure_future(self._paced(place))

    async def _paced(self, place: int) -> None:
        """Wait out the burst, write once, and **take responsibility for what arrived meanwhile.**

        A line can arrive while Discord is still accepting the write below. At that moment `_doing`
        sees this task as live and will not start another, so this one has to look again before it
        ends — otherwise the last lines of a turn sit in `pending` for ever and the commentary stops
        one tool short of where the agent actually got to.
        """
        await asyncio.sleep(GROW_SECONDS)
        held = self.growing.get(place)
        if held is None:
            return
        await self._flush(place, held)
        if held.pending:
            held.pacing = asyncio.ensure_future(self._paced(place))

    async def _flush(self, place: int, held: Growing) -> None:
        """Write what has happened since the last time — by growing one message, or starting one.

        **Edited while it is still last, posted fresh once it is not.** The first is what makes a
        turn read as one thing happening rather than as a wall of notifications; the second is what
        stops it rewriting a message the reader has already scrolled past.

        A failed edit puts the message down rather than trying it again for the rest of the turn: an
        edit fails because the message is gone or the channel is unreachable, and neither improves by
        being asked twice a second.
        """
        pending, held.pending = held.pending, []
        if not pending or self.client is None:
            return
        held.groups = grouped(held.groups, pending)
        saying, held.groups = bounded(held.groups)
        if saying == held.shown and held.posted is not None:
            return
        if held.posted is None:
            # Which write this is, kept across the await below. Something else may bury the
            # commentary while this is in flight, and a write that comes back afterwards must not put
            # the buried message back for the next line to grow into.
            mine = held.writes = held.writes + 1
            where = self.client.get_partial_messageable(place)
            try:
                sent = await where.send(content=saying)
            except Exception as why:       # noqa: BLE001 — a platform boundary
                self._final(why)
                noted(f"could not say what the agent is doing in {place}: "
                      f"{type(why).__name__}: {why}")
                return
            if mine == held.writes:
                held.posted, held.shown = sent, saying
                self.handled[str(sent.id)] = Handled(place=place, ours=True)
                self._make_room()
            return
        try:
            await held.posted.edit(content=saying)
        except Exception as why:           # noqa: BLE001 — a platform boundary
            self._final(why)
            noted(f"could not grow what the agent is doing in {place}: "
                  f"{type(why).__name__}: {why}")
            held.posted = None             # start a fresh one rather than keep failing on this
            return
        held.shown = saying

    def _no_longer_last(self, place: int) -> None:
        """Something visible was said in this place, so the commentary stops growing.

        Called wherever a message that is *not* the commentary is posted, and wherever somebody
        speaks. Both put something underneath it, and both mean the next thing to show belongs in a
        message of its own.
        """
        held = self.growing.get(place)
        if held is not None:
            held.buried()

    # -- the typing indicator, which is the only thing here with a clock -------------------

    def _typing_starts(self, place: int) -> None:
        """Begin renewing the indicator in a place, unless it is already being renewed there.

        Nothing repeats on the seam — `working` is sent once, when the turn is admitted, and is not
        a heartbeat. So an indicator that lapses after ten seconds has to be renewed on this side's
        own clock, or a turn that is still running looks finished shortly after it began.
        """
        if place in self.typing:
            return
        self.typing[place] = asyncio.ensure_future(self._typing(place))
        self._make_room()

    def _typing_stops(self, place: int) -> None:
        """Stop renewing it, and let go of the task — never one without the other."""
        task = self.typing.pop(place, None)
        if task is not None:
            task.cancel()

    async def _typing(self, place: int) -> None:
        """Renewed inside Discord's own lapse until the turn ends, or the platform says no.

        One refusal ends it. An indicator is fidelity and a turn completes without one, so asking
        again every eight seconds for the length of a turn would spend a rate limit saying nothing.
        """
        where = self.client.get_partial_messageable(place)
        while True:
            try:
                await where.typing()
            except asyncio.CancelledError:
                raise
            except Exception as why:       # noqa: BLE001 — a platform boundary
                self._final(why)
                noted(f"no typing indicator in {place}: {type(why).__name__}: {why}")
                return
            await asyncio.sleep(TYPING_SECONDS)

    def _make_room(self) -> None:
        """Keep what is held bounded, and cancel what is dropped.

        **Dropping an entry without cancelling what it started is the recorded failure**: the
        indicator went on renewing itself in that conversation for the rest of the process's life,
        which is weeks. Oldest first, because the oldest conversation is the one least likely to
        still be waiting on an answer.
        """
        while len(self.marks) > LIVE_KEPT:
            self.marks.pop(next(iter(self.marks)))
        while len(self.typing) > LIVE_KEPT:
            self._typing_stops(next(iter(self.typing)))
        while len(self.growing) > LIVE_KEPT:
            # Its pacing task goes with it, for exactly the reason above: a commentary dropped
            # without cancelling its timer goes on waking up in a conversation nothing is left of.
            self.growing.pop(next(iter(self.growing))).let_go()
        while len(self.handled) > LIVE_KEPT:
            self.handled.pop(next(iter(self.handled)))


def _without_our_name(text: Any, ours: Optional[int]) -> str:
    """What was said, with *our* naming taken out — it addressed us, it is not the ask.

    **Ours and nobody else's.** Every mention used to go, and everything between a literal `<@` and
    the next `>` with them: "ask <@alice> to review it" reached the brain as "ask to review it". Who
    else somebody named is part of what they asked, and a word they typed is not this file's to
    remove.
    """
    said = str(text or "")
    if ours is None:
        return said.strip()
    for named in (f"<@{ours}>", f"<@!{ours}>"):
        said = said.replace(named, "")
    return said.strip()


async def serving() -> int:
    """Hold the connection open and carry conversations until rundesk ends us."""
    missing = the_library()
    if missing:
        noted(missing, "error")
        return WILL_NOT_FIX
    token = the_token()
    if not token:
        # Said where the gateway's log will show it. A machine keeping an agent up has no terminal
        # and no shell profile, which is the state a channel spends its whole life in.
        noted(f"there is no bot token — nothing set {TOKEN_FROM}", "error")
        return WILL_NOT_FIX
    allow = who_may_reach()
    if not allow:
        # An empty list authorises nobody, so this would run perfectly and answer no one. Said out
        # loud, because a channel that is deaf by configuration looks exactly like a broken one.
        noted("nothing said who may reach this agent, so nothing said here will be answered",
              "error")
    try:
        return await Reaching(allow).run(token)
    except Refused as why:
        noted(str(why), "error")
        return WILL_NOT_FIX


def main(argv: List[str]) -> int:
    """The three invocations, and nothing that quietly resembles one of them.

    Matched exactly rather than searched for: an adapter that took a mistyped `--check` for a
    request for its capabilities would answer a question nobody asked and look as though it worked.
    """
    if argv == ["--capabilities"]:
        return capabilities()
    if argv[:1] == ["--check"]:
        return asyncio.run(check(list(argv[1:])))
    if argv == ["serve"]:
        return asyncio.run(serving())
    cannot_say(f"discord: {' '.join(argv) or 'nothing'} is not one of --capabilities, "
               f"--check [options] or serve")
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
