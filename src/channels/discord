#!/usr/bin/env python3
"""Discord, as an agent is reached on it.

Everything about this platform is in this file and nowhere else (R-CAD-13). A snowflake,
an intent, a gateway opcode, the two-thousand-character limit and the three seconds an
interaction has to be acknowledged in are all Discord's, and none of them appears outside
this program. Nothing here is imported by Rundesk, and nothing here imports Rundesk.

What it does, in the order somebody experiences it:

    named in a channel -> a thread opens and the turn happens there (R-DIS-1)
    inside that thread -> it answers without being named again      (R-DIS-3)
    in a direct message -> it answers where it was spoken to        (R-DIS-4)
    taken up -> 👀 and typing        finished -> ✅ and the answer, whole
    stopped  -> ✋                   failed   -> ⚠️ and what failed

The contract this implements is
`docs/extending/channel-adapters/references/the-contract.md`. Where the
two disagree, the reference is right.

The cost of the choice: `discord.py` is a dependency, pinned in `requirements.txt` and
installed by `install.sh` into the install's own virtualenv. Python's standard library has
no websocket client, and a gateway connection cannot be held open without one.
"""

from __future__ import annotations

import argparse
import asyncio
import contextlib
import hashlib
import io
import json
import os
import re
import signal
import stat
import sys
import tempfile
import time
from pathlib import Path

# The install's own virtualenv, found the way the launcher finds it. A channel adapter is
# a program run with a built environment and almost no PATH, so nothing has put this on
# the path for us — and being honest about not finding it beats an import error nobody
# can act on.
#
# **Counted from where this file stands, not written as a number.** This said `parents[3]`
# from `src/rundesk/channels/`, and went on saying it after the adapters moved up to
# `src/channels/` — so it looked for the virtualenv one directory *above* the install, found
# nothing, and told an owner to run the installer that had already put `discord.py` exactly
# where it belonged. Nothing failed until somebody added a channel.
_ROOT = Path(__file__).resolve().parents[2]
for _packages in sorted((_ROOT / ".venv" / "lib").glob("python3.*/site-packages")):
    sys.path.insert(0, str(_packages))

try:
    import discord
except ImportError:  # pragma: no cover - proved by the install, not by the suite
    print(json.dumps({"ok": False, "why": (
        "discord.py is not installed — run ./install.sh, which puts it in rundesk's own "
        f"virtualenv (looked in {_ROOT / '.venv'})")}), flush=True)
    raise SystemExit(1)

#: Where the token is read from unless the owner names another variable. Never an
#: argument: a command line is readable through the process list and lands in shell
#: history. Never written down either — what is kept is this name (R-CAD-11, R-CAD-12).
TOKEN_FROM = "DISCORD_TOKEN"

#: The file the token is read from when the variable is not set — a file the owner
#: already controls, in this channel's own directory.
#:
#: **A supervised gateway has no shell.** The machine that keeps an agent up starts it
#: with a built environment, so a token exported in somebody's terminal is a token the
#: agent will never see once it is being kept up properly — which is the only way it is
#: meant to run. Nothing here ever writes this file; it is the owner's to put there, and
#: what rundesk keeps is still only the *name* of where to look.
TOKEN_FILE = "token"

#: The kinds of place Discord is, each of which becomes a channel of its own (R-CAD-15). A
#: private message and a room full of people are not the same thing to talk in, and a
#: channel carries who may reach the agent through it — so an owner pointed at both gets an
#: allowed list and a set of instructions for each.
DMS, ROOMS = "dms", "rooms"

# Defaults shipped by older Discord adapters and persisted into channel records. They are
# sent back verbatim as `prompt_replaces` so Rundesk can omit only an untouched old default;
# owner-modified instructions remain appended. Discord owns these Discord-specific words.
LEGACY_INSTRUCTIONS = {
    DMS: """You are {agent}, reached over {kind} in a private conversation with {called}.
Nobody else can read it, so answer directly and at whatever length the question needs.""",
    ROOMS: """You are {agent}, reached over {kind} in {where.channel} on the {where.server} server,
and {called} is asking. Anyone in that room can read what you write. Keep replies short
enough to read on a phone, and never paste a credential, a private path, or anything
said to you in confidence somewhere else.""",
}

#: How many servers to name when saying what a room channel reaches. A bot in forty
#: servers has a description nobody reads; the count of the rest says the same thing.
GUILDS_SHOWN = 3

#: The pieces of a place, which an owner writes as `{where.channel}` and `{where.server}`.
#: Declared here so a misspelt one is refused when it is written; `where` on its own is
#: still the whole phrase, for anyone who wants it in one go.
FILLS = {DMS: (), ROOMS: ("channel", "server", "thread")}

#: Discord caps a message at two thousand characters. Left short of it on purpose: a
#: reply is split at a line break where there is one, and the room to do that has to come
#: from somewhere (R-DIS-13).
LIMIT = 1900

#: How long to wait for the connection before looking a room up by name. What rooms exist is
#: the client's cache and it is empty until Discord has sent them, so this is the difference
#: between a schedule that fires a minute after a gateway starts and one that fires six
#: seconds after it. Bounded rather than open: nothing is waiting on this delivery.
READY_SECONDS = 30.0

#: How long Discord's typing indicator lasts before it lapses. Renewed inside it while a
#: turn is running, because an indicator that stops is a turn that looks finished
#: (R-DIS-6).
TYPING_SECONDS = 8.0

#: How long to leave between writes of the running commentary. Discord rate-limits
#: posting harder than editing, so a message that grows is written more often than one
#: that is posted again — and a turn running a dozen tools in a second must not spend the
#: budget the answer needs (R-DIS-14).
POST_SECONDS = 2.5
GROW_SECONDS = 1.2

#: How the running commentary is shown, and the default (R-DIS-20).
#:
#: `grows` is one message that is edited as the turn goes, which reads as a single thing
#: happening. `posts` is a message per batch, which survives a surface that cannot edit
#: and buries a busy channel. `off` shows none of it, and is the default: a phone that
#: buzzes eleven times to say an agent read a file is worse than one that buzzes once
#: with the reply, and an owner who wants to watch can say so.
GROWS, POSTS, OFF = "grows", "posts", "off"

#: How much of the running commentary is kept in one growing message. Discord refuses a
#: message past its own limit, and a turn that ran fifty tools would otherwise write one
#: that cannot be sent at all — so the oldest lines go and a mark says they did.
ACTIVITY_CHARS = 1500

#: What a thread opened by being named is called. Discord allows a hundred; this is short
#: enough to read in a sidebar.
THREAD_CHARS = 80

#: How long to spend saying goodbye. Rundesk signals a channel and waits a few seconds
#: before insisting, so anything slower than this is a message nobody receives — and
#: holding the shutdown open for it would only turn a clean stop into a kill.
GOODBYE_SECONDS = 3.0

#: How much of that the message to the owner may take. **Well inside it, because the close
#: is the part that matters.** Telling the owner is two round trips — a user fetched and a
#: message sent — and an owner who cannot be reached spent the whole budget on them, so
#: `close()` was never reached and the socket was dropped rather than closed. Discord then
#: reaps it on its own schedule, and the bot goes on showing as online long after the
#: gateway behind it has gone (R-DIS-16).
TELLING_SECONDS = 1.0

#: How many attachments to carry in from one message, and how big one may be. A chat
#: platform accepts far more than a turn can use, and an agent's own directory is not
#: somewhere anybody who can message it gets to fill.
ATTACHED_MOST = 10
ATTACHED_BYTES = 32 * 1024 * 1024

#: How many messages an answer may be split across before it is sent as a file instead.
#: Past this it is a document rather than a message, and a dozen numbered fragments is
#: not a thing anybody reads.
ATTACH_AFTER = 3

#: How many recent messages to keep hold of, so a mark can be put on one without asking
#: Discord for it again. Bounded because this process runs for weeks.
SEEN_KEPT = 200

#: How many conversations to hold state for. An entry is made for each and taken away
#: when a turn ends in it, so one that never reached a turn would otherwise stay for the
#: life of the process — which is weeks.
LIVE_KEPT = 200

#: What each state looks like here (R-CAD-4). The system decides which one a turn is in;
#: this is the whole of what this file decides about it.
MARKS = {"finished": "✅", "stopped": "✋", "failed": "⚠️"}
SEEN = "👀"


#: What this agent offers as Discord's own commands, described where they are offered
#: (R-DIS-10, R-DIS-22). Slash commands rather than words typed in chat, because they
#: are discoverable, are described where they are offered, and cannot be said by accident.
#:
#: Each is Discord's own name for one of the gestures the seam defines — the platform
#: picks the word its people will recognise, and the seam keeps the meaning. `/new` is
#: what forgetting a conversation is called to somebody using it: they are not clearing
#: state, they are starting again.
CONTROL_COMMANDS = (
    ("stop", "Stop the turn running here", "stop", "✋ stopping this turn."),
    ("new", "Start a new session — the next message begins fresh", "forget",
     "🧹 this conversation starts fresh."),
    ("restart", "Restart this agent's gateway", "restart",
     "♻️ restarting the agent — it will be back in a moment."),
)

#: Read-only agent and gateway questions (R-DIS-22, R-DIS-36, R-DIS-37). Their names are
#: Discord's; the values are Rundesk's closed query vocabulary, so this never becomes
#: an arbitrary command runner.
QUERY_COMMANDS = (
    ("status", "Show this agent gateway's current status", "status"),
    ("version", "Show the installed and running Rundesk versions", "version"),
    ("agents", "List configured agents and whether they are running", "agents"),
    ("skills", "List skills granted to this agent", "skills"),
    ("schedules", "List this agent's schedules that can still run", "schedules"),
    ("roles", "List the work this agent has handed to a role", "roles"),
    ("help", "Show the gateway commands available here", "help"),
)

#: What a tool did, in a mark. One per verb the seam defines, and never keyed on a
#: brain's own name for a tool — recognising those would carry one vendor's vocabulary
#: into this file forever. A verb with no mark here would silently show as the fallback,
#: so the suite checks this covers the seam's list rather than trusting it to.
DID = {"read": "📖", "search": "🔎", "run": "💻", "edit": "✏️", "list": "📁",
       "make": "🎨", "delegate": "🤖",
       # What the agent changed of its own (R-PRV-29). Marked apart from `edit` because
       # they are apart: a file the agent was working on and a file the agent lives by
       # are the same pencil and different news.
       "memory": "🧠", "rules": "📜", "identity": "✨"}
UNKNOWN = "💭"

#: The same verbs as a person would say them. A commentary is read as a sentence, and
#: `edit` beside a pencil reads as an instruction rather than as something that happened.
#:
#: **No articles, and no capitals.** These are read as a column of subtext beside a row of
#: marks, dozens of them in a turn, and at that width "a" is a word carrying nothing: a
#: reader skims the verb and the noun. Clipped for the same reason a log line is.
#:
#: The continuity verbs are said in the first person because these files are the agent's
#: own. "Updated its memory" reads as a process writing to a store; the agent changed what
#: it will know next time, and it is the one saying so.
SHOWN = {"read": "read file", "search": "searched", "run": "ran command",
         "edit": "edited file", "list": "listed files", "make": "made something",
         "delegate": "delegated to subagent",
         "memory": "updated my memory", "rules": "updated my rules",
         "identity": "updated my identity"}

#: The two lines a delegation is bracketed by, written once. Both are said in three places
#: — the line itself, the prefix a repeat is counted under, and the prefix a name is
#: appended to — and a delegation counted under a heading that no longer matches the line
#: above it is a silent break with nothing to see in a diff.
DELEGATED = f"{DID['delegate']} {SHOWN['delegate']}"
FINISHED_HELPER = f"{DID['delegate']} subagent finished"

#: A role is delegation too, and is not a subagent: it runs outside the turn, under rules
#: of its own, and reports back for review. Saying "delegated to subagent" for one would
#: name the wrong mechanism to somebody deciding whether to wait. Told apart by the tool's
#: own name, which is the only thing in the record that differs.
ROLE_TOOL = "role"
HANDED_ON = f"{DID['delegate']} handed to a role"
ROLE_FINISHED = f"{DID['delegate']} role finished"
ROLE_FAILED = f"{DID['delegate']} role did not finish"

#: What a failed tool says without relaying its arguments or result. Those remain in the
#: run account; Discord activity is broad, because a command or path may be private
#: (R-DIS-9, R-DIS-20).
FAILED = {"read": "file read failed", "search": "search failed", "run": "command failed",
          "edit": "file edit failed", "list": "file listing failed",
          "make": "creation failed", "delegate": "subagent failed",
          "memory": "could not update my memory", "rules": "could not update my rules",
          "identity": "could not update my identity"}


def say(**it) -> None:
    """One record, one line, flushed — because rundesk is watching this as it happens."""
    sys.stdout.write(json.dumps(it) + "\n")
    sys.stdout.flush()


def note(said: str, level: str = "WARNING") -> None:
    """Ours, severity stated, kept apart from what we report (R-GW-44)."""
    sys.stderr.write(f"{level}\t{said}\n")
    sys.stderr.flush()


def options(argv) -> argparse.Namespace:
    """What this platform needs, parsed here and nowhere else (R-CAD-13)."""
    said = argparse.ArgumentParser(prog="discord", add_help=False)
    said.add_argument("--bot", metavar="<application id>")
    said.add_argument("--server", metavar="<id>")
    said.add_argument("--channel", metavar="<id>")
    said.add_argument("--dm", action="store_true")
    said.add_argument("--activity", choices=("grows", "posts"), default=None,
                      metavar="<how>")
    said.add_argument("--token-from", default=TOKEN_FROM, metavar="<variable>")
    known, rest = said.parse_known_args(list(argv))
    known.unknown = rest
    return known


def token_for(chose) -> str:
    """The credential, from the variable the owner named or the file they control.

    In that order, and never from anywhere else. An argument is readable through the
    process list; the record rundesk keeps holds the name of this variable and never what
    is in it; and nothing here writes either one down.
    """
    said = os.environ.get(chose.token_from)
    if said:
        return said.strip()
    beside = Path(os.environ.get("RUNDESK_CHANNEL_HOME") or ".") / TOKEN_FILE
    try:
        return beside.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def _plain_name(name: str) -> str:
    """A filename that can only ever be a filename.

    What somebody attached is their text, and a name is the one place a path could be
    smuggled in — so it is rebuilt from what is left rather than trusted after a check.
    """
    kept = "".join(ch if ch.isalnum() or ch in "-_." else "-" for ch in name).strip(".-")
    return kept[-120:] or "attachment"


def _somewhere_new(where: Path, named: str) -> Path:
    """That name in this directory, or the next one along if it is already taken.

    Two files on one message can differ only in a character the rebuilding above has to
    remove — `report v2.csv` and `report-v2.csv` are both `report-v2.csv` — so the second
    was written over the first, and the agent was handed two names that were one file. It
    opened the right name and read the other one's contents (R-CH-17).

    Bounded by what a message may bring in at all: nothing else writes here, and the
    directory is this message's own.
    """
    at, nth = where / named, 1
    stem, dot, rest = named.partition(".")
    while at.exists():
        nth += 1
        at = where / f"{stem}-{nth}{dot}{rest}"
    return at


def clip(text: str, limit: int) -> str:
    return text if len(text) <= limit else text[: limit - 1] + "…"


def split_at(text: str, limit: int):
    """The first message's worth, and the rest — broken at a line where there is one.

    Never cut in silence (R-DIS-13). A break at a newline keeps a code block or a list
    readable; past that a hard cut is the honest answer, because a word that does not fit
    is still a word that has to go somewhere.
    """
    if len(text) <= limit:
        return text, ""
    at = text.rfind("\n", 0, limit)
    if at <= 0:
        return text[:limit], text[limit:]
    return text[:at], text[at + 1:]


def thread_name(text: str) -> str:
    """What a thread opened by being named is called: the first line of what was asked."""
    first = (text.strip().splitlines() or ["rundesk"])[0].strip()
    return clip(first, THREAD_CHARS) or "rundesk"


def _a_direct_message(channel) -> bool:
    """Whether the room being written into is one person's own.

    Asked by `recipient`, which `discord.DMChannel` has and no other channel this surface
    ever writes into does — `TextChannel`, `Thread` and `GroupChannel` all lack it. Not asked
    by `guild`, which every one of them carries and a `DMChannel`'s merely answers `None`, so
    a stand-in that has never heard of guilds would read as a direct message and every room
    would quietly lose its mention.
    """
    return hasattr(channel, "recipient")


def _mentioning(recipient: str, content: str) -> str:
    """The mention on its own line, under the stats line rather than in front of it.

    `-#` is Discord's subtext and it renders only at the *start* of a line. Putting the
    mention first therefore turned the provider-and-cost line every answer carries (R-DIS-17,
    R-DIS-33) into ordinary text with a stray `-#` in it — the one line that is meant to sit
    quietly out of the way became the loudest thing in the message.
    """
    tag = f"<@{recipient}>"
    if not content.startswith("-# "):
        return f"{tag} {content}"
    stats, newline, rest = content.partition("\n")
    return f"{stats}\n{tag} {rest}" if newline else f"{stats}\n{tag}"


def where_to_answer(direct: bool, in_thread: bool, ours: bool, mentioned: bool):
    """Whether this message is for us, and where the answer goes.

    Five cases, and the two that are easy to get wrong are the ones this exists for: an
    agent answering inside somebody else's thread, and an agent opening a thread just to
    say that it stopped.
    """
    if direct:
        return "here"          # nobody else is here, and nowhere to put a thread (R-DIS-4)
    if ours:
        return "here"          # a thread this agent opened is its conversation (R-DIS-3)
    if not mentioned:
        return "ignore"        # silence in a shared channel until named (R-DIS-2)
    if in_thread:
        return "here"          # threads do not nest, so a named message stays put
    return "open-thread"       # named in a channel: the turn happens in a thread (R-DIS-1)


def within(direct: bool, belongs_to, listens_in, dms: bool, a_server=None) -> bool:
    """Whether this is somewhere the owner said this agent listens.

    A thread is asked about by the channel it was opened in, never by its own id: an
    owner confining an agent to one channel means the conversations under it too, and a
    thread is where those conversations happen.

    **A channel that named only direct messages takes only direct messages** (R-CAD-15).
    This went back and forth, and the reason it settled here is that the ground moved
    under it. It was briefly the other way, then briefly this way, then back: while one
    `add` made one channel, a channel pointed at direct messages was the *only* channel,
    and refusing a mention from the one person allowed to make it protected nobody and
    only made them say where twice.

    Now one `add` makes one channel per kind of place, so the direct-message channel is no
    longer the only one — the room has a channel of its own, with its own allowed list.
    Left as it was, both would match a message in a room and the agent would answer it
    twice, from two processes, neither aware of the other. Measured, not feared: with
    `--dm` and `--channel` both given, `within` returned true for the same message on both.

    What naming a place *does* mean is narrowing: `--server` confines to that server and
    `--channel` to that channel, for an owner who wants an agent in one room and not the
    next one along.
    """
    if direct:
        return bool(dms)
    if listens_in:
        return str(belongs_to) == str(listens_in)
    # It named a place, because `--check` refuses a channel that named none — so having
    # named no room, it named direct messages, and this is not one.
    return not dms


class Live:
    """One conversation, and what this agent is showing in it right now."""

    def __init__(self, clock=None):
        self.anchor = None          # the message that asked, for the mark to attach to
        self.activity = ""          # the running commentary, as it stands
        self.activity_groups = []   # adjacent equal lines and how many times each occurred
        self.pending = []           # what has happened since it was last written
        self.tools = {}             # tool id -> broad verb/name, until its result arrives
        self.posted = None          # the message it is growing into, while it is the last
        self.typing = None
        self.pacing = None
        self.marked = False
        self.cost = ""           # what the turn cost, shown with the answer
        self.writes = 0          # which write is the newest, across an await
        self.clock = time.monotonic if clock is None else clock
        self.started = None


class Agent(discord.Client):
    """The gateway connection, held open for as long as this program runs."""

    def __init__(self, chose, **kw):
        intents = discord.Intents.none()
        intents.guilds = True
        intents.guild_messages = True
        intents.dm_messages = True
        # The one intent Discord makes you turn on in the developer portal. Without it
        # every message arrives with empty content and the agent looks deaf.
        intents.message_content = True
        super().__init__(intents=intents, **kw)
        self.chose = chose
        self.live: dict = {}
        #: Presentation state for unattended turns, kept apart from a person whose newer
        #: interactive turn may be running in the same room (R-DIS-35, R-SCH-50).
        self.scheduled: dict = {}
        #: Recent messages by id, so a mark can be put on one without fetching it back.
        #: Bounded, because this process runs for weeks.
        self.seen: dict = {}
        #: Whether the owner has been told this agent came up. Once for this process,
        #: because coming up is what the message says happened (R-DIS-15).
        self.greeted = False
        #: Deferred slash interactions waiting for an authorized read-only answer.
        #: Bounded because the adapter lives for weeks and a broken gateway must not turn
        #: one unanswered interaction into permanent memory.
        self.queries: dict = {}
        #: The message that said a scheduled run had started, by schedule name, so what it
        #: found is posted as a reply to it (R-DIS-30). **Memory only, deliberately**: if
        #: this process goes, the run it was carrying goes with it, so there is no report
        #: left to anchor and nothing durable worth keeping. Bounded like the rest, because
        #: a schedule removed while its notice stood would otherwise never be forgotten.
        self.started: dict = {}
        self.tree = discord.app_commands.CommandTree(self)

    # -- coming up and going down ----------------------------------------------------

    async def setup_hook(self) -> None:
        for name, describes, _control, _said in CONTROL_COMMANDS:
            self.tree.add_command(discord.app_commands.Command(
                name=name, description=describes,
                callback=self._control_command(name), nsfw=False))
        for name, describes, _query in QUERY_COMMANDS:
            self.tree.add_command(discord.app_commands.Command(
                name=name, description=describes,
                callback=self._query_command(name), nsfw=False))
        self.tree.add_command(discord.app_commands.Command(
            name="provider", description="Change this agent's default provider",
            callback=self._provider_command(), nsfw=False))
        # Offered globally *and* to the server it was pointed at: a guild's copy appears
        # at once, where a global one can take an hour to propagate (R-DIS-10).
        with contextlib.suppress(Exception):
            await self.tree.sync()
        if self.chose.server:
            with contextlib.suppress(Exception):
                await self.tree.sync(guild=discord.Object(id=int(self.chose.server)))

    def _control_command(self, control: str):
        async def ran(interaction: discord.Interaction) -> None:
            if not self._owns(interaction):
                return
            # Answered inside the three seconds Discord allows, and answered *only* that
            # it was heard (R-DIS-11, R-DIS-12). What the control did comes back as the
            # turn's own outcome — acknowledging it with the running turn's half-written
            # output is how a half-finished sentence gets published as the reply.
            gesture, said = next(
                (c, s) for n, _d, c, s in CONTROL_COMMANDS if n == control
            )
            with contextlib.suppress(Exception):
                await interaction.response.send_message(said, ephemeral=True)
            say(type="control", conversation=str(interaction.channel_id),
                user=str(interaction.user.id), control=gesture)
        return ran

    def _query_command(self, named: str):
        async def ran(interaction: discord.Interaction) -> None:
            if not self._owns(interaction):
                return
            # Advisory only; Rundesk checks again before answering. This prevents a
            # deferred interaction from hanging forever for somebody Rundesk will
            # correctly answer with silence.
            if self.chose.allow and str(interaction.user.id) not in self.chose.allow:
                with contextlib.suppress(Exception):
                    await interaction.response.send_message(
                        "This command is not available to you.", ephemeral=True
                    )
                return
            query = next(query for name, _description, query in QUERY_COMMANDS
                         if name == named)
            ref = str(interaction.id)
            try:
                await interaction.response.defer(ephemeral=True)
            except Exception as why:  # noqa: BLE001 — a platform boundary
                note(f"could not defer /{named}: {type(why).__name__}: {why}")
                return
            self.queries[ref] = interaction
            while len(self.queries) > SEEN_KEPT:
                self.queries.pop(next(iter(self.queries)))
            say(type="query", conversation=str(interaction.channel_id),
                user=str(interaction.user.id), query=query, ref=ref)
        return ran

    def _provider_command(self):
        @discord.app_commands.describe(
            provider="Provider name or executable adapter path")
        async def ran(interaction: discord.Interaction, provider: str) -> None:
            if not self._owns(interaction):
                return
            if len(self.chose.allow) != 1 or \
                    str(interaction.user.id) != self.chose.allow[0]:
                with contextlib.suppress(Exception):
                    await interaction.response.send_message(
                        "This command is not available to you.", ephemeral=True)
                return
            ref = str(interaction.id)
            try:
                await interaction.response.defer(ephemeral=True)
            except Exception as why:  # noqa: BLE001 — a platform boundary
                note(f"could not defer /provider: {type(why).__name__}: {why}")
                return
            self.queries[ref] = interaction
            while len(self.queries) > SEEN_KEPT:
                self.queries.pop(next(iter(self.queries)))
            say(type="configure", conversation=str(interaction.channel_id),
                user=str(interaction.user.id), provider=provider, ref=ref)
        return ran

    def _owns(self, interaction: discord.Interaction) -> bool:
        """Whether this interaction belongs to this adapter's configured surface.

        One bot may have a DM adapter and a room adapter connected together. Discord
        delivers a slash command to both gateway sessions; only the scoped one may report
        it, or one gesture executes twice (R-DIS-23).
        """
        direct = interaction.guild is None
        if not direct and self.chose.server and str(interaction.guild.id) != \
                str(self.chose.server):
            return False
        at = interaction.channel
        belongs_to = getattr(at, "parent_id", None) \
            if isinstance(at, discord.Thread) else interaction.channel_id
        return within(direct, belongs_to, self.chose.channel, self.chose.dm,
                      self.chose.server)

    async def on_ready(self) -> None:
        # Online for as long as the gateway running this agent is up (R-DIS-16). This
        # program's own lifetime is the signal: rundesk starts it with the agent and ends
        # it with the agent, so tying presence to anything else would say an agent is up
        # when the thing behind it has gone.
        with contextlib.suppress(Exception):
            await self.change_presence(status=discord.Status.online)
        # **The record every time, the message once.** This runs on every connection, not
        # only the first: a session Discord will not resume is a fresh one, and over the
        # weeks a channel is held open that happens on its own. Rundesk wants to hear
        # `ready` each time, which is how a quiet agent is told from a deaf one — but an
        # owner told "the gateway is up" after a blip is told about something that did not
        # happen, and there is no going-down message to pair it with (R-DIS-15).
        say(type="ready")
        # **Once per gateway, not once per adapter.** `self.greeted` is this process's, and
        # an agent reachable both by direct message and in rooms runs *two* of these — so
        # the owner was told the gateway was online twice, a minute apart, which reads as it
        # having restarted in between (R-DIS-15). The claim below is shared by every adapter
        # of one gateway and settled by the filesystem rather than by asking, so two coming
        # up together cannot both win it.
        if not self.greeted and self._claim("online"):
            self.greeted = True
            if _maintenance():
                # **The version, in the ordinary green notice** (R-DIS-26). Every returning
                # gateway sends this one, including after an unattended update no
                # conversation started — so it is the only place an owner is certain to be
                # told which release is now listening, and the only one that can link it.
                landed = _running_release()
                await self._tell_the_owner(
                    f"👋 **I'm back** — new rundesk update installed, "
                    f"release notes for {landed}"
                    if landed else
                    "👋 **I'm back** — new rundesk update installed."
                )
                _finish_maintenance()
            else:
                # Unchanged, deliberately: a reconnection is not a release, and a version
                # offered here would read as one having just been installed.
                await self._tell_the_owner(
                    "🟢 **Gateway online** — rundesk is up and listening."
                )

    def _claim(self, what: str) -> bool:
        """True for exactly one adapter of this gateway, and false for every other.

        **Settled by the filesystem, not by asking.** Two adapters coming up together would
        both read "nobody has greeted yet" and both greet; creating a file that must not
        already exist is one operation the machine decides, so exactly one of them wins it.

        The claim lives in the directory rundesk hands every adapter of one agent, but is
        named for the gateway lifetime rundesk also hands it. The directory deliberately
        survives a stop because it carries the gateway lock and record; a static marker
        there silenced every successor after the first. A reconnect keeps the same lifetime
        and stays quiet, while a real restart gets a fresh claim.

        A machine that will not let it be written is answered `True` — being told once too
        often is a smaller failure than never being told a gateway came up at all.
        """
        home = os.environ.get("RUNDESK_HOME")
        gateway = os.environ.get("RUNDESK_GATEWAY")
        if not home or not gateway:
            return True
        gateway = "".join(char for char in gateway if char.isalnum() or char in "-_")
        if not gateway:
            return True
        marker = Path(home) / f".said-{what}-{gateway}"
        try:
            os.close(os.open(marker, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
        except FileExistsError:
            return False
        except OSError:
            return True
        # Only the winner cleans up predecessor claims. Two adapters racing for this
        # gateway cannot remove each other's current marker, and old releases' static
        # marker is included so updating repairs the next real startup.
        for old in Path(home).glob(f".said-{what}*"):
            if old != marker:
                with contextlib.suppress(OSError):
                    old.unlink()
        return True

    async def _tell_the_owner(self, said: str, who: str | None = None) -> None:
        """R-DIS-15, R-DIS-39 — one person hears about it privately, wherever they are.

        The first allowed user is the owner; the rest are guests. A notice that names
        somebody goes to *that* person instead — which is how a newly allowed user is
        introduced to the agent (R-CH-33) — and one naming somebody this channel does not
        allow is refused here as well as above, the same rule a direct-message place is
        held to (R-CAD-16). A bot that would DM any snowflake it was handed is one bug
        away from messaging a stranger.

        Failures are said out loud rather than swallowed: a greeting that silently never
        arrives is indistinguishable from an agent that never came up, which is the one
        thing this message exists to tell apart.
        """
        if not self.chose.allow:
            note("nobody to greet — RUNDESK_ALLOW is empty")
            return
        if who is not None and who not in self.chose.allow:
            note(f"not telling {who}, who this channel does not allow")
            return
        who = who or self.chose.allow[0]
        try:
            person = await self.fetch_user(int(who))
            await person.send(said)
        except Exception as why:  # noqa: BLE001 — a platform boundary
            note(f"could not tell the owner ({who}): {type(why).__name__}: {why}")
        else:
            # Said on success as well as on failure. "It reported nothing" was read as
            # "it worked" for three restarts running, and the two are only the same
            # thing when success has a line of its own.
            note(f"told the owner ({person}): {said.splitlines()[0]}", "INFO")

    async def going(self) -> None:
        # **Bounded, and before the close rather than instead of it.** This had the whole
        # goodbye budget to itself, so an owner who could not be reached — a fetch and a
        # send, with the library's own rate-limit waits behind them — spent all of it and
        # the close below was never reached at all (R-DIS-16).
        # The same once-per-gateway rule on the way out, and for a worse reason than tidiness:
        # two goodbyes for one shutdown read as two gateways, and an owner counting them is
        # counting wrong. Claimed separately from the greeting so that an adapter which came
        # up second — and therefore said no hello — is still able to say the goodbye if it is
        # the one that gets there first.
        if self._claim("offline"):
            with contextlib.suppress(BaseException):
                await asyncio.wait_for(
                    self._tell_the_owner(
                        "🛠️ **Installing an update** — I'm installing the new rundesk "
                        "update, be back shortly."
                        if _maintenance() else
                        "🔴 **Gateway offline** — rundesk has shut down."
                    ),
                    TELLING_SECONDS)
        for held in self.live.values():
            for task in (held.typing, held.pacing):
                if task is not None:
                    task.cancel()
        # Deliberately not marked invisible first: announcing it races a replacement
        # instance and leaves a working gateway looking dead.
        with contextlib.suppress(Exception):
            await self.close()

    # -- what arrives ----------------------------------------------------------------

    async def on_message(self, message: discord.Message) -> None:
        if message.author.bot:
            return
        direct = message.guild is None
        if not direct and self.chose.server and str(message.guild.id) != str(self.chose.server):
            return
        in_thread = isinstance(message.channel, discord.Thread)
        ours = in_thread and message.channel.owner_id == (self.user.id if self.user else None)
        mentioned = bool(self.user and self.user in message.mentions)
        where = where_to_answer(direct, in_thread, ours, mentioned)
        if where == "ignore":
            return
        # A thread belongs to the channel it was opened in, and that is what an owner
        # confined this agent to. Asked of the thread's own id, the restriction matched
        # nothing and was skipped for every thread in the server — so an agent told to
        # listen in one channel would answer in a thread under any of them.
        belongs_to = message.channel.parent_id if in_thread else message.channel.id
        if not within(direct, belongs_to, self.chose.channel, self.chose.dm,
                      self.chose.server):
            return
        # **Nothing expensive or visible before this.** Whether somebody may be answered
        # is rundesk's to decide and it still decides it — but a message from anybody at
        # all used to open a real thread and pull down as much as three hundred megabytes
        # first, so any member of a shared server could make this agent litter their
        # channel and fill a disk without ever being allowed to say a word to it. Rundesk
        # would then drop the message in silence, which is the whole point, while the
        # thread it had already opened said the opposite out loud.
        #
        # This is not the authorization: it is refusing to *work* for somebody who cannot
        # be answered. The decision that matters is still made once, over there.
        if self.chose.allow and str(message.author.id) not in self.chose.allow:
            return
        text = _without_mentions(message.content, self.user.id if self.user else None)
        brought = await self._fetch(message)
        if not text and not brought:
            return
        conversation = message.channel.id
        if where == "open-thread":
            opened = await self._open(message, text)
            conversation = opened if opened is not None else message.channel.id
        # **Not the anchor.** Every message was made the anchor here, so a second one
        # sent while a turn was still running took the ✅ that belonged to the message
        # that asked for it. Which message a turn is *for* is rundesk's to say, and it
        # says so with the `ref` on the state — all this has to do is be able to find it.
        # Somebody has spoken here, so whatever commentary was growing is no longer the
        # last thing in the conversation and must not be edited again.
        self._no_longer_last(self.live.setdefault(str(conversation), Live()))
        while len(self.live) > LIVE_KEPT:
            # Bounded for the same reason `seen` is, and it was not: an entry is made for
            # every conversation and removed only when a turn ends in it, so anything
            # that never reached a turn stayed for the life of the process.
            if not self._make_room(str(conversation)):
                break
        self.seen[str(message.id)] = message
        while len(self.seen) > SEEN_KEPT:
            self.seen.pop(next(iter(self.seen)))
        say(type="arrived", conversation=str(conversation), user=str(message.author.id),
            text=text, ref=str(message.id), direct=direct, attachments=brought,
            where=_place(message, direct, in_thread), called=_who(message),
            prompt_replaces=LEGACY_INSTRUCTIONS[DMS if direct else ROOMS],
            parts=_parts(message, direct, in_thread),
            **({"reply_to": reply} if (reply := _reply_to(message)) else {}),
            **_prompt_context(message, direct, in_thread))

    async def _fetch(self, message: discord.Message) -> list:
        """Put whatever somebody attached where the agent can read it (R-CH-17).

        Onto this machine rather than passed on as a link: the brain that will read it
        runs here, holds no credential for this platform, and handing it a URL would be
        handing it an instruction to go and fetch something on a stranger's say-so.

        Bounded on both count and size. A chat platform will accept far more than a turn
        can use, and an agent's own directory is not somewhere anybody who can send it a
        message gets to fill.
        """
        if not message.attachments:
            return []
        where = Path(os.environ.get("RUNDESK_CHANNEL_HOME") or ".") / "attachments" \
            / str(message.id)
        brought = []
        for one in message.attachments[:ATTACHED_MOST]:
            if one.size and one.size > ATTACHED_BYTES:
                note(f"{one.filename} is too big to bring in ({one.size} bytes)")
                continue
            try:
                where.mkdir(parents=True, exist_ok=True)
                # Named by us from its own name, never by the name it arrived under: a
                # filename is somebody else's text, and a path is a thing it must not be
                # able to become. Two of them rebuilt to the same name is one file, so
                # the second goes beside the first rather than over it.
                at = _somewhere_new(where, _plain_name(one.filename))
                await one.save(at)
                brought.append({"name": one.filename, "at": str(at)})
                note(f"brought in {one.filename} -> {at}", "INFO")
            except Exception as why:  # noqa: BLE001 — a platform boundary
                note(f"could not bring in {one.filename}: {why}")
        return brought

    async def _open(self, message: discord.Message, text: str):
        """A thread for this turn, or None if the platform would not give us one.

        Degrades rather than refuses: answering in the channel is worse than answering in
        a thread and far better than not answering (R-CAD-5).
        """
        try:
            made = await message.create_thread(name=thread_name(text))
            return made.id
        except Exception as why:  # noqa: BLE001 — a platform boundary
            note(f"could not open a thread: {why}")
            return None

    # -- what rundesk says -----------------------------------------------------------

    async def told(self, it: dict) -> None:
        """One record from rundesk, shown the way this platform shows things.

        What arrived, and what came of it, both said. A record that is received and then
        does nothing is indistinguishable from one that never arrived, and the two need
        entirely different fixes — so neither is left to be inferred.
        """
        kind = it.get("type")
        # Answered before anything is kept for a conversation, because this one has none:
        # it is about the agent and not about a turn, and a place held under an absent
        # conversation is a live exchange nobody is in.
        if kind == "owner-notice":
            # Split like anything else Discord is given: a catalog removal takes away
            # every skill it brought at once, and a notice over the limit is refused
            # outright rather than shortened (R-DIS-13).
            # Whoever it names, and otherwise the owner. An introduction is for the person
            # who has just arrived and for nobody else (R-DIS-39); a gateway notice names
            # no one and reaches the first allowed user, exactly as it always has.
            who = str(it.get("user") or "") or None
            rest = str(it.get("text") or "")
            while rest:
                piece, rest = split_at(rest, LIMIT)
                await self._tell_the_owner(piece, who)
            return
        if kind in ("state", "answer"):
            note(f"told {kind}"
                 f"{'/' + str(it.get('state')) if kind == 'state' else ''}"
                 f" for {it.get('conversation')}"
                 f" ({len(str(it.get('text') or ''))} chars,"
                 f" {len(it.get('attachments') or [])} files)", "INFO")
        named = str(it.get("schedule") or "")
        if named:
            scheduled = getattr(self, "scheduled", None)
            if scheduled is None:
                scheduled = self.scheduled = {}
            held = scheduled.setdefault(named, Live())
        else:
            held = self.live.setdefault(str(it.get("conversation")), Live())
        if kind == "state":
            await self._state(it, held)
        elif kind == "answer":
            if named:
                held.anchor = self.started.pop(named, None)
            await self._answer(it, held)
            if named:
                self.scheduled.pop(named, None)
        elif kind == "query-result":
            await self._query_result(it)
        elif kind == "configure-result":
            await self._configuration_result(it)
        elif kind == "said":
            # A queued terminal notice may race with a new turn admitted after reconnect.
            # Remember that turn before the notice briefly stops its indicator below.
            turn_was_running = (
                held.started is not None
                or held.typing is not None
                or held.pacing is not None
            )
            # A finished thing the agent said while it was still working, in a message of
            # its own. Not the answer and not anchored to anything: it is a remark, and
            # quoting the question on every remark buries the question.
            # Cancelled first, the way ending a turn does it. Left running, a paced
            # flush already suspended inside a write would finish *after* this one had
            # buried the message, and its assignment would put the buried message back —
            # so the next line grew into something nobody could see.
            if held.pacing is not None:
                held.pacing.cancel()
                held.pacing = None
            # A remark is something to read too, so stop claiming to be typing while
            # somebody is reading it — the next thing said starts the indicator again.
            self._stop_typing(held)
            await self._flush(it, held)
            # **A scheduled run's two messages, joined** (R-SCH-46, R-DIS-30). A remark
            # naming a schedule is either that run saying it has begun — held, so what it
            # finds can quote it — or the report itself, which replies to whatever is being
            # held under that name. Everything else is an ordinary remark and anchors to
            # nothing, because quoting the question on every remark buries the question.
            began = bool(it.get("began"))
            anchor = None if began else (self.started.pop(named, None) if named else None)
            rest, notice = str(it.get("text") or ""), None
            while rest:
                piece, rest = split_at(rest, LIMIT)
                posted = await self._post(it, piece, anchor=anchor)
                notice = posted if notice is None else notice
                anchor = None
            if began and named and notice is not None:
                self._holding(named, notice)
            self._no_longer_last(held)
            # **And start again only when a turn continues.** Ordinary remarks are said
            # while work is still running, so their indicator resumes without another
            # state record. A terminal notice arrives outside any turn and has no final
            # state coming behind it; restarting here would claim work was happening for
            # ever (R-DIS-35).
            if named and not began:
                self.scheduled.pop(named, None)
            elif it.get("continues", True) or turn_was_running:
                held.typing = held.typing or asyncio.ensure_future(self._typing(it))
            else:
                self.live.pop(str(it.get("conversation")), None)
        elif kind in ("think", "tool", "result", "usage"):
            await self._doing(it, held)

    def _holding(self, named: str, message) -> None:
        """Keep what was posted to say a schedule started, until its report replies to it
        (R-DIS-30).

        Newest wins for a name, which is what a schedule firing again after its last notice
        was answered leaves behind. Bounded like `seen` and `live`, because this process
        runs for weeks and a schedule taken away mid-run would otherwise be remembered for
        the whole of it.
        """
        self.started[named] = message
        while len(self.started) > SEEN_KEPT:
            self.started.pop(next(iter(self.started)))

    async def _query_result(self, it: dict) -> None:
        """Complete the exact deferred interaction that asked, and nowhere public."""
        interaction = self.queries.pop(str(it.get("ref")), None)
        if interaction is None:
            note(f"no deferred interaction for {it.get('query')}")
            return
        try:
            rest = str(it.get("text") or "No information available.")
            piece, rest = split_at(rest, LIMIT)
            await interaction.edit_original_response(content=piece)
            while rest:
                piece, rest = split_at(rest, LIMIT)
                await interaction.followup.send(content=piece, ephemeral=True)
        except Exception as why:  # noqa: BLE001 — a platform boundary
            note(f"could not answer /{it.get('query')}: {type(why).__name__}: {why}")

    async def _configuration_result(self, it: dict) -> None:
        """Complete the exact private interaction that requested a provider change."""
        interaction = self.queries.pop(str(it.get("ref")), None)
        if interaction is None:
            note("no deferred interaction for provider configuration")
            return
        try:
            await interaction.edit_original_response(
                content=clip(str(it.get("text") or "Provider was not changed."), LIMIT)
            )
        except Exception as why:  # noqa: BLE001 — a platform boundary
            note(f"could not answer /provider: {type(why).__name__}: {why}")

    async def _state(self, it: dict, held: Live) -> None:
        state = it.get("state")
        if state == "taken":
            # The adapter owns the visible duration and starts it when the seam says the
            # turn was taken. A monotonic clock cannot jump when the wall clock does, and
            # a repeated record cannot restart the measurement (R-DIS-24).
            if held.started is None:
                held.started = held.clock()
            # 👀 the moment it is heard, and typing straight after. This is the mark that
            # matters most: everything else can be late, and this one is the difference
            # between an agent that is working and one that is broken (R-DIS-5).
            await self._react(it, held, SEEN)
            held.typing = held.typing or asyncio.ensure_future(self._typing(it))
            return
        if state == "running":
            held.typing = held.typing or asyncio.ensure_future(self._typing(it))
            return
        if state in MARKS:
            for task in (held.typing, held.pacing):
                if task is not None:
                    task.cancel()
            held.typing = held.pacing = None
            await self._flush(it, held)
            self._no_longer_last(held)
            if state == "failed" and it.get("why"):
                await self._post(it, f"-# ⚠ {clip(str(it['why']), 400)}")
            await self._react(it, held, MARKS[state], instead_of=SEEN)
            self.live.pop(str(it.get("conversation")), None)

    async def _typing(self, it: dict) -> None:
        """Kept alive for as long as the turn runs (R-DIS-6). Discord's indicator lapses
        in about ten seconds, so it is renewed inside that rather than set once.

        **Fetched, not just looked up.** `get_channel` reads the client's cache, and a
        direct message is very often not in it — so it answered `None`, the loop below never
        ran once, and there was no typing indicator in a DM at all, ever. Nothing reported
        it: the task was created, returned immediately, and a `held.typing` that is a
        finished task looks exactly like one that is working. `_react` twenty lines down has
        always fetched as a fallback, which is what makes this one an omission rather than a
        decision.

        Said out loud when the channel cannot be resolved at all, because a turn with no
        indicator and no line saying why is the shape this bug already had once.
        """
        where = int(it["conversation"])
        channel = self.get_channel(where)
        if channel is None:
            try:
                channel = await self.fetch_channel(where)
            except Exception as why:  # noqa: BLE001 — a platform boundary
                note(f"no typing indicator for {where}: {type(why).__name__}: {why}")
                return
        while True:
            with contextlib.suppress(Exception):
                await channel.typing()
            await asyncio.sleep(TYPING_SECONDS)

    async def _react(self, it: dict, held: Live, mark: str, instead_of=None) -> None:
        """One mark at a time (R-DIS-8). 👀 means "working on it", and leaving it up
        beside ✅ says the opposite of what happened."""
        # The ref rundesk gave, first and always: it names the message that asked for
        # this turn, whatever has been said since.
        ref = it.get("ref")
        message = self.seen.get(str(ref)) if ref else None
        if message is None and ref:
            with contextlib.suppress(Exception):
                channel = self.get_channel(int(it["conversation"])) \
                    or await self.fetch_channel(int(it["conversation"]))
                message = await channel.fetch_message(int(ref))
        if message is None:
            message = held.anchor
        if message is None:
            return
        held.anchor = message
        with contextlib.suppress(Exception):
            await message.add_reaction(mark)
        if instead_of:
            with contextlib.suppress(Exception):
                await message.remove_reaction(instead_of, self.user)

    async def _doing(self, it: dict, held: Live) -> None:
        """What the agent did, shown as the owner asked for it to be (R-DIS-20).

        What it cost is kept either way, because it goes above the answer whatever else
        is shown. The rest is only worth a message if somebody asked to watch: a phone
        that buzzes eleven times to say an agent read a file is worse than one that
        buzzes once with the reply.
        """
        if it.get("type") == "usage":
            held.cost = _as_a_line(it) or held.cost
            return
        if self.chose.activity == OFF:
            return
        line = _activity_line(it, held.tools)
        if not line:
            return
        held.pending.extend(one for one in line.splitlines() if one.strip())
        if held.pacing is None or held.pacing.done():
            held.pacing = asyncio.ensure_future(self._paced(it, held))

    async def _paced(self, it: dict, held: Live) -> None:
        """A burst of tools is one write rather than ten (R-DIS-14)."""
        await asyncio.sleep(GROW_SECONDS if self.chose.activity == GROWS else POST_SECONDS)
        await self._flush(it, held)
        # A record can arrive while Discord is awaiting the post/edit above. At that point
        # `_doing` sees this task as still live, so it cannot own another one. Take
        # responsibility for anything that arrived during the write before this task ends.
        if held.pending:
            held.pacing = asyncio.ensure_future(self._paced(it, held))

    async def _flush(self, it: dict, held: Live) -> None:
        """Write whatever has happened since the last time, the way this owner asked.

        `grows` edits one message, so a turn reads as a single thing happening. `posts`
        starts a new one each time, which is what a surface that cannot edit would have
        to do — and which is why the message being edited is *never* the answer: a reply
        that rewrites itself in place is unreadable, and only the commentary may.
        """
        pending, held.pending = held.pending, []
        if not pending:
            return
        if self.chose.activity == POSTS:
            await self._post(it, _render_activity(_group_activity([], pending)))
            return
        # **Only while it is still the last thing in the conversation.** A message that
        # something has been posted under is one the reader has already scrolled past, and
        # editing it changes history rather than showing progress — the new line appears
        # above whatever came after it, where nobody is looking. So anything else being
        # said starts a fresh one, and this grows only for as long as it is the newest
        # thing there (R-DIS-20).
        if held.posted is None:
            held.activity_groups = []
        held.activity_groups = _group_activity(held.activity_groups, pending)
        held.activity, held.activity_groups = _bounded_activity(held.activity_groups)
        if held.posted is None:
            # Which write this was, kept across the await. Something else may bury the
            # commentary while this is in flight, and a write that comes back afterwards
            # must not put the buried message back for the next line to grow into.
            mine = held.writes = held.writes + 1
            said = await self._post(it, held.activity)
            if mine == held.writes:
                held.posted = said
            return
        try:
            await held.posted.edit(content=held.activity)
        except Exception as why:  # noqa: BLE001 — a platform boundary
            note(f"could not grow the commentary: {why}")
            held.posted = None   # start a fresh one rather than keep failing on this

    def _no_longer_last(self, held: Live) -> None:
        """Something else has been said here, so the commentary stops growing.

        Called wherever a message that is not the commentary is posted, and when somebody
        speaks: both put something under it, and both mean the next thing to show belongs
        in a message of its own.
        """
        held.posted = None
        held.activity = ""
        held.activity_groups = []
        if held.pending and held.pending[-1] is not None:
            # Activity already waiting to be written belongs before this visible message.
            # It may still be posted afterwards, but what follows must start a new count.
            held.pending.append(None)
        # Anything already in flight is no longer the newest, so its result is dropped
        # rather than becoming the message the next line grows into.
        held.writes += 1

    def _make_room(self, keeping: str) -> bool:
        """Drop one conversation, and never one with a turn still running in it.

        Says whether it found one to drop, so a caller making room cannot spin on a
        conversation it is not allowed to take.

        The oldest *entered* one went, whatever was happening in it — and an entry is
        where that turn's typing and pacing tasks are held, so dropping it left nobody to
        cancel them: the indicator went on renewing in that conversation for the rest of
        this process's life, which is weeks (R-CH-11). Idle ones first, and whatever has
        to go is cancelled on the way out rather than merely forgotten.
        """
        idle = [at for at, held in self.live.items()
                if at != keeping and held.typing is None and held.pacing is None]
        going = idle[0] if idle else next(
            (at for at in self.live if at != keeping), None)
        if going is None:
            return False
        held = self.live.pop(going)
        for task in (held.typing, held.pacing):
            if task is not None:
                task.cancel()
        return True

    def _stop_typing(self, held: Live) -> None:
        """Stop saying it is working, the moment there is something to read.

        Cancelled when the turn *ended*, which is one record too late: the answer is
        handed over first, so the loop could renew once more in between and Discord holds
        an indicator for about ten seconds after the last renewal. So it went on saying
        the agent was typing while the reply was already sitting there.
        """
        if held.typing is not None:
            held.typing.cancel()
            held.typing = None

    async def _answer(self, it: dict, held: Live) -> None:
        """The answer, whole, at the end — split across messages rather than cut.

        Anchored to the message that asked (R-DIS-28), or to a schedule's start notice
        (R-DIS-30), so it is findable in a busy channel. Only the first piece carries the
        anchor, because a quote on every piece buries what it is quoting.

        **And it mentions whoever asked** (R-DIS-31). A message that mentions you is drawn
        by *your own* client with a tint across the whole row — the avatar and the name
        inside it — which is a thing no bot can draw for itself and the only way the report
        somebody is waiting for stops looking like the bookkeeping in front of it. So it is
        this one message and nothing else rundesk posts: commentary, a remark said mid-turn,
        a state mark and a schedule's start notice all go through `_post` too, and a surface
        where everything is tinted has tinted nothing. An interactive answer mentions the
        asker through its reply; a scheduled answer explicitly mentions the single authorized
        recipient because its reply anchor was written by rundesk itself (R-SCH-50).
        """
        # The provider and cost first, then the answer, in one message (R-DIS-17,
        # R-DIS-33). At the top rather than the bottom because a long answer pushes
        # anything after it off a phone screen, and which brain ran the turn and what it
        # cost are worth seeing without scrolling.
        self._stop_typing(held)
        self._no_longer_last(held)
        whole = str(it.get("text") or "")
        footer = held.cost
        provider_name = it.get("provider")
        if isinstance(provider_name, str) and provider_name:
            footer = (f"-# {provider_name}{footer[2:]}"
                      if footer.startswith("-# ·") else f"-# {provider_name}")
        elapsed_seconds = it.get("elapsed")
        if not isinstance(elapsed_seconds, (int, float)) and held.started is not None:
            elapsed_seconds = held.clock() - held.started
        if isinstance(elapsed_seconds, (int, float)):
            elapsed = f"{_duration(elapsed_seconds)} elapsed"
            footer = f"{footer} · {elapsed}" if footer else f"-# · {elapsed}"
        if footer:
            whole = f"{footer}\n{whole}"
        files = [one for one in (it.get("attachments") or [])
                 if isinstance(one, dict)]
        # Past a certain length an answer is a document rather than a message, and a
        # dozen numbered fragments is not something anybody reads (R-DIS-13).
        recipient = str(it.get("recipient") or "")
        mention = (recipient if it.get("schedule") and recipient.isdigit()
                   else held.anchor is not None and not it.get("schedule"))
        if len(whole) > LIMIT * ATTACH_AFTER:
            await self._post(it, f"{footer}\n-# the answer is long, so it is attached"
                             .strip(), anchor=held.anchor, files=files, text_as=whole,
                             mention=mention)
            return
        rest, anchor = whole, held.anchor
        while rest:
            piece, rest = split_at(rest, LIMIT)
            # **Once, on the piece carrying the anchor** (R-DIS-13, R-DIS-31). The mention
            # is the reply, so it goes exactly where the reply goes: a long answer that
            # mentioned on every piece would be five notifications for one reply.
            await self._post(it, piece, anchor=anchor, mention=mention,
                             files=files if not rest else [])
            anchor = None
            mention = False

    async def _where_to_write(self, it: dict):
        """The room to write in: the place rundesk was told to say it in, or the conversation.

        **A place is a word rundesk carried and never read** — `#operations`, a room id — so
        resolving it is ours, and it is the only way to reach a room nobody has spoken in yet:
        rundesk has no conversation for one, so it has nothing to hand us but the word
        (R-CAD-16). A place we cannot find falls back to the conversation rather than failing,
        because a report in the wrong room beats a report nowhere; it is said out loud so
        nobody has to wonder which happened.

        **A refusal is not a typo, and must not read like one.** "Could not find" points an
        owner at a wrong-id hunt; when the id was found and declined, saying so is the
        difference between a one-line fix and the misdiagnosis this path exists to end.
        """
        place = it.get("place")
        if place:
            found, why = await self._room_named(str(place))
            if found is not None:
                return found
            note(why or f"could not find '{place}' on this surface — "
                        f"saying it in the conversation instead")
        at = it.get("conversation")
        if at is None:
            return None
        channel = self.get_channel(int(at))
        if channel is None:
            with contextlib.suppress(Exception):
                channel = await self.fetch_channel(int(at))
        return channel

    async def _room_named(self, said: str):
        """One room, by the word an owner wrote for it: an id, or a name with or without its
        hash. Confined to the server this channel is for, where it is for one.

        **Waits for the connection first.** What rooms exist is Discord's cache, and it is
        empty until the gateway has finished handshaking and sent them — so a schedule due in
        the first seconds of a gateway's life resolved nothing and posted nowhere, while the
        same schedule a minute later worked. It read as a bad room name and was a cold cache.
        Bounded, because a client that never connects must not hold a delivery for ever; the
        turn is long over by here and nothing is waiting on it (R-CH-12).

        **A direct-message place may be a person, not a channel (R-CAD-16).** The id an owner
        already typed for `--allow` is a *user* snowflake. A DM channel snowflake is a different
        number that only appears after someone has already spoken — and is different again for
        every bot, so copying Winston's place onto Markus (or guessing from the allow list)
        cannot work. `_tell_the_owner` already opens a DM from a user id; schedule delivery
        used only `fetch_channel`, so a user-id `--in` logged "could not find" and posted
        nowhere. On a DM channel, try channel first (already-known DM), then authorized user.

        Answers with the room and, when there is none, why — so the one caller can tell a
        word it could not find from a person it declined to message.
        """
        with contextlib.suppress(asyncio.TimeoutError):
            await asyncio.wait_for(self.wait_until_ready(), READY_SECONDS)
        digits = said.lstrip("#")
        if digits.isdigit():
            with contextlib.suppress(Exception):
                found = await self.fetch_channel(int(digits))
                if found is not None:
                    return found, None
            # Only on the direct-message surface, and only for someone this channel already
            # authorizes: a room channel must not open a private message because a snowflake
            # failed as a room, and a schedule must not DM a stranger (R-CH-4, R-CAD-16).
            if getattr(self.chose, "dm", False):
                allowed = {str(one) for one in (self.chose.allow or ())}
                if digits not in allowed:
                    return None, (f"'{said}' is not on this channel's allowed list — "
                                  f"saying it in the conversation instead")
                with contextlib.suppress(Exception):
                    person = await self.fetch_user(int(digits))
                    return await person.create_dm(), None
            return None, None
        for guild in self.guilds:
            if self.chose.server and str(guild.id) != str(self.chose.server):
                continue
            for room in getattr(guild, "text_channels", ()):
                if room_matches(said, getattr(room, "name", "")):
                    return room, None
        return None, None

    async def _post(self, it: dict, content: str, anchor=None, files=(), text_as=None,
                    mention=False):
        """One message, and never at the turn's expense: a delivery that fails is written
        to our own stderr and the turn goes on (R-CH-12).

        **`mention` is off unless a caller asks for it, and only `_answer` does** (R-DIS-31).
        Everything this surface writes comes through here — the running commentary, a remark
        said mid-turn, a state mark, a schedule's start notice — and the tint an owner is
        being given is worth something only while it means *this is the answer*.
        """
        channel = await self._where_to_write(it)
        if channel is None:
            note(f"nowhere to write in {it.get('place') or it.get('conversation')}")
            return
        # **Only if it is in the same place** (R-DIS-28). Being named in a channel opens a
        # thread and the turn happens there, while the message that asked is still sitting
        # in the channel above it — so quoting it made Discord refuse the whole message,
        # and a turn ended with a ✅ on the question and no answer under it.
        #
        # Read off `channel.id`, never `channel_id`: a `discord.Message` has no such
        # attribute, so this guard compared `""` to the conversation, was true of every
        # message that ever reached it, and dropped every anchor there has ever been —
        # the feature it exists to protect had therefore never once happened.
        #
        # Compared against the room actually resolved above, not against `conversation`.
        # The two are the same room in every case that had an anchor before — but a
        # schedule reporting into a place rundesk has never seen a word in sends no
        # conversation at all, only the word, so the old comparison dropped the notice
        # this report is a reply to on exactly the delivery that needed it (R-DIS-30).
        anchor_in = getattr(getattr(anchor, "channel", None), "id", "")
        if anchor is not None and str(anchor_in) != str(getattr(channel, "id", "")):
            anchor = None
        sending = []
        try:
            for attachment in files:
                try:
                    ready = await asyncio.to_thread(_outbound_attachment, attachment)
                except Exception as why:  # noqa: BLE001 — an adapter boundary
                    note(f"could not attach: {type(why).__name__}: {why}")
                    continue
                if ready:
                    sending.append(ready)
            if text_as is not None:
                sending.append(discord.File(io.BytesIO(text_as.encode("utf-8")),
                                            filename="answer.md"))
            # **The quote never costs the answer** (R-DIS-1, R-DIS-28). discord.py builds
            # the reference without `fail_if_not_exists`, so Discord's own default applies:
            # a message quoting one it can no longer resolve is refused outright, and the
            # answer is lost to a line on our own stderr. The asker deleting their question
            # is enough, and a turn here runs for minutes. Off, Discord drops the quote and
            # still posts.
            quoting = None if anchor is None else anchor.to_reference(fail_if_not_exists=False)
            # **An ordinary mention is the reply's** (R-DIS-31).
            # `mention_author` is Discord's `allowed_mentions.replied_user`, which names the
            # author of the message being replied to — so it can only reach somebody through
            # `quoting`, and the guard above drops an anchor standing in another room. Asked
            # of `quoting` rather than of `anchor` for exactly that: an answer whose question
            # is somewhere else quotes nobody and must therefore mention nobody.
            mention_recipient = mention if isinstance(mention, str) and mention.isdigit() else ""
            if mention_recipient and _a_direct_message(channel):
                # Both halves, not only the tag: `mention_author` would otherwise turn back
                # on here and ping the *notice's* author, which for a schedule is rundesk.
                # **Nobody needs telling they are the only reader** (R-DIS-31). The tint
                # exists to pick one message out of a busy room. A direct message has one
                # human in it and every message in it is already theirs, so the mention buys
                # no attention there and spends a notification to buy it.
                mention, mention_recipient = False, ""
            if mention_recipient:
                # A schedule's anchor is rundesk's own notice, so mentioning the reply author
                # would ping the bot and leave the owner untinted. The core supplies the one
                # authorized recipient only where the channel has exactly one (R-SCH-50).
                content = _mentioning(mention_recipient, content)
            try:
                said = await channel.send(
                    content,
                    reference=quoting,
                    mention_author=(bool(mention) and not mention_recipient
                                    and quoting is not None),
                    files=sending or None,
                )
                note(f"wrote {len(content)} chars and {len(sending)} files", "INFO")
                return said
            except Exception as why:  # noqa: BLE001 — a platform boundary
                note(f"could not write: {type(why).__name__}: {why}")
        finally:
            # discord.File deliberately does not own file-like objects. These snapshots
            # are ours, so close them after the upload attempt succeeds or fails.
            for attached in sending:
                opened = attached.fp
                with contextlib.suppress(Exception):
                    attached.close()
                with contextlib.suppress(Exception):
                    opened.close()
        return None


def _outbound_attachment(attachment):
    """Open, verify, and snapshot exactly the bytes core approved for delivery."""
    at = attachment.get("at")
    expected_size = attachment.get("bytes")
    expected_digest = attachment.get("sha256")
    if (not isinstance(at, str) or not isinstance(expected_size, int)
            or isinstance(expected_size, bool) or expected_size < 0
            or expected_size > ATTACHED_BYTES
            or not isinstance(expected_digest, str)
            or re.fullmatch(r"[0-9a-f]{64}", expected_digest) is None):
        note(f"could not attach {at}: missing or invalid verification")
        return None
    snapshot = tempfile.TemporaryFile()
    digest = hashlib.sha256()
    size = 0
    directory = None
    descriptor = None
    try:
        path = Path(at)
        if not path.is_absolute() or not path.parts[1:]:
            raise OSError("not an absolute file")
        directory = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        for part in path.parts[1:-1]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=directory)
            os.close(directory)
            directory = child
        descriptor = os.open(
            path.parts[-1], os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW,
            dir_fd=directory,
        )
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise OSError("not a regular file")
        with os.fdopen(descriptor, "rb") as source:
            descriptor = None
            while block := source.read(min(1024 * 1024, ATTACHED_BYTES + 1 - size)):
                size += len(block)
                if size > ATTACHED_BYTES:
                    break
                digest.update(block)
                snapshot.write(block)
    except (OSError, ValueError) as why:
        note(f"could not attach {at}: {why}")
        snapshot.close()
        return None
    finally:
        if directory is not None:
            os.close(directory)
        if descriptor is not None:
            os.close(descriptor)
    if size != expected_size or digest.hexdigest() != expected_digest:
        note(f"could not attach {at}: file changed after validation")
        snapshot.close()
        return None
    snapshot.seek(0)
    try:
        return discord.File(snapshot, filename=Path(at).name)
    except (OSError, ValueError) as why:
        note(f"could not attach {at}: {why}")
        snapshot.close()
        return None


def _place(message, direct: bool, in_thread: bool) -> str:
    """What Discord calls the place this was said, as a person reading it would say it.

    For the agent's own benefit, not for routing: where an answer goes is decided from the
    conversation id and never from this. A snowflake told a brain nothing, so it answered a
    room of forty people in exactly the voice it used for a direct message.
    """
    if direct:
        return "a direct message"
    where = message.channel
    named = getattr(where, "name", None)
    # Whether this is a thread is what the caller already worked out to decide whether to
    # answer at all — asked again here it would be a second answer to the same question,
    # and the two would drift.
    if in_thread:
        under = getattr(where.parent, "name", None)
        said = f"the thread '{named}'" if named else "a thread"
        said += f" under #{under}" if under else ""
    else:
        said = f"#{named}" if named else "a channel"
    server = getattr(getattr(message, "guild", None), "name", None)
    return f"{said} on the '{server}' server" if server else said


def _parts(message, direct: bool, in_thread: bool) -> dict:
    """The place, in pieces, so an owner can name one without dragging the rest along.

    `where` is a phrase this file composed, and a phrase is all it could ever be used as —
    there was no way to say "you are in #ops" without also saying which server. These are
    the same facts, separately, and the names are declared by `--check` so one written
    wrongly is refused rather than left quietly blank.
    """
    if direct:
        return {}
    where = message.channel
    under = getattr(where, "parent", None) if in_thread else None
    channel = under or where
    named = getattr(channel, "name", None)
    server = getattr(message, "guild", None)
    return {what: value for what, value in (
        # With the hash, because that is how Discord writes a channel and how anyone
        # reading the agent's reply would expect to see it named.
        ("channel", f"#{named}" if named else None),
        ("server", getattr(server, "name", None)),
        ("thread", getattr(where, "name", None) if in_thread else None),
    ) if value}


def _prompt_context(message, direct: bool, in_thread: bool) -> dict:
    """Map Discord's place hierarchy onto communication-agnostic prompt variables."""
    destination = message.channel
    parent = getattr(destination, "parent", None) if in_thread else None
    channel = parent or destination
    container = getattr(message, "guild", None)
    return {
        "channel_name": (
            "a direct message" if direct else str(getattr(channel, "name", "") or "")
        ),
        "channel_id": str(getattr(channel, "id", "") or ""),
        "channel_parent_name": str(getattr(container, "name", "") or ""),
        "channel_parent_id": str(getattr(container, "id", "") or ""),
        "channel_thread_name": (
            str(getattr(destination, "name", "") or "") if in_thread else ""
        ),
        "channel_thread_id": (
            str(getattr(destination, "id", "") or "") if in_thread else ""
        ),
    }


def room_matches(said: str, named: str) -> bool:
    """Whether the word an owner wrote for a room names this one.

    The hash is how Discord writes a channel and how anybody would type one, and it is not
    part of the name — so `#operations` and `operations` are the same room asked for two ways.
    Case-insensitively, because nobody types a room name the way the server stores it.

    Pure, so the rule is proved without a token: what a case cannot drive is the fetching, and
    what it must drive is which of two rooms a word means.
    """
    return said.strip().lstrip("#").casefold() == (named or "").strip().casefold()


def _who(message) -> str:
    """What Discord shows for the person who spoke, rather than their number."""
    author = message.author
    return str(getattr(author, "display_name", None) or getattr(author, "name", "") or "")


def _reply_to(message) -> dict | None:
    """Discord's native reply reference in Rundesk's shared arrival shape (R-DIS-34)."""
    reference = getattr(message, "reference", None)
    if reference is None:
        return None
    kind = getattr(reference, "type", None)
    # discord.py exposes the ordinary reply type as `default`; `reply` is an alias.
    if kind is not None and getattr(kind, "name", "default") not in ("default", "reply"):
        return None
    identifier = getattr(reference, "message_id", None)
    if identifier is None:
        return None
    resolved = (
        getattr(reference, "resolved", None)
        or getattr(reference, "cached_message", None)
    )
    author = getattr(resolved, "author", None)
    if resolved is None or author is None or not hasattr(resolved, "content"):
        return {"id": str(identifier), "resolved": False}
    called = (
        getattr(author, "display_name", None)
        or getattr(author, "name", None)
        or getattr(author, "id", None)
        or ""
    )
    return {
        "id": str(identifier),
        "resolved": True,
        "author": str(called),
        "text": str(getattr(resolved, "content", "") or ""),
    }


def _without_mentions(text: str, ours=None) -> str:
    """What was said, with *our* naming taken out — it addressed us, it is not the ask.

    **Ours and nobody else's.** Every mention used to go, and with them everything between
    a literal `<@` and the next `>`: "ask <@alice> to review it" reached the brain as "ask
    to review it", and a message about `a<@b` arrived as `ab`. Who else somebody named is
    part of what they asked, and a word they typed is not this file's to remove.

    Given nobody to strip — which cannot happen once we are signed in — what was said is
    handed over as it was typed. Leaving the naming in is a question with one word too
    many; guessing at which mention was ours is a question with one too few.
    """
    if ours is None:
        return text.strip()
    for named in (f"<@{ours}>", f"<@!{ours}>"):
        text = text.replace(named, "")
    return text.strip()


def commentary(it: dict) -> str:
    """What belongs in the running commentary, and nothing else.

    What a turn *cost* is not commentary: it goes above the answer, where somebody
    reading the reply can see it without going back for it. And a turn that neither
    thought nor ran anything has nothing to show while it works — so it gets no
    commentary message at all rather than an empty one, which would be a notification
    that says nothing (R-DIS-20).
    """
    if it.get("type") == "usage":
        return ""
    return _as_a_line(it)


def _activity_line(it: dict, tools: dict) -> str:
    """One broad activity line, correlating only what needs a later state.

    Tool arguments and results stay out. A delegation's id is enough to turn its successful
    result into "subagent finished", while every other successful result remains quiet.
    """
    kind = it.get("type")
    at = str(it.get("id") or "")
    if kind == "tool":
        did = it.get("did")
        who = _helper_name(it.get("who")) if did == "delegate" else ""
        role = it.get("name") == ROLE_TOOL
        if at:
            tools[at] = {"did": did, "who": who, "role": role}
        if did == "delegate":
            opened = HANDED_ON if role else DELEGATED
            return f"-# {opened}{': ' + who if who else ''}"
        return commentary(it)
    if kind == "result":
        remembered = tools.pop(at, None) if at else None
        role = False
        if isinstance(remembered, dict):
            did, who = remembered.get("did"), remembered.get("who") or ""
            role = bool(remembered.get("role"))
        else:  # an in-memory turn begun by an older adapter shape during an update
            did, who = remembered, ""
        if it.get("ok") is False:
            if role:
                return f"-# ⚠ {ROLE_FAILED}{': ' + who if who else ''}"
            return f"-# ⚠ {FAILED.get(did, 'tool failed')}"
        if did == "delegate" and it.get("ok") is True:
            closed = ROLE_FINISHED if role else FINISHED_HELPER
            return f"-# {closed}{': ' + who if who else ''}"
    return commentary(it)


def _group_activity(groups: list, lines: list) -> list:
    """Add lines to adjacent groups, preserving every event as a count."""
    grouped = list(groups)
    may_join = True
    for line in lines:
        if line is None:
            may_join = False
            continue
        category = _activity_category(line)
        if may_join and grouped and _activity_category(grouped[-1][0]) == category:
            # Names are useful on one helper, but listing every name defeats compact
            # counting. Once the category repeats, its broad wording owns the count.
            grouped[-1] = (category, grouped[-1][1] + 1)
        else:
            grouped.append((line, 1))
        may_join = True
    return grouped


def _activity_category(line: str) -> str:
    """The broad line counted even when one helper's safe name is shown."""
    if line.startswith(f"-# {DELEGATED}"):
        return f"-# {DELEGATED}"
    if line.startswith(f"-# {FINISHED_HELPER}"):
        return f"-# {FINISHED_HELPER}"
    return line


def _helper_name(raw) -> str:
    """One safe, compact helper name — never its full provider path."""
    named = str(raw or "").strip().replace("\\", "/").rsplit("/", 1)[-1]
    return _plain_name(named)[-48:] if named else ""


def _render_activity(groups: list) -> str:
    """Render adjacent groups; one occurrence needs no visual noise."""
    return "\n".join(
        line if count == 1 else f"{line} **(x{count})**"
        for line, count in groups)


def _bounded_activity(groups: list) -> tuple:
    """Keep whole recent groups inside one Discord commentary message."""
    kept = list(groups)
    clipped = False
    while len(kept) > 1:
        prefix = "-# …\n" if clipped else ""
        if len(prefix + _render_activity(kept)) <= ACTIVITY_CHARS:
            break
        kept.pop(0)
        clipped = True
    shown = _render_activity(kept)
    if clipped:
        shown = "-# …\n" + shown
    return shown, kept


def _as_a_line(it: dict) -> str:
    """One record of what the agent did, as one line of Discord subtext."""
    kind = it.get("type")
    if kind == "think":
        return "-# 💭 thinking" if str(it.get("text") or "").strip() else ""
    if kind == "tool":
        # **What it did, never what its brain calls it.** This showed `name` first, so a
        # commentary read `commandExecution` and `imageGeneration` — one vendor's
        # identifiers, in front of somebody who has never heard of that vendor and never
        # should. The verb is the whole reason the seam translates at all; a brain that
        # gave none is doing something this vocabulary has no word for yet, so it joins the
        # broad thinking category rather than inventing a vendor-shaped label.
        did = it.get("did")
        mark = DID.get(did, UNKNOWN)
        return f"-# {mark} {SHOWN.get(did, 'thinking')}"
    if kind == "result":
        # Only when it went wrong, and never with its raw summary: an uncorrelated result
        # is still broad rather than a route around the privacy boundary above.
        if it.get("ok") is False:
            return "-# ⚠ tool failed"
        return ""
    if kind == "usage":
        # **How big this session is now, then what the turn wrote** (R-DIS-29). A footer is
        # read to decide one thing — whether to start a fresh conversation — and none of the
        # billed quantities answers it: fresh input is 2 on any warm turn, and a reader
        # cannot add three numbers in their head to find out. So a brain that says how big
        # the conversation it ended on was leads with that, and `output` stays beside it as
        # the only other thing the turn itself did.
        #
        # A brain that does not say gets the useful cost summary. Cache writes remain in
        # the recorded usage details, but are omitted from this compact final footer.
        # Absent means "could not tell" on either side, which is what the isinstance guard
        # has always been for.
        slots = (("session", "output") if isinstance(it.get("session"), int)
                 else ("input", "output", "cached"))
        parts = [f"{_amount(it[what])} {what}"
                 for what in slots if isinstance(it.get(what), int)]
        return f"-# · {' · '.join(parts)}" if parts else ""
    return ""


def _duration(seconds: float) -> str:
    """A compact elapsed duration that remains readable in Discord subtext."""
    whole = max(0, int(seconds))
    if whole < 60:
        return f"{whole}s"
    if whole < 3600:
        return f"{whole // 60}m"
    return f"{whole // 3600}h"


def _amount(tokens: int) -> str:
    """A count somebody can read, without rounding it into a lie.

    Everything was shown in thousands, so a turn that answered in thirteen tokens
    reported `0k output` — which is a measurement, stated plainly, and wrong. Small
    numbers are shown as themselves, and only what is genuinely in thousands is
    abbreviated.

    A cache read is counted once per request, so a turn that made forty of them
    reported `15425k cached` — a unit nobody carries that far, and one a reader has
    to divide in their head before it means anything. Thousands stop at a thousand
    of them. Millions keep a decimal because rounding one away is half a million
    tokens, which is a real amount of somebody's money.
    """
    if tokens < 1000:
        return str(tokens)
    if tokens < 10000:
        return f"{tokens / 1000:.1f}k".replace(".0k", "k")
    if round(tokens / 1000) < 1000:
        return f"{round(tokens / 1000)}k"
    return f"{tokens / 1000000:.1f}M".replace(".0M", "M")


async def check(chose) -> int:
    """Connect, sign in, and see whether what we were pointed at is really there.

    Nothing about this channel is written down unless this says yes (R-CAD-9). The whole
    of the owner's diagnosis is what comes back from here, so it says what was wrong
    rather than that something was.
    """
    token = token_for(chose)
    if not token:
        # **Named on the way out, not only on the way in.** `secret` is where this adapter
        # reads its credential from, and saying it here as well as on success is what lets
        # rundesk offer to take the token without ever reading this sentence — a platform's
        # words are this file's, and a caller that string-matched them would be the seam
        # failing (R-CAD-12, R-CAD-13).
        say(ok=False, secret={"env": [chose.token_from]},
            why=f"no bot token — rundesk will ask for it, or export {chose.token_from} "
                f"in the shell you are running this from, or put it in a file called "
                f"'{TOKEN_FILE}' in this channel's own directory; never as an argument")
        return 1
    if chose.unknown:
        say(ok=False, why=f"this channel does not understand {' '.join(chose.unknown)}")
        return 1
    client = Agent(chose)
    shapes = []
    try:
        await client.login(token)
        # **Discord is two places, so it is two channels.** A private message and a room
        # full of people are not the same thing to talk in, and a channel carries who may
        # reach the agent through it — so an owner who pointed this at both gets one of
        # each, with an allowed list and a set of instructions for each. Checked
        # separately too: being able to see a room proves nothing about direct messages.
        wants_dms, wants_rooms = wanted(chose)
        if wants_dms:
            me = await client.application_info()
            shapes.append(_shape(chose, DMS, f"direct messages to {me.name}", dm=True))
        if wants_rooms:
            # **A server is the room channel's ordinary scope, and one room is the
            # narrowing.** `--server` on its own means every room in it — which is what an
            # agent in a server is for, and what "rooms" says. `--channel` as well confines
            # it to one, for an owner who wants it in one room and not the next along.
            where = await _room(client, chose)
            if where is None:
                return 1        # `_room` has already said why
            shapes.append(_shape(chose, ROOMS, where, server=chose.server,
                                 channel=str(chose.channel) if chose.channel else None))
    except Exception as why:  # noqa: BLE001 — a platform boundary, and the diagnosis
        say(ok=False, why=f"could not reach Discord: {why}")
        return 1
    finally:
        with contextlib.suppress(Exception):
            await client.close()
    say(ok=True, secret={"env": chose.token_from}, shapes=shapes,
        describes=" and ".join(one["describes"] for one in shapes),
        # What one channel would have been given, for anything that reads the old shape.
        settings={what: value for what, value in (
            ("bot", chose.bot), ("server", chose.server), ("channel", chose.channel),
            ("dm", chose.dm), ("token_from", chose.token_from),
            ("activity", chose.activity)) if value})
    return 0


def _maintenance() -> bool:
    marker = os.environ.get("RUNDESK_MAINTENANCE")
    return bool(marker and Path(marker).is_file())


def _running_release() -> str:
    """This gateway's version as Discord should show it, linked where there is a link.

    Both parts are handed over by rundesk: the version is the process that actually came
    up, and the URL is built from the repository this install updates itself from. Nothing
    is composed here, so this adapter never learns a repository name — and an install told
    only a version still names it, in plain text, rather than saying nothing at all.
    """
    version = (os.environ.get("RUNDESK_VERSION") or "").strip()
    if not version:
        return ""
    shown = version if version.startswith("v") else f"v{version}"
    where = (os.environ.get("RUNDESK_RELEASE_URL") or "").strip()
    return f"[{shown}]({where})" if where else shown


def _finish_maintenance() -> None:
    marker = os.environ.get("RUNDESK_MAINTENANCE")
    if marker:
        with contextlib.suppress(OSError):
            Path(marker).unlink()


async def _room(client, chose):
    """What the room channel is pointed at, said the way a person would — or `None`, said.

    Checked rather than assumed, which is the whole of what `--check` is for: an owner
    finds out that a room is not in the server they named while they are standing at the
    terminal, rather than at three in the morning when somebody asks the agent something.
    """
    if not chose.channel and not chose.server:
        # **Asked of Discord, not of the owner.** A bot knows which servers it is in, and
        # one call at check time says so — `--server` was asking somebody to go and copy
        # an id for a question this can answer itself. Named here only to be shown; the
        # channel is left unconfined, and answers wherever it has been invited.
        found = [one async for one in client.fetch_guilds(limit=GUILDS_SHOWN + 1)]
        if not found:
            say(ok=False, why="this bot is not in any server — invite it to one, or use "
                              "--dm on its own for direct messages only")
            return None
        named = ", ".join(f"'{one.name}'" for one in found[:GUILDS_SHOWN])
        more = f" and {len(found) - GUILDS_SHOWN} more" if len(found) > GUILDS_SHOWN else ""
        return f"every room in {named}{more}"
    if not chose.channel:
        guild = await client.fetch_guild(int(chose.server))
        named = getattr(guild, "name", None)
        # Said *as a server*, because a server's name is whatever its owner called it and
        # may be a word that means something else here. One called "rundesk" read as
        # "every room in rundesk", which says nothing at all.
        return f"every room in the '{named}' server" if named else "every room in that server"
    found = await client.fetch_channel(int(chose.channel))
    guild = getattr(found, "guild", None)
    if chose.server and guild is not None and str(guild.id) != str(chose.server):
        say(ok=False, why=f"channel {chose.channel} is not in server {chose.server}")
        return None
    # On the *name*, not on the guild existing. Fetched by id, a channel can come back
    # attached to a guild that has not been resolved to a name yet — so this said
    # "#development in " with nothing after it, which reads like something went missing
    # rather than like there was nothing to say.
    named = getattr(guild, "name", None)
    return f"#{found.name}" + (f" in the '{named}' server" if named else "")


def wanted(chose) -> tuple[bool, bool]:
    """Which kinds of place this `add` is for: direct messages, and rooms.

    **Nothing said means both**, because a bot is reachable in both and asking an owner
    which of them they meant is asking them to say something this can find out for itself.
    The flags narrow rather than choose: `--dm` on its own leaves the rooms out, `--server`
    or `--channel` on their own leave direct messages out, and naming neither takes both.
    """
    confined = bool(chose.server or chose.channel)
    return (bool(chose.dm) or not confined, confined or not chose.dm)


def _shape(chose, suffix: str, describes: str, **where) -> dict:
    """One kind of place this bot was pointed at, as its own channel.

    The settings are narrowed to that place and nothing else: the direct-message channel
    is told nothing about a room, so it cannot drift into answering in one, and neither
    can be widened by editing the other.
    """
    settings = {what: value for what, value in (
        ("bot", chose.bot), ("token_from", chose.token_from),
        ("activity", chose.activity), *where.items()) if value}
    return {"suffix": suffix, "describes": describes, "settings": settings,
            "fills": list(FILLS[suffix])}


async def carry(chose) -> int:
    """Hold the connection open, and carry conversations until rundesk ends us."""
    token = token_for(chose)
    if not token:
        # Said where the gateway's log will show it: a machine keeping this agent up has
        # no shell, so the variable an owner exported by hand is not here.
        note(f"no bot token — {chose.token_from} is not set and there is no "
             f"'{TOKEN_FILE}' file in this channel's own directory")
        return 1
    client = Agent(chose)
    # **Asked to stop, rather than killed where we stand.** Rundesk ends a channel by
    # signalling its whole process group and giving it a few seconds before it insists,
    # and the default for these two signals is to die immediately — so the goodbye, the
    # presence going away and every last write were simply never reached. Handled, they
    # are: the wait below ends and the cleanup that was always written runs (R-DIS-15).
    stopping = asyncio.Event()
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        with contextlib.suppress(NotImplementedError, ValueError):
            loop.add_signal_handler(sig, stopping.set)
    reading = asyncio.ensure_future(_read(client))
    connected = asyncio.ensure_future(client.start(token))
    asked = asyncio.ensure_future(stopping.wait())
    try:
        await asyncio.wait({reading, connected, asked},
                           return_when=asyncio.FIRST_COMPLETED)
    except asyncio.CancelledError:
        pass
    finally:
        say(type="gone", why="the connection is closing")
        # Bounded: rundesk waits a few seconds before it insists, and a goodbye that
        # takes longer than that is one nobody will receive anyway.
        with contextlib.suppress(BaseException):
            await asyncio.wait_for(client.going(), timeout=GOODBYE_SECONDS)
        for task in (reading, connected, asked):
            task.cancel()
            with contextlib.suppress(BaseException):
                await task
    return 0


async def _read(client: Agent) -> None:
    """Everything rundesk says, a record at a time, for as long as it is saying it."""
    loop = asyncio.get_event_loop()
    reader = asyncio.StreamReader()
    await loop.connect_read_pipe(lambda: asyncio.StreamReaderProtocol(reader), sys.stdin)
    while True:
        line = await reader.readline()
        if not line:
            return   # rundesk has stopped speaking, which means the turn of this is over
        try:
            it = json.loads(line)
        except ValueError:
            continue
        if isinstance(it, dict):
            with contextlib.suppress(Exception):
                await client.told(it)


#: What is taken from what rundesk wrote down about this channel when it was not given on
#: the command line. The two are the same words, so an owner who set one in either place
#: gets the same thing.
FROM_SETTINGS = ("bot", "server", "channel", "token_from", "activity")


def settled(chose, settings: dict, allow: str = ""):
    """Everything this adapter was told, from wherever it was told it — and the defaults.

    A function of its arguments and nothing else, so what an owner who said nothing ends up
    with can be read by a test rather than by starting Discord. That is not tidiness: the
    default below was wrong for as long as it has existed and nothing could see it, because
    it was resolved three lines into the function that opens a websocket.
    """
    # Who may use this is rundesk's, and it enforces it — but the owner is who a hello
    # and a goodbye go to, so the adapter is told who they are.
    chose.allow = [one for one in (allow or "").split(",") if one]
    for what in FROM_SETTINGS:
        value = settings.get(what)
        # Rundesk owns whether commentary is shown and already withholds every activity
        # record when the channel-level `--no-activity` switch is set. Discord's old
        # adapter default persisted a second `off` decision in settings, leaving records
        # that say the channel is on while the adapter silently drops every line. Ignore
        # that stale duplicate at runtime rather than rewriting an owner's records.
        if what == "activity" and value == OFF:
            continue
        if not getattr(chose, what, None) and value:
            setattr(chose, what, value)
    # **Shown unless somebody said otherwise, which is what rundesk already decided.** This
    # was `or OFF`, and it quietly overruled the core: `answering` sends what the agent is
    # doing unless the channel record turns it off, and its comment says why — "a room that
    # goes quiet for four minutes and then answers looks broken". Two defaults for one idea,
    # and the one further from the owner won: an owner who never said anything got a channel
    # rundesk was streaming activity to and an adapter dropping every line of it, so nothing
    # ever appeared and nothing said why.
    #
    # `grows` rather than `posts` because it is the quiet one: a turn is a single message
    # that fills in, not a room filling with commentary.
    chose.activity = chose.activity or GROWS
    chose.dm = chose.dm or bool(settings.get("dm"))
    return chose


def main(argv) -> int:
    asking = "--check" in argv
    chose = settled(options([one for one in argv if one != "--check"]),
                    json.loads(os.environ.get("RUNDESK_SETTINGS") or "{}"),
                    os.environ.get("RUNDESK_ALLOW") or "")
    return asyncio.run(check(chose) if asking else carry(chose))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
