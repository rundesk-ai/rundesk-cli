    "add a reaction": 1 << 6,
    "send a message": 1 << 11,
    "attach a file": 1 << 15,
    "read the history": 1 << 16,          # Discord refuses a reply reference without it
    "open a thread": 1 << 35,             # CREATE_PUBLIC_THREADS — a room's exchange happens in one
