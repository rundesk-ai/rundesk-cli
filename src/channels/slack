WILL_NOT_FIX = 78


class Refused(Exception):
    """Something this will not do, carrying the sentence that says why.

    A sentence rather than a code, because every one of these ends up in a record somebody reads and
    is the whole of what they have to act on.
    """


# ---------------------------------------------------------------------------------------------
# The three ways out of this process: a record, a note, and a traceback.
# ---------------------------------------------------------------------------------------------

#: Held across every write to stdout. Records are produced by the thread reading rundesk, by the
#: socket client's own listener threads and by the watcher, so two half-lines interleaved is a real
#: outcome rather than a theoretical one — and one unparseable line is a record rundesk drops.
_SAYING = threading.Lock()


def say(record: Dict[str, Any]) -> None:
    """One object, one line, flushed — because rundesk is reading this as it happens.

    Flushed per line rather than per block: the answer to one message must not sit in a buffer
    waiting behind the answer to the next.
    """
    with _SAYING:
        sys.stdout.write(json.dumps(record) + "\n")
        sys.stdout.flush()


def noted(text: str, level: str = "warning") -> None:
    """Something an owner should know, said as a record rather than as prose.

    This is the distinction stdout enforces: a `note` is a line the reader parses like every other
    line, and free text there would be a line nothing can parse. Anything this has no words of its
    own for goes to `cannot_say` instead.
    """
    say({"say": "note", "level": level, "text": text})


def cannot_say(said: str) -> None:
    """stderr, for what this has no words for — a traceback, and nothing pretending to be one."""
    sys.stderr.write(said if said.endswith("\n") else said + "\n")
    sys.stderr.flush()


