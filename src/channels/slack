WILL_NOT_FIX = 78


class Refused(Exception):
    """Something this will not do, carrying the sentence that says why.

    A sentence rather than a code, because every one of these ends up in a record somebody reads and
    is the whole of what they have to act on.
    """


# ---------------------------------------------------------------------------------------------
# The three ways out of this process: a record, a note, and a traceback.
# ---------------------------------------------------------------------------------------------

#: Held across every write to stdout. Records are produced by the thread reading rundesk, by the
#: socket client's own listener threads and by the watcher, so two half-lines interleaved is a real
#: outcome rather than a theoretical one — and one unparseable line is a record rundesk drops.
_SAYING = threading.Lock()


def say(record: Dict[str, Any]) -> None:
    """One object, one line, flushed — because rundesk is reading this as it happens.

    Flushed per line rather than per block: the answer to one message must not sit in a buffer
    waiting behind the answer to the next.
    """
    with _SAYING:
        sys.stdout.write(json.dumps(record) + "\n")
        sys.stdout.flush()


def noted(text: str, level: str = "warning") -> None:
    """Something an owner should know, said as a record rather than as prose.

    This is the distinction stdout enforces: a `note` is a line the reader parses like every other
    line, and free text there would be a line nothing can parse. Anything this has no words of its
    own for goes to `cannot_say` instead.
    """
    say({"say": "note", "level": level, "text": text})


def cannot_say(said: str) -> None:
    """stderr, for what this has no words for — a traceback, and nothing pretending to be one."""
    sys.stderr.write(said if said.endswith("\n") else said + "\n")
    sys.stderr.flush()


# ---------------------------------------------------------------------------------------------
# What this is given, and what it makes of it.
# ---------------------------------------------------------------------------------------------


def the_library() -> str:
    """Bring `slack_sdk` in. `""` when it is here, otherwise the sentence saying it is not.

    Imported at the moment it is needed and never at module scope, so that `--capabilities` answers
    on a machine with nothing installed — which is the state rundesk asks that question in.

    **Not located, only imported.** Which interpreter runs this is decided by rundesk and handed over
    on `PATH`. **The built-in Socket Mode client and nothing else**: `slack_sdk.socket_mode`
    re-exports the one that implements the websocket protocol itself, so this line pulls in one
    package with nothing behind it, and the aiohttp, websockets and websocket-client variants stay
    the optional extras they are.
    """
    global slack_sdk, SocketModeClient, SocketModeResponse, WebClient, WebhookClient
    global SlackApiError
    if slack_sdk is not None:
        return ""
    try:
        import slack_sdk as library
        from slack_sdk.errors import SlackApiError as failed
        from slack_sdk.socket_mode import SocketModeClient as socket
        from slack_sdk.socket_mode.response import SocketModeResponse as answering
        from slack_sdk.web import WebClient as web
        from slack_sdk.webhook import WebhookClient as webhook
    except ImportError as why:
        return (f"slack_sdk is not installed for the interpreter running this adapter ({why}) — it "
                f"is pinned in rundesk's own requirements, so this is an install that has not built "
                f"its virtualenv rather than a channel that is misconfigured")
    slack_sdk, SocketModeClient = library, socket
    SocketModeResponse, WebClient, SlackApiError = answering, web, failed
    # A command's own response url is neither a Web API method nor a websocket frame, and the
    # vendor's client for it is in the same package and pulls in nothing further.
    WebhookClient = webhook
    return ""


def the_tokens() -> Tuple[str, str]:
    """The bot token and the app-level token, in that order. Either may be `""`.

    One place each and no fallback file. What rundesk keeps is the *names*; the values live in its
    sealed store, and both `--check` and `serve` are handed them under these names — so a second
    place to look would be a second thing that can silently be the wrong one.
    """
    return ((os.environ.get(BOT_TOKEN_FROM) or "").strip(),
            (os.environ.get(APP_TOKEN_FROM) or "").strip())


def who_may_reach() -> List[str]:
    """The sender ids this may work for, the owner first. Never shown to anybody, never the answer.

    An empty list authorises **nobody** — never everybody. That is the rule other people have got
    backwards at real cost, and here it means an agent that answers no one rather than one that
    answers everyone.
    """
    return _a_list(os.environ.get("RUNDESK_ALLOW"))


def which_places() -> List[str]:
    """The channels anybody may reach this agent from. Read on exactly the same terms.

    **Advisory, exactly as the sender list is.** Whether somebody may be answered is decided by
    rundesk against the channel's own record; this is read so that a thread is not fetched and a
    reaction is not put up for a message that is going to be dropped a moment later.
    """
    return _a_list(os.environ.get("RUNDESK_ALLOW_PLACES"))


def _a_list(said: Any) -> List[str]:
    """One comma-separated variable as the ids in it, with nothing empty left in."""
    return [one for one in (said or "").split(",") if one]


def flat(said: Any, most: int = SAID_MOST) -> str:
    """One line, clipped — for a stranger's words on their way into somebody's prompt."""
    whole = " ".join(str(said or "").split())
    return whole if len(whole) <= most else whole[:most - 1] + "…"


def escaped(said: str) -> str:
    """The three characters Slack reserves, replaced, in the order they have to be replaced in.

    **The ampersand first, and that is not cosmetic**: doing it after the others would go back over
    the escapes just added and turn `&lt;` into `&amp;lt;`.

    **The whole of it, with nothing kept back**, which is what a private command answer goes through
    (R-SLK-15): those words are composed by rundesk out of stored records, so none of them is an
    agent deliberately addressing anybody. A turn's answer is a different question and has
    `escaped_keeping_mentions` below for it.

    Escaped, markup is exactly the text it looks like. Slack renders the entities back, inside code
    blocks and out, so nothing is lost by escaping words that were never going to be read as markup.
    """
    return said.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def escaped_keeping_mentions(said: str) -> str:
    """Escaped, except where the agent named one person by Slack's own id for them (R-SLK-15).

    **An agent that answers *I'll ask <@U…> about it* meant to ask them.** Escaping that made a
    working answer into a line of punctuation that notified nobody and named nobody a person could
    click, so the exact markup for one member survives and reaches Slack as the mention it is.

    **One person, and nothing wider, and that is one decision rather than a spectrum.**
    `<!channel>`, `<!here>`, `<!everyone>`, a user group's `<!subteam^…>` and a channel link's
    `<#C…>` all still arrive as the text they look like. What decides it is who pays for the answer
    being wrong: one person reads a line that was meant for them, or a room full of people is
    interrupted on the agent's behalf — and the second is what somebody talking a brain into writing
    markup would be reaching for.

    **Exact, and never nearly.** `A_MENTION` matches a whole token and nothing else, so a malformed
    one, a lowercased id, the deprecated `<@U…|label>` form and every other angle-bracket shape this
    has no word for go through `escaped` along with the text around them. Anything that is not
    certainly one person is not one.
    """
    kept = []
    at = 0
    for found in A_MENTION.finditer(said):
        kept.append(escaped(said[at:found.start()]))
        kept.append(found.group(0))
        at = found.end()
    kept.append(escaped(said[at:]))
    return "".join(kept)


def a_handle_for(user: str) -> str:
    """The exact markup that mentions this member, or `""` where the id is not one (R-SLK-65).

    **The same token `escaped_keeping_mentions` keeps, checked by the same rule.** What arrives
    beside a speaker's name is what the brain will write back to mention them, so it has to be a
    token the answer path lets through as a mention — `A_MENTION` decides both, and a handle this
    would escape on the way out is one that must not be taught on the way in.
    """
    said = f"<@{user}>" if user else ""
    return said if said and A_MENTION.fullmatch(said) else ""


def conversation_of(team: str, channel: str, thread: str = "") -> str:
    """The one string rundesk keeps this exchange under.

    **The workspace is in it.** A channel id is unique inside one workspace and not across two, and a
    bot reachable from an Enterprise Grid organisation can be handed the same id from two of them —
    which without this would be two exchanges sharing one session and one history.
    """
    return IN.join(part for part in (team, channel, thread) if part)


def where_of(place: Any) -> Tuple[str, str, str]:
    """A conversation string read back as the workspace, the channel and the thread inside it.

    `Refused` rather than a guess for anything that is not one: a delivery aimed at a place this
    cannot address is a delivery that must be reported failed, and posting it somewhere plausible is
    the one outcome worse than not posting it at all.
    """
    parts = str(place or "").split(IN)
    if len(parts) < 2 or not parts[0] or not parts[1]:
        raise Refused(f"{place!r} is not a Slack conversation this adapter wrote")
    if len(parts) > 3:
        raise Refused(f"{place!r} has more pieces in it than a Slack conversation has")
    return parts[0], parts[1], parts[2] if len(parts) == 3 else ""


def written_by_us(one: Dict[str, Any], ours: str, our_bot: str) -> bool:
    """Whether this app wrote this message. Both ids are asked, and an unknown one matches nothing.

    **One rule, because there are two callers and they must not disagree.** A thread read for
    context and a search reading a month of history are the same question — *did we write this?* —
    and an answer that differed between them would let an agent quote itself back in one of them.

    `our_bot` is empty only where `auth.test` gave no `bot_id`, which is a token `--check` refuses.
    An empty one must never match a message that carries none, or every ordinary person's line
    would read as ours.
    """
    wrote = str(one.get("bot_id") or "")
    who = str(one.get("user") or "")
    return bool(our_bot and wrote == our_bot) or bool(ours and who == ours)


def named_in(one: Dict[str, Any]) -> str:
    """What to call a peer app out of the message it wrote, asking Slack nothing.

    `users.info` knows nothing about a bot, so asking would spend a call to learn nothing. What
    Slack already hands over is the app's own profile name, then the name it posted under, then its
    bot id — and each of those was chosen by whoever installed that app, so it is a stranger's text
    and is flattened and clipped exactly as a display name is.
    """
    profile = one.get("bot_profile")
    named = (profile.get("name") if isinstance(profile, dict) else None) or \
        one.get("username") or one.get("bot_id")
    return flat(named)


def named_as(profile: Dict[str, Any], who: str) -> str:
    """One `users.info` answer as the label to show, in the order Slack's own surfaces prefer.

    Their id where it will say none, which is a whole answer: **it reaches a prompt and never a
    decision** — who may be answered is settled against the member id, which nobody can choose.
    """
    return flat((profile.get("profile") or {}).get("display_name")
                or profile.get("real_name") or profile.get("name") or who)


def a_room_from(said: Dict[str, Any]) -> Tuple[str, bool, bool]:
    """One `conversations.info` answer as the name, whether it is private, and whether it is read
    by people outside this workspace. One reading, so two callers cannot describe one room two ways.
    """
    return (flat(said.get("name"), WHERE_AT_MOST), bool(said.get("is_private")),
            bool(said.get("is_ext_shared")))


def _aimed_at(said: Any) -> Optional[Tuple[str, str]]:
    """The one destination a delivery names, as `("sender"|"place", id)`, or `None` for none.

    **Read whole rather than guessed at.** `to` supersedes `place` entirely, so a malformed one must
    never fall through to the place beside it — that place is the channel's own recorded destination
    and delivering there is the mis-delivery rundesk aimed this away from.
    """
    if said is None:
        return None
    if not isinstance(said, dict):
        raise Refused("the destination to deliver to was not an object")
    for kind in ("sender", "place"):
        named = str(said.get(kind) or "")
        if named:
            return kind, named
    raise Refused("the destination to deliver to named neither a sender nor a place")


def a_direct_message(event: Dict[str, Any]) -> bool:
    """Whether this was said in a direct conversation with the bot.

    Asked two ways because the two events answer differently: `message.im` carries `channel_type`,
    and an `app_mention` carries only the channel — whose id Slack starts with `D` for exactly this
    kind of place.
    """
    return (str(event.get("channel_type") or "") == "im"
            or str(event.get("channel") or "").startswith("D"))


class Waking(NamedTuple):
    """One event that wakes the agent: which conversation it belongs to, and where an answer goes.

    **Those are two different facts and this is where they part** (R-SLK-50). Identity is what
    rundesk keeps a conversation and a provider session under; a reply target is where a person
    reads the answer. Folding them into one field is what made a Slack thread inside a direct
    message a *second* conversation with a session of its own.
    """

    #: Slack's own id for the channel — a `C`, a `G` or a `D`. What the allow list's places name.
    channel: str
    #: The thread the **conversation** is keyed by, and `""` in a direct message however this
    #: message was threaded: one direct conversation is one conversation.
    thread: str
    #: Where an **answer** to this message is posted, which is not the same thing. In a direct
    #: message it is the thread this message stands in, or a thread rooted at this message when it
    #: stands in none; in a channel it is the same thread the conversation is keyed by.
    answer_in: str
    #: This message's own id, which is what a mark is put on.
    ts: str
    #: Slack's own id for whoever spoke.
    user: str
    #: What they said, with the bot's own naming taken out of it.
    text: str
    #: Whether this was a direct message, which decides whether a thread is opened for the answer.
    direct: bool
    #: Whether the thread was already standing when this arrived, which is the only case with any
    #: prior context to carry.
    joined: bool
    #: What Slack says is attached, as it said it — each file object whole, so what is landed is
    #: decided off the declared name, size and download url and nothing this file invented.
    files: Tuple[Dict[str, Any], ...] = ()


def waking(kind: str, event: Dict[str, Any], ours: str) -> Optional[Waking]:
    """Whether this event wakes the agent, and where its answer goes. `None` for everything else.

    **A pure decision, with no platform behind it**, because it is the one thing on this surface that
    must never be got wrong: it decides whether a stranger in a shared channel can start a turn, and
    whether a thread the agent once answered in goes on waking it.

    Four refusals, and each is a different thing being asked:

    **A bot did not speak.** Anything carrying a `bot_id`, anything whose subtype says it is not
    speech, and anything from this bot itself. An agent answering its own message is a loop.

    **A direct message wakes on its own** — that is what a private conversation with the agent is
    for, and there is nobody there to be out of the way of.

    **A channel wakes only on a mention, and the mention is checked.** Slack sends `app_mention` only
    when the app is named, and the literal is looked for anyway: this is the guarantee the whole
    surface rests on, and it should not depend on the platform never widening what it sends.

    **A mention in a direct message is dropped**, because `message.im` has already carried it.
    Taking both would run every turn twice for anybody who typed the bot's name into a DM.

    A message in a channel that names nobody never reaches here at all — nothing subscribes to it.
    Refused anyway if one ever does, so that what this file promises is true of the file and not only
    of a manifest somebody could edit.
    """
    if not isinstance(event, dict):
        return None
    if event.get("bot_id") or str(event.get("subtype") or "") in NOT_SPEECH:
        return None
    who = str(event.get("user") or "")
    channel = str(event.get("channel") or "")
    ts = str(event.get("ts") or "")
    if not who or not channel or not ts or (ours and who == ours):
        return None
    text = str(event.get("text") or "")
    standing = str(event.get("thread_ts") or "")
    if kind == MESSAGE:
        if not a_direct_message(event):
            return None
        # **One direct conversation, whatever Slack threading somebody used** (R-SLK-50). The
        # thread is left out of the identity on purpose: a person who answers their own question in
        # a thread, or asks a follow-up beside one, is the same person in the same conversation, and
        # keying on the thread gave each of those a session and a history of its own — so an agent
        # asked *and what about the other one?* in a thread had never heard of the other one.
        #
        # **The answer still goes where they are looking.** A message inside a thread is answered
        # there; one that stands on its own is answered in a thread rooted at itself, which is what
        # keeps two exchanges in one direct conversation readable apart.
        #
        # **A direct message carries no thread slice.** The conversation rundesk already keeps for
        # it *is* the history, so reading Slack's copy of the same exchange would hand a brain the
        # last few things it said back to itself.
        return Waking(channel, "", standing or ts, ts, who, without_our_name(text, ours), True,
                      False, _files_on(event))
    if kind == MENTION:
        if a_direct_message(event):
            return None
        if ours and f"<@{ours}>" not in text:
            return None
        # **A mention at the top of a channel roots a thread at itself.** A reply that arrives whole
        # after minutes of working needs somewhere of its own to arrive into, and a channel is
        # somebody else's. Reported as the conversation on the very record that opens it, so nothing
        # moves a turn somewhere the other side of the seam could not address.
        # In a channel the two facts coincide: the thread that identifies the conversation is the
        # thread a person reads the answer in, and both are stated so neither has to be inferred.
        return Waking(channel, standing or ts, standing or ts, ts, who,
                      without_our_name(text, ours), False, bool(standing) and standing != ts,
                      _files_on(event))
    return None


def _files_on(event: Dict[str, Any]) -> Tuple[Dict[str, Any], ...]:
    """Every file object Slack put on this event, and nothing that is not one."""
    files = event.get("files")
    return tuple(one for one in files if isinstance(one, dict)) if isinstance(files, list) else ()


def without_our_name(text: str, ours: str) -> str:
    """What was said, with *our* naming taken out — it addressed us, it is not the ask.

    **Ours and nobody else's.** Taking out every mention would turn "ask <@U9> to review it" into
    "ask to review it": who else somebody named is part of what they asked, and a word they typed is
    not this file's to remove.
    """
    said = str(text or "")
    if not ours:
        return said.strip()
    # **The space after it goes with it.** Somebody who named two bots wrote one space between them,
    # and taking only the naming out leaves a brain reading a line with a gap in the middle of it.
    for named in (f"<@{ours}> ", f"<@{ours}>"):
        said = said.replace(named, "")
    return said.strip()


def with_context(text: str, earlier: List[str]) -> str:
    """What somebody typed, and the bounded slice of the thread that stood above it.

    Said as a labelled block after their words rather than folded into them, so that the thread and
    the ask stay told apart — the shape `channels/hosting.py` already uses for what was attached and
    what was being replied to.

    Bounded twice: by how many lines are carried and by how long the block may be. A thread runs for
    days, and what a brain is handed is not the place to find that out.
    """
    if not earlier:
        return text
    block = ""
    for line in earlier:
        wanted = f"{block}\n- {line}" if block else f"- {line}"
        if len(wanted) > CONTEXT_CHARS:
            break
        block = wanted
    if not block:
        return text
    return f"{text}\n\n{CONTEXT_SAID}\n{block}".strip()


def a_place(named: str, private: bool, external: bool = False) -> str:
    """Where an answer is being written, in words a brain can repeat, and never as an id.

    The platform's nouns, rundesk's sentence: rundesk may never name a channel — that is a layer
    which would have to be rewritten for every surface — so the naming happens here, and what crosses
    the seam is one line of ordinary English.

    **Who can read it is said outright, because a name does not say it.** `the ops channel` was the
    whole sentence for a public channel and for a private one alike, so the one fact an agent needs
    in order to know how much to disclose — that it is standing somewhere other people are reading
    — was the one fact the words left out. A brain cannot tell `ops` from `ops` and should not have
    to: what is public in this workspace is public, and saying so is not a policy about what to
    write. Nothing here tells it what to withhold.

    **A Slack Connect channel is read by people this workspace does not contain**, and Slack says
    so in `is_ext_shared` rather than in the name. Left to the workspace sentence it was the widest
    audience an agent can stand in described as the narrowest one it knows, which is the reading
    that matters most and was the one that was wrong. It is checked before `private`: a Connect
    channel may be either, and who is on the other side of it is the larger fact.

    Bounded by construction as well as by rundesk: the name is already flattened and clipped to
    `WHERE_AT_MOST` before it arrives, and the longest sentence this can build — a thread in an
    externally shared channel with a sixty-character name — is 130 characters against the 140
    rundesk carries, so the clause cannot be the part that is cut off.
    `test_the_longest_place_sentence_still_says_who_can_read_it` holds that against both bounds
    rather than trusting this paragraph.
    """
    if external:
        return (f"the {named} channel, which people outside this workspace can read" if named
                else "a channel shared with people outside this workspace, who can read it")
    if private:
        return (f"the {named} channel, which its invited members can read" if named
                else "a private channel, which its invited members can read")
    return (f"the {named} channel, which anybody in this workspace can read" if named
            else "a channel, which anybody in this workspace can read")


class Gesture(NamedTuple):
    """One thing somebody asked for with this agent's own command, as rundesk speaks it."""

    #: Which record this becomes — `control`, `query` or `configure`, and nothing else.
    saying: str
    #: The wire word rundesk knows, or the provider named for a `configure`.
    word: str
    #: The account alias a `configure` named, or `None` where it named none.
    alias: Optional[str]


def the_gesture(text: Any) -> Optional[Gesture]:
    """Which gesture this subcommand names. `None` for every word this does not offer.

    **A pure decision, with no platform behind it**, and the only place a typed word becomes one
    rundesk speaks. Nothing outside the closed sets above can leave here: a gesture whose name is
    whatever somebody typed is a command runner with a chat window in front of it, and this is the
    line that keeps it from becoming one.

    **The subcommand is read case-insensitively and the value after it is not.** A person typing
    `Status` on a phone that capitalised it for them asked the same question; a provider is a name
    or a path this machine has, and lowering it would be this file editing what they typed.

    A bare `provider`, and one given more words than it takes, are both `None` rather than a guess.
    Rundesk answers an empty provider with a sentence naming what the install has, but it would have
    to be asked first — and the local help says the same thing without spending the round trip.
    """
    said = str(text or "").split()
    if not said:
        return None
    word = said[0].lower()
    for name, _describes, control in CONTROLS:
        if word == name:
            return Gesture("control", control, None)
    for name, _describes, query in QUERIES:
        if word == name:
            return Gesture("query", query, None)
    if word != CONFIGURE[0] or not 2 <= len(said) <= 3:
        return None
    return Gesture("configure", said[1], said[2] if len(said) == 3 else None)


def the_help(command: str) -> str:
    """What this command takes, written here and asked of nothing. The answer to anything unknown.

    **Named after the command that was actually typed**, because the name is the workspace's and this
    file does not hold it: an agent's command is whatever its app manifest declares, so a fixed
    example here would be the wrong word for every workspace that chose a different one.

    Slack's own `mrkdwn` rather than rundesk's Markdown, because these are this file's words on this
    file's surface. The placeholders go through `escaped` like everything else, which is what makes
    `<name>` arrive as the word somebody types over rather than as a Slack entity.
    """
    named = command.strip() or "this command"
    lines = [f"*{named}* takes one of these:"]
    lines += [f"- `{name}` — {describes}" for name, describes, _word in CONTROLS + QUERIES]
    lines.append(f"- `{CONFIGURE[0]} <name> [alias]` — {CONFIGURE[1]}")
    lines.append("Every answer is private to you, wherever you ask it.")
    return "\n".join(lines)


def confirming(command: str) -> str:
    """What somebody is told the first time they ask for the one thing that cannot be undone."""
    named = command.strip() or "this command"
    return (f"⚠️ This stops the gateway for good. Nothing here can start it again — you will need "
            f"the machine it runs on. Run *{named} {SHUTDOWN}* again within "
            f"{int(CONFIRM_WITHIN)}s to confirm.")


def answer_pieces(said: str) -> List[str]:
    """A private command answer in every bounded piece needed to say it whole.

    **Rundesk does not split this one.** Turn answers are cut once, on rundesk's side, to the
    `max_text` this adapter reports — and a gesture is answered out of what the install already
    knows, on a path that never went near that splitter. So an install-wide directory of agents
    arrives here whole and is cut here, and joining the pieces reproduces it exactly: a whole line
    is preferred, then a word boundary, and the separator goes with the earlier piece so nothing is
    silently dropped between two of them.
    """
    pieces = []
    rest = said
    while len(rest) > MAX_TEXT:
        cut = rest.rfind("\n", 0, MAX_TEXT)
        if cut < 1:
            cut = rest.rfind(" ", 0, MAX_TEXT)
        if cut < 1:
            cut = MAX_TEXT
        else:
            cut += 1
        pieces.append(rest[:cut])
        rest = rest[cut:]
    if rest:
        pieces.append(rest)
    return pieces


# ---------------------------------------------------------------------------------------------
# A file on its way out, which is verified twice and sent from neither the path nor trust.
# ---------------------------------------------------------------------------------------------


def a_verified_file(said: Dict[str, Any]) -> Tuple[Any, str]:
    """Re-open what rundesk approved, prove it is still that, and hand back those exact bytes.

    **The second of two checks, and it is the one that closes the window** (R-SLK-48). Rundesk
    resolved this explicitly declared path and fingerprinted it; between that moment and this one a
    concurrent write can replace the file, or replace a directory above it with a symbolic link to
    somewhere else entirely. So every component is opened with `O_NOFOLLOW` from a descriptor on the
    one above it — a path resolved twice is two different paths — and the bytes are streamed into a
    snapshot whose size and digest are compared with what was approved. **What is uploaded is the
    snapshot**, so the path is never handed to the platform and never opened a third time.

    **Immediately before its own upload, and once per file.** Verifying all of them and then
    uploading would leave the last file approved a whole upload ago; this way the window between the
    check and the send is one call wide, and a file that changed while an earlier one was uploading
    is caught rather than sent.

    **The declared size is also the bound on the read**, which is why there is no constant for it: a
    file that grew is refused for having grown, rather than truncated into something that would
    still hash correctly.

    **A refusal says which component would not open and what the machine actually answered**, and
    says that it was this re-open rather than rundesk's approval — the two run as different
    processes and a permission one holds is not one the other holds, so *which of them refused* is
    the first thing anybody looking into it needs.

    `Refused` on anything at all. Nothing that did not verify is ever uploaded.
    """
    at = said.get("at")
    expected = said.get("bytes")
    wanted = said.get("sha256")
    if not isinstance(at, str) or not at:
        raise Refused("a file was named with no path to open")
    if isinstance(expected, bool) or not isinstance(expected, int) or expected < 0:
        raise Refused(f"could not attach {at}: it was approved without a size to check against")
    if not isinstance(wanted, str) or re.fullmatch(r"[0-9a-f]{64}", wanted) is None:
        raise Refused(f"could not attach {at}: it was approved without a digest to check against")
    path = Path(at)
    if not path.is_absolute() or not path.parts[1:]:
        raise Refused(f"could not attach {at}: it is not an absolute path to a file")

    digest = hashlib.sha256()
    size = 0
    snapshot = None
    directory = None
    descriptor = None
    try:
        # **Opened inside the guard, like every other thing here that can fail.** A `TMPDIR` that is
        # full or unwritable raises exactly what a file that will not open raises, and standing
        # above this line it would be the one `OSError` here that never became a `Refused`.
        snapshot = tempfile.TemporaryFile()
        directory = os.open(path.parts[0], A_SEARCH | os.O_NOFOLLOW)
        for nth, part in enumerate(path.parts[1:-1], start=1):
            try:
                below = os.open(part, A_SEARCH | os.O_NOFOLLOW, dir_fd=directory)
            except OSError as why:
                raise a_refusal(why, at, Path(*path.parts[:nth + 1]), part, directory) from why
            os.close(directory)
            directory = below
        try:
            descriptor = os.open(path.parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                                 dir_fd=directory)
        except OSError as why:
            raise a_refusal(why, at, path, path.parts[-1], directory) from why
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise OSError("it is not a regular file")
        with contextlib.suppress(OSError):
            fcntl.fcntl(descriptor, fcntl.F_SETFL,
                        fcntl.fcntl(descriptor, fcntl.F_GETFL) & ~os.O_NONBLOCK)
        with os.fdopen(descriptor, "rb") as reading:
            descriptor = None                      # the file object owns the descriptor from here
            while size <= expected:
                block = reading.read(min(A_BLOCK, expected + 1 - size))
                if not block:
                    break
                size += len(block)
                digest.update(block)
                snapshot.write(block)
    except Refused:
        # Already in words of our own, from the walk above. Named before the pair below it so the
        # snapshot is let go of on this path too: a refusal that leaked one would leave a temporary
        # file open for as long as this process lives, which is months.
        if snapshot is not None:
            snapshot.close()
        raise
    except (OSError, ValueError) as why:
        if snapshot is not None:
            snapshot.close()
        raise Refused(f"could not attach {at}: {why}") from why
    finally:
        if directory is not None:
            os.close(directory)
        if descriptor is not None:
            os.close(descriptor)

    if size != expected or digest.hexdigest() != wanted:
        snapshot.close()
        raise Refused(f"could not attach {at}: it changed after it was approved")
    snapshot.seek(0)
    return snapshot, a_plain_name(said, path)


def a_plain_name(said: Dict[str, Any], path: Path) -> str:
    """What the file is called on the platform: rundesk's name, taken as a bare name even so.

    Rundesk has already made this its own, and it is taken apart again here because a filename with
    a separator in it is a filename pretending to be somewhere.
    """
    return Path(str(said.get("name") or path.name)).name


def a_refusal(why: OSError, at: str, standing: Path, part: str, directory: int) -> Refused:
    """Why one component would not re-open, named as the thing it was rather than as a link.

    Both halves are in here because the incident this shape was written for was read as a symbolic
    link on a directory that never was one: the sentence carries the errno, names the component, and
    says which side of the seam refused.

    **Naming the component the open failed on is not the same as naming the component at fault.** A
    descriptor held on a directory this process cannot search refuses every lookup made through it,
    so the error surfaces on the child while the mode bit is on the parent — which is what `O_PATH`
    hands back on Linux for a directory `O_SEARCH` refuses outright on macOS. So the directory above
    is asked first, and the sentence names the same component on either platform.
    """
    code = errno.errorcode.get(why.errno or 0) or f"errno {why.errno}"
    if why.errno == errno.ELOOP or (why.errno == errno.ENOTDIR and a_link(part, directory)):
        # A link opened `O_NOFOLLOW | O_DIRECTORY` answers `ENOTDIR` here and one opened as a file
        # answers `ELOOP`, so the component is asked about after it has already been refused. This
        # is exactly the replacement the second check exists to catch, and it is worth saying so.
        return Refused(f"could not attach {at}: the adapter re-opened it and found a symbolic link "
                       f"at {standing}, which no component of an approved path may be ({code})")
    if why.errno in (errno.EPERM, errno.EACCES):
        if not a_reached(part, directory):
            return Refused(f"could not attach {at}: the adapter cannot search {standing.parent} "
                           f"({code}), so {standing} under it was never reached — the refusal "
                           f"belongs to that directory above rather than to what was named under "
                           f"it, it is not a link, and this adapter's own process is what was "
                           f"refused")
        return Refused(f"could not attach {at}: the adapter may not open {standing} ({code}) — a "
                       f"refusal to read, not a link, and this adapter's own process is what was "
                       f"refused")
    if why.errno == errno.ENOENT:
        return Refused(f"could not attach {at}: {standing} was there when it was approved and is "
                       f"not there now ({code})")
    return Refused(f"could not attach {at}: the adapter could not open {standing} "
                   f"({code}: {why.strerror or why})")


def a_link(part: str, directory: int) -> bool:
    """Whether this component is a symbolic link, asked only to word a refusal already decided."""
    try:
        return stat.S_ISLNK(os.lstat(part, dir_fd=directory).st_mode)
    except OSError:
        return False


def a_reached(part: str, directory: int) -> bool:
    """Whether this component could be looked up at all in the directory above it.

    A lookup needs search permission on the directory it is asked of and none whatever on what it
    finds, so a refusal here belongs to the directory above and a success leaves the refusal with
    the component itself. Asked only to word a refusal already decided.
    """
    try:
        os.lstat(part, dir_fd=directory)
    except OSError as why:
        return why.errno not in (errno.EACCES, errno.EPERM)
    return True


def rundesk_says(stream: Any, most: int = READS_MOST):
    """Every line rundesk says, holding no more than `most` bytes of any one of them.

    **Bounded on this side too.** Rundesk bounds what it reads from an adapter for a reason that
    faces both ways: a reader with no ceiling grows until the kernel ends the process, and the
    failure looks exactly like a hang. What is over the bound is thrown away with a line saying so,
    and reading carries on — one unreadable line is not a channel going away.

    **`read1` and not `read`, and this is the whole of the difference between a channel that answers
    and one that does not.** `sys.stdin.buffer` is a `BufferedReader`, and its `read(n)` is defined
    to return `n` bytes: handed a pipe, it blocks until that many have arrived or the far side
    closes. Rundesk speaks in single JSON lines of a few hundred bytes, so asking for `READ_BLOCK`
    of them means the first delivery is not read until sixty-four kilobytes of later ones have
    piled up behind it — which is never, on a channel answering one person. `read1` asks for at
    most that many and returns what one read gives, which is the line that just arrived.

    Measured against a real pipe: one 66-byte record was written and the reader stayed inside
    `read` until the pipe was padded to `READ_BLOCK`. A stream with no `read1` — a stand-in, or a
    file — keeps `read`, which is exact for both.
    """
    reading = getattr(stream, "read1", None) or stream.read
    held = bytearray()
    dropping = False
    complained = False

    def lost() -> bool:
        """Say a line could not be read whole — **once**, however many of them there are.

        A sender in this state produces a line per megabyte, and the log is not where that belongs.
        """
        nonlocal complained
        if not complained:
            complained = True
            noted("rundesk said more in one line than is read at once, so it was thrown away",
                  "error")
        return True

    while True:
        block = reading(READ_BLOCK)
        if not block:
            break
        held += block
        while True:
            at = held.find(b"\n")
            if at < 0:
                break
            line, held = bytes(held[:at]), held[at + 1:]
            if dropping:
                dropping = False           # the tail of a line already thrown away
                continue
            # **The whole line is measured, not only what was held when the newline arrived.** A
            # line that came in one block was under no ceiling at all before this, so the guard
            # protected against a sender that never wrote a newline and against nothing else.
            if len(line) > most and lost():
                continue
            yield line.decode("utf-8", "replace")
        if len(held) > most:
            held.clear()
            dropping = True
            lost()
    if held and not dropping and len(held) <= most:
        yield bytes(held).decode("utf-8", "replace")


# ---------------------------------------------------------------------------------------------
# Question one: what can you do?
# ---------------------------------------------------------------------------------------------


def capabilities() -> int:
    """Say what this can do, and nothing else. No network, no account, no dependency."""
    say(CAPABILITIES)
    return 0


# ---------------------------------------------------------------------------------------------
# Question two: can you reach it, and what did you find?
# ---------------------------------------------------------------------------------------------


def check(options: List[str]) -> int:
    """Sign in, and report what was found, so that a person confirms rather than pastes.

    **`ok: false` still exits `0`.** What is read is the object and not the code: a program that
    printed `ok: false` *refused*, one that died without printing anything *failed*, and those two
    lead somewhere different. Every return below is `0` for that reason.

    Nothing about this channel is written down unless this says yes, so the whole of an owner's
    diagnosis is the sentence that comes back: it says what was wrong rather than that something was.
    """
    if options:
        return _refused(f"this channel takes no options and was given {' '.join(options)} — a "
                        f"channel here is a connection rather than a place, so there is nothing to "
                        f"point it at and nothing to configure")
    missing = the_library()
    if missing:
        return _refused(missing)
    bot, app = the_tokens()
    trouble = _token_trouble(bot, app)
    if trouble:
        return _refused(trouble, secret=True)

    senders, places = who_may_reach(), which_places()
    if not senders and not places:
        return _refused("nothing said who may reach this agent, so there is nobody to open a "
                        "private conversation with and no channel to answer in — a channel needs at "
                        "least the owner's own Slack member id")

    web = WebClient(token=bot, timeout=CALL_WITHIN)
    try:
        who = web.auth_test()
    except Exception as why:               # noqa: BLE001 — a platform boundary, and the diagnosis
        return _refused(_why_slack_refused(why), secret=_will_not_come_right(why) != "")
    if not who.get("bot_id"):
        return _refused(f"the token in {BOT_TOKEN_FROM} signed in as a person rather than as an "
                        f"app — a Rundesk agent is a Slack App with its own bot user, and a user "
                        f"token would give it that person's own view of the workspace", secret=True)

    lacking = _scopes_lacking(who)
    if lacking:
        return _refused(
            f"this app has not been granted {', '.join(sorted(lacking))} — reinstall it to the "
            f"workspace after adding the missing bot scopes, because a scope added in the app's "
            f"settings does not reach a token that was issued before it")

    try:
        web.apps_connections_open(app_token=app)
    except Exception as why:               # noqa: BLE001 — a platform boundary
        return _refused(f"the bot token was accepted and the app-level token in {APP_TOKEN_FROM} "
                        f"was not — Socket Mode has to be switched on for this app, and its token "
                        f"carries the `connections:write` scope ({_why_slack_refused(why)})",
                        secret=True)

    team = str(who.get("team_id") or "")
    try:
        landing = _where_it_writes(web, team, senders, places)
    except Exception as why:               # noqa: BLE001 — a platform boundary
        return _refused(f"could not open the conversation unprompted things would be written to: "
                        f"{_why_slack_refused(why)}")

    say({"ok": True,
         "describes": _what_it_reached(who, web, places),
         "notify_place": landing,
         # **`max_text` is reported here because it is the one capability rundesk keeps.** It is read
         # out of a channel's settings and is what turn answers are split to; without it every answer
         # would be cut at the flat 2000 rundesk assumes of a platform that said nothing.
         "settings": {"max_text": MAX_TEXT},
         "secret": {"env": [BOT_TOKEN_FROM, APP_TOKEN_FROM]},
         "invite": ""})
    return 0


def _token_trouble(bot: str, app: str) -> str:
    """Why these two are not a bot token and an app-level token, or `""` when they are.

    Checked before anything is called, because `auth.test` answers `ok` for a user token as readily
    as for a bot one — so the only place the difference can be named is here, in front.
    """
    if not bot and not app:
        return (f"there are no Slack tokens — nothing set {BOT_TOKEN_FROM} or {APP_TOKEN_FROM}, and "
                f"this needs both: the app-level token opens the socket and the bot token answers")
    if not bot:
        return f"there is no bot token — nothing set {BOT_TOKEN_FROM}"
    if not app:
        return (f"there is no app-level token — nothing set {APP_TOKEN_FROM}, which is the "
                f"`{APP_TOKEN_STARTS}…` token that opens Socket Mode and is not the bot token")
    if bot.startswith(USER_TOKEN_STARTS):
        return (f"{BOT_TOKEN_FROM} holds a user token — one of those carries a *person's* own view "
                f"of the workspace, including every direct message they can read, and no Rundesk "
                f"agent is ever given one. Use the bot token, which begins `{BOT_TOKEN_STARTS}`")
    if not bot.startswith(BOT_TOKEN_STARTS):
        return (f"{BOT_TOKEN_FROM} does not hold a bot token — a bot token begins "
                f"`{BOT_TOKEN_STARTS}` and is found under OAuth & Permissions")
    if not app.startswith(APP_TOKEN_STARTS):
        return (f"{APP_TOKEN_FROM} does not hold an app-level token — one begins "
                f"`{APP_TOKEN_STARTS}` and is made under Basic Information → App-Level Tokens with "
                f"the `connections:write` scope")
    return ""


def _scopes_lacking(who: Any, wanted: Any = WANTED_SCOPES) -> List[str]:
    """Which of the scopes asked about the token was not granted, read off Slack's own header.

    **Empty when the header is not there**, which is not the same as everything being granted: it is
    everything this can *establish*, and refusing a connection over a header that could not be read
    would turn a working setup into one nobody can explain. Where it is there, this is the one place
    an owner is told before three in the morning — a scope added in an app's settings does not reach
    a token that was issued before it, and the symptom is one call refusing for ever.

    **One reader for two questions, because there is one header.** `--check` asks about
    `WANTED_SCOPES` and refuses on what is missing; `search` and `fetch` ask about `FURTHER_SCOPES`
    and degrade on it. A second way to read the same header is a second way to be wrong about it,
    and the two would eventually disagree about the same token.
    """
    headers = getattr(who, "headers", None) or {}
    granted = str(headers.get("x-oauth-scopes") or headers.get("X-OAuth-Scopes") or "")
    if not granted.strip():
        return []
    held = {one.strip() for one in granted.split(",") if one.strip()}
    return [one for one in wanted if one not in held]


def _where_it_writes(web: Any, team: str, senders: List[str], places: List[str]) -> str:
    """Where unprompted things land: the owner's own direct message, or the first allowed channel.

    **The owner first wherever there is one.** A gateway coming up is answering nobody, and news
    nobody asked for belongs in the one conversation only the owner can read. A channel configured
    with places alone has no such conversation, and the first allowed place is the honest second
    answer rather than a refusal.
    """
    if senders:
        opened = web.conversations_open(users=senders[0])
        return conversation_of(team, str((opened.get("channel") or {}).get("id") or ""))
    return conversation_of(team, places[0])


def _what_it_reached(who: Any, web: Any, places: List[str]) -> str:
    """The one line of this answer a person is ever shown, and where a standing caveat rides.

    `channels add` prints it, `channels show` keeps it and `channels doctor` repeats it — so
    anything an owner still has to go and do belongs here rather than in prose nobody will read. The
    thing they most often still have to do is invite the bot: a Slack App installed into a workspace
    is in no channel until somebody adds it to one.
    """
    said = f"{who.get('user') or 'this app'} in {who.get('team') or 'a Slack workspace'}"
    outside = []
    for place in places[:CONTEXT_MOST]:
        try:
            found = web.conversations_info(channel=place).get("channel") or {}
        except Exception:                  # noqa: BLE001 — a caveat, never a refusal
            outside.append(place)
            continue
        if not found.get("is_member"):
            outside.append(place)
    if outside:
        return (f"{said} — it is not in {', '.join(outside)} yet, so invite it there with "
                f"`/invite @{who.get('user') or 'the bot'}` before anybody expects an answer")
    return said


def _a_session(channel: str, thread: str) -> str:
    """The one key a session is remembered under. A channel and the thread in it, and never one.

    Two threads in a channel are two sessions to Slack, so a refusal about one of them is not a
    refusal about the other — keying on the channel alone would be the scope mistake this exists to
    prevent, one level down from the one the embargo exists to get right.
    """
    return f"{channel}/{thread}"


def _slack_said(why: Any) -> str:
    """Slack's own word for a refusal, or `""` where it gave none.

    One reader, because three callers need the same string for three different decisions — whether
    to stop for good, whether to try again, and what to put in a sentence a person reads.
    """
    answered = getattr(why, "response", None)
    if answered is None or not hasattr(answered, "get"):
        return ""
    return str(answered.get("error") or "")


def _will_not_come_right(why: Any) -> str:
    """Slack's own word for a refusal nothing here can get past, or `""`."""
    said = _slack_said(why)
    return said if said in WILL_NOT_COME_RIGHT else ""


def _why_slack_refused(why: Any) -> str:
    """What Slack said, as a sentence rather than as an error code nobody can look up."""
    final = _will_not_come_right(why)
    if final:
        return f"Slack answered {final}: {WILL_NOT_COME_RIGHT[final]}"
    said = _slack_said(why)
    if said:
        return f"Slack answered {said}"
    return f"could not reach Slack: {type(why).__name__}: {why}"


def _refused(why: str, secret: bool = False) -> int:
    """One shape for every way this comes back no, so that no path here has to build one.

    **The credential names come back on a refusal too**, and that is the whole of how rundesk knows
    what to ask a person for without holding a list of what any platform wants: an adapter that
    answers `ok: false` and names the variables it looked in gets a prompt and a second `--check`.
    """
    said: Dict[str, Any] = {"ok": False, "why": why}
    if secret:
        said["secret"] = {"env": [BOT_TOKEN_FROM, APP_TOKEN_FROM]}
    say(said)
    return 0


# ---------------------------------------------------------------------------------------------
# Question four: look through what this bot was invited to, and say how far you got.
# ---------------------------------------------------------------------------------------------


class Asked(NamedTuple):
    """One search request as rundesk writes it, with nothing left for this file to guess at.

    **Every field is always on the wire and `""` means unscoped.** A scope has no third meaning —
    an absent place and an empty place both mean *everywhere this bot can reach* — so nothing here
    has to decide what a missing key would have meant.
    """

    #: What to look for. Every word of it has to be in a message, in any order and ignoring case.
    words: str
    #: One Slack conversation id, or `""` for every place this bot is party to.
    place: str
    #: One Slack member id, or `""` for anybody.
    user: str
    #: The inclusive first and last day, `YYYY-MM-DD` in UTC, or `""` for unbounded.
    since: str
    until: str
    #: How many results to answer with.
    most: int


def search() -> int:
    """Look through what this bot was invited to, and be exact about how far that got.

    **Slack publishes no search this may call, so this one is fetch and filter.**
    `assistant.search.context` needs an `action_token` minted by an inbound message event, which a
    bounded program started afterwards does not have and cannot obtain; `search.messages` is
    user-token-only, and a user token is the one thing this adapter refuses by name. So what stands
    behind the `search` capability is `users.conversations` and `conversations.history`, bounded by
    a budget of this program's own and honest about where it stopped.

    **Four outcomes, and none of them may be read as another.** *Found* is `ok` with results and an
    empty `partial`; *found nothing* is `ok`, no results and an empty `partial`, and it means the
    search really did look everywhere it was asked to; *looked as far as it could* is `ok` with a
    `partial` sentence, with or without results; *could not look* is `ok: false` and a `why`. The
    third is the one that costs the most to get wrong: an agent reading a spent budget as an
    absence of conversation concludes a thing was never discussed, which is the single worst answer
    this capability can give.

    **`ok: false` still exits `0`**, exactly as `--check` does. What is read is the object, not the
    code: a program that printed `ok: false` refused, and one that died without printing anything
    failed.
    """
    missing = the_library()
    if missing:
        return _refused(missing)
    bot, _app = the_tokens()
    if not bot:
        return _refused(f"there is no bot token — nothing set {BOT_TOKEN_FROM}. A search reaches "
                        f"Slack with the same credential this channel connects with, so there is "
                        f"nothing here to look with")
    try:
        asked = _asked(_one_request())
    except Refused as why:
        return _refused(str(why))
    # **Its own ceiling, the way `check` builds one.** `CALL_WITHIN` is right for a call nobody is
    # waiting behind; a call inside a budget this program has to answer within cannot be allowed to
    # spend the whole of it.
    web = WebClient(token=bot, timeout=A_LOOK_WITHIN)
    try:
        who = web.auth_test()
    except Exception as why:               # noqa: BLE001 — a platform boundary, and the diagnosis
        return _refused(_why_slack_refused(why))
    try:
        return Looking(web, who, asked).run()
    except Refused as why:
        return _refused(str(why))


class Looking:
    """One search: what it may reach, what it has spent, and what it actually examined.

    Held together rather than passed along because a search is one budget, two name caches and a
    handful of counters, and every step of it needs all of them. Nothing here outlives the one
    invocation, so the caches are asked of Slack once per id and never bounded further.
    """

    def __init__(self, web: Any, who: Any, asked: Asked) -> None:
        self.web = web
        self.asked = asked
        #: The two ids Slack gives this app for itself, from `auth.test` and never inferred. Both,
        #: because a message this bot posted carries the first and may carry the second.
        self.ours = str(who.get("user_id") or "")
        self.our_bot = str(who.get("bot_id") or "")
        #: Which of the four further scopes this token demonstrably lacks. **Empty where Slack's
        #: header could not be read**, which is everything this can establish rather than a claim
        #: that everything was granted — so a call is attempted and its own refusal is what becomes
        #: a sentence, rather than a scope being invented either way.
        self.lacking = set(_scopes_lacking(who, FURTHER_SCOPES))
        #: The monotonic moment this stops looking, whatever it has by then.
        self.deadline = time.monotonic() + LOOKING_WITHIN
        self.people: Dict[str, str] = {}
        self.rooms: Dict[str, Tuple[str, bool, bool]] = {}
        #: What was really examined. **`measured` is the difference between said-zero and
        #: said-nothing**: a search that never established a list of places to walk reports no
        #: `looked` at all, because rundesk reads an absent count as *did not say* and a zero as
        #: *looked nowhere*, and those are two different answers.
        self.measured = False
        self.places_looked = 0
        self.messages_looked = 0
        #: How many threads have been opened, and whether that ceiling stopped any being opened.
        self.threads_read = 0
        self.crowded_threads = False
        #: Why it stopped, each held as a flag and turned into a sentence once, in `_partial`, so
        #: that the order an agent reads them in is decided in one place.
        self.ran_out = False
        self.places_left = 0
        self.limited = False
        self.filled = False
        self.deep = 0
        self.crowded = False
        self.unlisted: List[str] = []
        self.cannot_list = ""
        self.unread = 0
        self.why_unread = ""
        self.window_said = ""
        #: Set by anything that ends the walk where it stands: the budget, or a rate limit.
        self.stop_now = False

    # -- the whole of one search -----------------------------------------------------------

    def run(self) -> int:
        """Walk what may be walked, then answer once with what was found and where it stopped."""
        begins, ends = self._window()
        places = self._places()
        found: List[Dict[str, Any]] = []
        left = list(places or [])
        while left:
            if self._spent():
                self.ran_out, self.places_left = True, len(left)
                break
            if len(found) >= self.asked.most:
                self.filled, self.places_left = True, len(left)
                break
            found.extend(self._through(left.pop(0), begins, ends))
            if self.stop_now:
                self.places_left = len(left)
                break
        # Newest first across every place at once, and only then cut. A result is worth more for
        # being recent, and cutting per place would answer with the newest of the first place
        # rather than the newest of the search.
        found.sort(key=lambda one: _as_a_number(str(one.get("ts") or "")), reverse=True)
        said: Dict[str, Any] = {"ok": True,
                                "results": [self._a_result(one) for one in found[:self.asked.most]],
                                "partial": self._partial()}
        if self.measured:
            said["looked"] = {"places": self.places_looked, "messages": self.messages_looked}
        say(said)
        return 0

    def _spent(self) -> bool:
        """Whether the budget is gone. **Measured on the monotonic clock**, so the machine's wall
        clock moving — a daylight change, an NTP correction — can neither cut a search short nor
        strand one."""
        return time.monotonic() >= self.deadline

    # -- the days it covers ----------------------------------------------------------------

    def _window(self) -> Tuple[float, float]:
        """The first second the search covers and the first second past it, both in UTC.

        **Slack is handed these as a hint and this side does the filtering.** `oldest` and `latest`
        are exclusive on `conversations.history`, so a bound handed over exactly would drop a
        message standing on the boundary; a second of slack on the way out and an exact comparison
        on the way back gets the inclusive days that were asked for.

        **A defaulted window is always stated in `partial`.** An agent that was not told the search
        covered thirty days reads *nothing was found* as *nothing was ever said*, and there is no
        way for it to find out otherwise.
        """
        ends = (_midnight(self.asked.until) + A_DAY) if self.asked.until else time.time()
        if self.asked.since:
            return _midnight(self.asked.since), ends
        begins = ends - LOOKED_BACK_DAYS * A_DAY
        self.window_said = (f"Nothing said how far back to look, so this searched the "
                            f"{LOOKED_BACK_DAYS} days ending {_a_day(ends - 1)} (UTC) and no "
                            f"further.")
        return begins, ends

    # -- where it looks --------------------------------------------------------------------

    def _places(self) -> Optional[List[str]]:
        """Every conversation this search will walk, or `None` where it could not establish one.

        **A place named outright is read and never listed.** Enumeration and reading are two scopes
        and two failures: a bot holding `groups:history` and no `groups:read` can read the private
        channel it was pointed at perfectly well, and refusing that because it cannot go looking for
        others would be one failure standing in for another.

        `None` rather than `[]` where nothing could be listed at all, because those are two answers:
        an empty list is *this bot is party to nothing*, which is a measurement, and `None` is *this
        never established what it was party to*, which is not one.
        """
        if self.asked.place:
            # One place named outright is a reach this search established, so what it examines is
            # measured — `looked` is left out only where no list of places was ever arrived at.
            self.measured = True
            return [self.asked.place]
        kinds = []
        for kind, listing, reading, called in EVERY_KIND:
            missing = listing if listing in self.lacking else (
                reading if reading in self.lacking else "")
            if missing:
                self.unlisted.append(WITHOUT_SCOPE.format(what=called, scope=missing))
                continue
            kinds.append(kind)
        if not kinds:
            return None
        found: List[str] = []
        listed = False
        cursor = ""
        for _ in range(PLACES_PAGES):
            if self._spent():
                self.ran_out = True
                break
            asking: Dict[str, Any] = {"types": ",".join(kinds), "limit": PLACES_PAGE,
                                      "exclude_archived": True}
            if cursor:
                asking["cursor"] = cursor
            try:
                answered = self.web.users_conversations(**asking)
            except Exception as why:       # noqa: BLE001 — a platform boundary
                if not self._rate_limited(why):
                    self.cannot_list = _why_slack_refused(why)
                break
            listed = True
            for one in (answered.get("channels") or []):
                if isinstance(one, dict) and one.get("id"):
                    found.append(str(one["id"]))
            cursor = str((answered.get("response_metadata") or {}).get("next_cursor") or "")
            if not cursor or len(found) >= PLACES_MOST:
                break
        # **A cursor still in hand is more conversations, however few came back.** Slack's own
        # pagination warns that a page may hold fewer items than the limit and still carry a
        # `next_cursor` — routine with `exclude_archived` — so testing the *count* against the
        # ceiling missed the case where the pages ran out first: twenty-five of an unknown number
        # walked, and an answer that read `found nothing, and I looked everywhere`.
        if len(found) > PLACES_MOST or cursor:
            self.crowded = True
            found = found[:PLACES_MOST]
        if not listed:
            return None
        self.measured = True
        return found

    # -- what was said in one of them ------------------------------------------------------

    def _through(self, place: str, begins: float, ends: float) -> List[Dict[str, Any]]:
        """One conversation, read newest first, for as many pages as the ceilings allow.

        A conversation that will not be read is counted and reported once at the end rather than
        named: a channel id in a sentence an agent reads is one more stranger's identifier crossing
        a seam for nothing, and the fact that matters is that somewhere was not looked at.
        """
        here: List[Dict[str, Any]] = []
        cursor = ""
        for page in range(PAGES_MOST):
            if self._spent():
                self.ran_out = self.stop_now = True
                return here
            if not page:
                # **Counted once the request is about to be made, and never on the way in.** The
                # caller checks the budget too, and time passes between its check and this one — so
                # counting there reported a conversation this then never asked about as one it had
                # looked through. A place that refuses is still counted, because it was asked and it
                # answered; one that was never asked is not.
                self.places_looked += 1
            asking: Dict[str, Any] = {"channel": place, "limit": HISTORY_PAGE,
                                      "oldest": "{0:.6f}".format(max(0.0, begins - 1)),
                                      "latest": "{0:.6f}".format(ends)}
            if cursor:
                asking["cursor"] = cursor
            try:
                answered = self.web.conversations_history(**asking)
            except Exception as why:       # noqa: BLE001 — a platform boundary
                if self._rate_limited(why):
                    self.stop_now = True
                else:
                    self.unread += 1
                    self.why_unread = self.why_unread or _why_slack_refused(why)
                return here
            messages = answered.get("messages")
            for one in (messages if isinstance(messages, list) else []):
                if not isinstance(one, dict):
                    continue
                self.messages_looked += 1
                if self._matches(one, begins, ends):
                    here.append(dict(one, _place=place))
                here.extend(self._replies_to(place, one, begins, ends))
            if len(here) >= self.asked.most:
                self.filled = True
                return here
            cursor = str((answered.get("response_metadata") or {}).get("next_cursor") or "")
            if not cursor:
                return here
        self.deep += 1
        return here

    def _replies_to(self, place: str, parent: Dict[str, Any],
                    begins: float, ends: float) -> List[Dict[str, Any]]:
        """Everything said under one parent message, which `conversations.history` does not return.

        **The one Slack fact this search would otherwise get silently wrong.** `conversations.history`
        answers with parent messages only — its own reference says *"To retrieve a message from a
        thread, check out `conversations.replies`"* — and this adapter answers **every channel
        mention in a thread of its own**. So the conversations most likely to hold the agent's own
        work were exactly the ones a search could not see, and it reported that as `results: []` with
        an empty `partial`, which the contract defines as *looked everywhere you were asked to*. That
        is the one outcome the four states exist to prevent.

        **Bounded, because a thread is a second call.** A busy channel would otherwise turn one
        search into a hundred requests. When a ceiling bites, `partial` says so; a thread that will
        not open is counted with the conversations that could not be read, for the same reason those
        are counted rather than named.
        """
        at = str(parent.get("ts") or "")
        replies = parent.get("reply_count")
        if not at or not isinstance(replies, int) or isinstance(replies, bool) or replies < 1:
            return []
        if self.threads_read >= THREADS_MOST:
            self.crowded_threads = True
            return []
        if self._spent():
            self.ran_out = self.stop_now = True
            return []
        self.threads_read += 1
        try:
            answered = self.web.conversations_replies(
                channel=place, ts=at, limit=THREAD_PAGE,
                oldest="{0:.6f}".format(max(0.0, begins - 1)), latest="{0:.6f}".format(ends))
        except Exception as why:           # noqa: BLE001 — a platform boundary
            if self._rate_limited(why):
                self.stop_now = True
            else:
                self.unread += 1
                self.why_unread = self.why_unread or _why_slack_refused(why)
            return []
        found: List[Dict[str, Any]] = []
        said = answered.get("messages")
        for one in (said if isinstance(said, list) else []):
            # **The parent comes back with its own replies**, and counting or matching it twice
            # would double every threaded conversation in the answer.
            if not isinstance(one, dict) or str(one.get("ts") or "") == at:
                continue
            self.messages_looked += 1
            if self._matches(one, begins, ends):
                found.append(dict(one, _place=place))
        return found

    def _matches(self, one: Dict[str, Any], begins: float, ends: float) -> bool:
        """Whether this message is one of the ones that were asked for.

        **This app's own messages are never among them.** An agent handed its own earlier answers
        back as evidence of what a workspace discussed is an agent citing itself, and it would do it
        most in exactly the conversations it has been busiest in.
        """
        at = str(one.get("ts") or "")
        if not at or not begins <= _as_a_number(at) < ends:
            return False
        if str(one.get("subtype") or "") in NOT_SAID:
            return False
        if written_by_us(one, self.ours, self.our_bot):
            return False
        if self.asked.user and str(one.get("user") or "") != self.asked.user:
            return False
        return _holds(str(one.get("text") or ""), self.asked.words)

    # -- what one of them is answered as ---------------------------------------------------

    def _a_result(self, one: Dict[str, Any]) -> Dict[str, Any]:
        """One found message in the shape rundesk reads, with every stranger's word flattened.

        **A channel's name, a display name and a message body are all somebody else's text**, and a
        newline in any of them is how they would end our sentence and begin one of their own. Each
        goes through `flat` before it can reach a prompt.
        """
        place = str(one.get("_place") or "")
        at = str(one.get("ts") or "")
        who = str(one.get("user") or "")
        return {"who": who,
                "display": named_in(one) if one.get("bot_id") else self._a_name(who),
                "where": self._where_this_is(place),
                "external_place": place,
                "when": _when(at),
                "text": flat(one.get("text"), FOUND_TEXT),
                "link": self._a_link(place, at),
                "ref": _a_ref(place, at),
                "attachments": _attached(one.get("files"))}

    def _a_name(self, who: str) -> str:
        """What Slack shows this person as, asked once per id and remembered. Their id otherwise.

        **Not asked once the budget is spent, and their id is a whole answer.** These run after the
        walk has ended, once per person in the answer — up to a hundred of them at the ceiling
        rundesk allows — and each is bounded only by one call's own timeout. Unguarded, they ran the
        invocation past `SEARCH_WITHIN`, and what an agent then got was a program killed with
        nothing on stdout instead of the results it had already found.
        """
        if not who:
            return ""
        if who in self.people:
            return self.people[who]
        if self._spent():
            return who
        named = who
        try:
            named = named_as(self.web.users_info(user=who).get("user") or {}, who)
        except Exception:                  # noqa: BLE001 — a name, never a refusal
            pass
        self.people[who] = named or who
        return self.people[who]

    def _where_this_is(self, place: str) -> str:
        """Where this was said, in one ordinary sentence that says who can read it.

        A `D` is a direct conversation whatever else Slack will say about it, and the fallback for
        a room claims the narrower audience rather than the wider one — the sentence for an
        externally shared channel warns a brain that strangers are reading, and inventing that
        warning from a call that did not answer would teach it to distrust the words.
        """
        if place.startswith("D"):
            return "a direct message, which nobody else can read"
        if place in self.rooms:
            named, private, external = self.rooms[place]
        elif self._spent():
            # The same rule `_a_name` and `_a_link` are held to, and the same reason: this runs
            # after the walk, and a call made past the budget is one rundesk never sees the answer
            # to. The fallback claims the narrower audience, so nothing is invented by not asking.
            return a_place("", place.startswith("G"), False)
        else:
            named, private, external = "", place.startswith("G"), False
            try:
                found = self.web.conversations_info(channel=place).get("channel") or {}
                named, private, external = a_room_from(found)
            except Exception:              # noqa: BLE001 — a name, never a refusal
                pass
            self.rooms[place] = (named, private, external)
        return a_place(named, private, external)

    def _a_link(self, place: str, at: str) -> str:
        """Slack's own permalink, asked **only for the results being returned and no others**.

        `""` for any refusal and for a budget already spent, and that is a whole answer rather than
        a failure: `external_place` and `ref` are what this message is reached by again, and both
        are always there.
        """
        if not place or not at or self._spent():
            return ""
        try:
            return str(self.web.chat_getPermalink(
                channel=place, message_ts=at).get("permalink") or "")
        except Exception:                  # noqa: BLE001 — a link, never a failure
            return ""

    # -- where it stopped ------------------------------------------------------------------

    def _rate_limited(self, why: Any) -> bool:
        """Whether Slack asked us to slow down. **Never waited out, never retried.**

        The pause Slack asks for is routinely longer than this whole budget, so sleeping it off
        inside a bounded program means being killed instead of answering. It ends the search and
        becomes a sentence, which is the outcome an agent can act on.
        """
        if _slack_said(why) != RATE_LIMITED:
            return False
        self.limited = True
        return True

    def _partial(self) -> str:
        """Everything this search did not do, most important first, or `""` where it did it all.

        **Ordered deliberately.** Rundesk flattens and clips this to one bounded line, so what
        leads has to be the thing an agent acts on: that the search stopped before it finished
        beats how it was bounded, which beats what window it used.

        `""` here is a claim and not an absence — it says the search looked everywhere it was asked
        to and this is the whole answer. Nothing returns it unless every one of these is false.
        """
        said = []
        if self.ran_out:
            said.append(f"This search stopped after {int(LOOKING_WITHIN)}s with "
                        f"{self.places_left} conversations still to look in.")
        if self.limited:
            said.append("Slack rate-limited this search; a bounded program does not wait one out, "
                        "so it stopped where it was.")
        if self.filled:
            said.append(f"This search stopped once it had the {self.asked.most} results it was "
                        f"asked for, so there may be more.")
        if self.deep:
            said.append(f"{self.deep} conversations hold more than "
                        f"{PAGES_MOST * HISTORY_PAGE} messages in that window and were read only "
                        f"that far back.")
        if self.crowded_threads:
            said.append(f"More than {THREADS_MOST} threads held replies in that window and only "
                        f"that many were opened, so some replies were not read.")
        if self.crowded:
            said.append(f"This bot is party to more than {PLACES_MOST} conversations and only that "
                        f"many were looked in.")
        if self.cannot_list:
            said.append(f"The conversations this bot is party to could not be listed, so nothing "
                        f"was looked through: {self.cannot_list}.")
        if self.unread:
            said.append(f"{self.unread} conversations could not be read: {self.why_unread}.")
        said.extend(self.unlisted)
        if self.window_said:
            said.append(self.window_said)
        return " ".join(said)


# ---------------------------------------------------------------------------------------------
# Question five: bring in the files on one message that was found.
# ---------------------------------------------------------------------------------------------


def fetch() -> int:
    """Stage the attachments of one message a search found, inside this channel's own directory.

    **A second act rather than a field on a result**, because answering a question about words by
    downloading every file of every result is spending somebody's bandwidth on a question nobody
    asked.

    **This stages and rundesk lands.** The adapter holds the credential and rundesk holds the
    filesystem, which is the division the arriving path already makes: this writes into
    `RUNDESK_CHANNEL_HOME` under a name of no consequence and says where, and rundesk proves the
    path is contained and holds the bytes Slack said it would — against the file, never against
    what this claimed about it. **Rundesk removes what is staged**, whether it takes it or refuses
    it, so nothing here cleans up after itself and nothing here reports a path it did not write.

    **A file that will not come is a line in `partial` and never a refusal of the whole fetch.**
    The other files are still worth having, and the one that did not come is named.
    """
    missing = the_library()
    if missing:
        return _refused(missing)
    bot, _app = the_tokens()
    if not bot:
        return _refused(f"there is no bot token — nothing set {BOT_TOKEN_FROM}. A file is fetched "
                        f"with the same credential this channel connects with, so there is nothing "
                        f"here to fetch it with")
    try:
        asked = _one_request()
        place, at = _the_message(str(asked.get("ref") or ""))
    except Refused as why:
        return _refused(str(why))
    home = (os.environ.get("RUNDESK_CHANNEL_HOME") or "").strip()
    if not home or not Path(home).is_absolute():
        return _refused("nothing said where this channel may put what it fetches — "
                        "RUNDESK_CHANNEL_HOME has to name this channel's own directory by an "
                        "absolute path, and a file put anywhere else is one rundesk will not take")
    web = WebClient(token=bot, timeout=A_LOOK_WITHIN)
    try:
        who = web.auth_test()
    except Exception as why:               # noqa: BLE001 — a platform boundary
        return _refused(_why_slack_refused(why))
    if "files:read" in set(_scopes_lacking(who, WANTED_SCOPES)):
        return _refused(WITHOUT_FILES)
    try:
        # Slack's own way of naming one message: the same second at both ends, and inclusive.
        answered = web.conversations_history(channel=place, oldest=at, latest=at,
                                             inclusive=True, limit=1)
    except Exception as why:               # noqa: BLE001 — a platform boundary
        return _refused(f"could not read the message that reference names: "
                        f"{_why_slack_refused(why)}")
    found = None
    for one in (answered.get("messages") or []):
        if isinstance(one, dict) and str(one.get("ts") or "") == at:
            found = one
            break
    if found is None:
        return _refused(f"no message stands at {place}{REF_IN}{at} — it may have been deleted, or "
                        f"this app may no longer be in that conversation")
    brought, stopped = _staged(found, bot, Path(home) / FETCHED_IN / at)
    say({"ok": True, "message": at, "attachments": brought, "partial": " ".join(stopped)})
    return 0


def _staged(found: Dict[str, Any], bot: str,
            into: Path) -> Tuple[List[Dict[str, Any]], List[str]]:
    """Every file on this message that came, and a line for each one that did not.

    **What Slack declared, never what this measured.** Rundesk checks the declared size against the
    file it lands, and a number taken from this program's own `stat()` would make that check compare
    rundesk's measurement with rundesk's measurement — it would agree always, and a documented
    guarantee would have no way to fire. Left out entirely where Slack declared nothing, because
    said-nothing and said-zero are different answers and rundesk reads an absent one as the first.
    """
    files = found.get("files")
    files = files if isinstance(files, list) else []
    brought: List[Dict[str, Any]] = []
    stopped: List[str] = []
    for nth, one in enumerate(files[:BROUGHT_MOST]):
        if not isinstance(one, dict):
            continue
        name = flat(one.get("name") or one.get("title") or str(nth))
        size = one.get("size")
        declared = size if isinstance(size, int) and not isinstance(size, bool) and size > 0 else 0
        url = str(one.get("url_private_download") or one.get("url_private") or "")
        if not url:
            stopped.append(f"Could not bring in {name}: Slack published no download url for it.")
            continue
        if declared > BROUGHT_BYTES:
            stopped.append(f"Could not bring in {name}: Slack says it is {declared} bytes, past "
                           f"the {BROUGHT_BYTES} one message may bring in.")
            continue
        at = into / str(nth)
        try:
            into.mkdir(parents=True, exist_ok=True)
            _brought_in(url, bot, at)
        except Refused as why:
            _dropped(at)
            stopped.append(f"Could not bring in {name}: {why}.")
            continue
        except Exception as why:           # noqa: BLE001 — a platform boundary
            # **Nothing is left behind on the way out.** A path this never reports is a path rundesk
            # never hears of, so the sweep that removes every staged file it was told about cannot
            # remove this one. Dropped by hand, or it is debris for the life of the install.
            _dropped(at)
            stopped.append(f"Could not bring in {name}: {type(why).__name__}: {why}.")
            continue
        said: Dict[str, Any] = {"at": str(at), "name": name}
        if declared:
            said["bytes"] = declared
        brought.append(said)
    if len(files) > BROUGHT_MOST:
        stopped.append(f"{len(files)} files are on that message and only the first {BROUGHT_MOST} "
                       f"were brought in.")
    return brought, stopped


def _not_a_slack_file(url: str) -> str:
    """Why this is not a link to a file on Slack, or `""` when it is.

    A host is matched on its labels rather than on how the name ends, so `slack.com.example.invalid`
    is not `slack.com` — the string test that reads as obviously right is the one that lets a
    lookalike through.
    """
    try:
        where = urlparse(url)
    except ValueError:
        return "the link Slack gave for it could not be read as one"
    if where.scheme.lower() != FETCHED_OVER:
        return (f"the link Slack gave for it is not {FETCHED_OVER}, and nothing else is fetched "
                f"from — a file this program may open is not a file somebody sent")
    host = (where.hostname or "").lower()
    if not any(host == one or host.endswith("." + one) for one in FETCHED_FROM):
        return "the link Slack gave for it does not point at Slack, so nothing was fetched from it"
    return ""


def _brought_in(url: str, bot: str, at: Path) -> None:
    """One Slack file onto the disk, refused the moment it is past what may be brought in.

    **The bot token goes in the header and never in the url.** A `url_private_download` is not a
    signed link: it answers with an HTML sign-in page to anyone who asks for it unauthenticated, and
    a query-string credential is one that lands in every log between here and Slack.

    **Bounded while it is being read rather than afterwards.** A platform that declared a small file
    and sends an enormous one is otherwise thirty-two megabytes of somebody's disk before anything
    notices, and the refusal has to happen where the writing does.

    **And the link is checked before it is opened**, because it is the one value out of Slack's JSON
    this used on trust — see `FETCHED_FROM` for the two things that made that matter.
    """
    trouble = _not_a_slack_file(url)
    if trouble:
        raise Refused(trouble)
    request = Request(url, headers={"Authorization": f"Bearer {bot}"})
    written = 0
    with contextlib.closing(urlopen(request, timeout=A_DOWNLOAD_WITHIN)) as answering:
        # **Where it ended up, checked again.** A redirect is followed before this side sees the
        # answer, and `urllib` carries the `Authorization` header across it — so the host that
        # really answered is the one that has to be a Slack host, not the one that was asked.
        landed = _not_a_slack_file(str(getattr(answering, "url", url) or url))
        if landed:
            raise Refused(landed)
        with open(str(at), "wb") as into:
            while True:
                block = answering.read(A_BLOCK)
                if not block:
                    break
                written += len(block)
                if written > BROUGHT_BYTES:
                    raise Refused(f"it is past the {BROUGHT_BYTES} bytes one message may bring in")
                into.write(block)


def _dropped(at: Path) -> None:
    """Remove a staged file that will not be reported, and never one that will."""
    with contextlib.suppress(OSError):
        at.unlink()


# ---------------------------------------------------------------------------------------------
# What the two of them are asked, and how each answer is shaped.
# ---------------------------------------------------------------------------------------------


def _one_request(stream: Any = None) -> Dict[str, Any]:
    """The one JSON object rundesk wrote on this program's standard input.

    Bounded on the way in: rundesk writes a request of at most sixteen kilobytes and closes the
    pipe behind it, and `READS_MOST` is here so that an input nothing closes cannot grow this
    process without bound.
    """
    said = (stream if stream is not None else sys.stdin).read(READS_MOST)
    try:
        asked = json.loads(said or "")
    except (TypeError, ValueError) as why:
        raise Refused(f"what arrived on this program's input is not JSON ({why})") from why
    if not isinstance(asked, dict):
        raise Refused("what arrived on this program's input is not a JSON object")
    return asked


def _asked(said: Dict[str, Any]) -> Asked:
    """One request object as the search it asks for, trusting no type it was handed.

    Every bound rundesk applies is applied again here. That is not distrust of rundesk: this is a
    program anything on the machine may run, and a bound that only holds when the caller applied it
    is not a bound.
    """
    most = said.get("limit")
    if isinstance(most, bool) or not isinstance(most, int):
        most = RESULTS_UNSAID
    return Asked(words=str(said.get("words") or "")[:WORDS_MOST],
                 place=str(said.get("place") or ""),
                 user=str(said.get("user") or ""),
                 since=str(said.get("since") or ""),
                 until=str(said.get("until") or ""),
                 most=max(1, min(most, RESULTS_MOST)))


def _holds(said: str, words: str) -> bool:
    """Whether this message answers the words asked for: **every one of them, in any order,
    ignoring case**.

    The plainest rule that cannot surprise, and it is this file's because Slack publishes no search
    a bot token may call. An empty ask matches everything, exactly as an empty place and an empty
    person do — `""` means unscoped in all three.
    """
    wanted = words.lower().split()
    if not wanted:
        return True
    holds = said.lower()
    return all(one in holds for one in wanted)


def _midnight(said: str) -> float:
    """`YYYY-MM-DD` as the unix second that day begins, in UTC. `Refused` for anything else.

    **UTC, and said so wherever a window is reported.** A day is a different eight hours in Auckland
    than in Los Angeles, and a search quietly using the machine's own zone would answer a
    differently-bounded question on every install it ran on.
    """
    try:
        at = time.strptime(said, "%Y-%m-%d")
    except (TypeError, ValueError) as why:
        raise Refused(f"{said!r} is not a day this can search from — a day is written "
                      f"YYYY-MM-DD") from why
    return float(calendar.timegm(at))


def _a_day(seconds: float) -> str:
    """One unix second as the UTC day it falls in."""
    return time.strftime("%Y-%m-%d", time.gmtime(seconds))


def _when(at: str) -> str:
    """A Slack `ts` as the UTC instant an agent can compare with any other. `""` for anything else.

    **One spelling for every result**, because an agent reading two of them has to be able to put
    them in order without knowing which platform either came from.
    """
    seconds = _as_a_number(at)
    if not seconds:
        return ""
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(seconds))


def _a_ref(place: str, at: str) -> str:
    """The short opaque string `fetch` resolves back to exactly this one message.

    Slack's own two ids with a separator between them, because together they are unique and
    separately neither is. `""` where either is missing or the whole is past what rundesk carries — a
    result without a `ref` is still a result, and a `ref` that will not resolve is worse than none.
    """
    if not place or not at or REF_IN in place or REF_IN in at:
        return ""
    said = f"{place}{REF_IN}{at}"
    return said if len(said) <= REF_MOST else ""


def _the_message(ref: str) -> Tuple[str, str]:
    """One `ref` read back as the conversation and the `ts` inside it.

    `Refused` rather than a guess for anything that is not one: a fetch aimed at a message this
    cannot name is a fetch that must say so, and downloading whatever a plausible reading pointed at
    would be bringing somebody a file from a conversation they did not ask about.
    """
    parts = str(ref or "").split(REF_IN)
    if len(parts) != 2 or not parts[0] or not parts[1] or len(ref) > REF_MOST:
        raise Refused(f"{ref!r} is not a reference this adapter wrote — one is a Slack "
                      f"conversation id and a message ts, written `C…{REF_IN}1700000000.000100`")
    if not _as_a_number(parts[1]):
        raise Refused(f"{ref!r} does not name a Slack message — the part after {REF_IN!r} is a "
                      f"`ts`, which is a number")
    return parts[0], parts[1]


def _attached(said: Any) -> List[Dict[str, Any]]:
    """What a found message carries, described and never fetched.

    Described here so an agent can decide whether a file is worth having before anything downloads
    one — which is the whole reason `fetch` is a second act. `bytes` is kept only where Slack really
    said a number.
    """
    brought: List[Dict[str, Any]] = []
    for one in (said if isinstance(said, list) else [])[:BROUGHT_MOST]:
        if not isinstance(one, dict):
            continue
        described: Dict[str, Any] = {"name": flat(one.get("name") or one.get("title") or "")}
        size = one.get("size")
        if isinstance(size, int) and not isinstance(size, bool) and size > 0:
            described["bytes"] = size
        brought.append(described)
    return brought


# ---------------------------------------------------------------------------------------------
# Question three: carry conversations for as long as the agent is up.
# ---------------------------------------------------------------------------------------------


class Reaching:
    """The connection, held open for as long as this program runs, and what it is holding.

    **Threads, and no event loop.** `slack_sdk`'s built-in Socket Mode client is synchronous and
    dispatches on workers of its own, and its `WebClient` is synchronous too — so the shape that
    fits is one thread reading rundesk, the client's own threads carrying what arrives, and a small
    watcher saying when the socket goes and comes back. The main thread waits on one event and does
    the cleanup, which is what makes a `SIGTERM` reach the goodbye rather than ending the process
    where it stands.

    Everything kept here is bounded, because this process runs for weeks.
    """

    def __init__(self, allow: List[str], places: List[str]) -> None:
        self.allow = allow
        self.places = places
        self.web: Any = None
        #: The same Web API under a shorter ceiling, for uploads alone. **One client cannot carry
        #: both**: `CALL_WITHIN` is right for a call a person is not waiting on the far side of, and
        #: far too long for one inside a delivery's own budget — see `UPLOADS_WITHIN`.
        self.uploads: Any = None
        self.socket: Any = None
        #: Who this bot is, and which workspace it is in. All of it comes from `auth.test` at
        #: startup and none of it is guessed: the member id is what a mention is recognised by, the
        #: workspace id is half of every conversation key, and the bot id is what tells this app's
        #: own earlier answers from another app's when a thread is read back.
        self.ours = ""
        self.our_bot = ""
        self.team = ""
        self.named = ""
        #: Which Slack app issued the bot token, asked of `bots.info` once at startup and held only
        #: to be compared with the app behind the websocket. `""` where Slack would not say, which
        #: is a state of its own: unable to establish is never treated as a mismatch.
        self.our_app = ""
        #: Envelopes and messages already acted on. Slack redelivers, and a turn run twice for one
        #: question is the failure that costs an owner real money.
        self.handled: Dict[str, float] = {}
        #: Where a message this has seen is standing, by its own id, so a mark can be put on one
        #: without asking Slack about it again.
        self.standing: Dict[str, str] = {}
        #: The direct conversation one person reads, by their own id. Held for the life of this
        #: process because it does not change, and written down nowhere because Slack owns it.
        self.opened: Dict[str, str] = {}
        #: The visual target of the prompted answer being written into each conversation, by that
        #: conversation's own key (R-SLK-14). **Rundesk puts `reply_to` on the first piece of a
        #: split answer and the files on the last**, so every piece after the first carries nothing
        #: to resolve a target from — and in a direct conversation, whose key holds no thread, each
        #: of them would land flat while the first stood in a thread. One answer would arrive in two
        #: places with its file in a third.
        #:
        #: **Written only by a delivery that answers a message, and read only by one that answers
        #: none and is not a notice** — which, of everything rundesk sends, is exactly a later piece
        #: of the answer whose first piece wrote it. An unprompted notice neither writes nor reads
        #: it, so a schedule's report arriving mid-answer stays flat and takes nothing with it.
        self.prompted: Dict[str, str] = {}
        #: Where an answer to a message this has seen belongs, by that message's own id
        #: (R-SLK-50). **The conversation does not carry it and must not**: in a direct message
        #: every thread is one conversation, so the visual target is a fact about the *message* a
        #: turn is answering rather than about the conversation it is in. Written down when the
        #: message arrives, which is the only moment Slack says what thread it stood in, and read
        #: back off the `reply_to` rundesk carries on the answer — so a later message steering the
        #: same turn cannot move where that turn's answer lands.
        self.replying: Dict[str, str] = {}
        #: The mark now on a message, so the new one goes up before the old comes down.
        self.marks: Dict[str, str] = {}
        #: Where the answer to one command goes back, by the id of the command that asked it.
        #: **Slack's response url and nothing else**: it is private to that invocation, it expires
        #: on its own, and it is the only way an answer arriving seconds later reaches the person
        #: who typed the command rather than the channel they typed it in. Bounded like every other
        #: map here, so a process running for weeks does not keep one url per question ever asked.
        self.asked: Dict[str, str] = {}
        #: Who has asked for the one control that cannot be undone, and when. Keyed by member so
        #: one person's confirmation is never another person's, and bounded the same way.
        self.confirming: Dict[str, float] = {}
        #: Display names and channel names already looked up. Both are asked of Slack once.
        self.people: Dict[str, str] = {}
        self.rooms: Dict[str, Tuple[str, bool, bool]] = {}
        #: Whether the agent-session status has been put down for the life of this adapter. **Set
        #: only by something that proves the mechanism itself is unavailable to this app** — one of
        #: `NO_SESSIONS_AT_ALL`, or a rate limit with no usable delay, where the quietest thing an
        #: optional mechanism can do is stop. Never set by a refusal about one channel.
        self.statusless = False
        #: The monotonic moment before which no status call is made, or `None`. **This adapter's,
        #: not one place's**: it is one app in one workspace calling one method, so Slack's limit on
        #: it is a limit everywhere at once.
        self.embargo_until: Optional[float] = None
        #: The channel-and-thread pairs whose own session Slack refuses, so the same place is not
        #: asked about on every turn. Bounded, and it quiets nothing but the places in it.
        self.sessionless: Dict[str, float] = {}
        #: Whether Slack has greeted the current socket, so `ready` and `gone` are earned facts.
        self.connected = False
        #: The SDK session Slack most recently greeted. A different current session is not ready
        #: until its own greeting arrives.
        self.greeted_session: Optional[str] = None
        #: Diagnostic boundaries already reported. Fixed words only, bounded by `ARRIVING`,
        #: `IGNORED` and the handful the greeting itself is named by.
        self.reported: Set[str] = set()
        self.stopping = threading.Event()
        #: Held across every write to the maps above and to `connected`. **Two kinds of thread write
        #: here** — the socket client's own workers carry what arrives, and one thread of this
        #: program's carries what rundesk says — so `pop(next(iter(…)))` on a map another thread is
        #: changing raises `RuntimeError` rather than dropping the oldest entry, and a connection
        #: noticed twice says `ready` twice. Re-entrant so that a guarded block calling `_remember`
        #: is a change somebody can make later without finding out this way.
        self.holding = threading.RLock()
        #: What went wrong, if anything did, read as the exit code on the way out.
        self.trouble = ""
        self.unrecoverable = False

    # -- the whole of the run --------------------------------------------------------------

    def run(self, bot: str, app: str) -> int:
        """Connect, read rundesk, and keep both going until one of them ends.

        **Asked to stop rather than killed where we stand.** Rundesk ends a channel by signalling the
        whole process group and giving it a few seconds before it insists, and the default for those
        two signals is to die immediately — so the goodbye and every last write would simply never be
        reached. Handled, the wait below ends and the cleanup that was always written runs.
        """
        self.web = WebClient(token=bot, timeout=CALL_WITHIN)
        self.uploads = WebClient(token=bot, timeout=AN_UPLOAD_WITHIN)
        try:
            who = self.web.auth_test()
        except Exception as why:           # noqa: BLE001 — a platform boundary
            final = _will_not_come_right(why)
            self._trouble(_why_slack_refused(why), never_again=bool(final))
            say({"say": "gone", "why": self.trouble})
            return WILL_NOT_FIX if self.unrecoverable else 1
        self._identified(who)
        self._which_app()

        for sig in (signal.SIGTERM, signal.SIGINT):
            with contextlib.suppress(ValueError, OSError):
                signal.signal(sig, self._signalled)

        self.socket = SocketModeClient(app_token=app, web_client=self.web)
        self._listening()
        reading = threading.Thread(target=self._reading, name="rundesk", daemon=True)
        watching = threading.Thread(target=self._watching, name="socket", daemon=True)
        noted("opening the Socket Mode websocket and waiting for Slack to say hello on it", "info")
        try:
            self.socket.connect()
        except Exception as why:           # noqa: BLE001 — a platform boundary
            final = _will_not_come_right(why)
            self._trouble(_why_slack_refused(why), never_again=bool(final))
            say({"say": "gone", "why": self.trouble})
            return WILL_NOT_FIX if self.unrecoverable else 1
        reading.start()
        watching.start()

        while not self.stopping.wait(STOPPING_WITHIN):
            pass
        say({"say": "gone", "why": self.trouble or "rundesk asked this to stop"})
        with contextlib.suppress(Exception):
            self.socket.close()
        reading.join(GOODBYE_SECONDS)
        watching.join(GOODBYE_SECONDS)
        if self.unrecoverable:
            return WILL_NOT_FIX
        return 1 if self.trouble else 0

    def _listening(self) -> None:
        """Register the raw greeting and decoded event boundaries on the vendor client."""
        self.socket.socket_mode_request_listeners.append(self._envelope)
        self.socket.message_listeners.append(self._said_about_connection)

    def _identified(self, who: Any) -> None:
        """Take who this app is from Slack's own answer, and derive none of it.

        Four facts and one source. **`bot_id` is the one worth naming**: `auth.test` returns it for a
        bot token and omits it for a person's — the same fact `--check` refuses a user token on — and
        it is what tells this app's own earlier messages from another app's when a thread is read
        back. Nothing works it out from a name or a prefix, because two apps in one workspace may be
        called anything at all.
        """
        self.ours = str(who.get("user_id") or "")
        self.our_bot = str(who.get("bot_id") or "")
        self.team = str(who.get("team_id") or "")
        self.named = str(who.get("user") or "")

    def _which_app(self) -> None:
        """Ask Slack which app issued the bot token, and hold the answer for one comparison.

        **One call, at startup, and never fatal.** `bots.info` is answered by the `users:read` scope
        this already asks for, so nothing new is wanted from an owner. A refusal, a shape this does
        not recognise, or a token that carries no bot id all leave `our_app` empty — and empty means
        *unable to establish*, which never earns a verdict and never puts a channel down.
        """
        if not self.our_bot:
            return
        try:
            said = self.web.bots_info(bot=self.our_bot)
            found = said.get("bot")
            if isinstance(found, dict):
                self.our_app = str(found.get("app_id") or "")
        except Exception:                  # noqa: BLE001 — a platform boundary, and only a hint
            self.our_app = ""

    def _signalled(self, *_: Any) -> None:
        """A signal arrived, so the wait below ends and the goodbye runs.

        **The default disposition for `SIGTERM` is to die where you stand**, so an adapter that wants
        its goodbye said has to handle it. Nothing is done in the handler beyond setting the event:
        it runs on the main thread between bytecodes, and cleanup is not a thing to start from there.
        """
        self.stopping.set()

    def _trouble(self, said: str, never_again: bool = False) -> None:
        """Record what went wrong, and whether coming back would ever help."""
        self.trouble = said
        if never_again:
            self.unrecoverable = True
            noted(said, "error")

    def _final(self, why: Any) -> bool:
        """Whether a platform refusal is one nothing here can ever get past, and end if it is.

        Only the five words that say the credential itself is gone. `channel_not_found` is one
        channel this bot was not invited to and `message_not_found` is one message that has been
        deleted; ending the whole connection over either would take an agent off every other place it
        is reachable in.
        """
        final = _will_not_come_right(why)
        if not final:
            return False
        self._trouble(f"Slack answered {final}: {WILL_NOT_COME_RIGHT[final]}. Reconnecting cannot "
                      f"fix this and would only repeat it", never_again=True)
        self.stopping.set()
        return True

    # -- the connection itself -------------------------------------------------------------

    def _said_about_connection(self, client: Any, message: Any, _raw: Any = None) -> None:
        """Name what arrived on the websocket, and earn readiness from Slack's `hello`.

        **Every frame is named and none is read.** What is said of one is the fixed word `ARRIVING`
        holds for its top-level type and nothing else — never the payload, never Slack's own type
        string, and never an id. That naming is the whole difference between an adapter that is
        being sent nothing and one that is being sent something it does not decode, and without it
        both look the same from the log: a `hello`, and then silence.
        """
        try:
            kind = str(message.get("type") or "") if isinstance(message, dict) else ""
            if kind != HELLO:
                word = kind if kind in ARRIVING else "other"
                self._once(word, ARRIVING[word])
                return
            session: Optional[str] = None
            with contextlib.suppress(Exception):
                found = client.session_id()
                session = str(found) if found else None
            with self.holding:
                noted("Slack said hello on this Socket Mode websocket", "info")
                self._greeted(message)
                replaced = bool(self.connected and self.greeted_session and session
                                and session != self.greeted_session)
                if replaced:
                    self.connected = False
                self.greeted_session = session
                if not self.connected:
                    self.connected = True
                    became_ready = True
                else:
                    became_ready = False
                if replaced:
                    say({"say": "gone",
                         "why": "the Socket Mode websocket changed; its replacement has now said hello"})
                if became_ready:
                    say({"say": "ready",
                         "as": f"{self.named} in {self.team}" if self.named else self.team})
        except Exception:                  # noqa: BLE001 — one message is not the channel
            cannot_say(traceback.format_exc())

    def _greeted(self, message: Dict[str, Any]) -> None:
        """Say what Slack's greeting reports about this connection. **It decides nothing.**

        Two facts, both bounded, neither an identifier, and neither one a state this acts on.

        **How many connections this app has open.** Slack delivers each event to one of them, so a
        second connection somewhere else is a complete explanation for an agent that is greeted and
        never woken — and a count is the only form of that fact this can hold without saying
        anything about what opened the other one.

        **Whether the socket is this bot's app.** Where both ids are known and differ, every event
        this bot is subscribed to is being delivered to another app's connections, and the line says
        which two tokens to reissue. It is still only a line: readiness is Slack's `hello`, this
        does not withhold it, and nothing here ends or restarts the adapter. Ending a channel over
        a comparison no live workspace has yet answered would risk taking an agent off Slack for an
        inference, which costs more than the silence it is describing. Where either id is unknown,
        nothing is concluded and that is said too.
        """
        count = message.get("num_connections")
        if isinstance(count, int) and not isinstance(count, bool):
            many = "" if count == 1 else "s, and sends each event to one of them"
            self._once("connections",
                       f"Slack says this app has {count} open Socket Mode connection{many}")
        found = message.get("connection_info")
        theirs = str(found.get("app_id") or "") if isinstance(found, dict) else ""
        if not self.our_app or not theirs:
            self._once("app_unsure", UNSURE_APP)
        elif theirs == self.our_app:
            self._once("app_same", ONE_APP)
        else:
            self._once("app_other", TWO_APPS, "warning")

    def _reconcile(self) -> None:
        """Withdraw readiness when the greeted websocket is gone or has been replaced."""
        with self.holding:
            connected_now = bool(self.socket.is_connected())
            session: Optional[str] = None
            if connected_now:
                with contextlib.suppress(Exception):
                    found = self.socket.session_id()
                    session = str(found) if found else None
            replaced = bool(connected_now and self.connected and self.greeted_session and session
                            and session != self.greeted_session)
            if self.connected and (not connected_now or replaced):
                self.connected = False
                self.greeted_session = None
                losing = ("the Socket Mode websocket changed and the replacement has not said hello"
                          if replaced else "the socket closed")
                say({"say": "gone", "why": losing})

    def _watching(self) -> None:
        """Ask whether the greeted websocket is still the one the client currently holds."""
        while not self.stopping.wait(WATCHING_SECONDS):
            try:
                self._reconcile()
            except Exception:              # noqa: BLE001 — asking must never end the program
                cannot_say(traceback.format_exc())

    # -- what arrives ----------------------------------------------------------------------

    def _envelope(self, client: Any, request: Any) -> None:
        """One Socket Mode envelope. **Acknowledged before anything else happens.**

        Slack gives three seconds and redelivers whatever is not acknowledged inside them, so the ack
        goes first and unconditionally: an envelope acknowledged after the work is one Slack has
        already sent again, and a turn run twice for one question costs the owner real money.

        **Never raises.** The client logs a listener that does and carries on, which means a
        traceback would go somewhere nobody reads; it is written to stderr here instead, where the
        gateway rotates it and shows it.
        """
        with contextlib.suppress(Exception):
            client.send_socket_mode_response(SocketModeResponse(envelope_id=request.envelope_id))
        try:
            # **Two kinds of envelope and one acknowledgement.** A command is answered privately
            # through its own response url a moment later rather than in the acknowledgement above,
            # which is what keeps the three-second rule one rule for everything that arrives.
            if str(getattr(request, "type", "")) == SLASH:
                self._a_command(request)
            else:
                self._an_event(request)
        except Exception as why:           # noqa: BLE001 — one event is not the channel
            cannot_say(traceback.format_exc())
            noted(f"could not act on a Slack event: {type(why).__name__}: {why}", "error")

    def _an_event(self, request: Any) -> None:
        """What was in that envelope, if it is something this wakes for."""
        if str(getattr(request, "type", "")) != EVENTS_API:
            self._observed("not_an_event")
            return
        payload = getattr(request, "payload", None)
        if not isinstance(payload, dict):
            self._observed("no_event")
            return
        event = payload.get("event")
        if not isinstance(event, dict):
            self._observed("no_event")
            return
        kind = str(event.get("type") or "")
        woken = waking(kind, event, self.ours)
        if woken is None:
            self._observed("not_woken")
            return
        # **Two keys and not one.** The envelope's own id catches Slack sending the same delivery
        # again; the message's own catches the same message arriving through a second event or a
        # reconnection that replayed it. Either alone leaves a way for one question to become two
        # turns.
        if not self._may(woken.user, woken.channel):
            self._observed("not_allowed")
            return
        if self._already(str(payload.get("event_id") or ""),
                         f"{woken.channel}/{woken.ts}"):
            self._observed("already")
            return
        self._observed("woken")
        self._say_it_arrived(woken)

    def _observed(self, boundary: str) -> None:
        """Log one fixed decoded boundary; never repeat Slack content or identifiers."""
        self._once(boundary, IGNORED[boundary])

    def _once(self, word: str, said: str, level: str = "info") -> None:
        """Say one fixed sentence once for the life of this run, and never a second time.

        **A note record rather than stderr**, because that is the stream rundesk reads as it happens
        and writes into the agent's own log. What goes to stderr reaches that log only when the
        gateway collects an adapter that has exited, so a diagnostic written there says nothing at
        all for as long as the channel is working — which is the only time anybody is reading it.

        Bounded by the fixed vocabularies above and by `reported`: one line per word per run, which
        is what keeps a channel carrying thousands of events from writing thousands of lines.
        """
        with self.holding:
            if word in self.reported:
                return
            self.reported.add(word)
        noted(said, level)

    def _already(self, envelope: str, message: str) -> bool:
        """Whether this has been acted on. Written down here so the answer is the same twice."""
        keys = [one for one in (envelope, message) if one]
        if not keys:
            return False
        with self.holding:
            if any(key in self.handled for key in keys):
                return True
            for key in keys:
                self.handled[key] = time.monotonic()
            while len(self.handled) > SEEN_KEPT:
                self.handled.pop(next(iter(self.handled)))
        return False

    def _may(self, who: str, channel: str) -> bool:
        """Whether this is worth any work at all. **Advisory, and never the decision.**

        Rundesk decides again on its own side against the channel's record and answers a stranger
        with silence, which is the only check that counts. This one exists so that a thread is not
        fetched and a name is not looked up for somebody who will correctly never be answered.

        **One rule for a message and for a command**, out of the same two lists, because rundesk
        admits both by one rule over one list (R-CH-39) — and two rules over it would eventually
        disagree about the same person, with the one they disagreed about holding a control.
        """
        return who in self.allow or channel in self.places

    def _say_it_arrived(self, woken: Waking) -> None:
        """Report one message, with who said it, where, and what stood above it in the thread."""
        text = woken.text
        if woken.joined:
            text = with_context(text, self._earlier(woken))
        # **Before the words are judged, because a file is an ask too** (R-SLK-66). A message that
        # is only an attachment used to be dropped here as a message with nothing in it.
        brought = self._brought(woken)
        if not text and not brought:
            return
        self._remember(self.standing, woken.ts, woken.channel)
        self._remember(self.replying, woken.ts, woken.answer_in)
        handle = a_handle_for(woken.user)
        say({"say": "arrived",
             "conversation": conversation_of(self.team, woken.channel, woken.thread),
             # **The stable id of the place, in a field of its own.** `place` below is a word for a
             # reader and is not this: rundesk decides admission against this id, so it is Slack's
             # own and never anything composed here.
             "external_place": woken.channel,
             "place": "dm" if woken.direct else "room",
             "user": woken.user,
             "display": self._a_name(woken.user),
             # **How to mention them, beside what to call them** (R-SLK-65). Sent only where the id
             # is one `escaped_keeping_mentions` would keep, so nothing here teaches a brain a token
             # the answer path would then escape into punctuation.
             **({"mention": handle} if handle else {}),
             "where": self._where_this_is(woken),
             "text": text,
             "external_id": woken.ts,
             # Only where something landed, so an ordinary message's record is the one it always
             # was. Each entry is exactly what `fetch` reports and `channels.files.landed` takes.
             **({"attachments": brought} if brought else {})})

    def _brought(self, woken: Waking) -> List[Dict[str, Any]]:
        """Every file on this message that landed, staged where rundesk will find it (R-SLK-66).

        **The same rules `fetch` lands a message's files under, because it is the same act** — one
        message's files, staged under this channel's own home, named by position, reported with the
        size Slack declared. `_staged` holds those rules once, so a file that arrives and a file a
        search found cannot come to be treated two ways.

        **A file that will not come is a line in the agent's log and never a dropped message.** The
        words still arrive, the files that did land are still reported, and the reason is where an
        owner reads it: a missing `files:read` on an app installed before it was wanted arrives here
        as Slack's own refusal of the download and is said as such.

        Nowhere to put them is said once and the words go on: the same choice the Discord adapter
        makes, because a message somebody sent is not something to lose over a directory.
        """
        if not woken.files:
            return []
        home = (os.environ.get("RUNDESK_CHANNEL_HOME") or "").strip()
        if not home or not Path(home).is_absolute():
            self._once("no_home", "nothing said where this channel may put what arrives, so a file "
                                  "somebody attached was left where only Slack can reach it", "error")
            return []
        token = str(getattr(self.web, "token", "") or "")
        if not token:
            self._once("no_token", "no bot token was held to download a file somebody attached, so "
                                   "it was left where only Slack can reach it", "error")
            return []
        brought, stopped = _staged({"files": list(woken.files)}, token,
                                   Path(home) / FETCHED_IN / woken.ts)
        for why in stopped:
            noted(why, "error")
        return brought

    def _earlier(self, woken: Waking) -> List[str]:
        """The newest lines of the thread above the message that named the agent.

        **This is not an ingestion of the thread and nothing here goes on watching one.** It is read
        at the moment somebody names the agent inside a conversation that was already going, because
        an answer to "what do you think?" needs the question above it. A mention that opens its own
        thread has nothing above it and asks for nothing.

        **Walked to the end of the thread rather than asked for once**, and that is the whole of why
        this is not a single call. `conversations.replies` pages *forward* from a thread's first
        message: a bounded ask answers with the oldest page and says there is more, so a thread with
        thirty replies would have handed a brain the ten furthest from the question. The walk keeps
        only the newest lines it has seen, so what is held stays bounded however long the thread is.

        **The ceiling is a real one and is said out loud when it is reached.** This stands on the
        inbound path in front of somebody waiting, so a thread past `CONTEXT_PAGE * CONTEXT_PAGES`
        messages is read only that far — and the lines carried are then genuinely earlier in the
        thread rather than immediately above the question, which is worth a line in the log.

        A thread that cannot be read is one line in the log and no context at all: the message is
        still worth carrying, and a brain told nothing is better than a brain told a misleading part.
        """
        said: List[Any] = []
        cursor = ""
        more = False
        for _ in range(CONTEXT_PAGES):
            asked = {"channel": woken.channel, "ts": woken.thread, "latest": woken.ts,
                     "inclusive": False, "limit": CONTEXT_PAGE}
            if cursor:
                asked["cursor"] = cursor
            try:
                found = self.web.conversations_replies(**asked)
            except Exception as why:       # noqa: BLE001 — a platform boundary
                self._final(why)
                noted(f"could not read the thread this was said in, so it was carried without the "
                      f"messages above it: {_why_slack_refused(why)}", "info")
                return []
            said.extend(self._as_context(found.get("messages"), woken.ts))
            # Trimmed each time round rather than at the end, so a thread of any length costs the
            # same to hold. The pages arrive in order, and the newest of what has been seen is the
            # newest full stop once the walk reaches the end.
            said.sort(key=lambda one: _as_a_number(one[0]))
            said = said[-CONTEXT_MOST:]
            cursor = str((found.get("response_metadata") or {}).get("next_cursor") or "")
            more = bool(cursor)
            if not more:
                break
        if more:
            noted(f"the thread this was said in is longer than {CONTEXT_PAGE * CONTEXT_PAGES} "
                  f"messages, so what was carried is earlier in it rather than directly above the "
                  f"question", "info")
        return [line for _, line in said]

    def _as_context(self, messages: Any, before: str) -> List[Any]:
        """One page of a thread as the lines worth carrying, each with the `ts` that orders it.

        A join notice and anything at or after the invoking message are dropped here rather than by
        the caller, so the page and the walk have one rule between them.

        **Another agent's answer is carried, and this one's own is not.** A thread where two invited
        agent bots have been working is the case this exists for: somebody asks `@dev` something,
        reads the answer, and then asks `@ava` what she makes of it — and dropping every line with a
        `bot_id` handed ava the question with the answer it was about taken out. So a peer's line is
        context like anybody else's, and only *this* app's own earlier messages are left behind,
        because handing a brain the last thing it said back to itself is not context.

        **Told apart by the two ids Slack gives us for ourselves**, from `auth.test` and never
        inferred: the app's `bot_id` and its bot user's id. Both, because a message this bot posted
        carries the first and may carry the second, and a guard that reads only one of them is a
        guard that lets an agent quote itself.

        **Nothing about what wakes the agent changes.** `waking` refuses anything carrying a
        `bot_id`, whatever its subtype, so a peer agent's answer is something this reads and never
        something it answers.
        """
        said: List[Any] = []
        for one in (messages if isinstance(messages, list) else []):
            if not isinstance(one, dict):
                continue
            at = str(one.get("ts") or "")
            if not at or not _before(at, before):
                continue
            if str(one.get("subtype") or "") in NOT_SAID or self._ours(one):
                continue
            body = flat(without_our_name(str(one.get("text") or ""), self.ours), CONTEXT_LINE)
            if not body:
                continue
            said.append((at, f"{self._who_said(one)}: {body}"))
        return said

    def _ours(self, one: Dict[str, Any]) -> bool:
        """Whether this app wrote this line. Both ids are asked, and an unknown one matches nothing.

        `self.our_bot` is empty only where `auth.test` gave no `bot_id`, which is a token `--check`
        refuses — and an empty one must never match a message that carries none, or every ordinary
        person's line would read as ours.
        """
        return written_by_us(one, self.ours, self.our_bot)

    def _who_said(self, one: Dict[str, Any]) -> str:
        """What to call whoever wrote this line, as one bounded, flattened label.

        **A peer app is named out of the message and never asked about.** `users.info` knows nothing
        about a bot, so asking would spend a call to learn nothing; what Slack already hands over is
        the app's own profile name, then the name it posted under, then its bot id — and each of
        those was chosen by whoever installed that app, so it is a stranger's text and is flattened
        and clipped exactly as a display name is.
        """
        if one.get("bot_id"):
            return named_in(one)
        return self._a_name(str(one.get("user") or ""))

    def _a_name(self, who: str) -> str:
        """What Slack shows this person as, asked once and remembered. Their id when it will not say.

        Flattened and clipped like every other stranger's text: a display name is somewhere somebody
        writes whatever they like, and a newline in one is how they would end our sentence and start
        their own. **It reaches a prompt and never a decision** — who may be answered is settled
        against the member id, which nobody can choose.
        """
        if not who:
            return ""
        held = self.people.get(who)
        if held is not None:
            return held
        named = who
        try:
            named = named_as(self.web.users_info(user=who).get("user") or {}, who)
        except Exception as why:           # noqa: BLE001 — a platform boundary
            self._final(why)
        self._remember(self.people, who, named or who)
        return self.people[who]

    def _where_this_is(self, woken: Waking) -> str:
        """Where this was said, in one ordinary sentence. Names, never ids.

        Five places and each says who is reading: a direct message nobody else can see, a public
        channel the workspace can read, a private channel its members can read, a channel shared
        with another organisation that people outside this workspace can read, and a thread in any
        of them.
        """
        if woken.direct:
            return "a direct message, which nobody else can read"
        named, private, external = self._a_room(woken.channel)
        where = a_place(named, private, external)
        return f"a thread in {where}" if woken.joined else where

    def _a_room(self, channel: str) -> Tuple[str, bool, bool]:
        """What Slack calls this channel, whether it is private, and whether it reaches outside
        this workspace. Asked once and remembered.

        **The fallback claims the narrower audience and never the wider one.** Where Slack will not
        say, a `G` is taken as private — which it is — and nothing is taken as externally shared,
        because the sentence for that warns a brain that strangers are reading and inventing that
        warning from an unanswered call would teach it to distrust the words. The audience it then
        describes is the one this adapter can stand behind.
        """
        held = self.rooms.get(channel)
        if held is not None:
            return held
        found = ("", channel.startswith("G"), False)
        try:
            found = a_room_from(self.web.conversations_info(channel=channel).get("channel") or {})
        except Exception as why:           # noqa: BLE001 — a platform boundary
            self._final(why)
        self._remember(self.rooms, channel, found)
        return found

    # -- the one command this offers -------------------------------------------------------

    def _a_command(self, request: Any) -> None:
        """One slash command: whether it is theirs, which gesture it names, and where to answer it.

        **Nothing crosses the seam until three things are true**: somebody the lists cover asked
        it, the word is one of the closed sets, and — for the one control that cannot be undone —
        they have asked twice. Everything else is answered here, out of this file, with no gesture
        recorded and no turn started anywhere.

        **One envelope is one command, and the guard is not optional** (R-SLK-43). The
        acknowledgement above is written inside `contextlib.suppress`, because an envelope that
        cannot be acknowledged must not stop the work — so an acknowledgement Slack never received
        is a real state, and Slack answers it by sending the same envelope again. Without a guard
        that redelivery is indistinguishable from a person typing the command a second time, which
        is exactly what the confirmation below reads as consent: **one mistyped `shutdown` and one
        dropped acknowledgement would have ended the gateway between them.** So the envelope's own
        id is written down before anything is decided, and a retry returns here having changed
        nothing — no confirmation remembered, no gesture sent, no answer written.

        **A person pressing enter twice is still two commands**, because Slack gives each invocation
        an envelope of its own. What is refused is the same envelope arriving twice, and nothing
        else.
        """
        payload = getattr(request, "payload", None)
        if not isinstance(payload, dict):
            self._observed("no_command")
            return
        who = str(payload.get("user_id") or "")
        channel = str(payload.get("channel_id") or "")
        answering = str(payload.get("response_url") or "")
        if not who or not channel or not answering:
            self._observed("no_command")
            return
        if not self._may(who, channel):
            # **Silence, and no platform call.** Nothing is held open — the envelope is already
            # acknowledged — so there is no spinner for somebody to be released from, and saying
            # *this is not yours* would confirm to a stranger that the agent is listening.
            self._observed("not_theirs")
            return
        # **Before anything is decided, remembered, answered or sent.** Written down by the
        # envelope's own identity — never by who asked or what they typed, both of which are
        # identical on a genuine second ask. `_already` is the same bounded, locked guard an event
        # goes through, because a redelivery is one thing however Slack wrapped it.
        if self._already(str(getattr(request, "envelope_id", "") or ""), ""):
            self._observed("already_commanded")
            return
        named = str(payload.get("command") or "")
        wanted = the_gesture(payload.get("text"))
        if wanted is None:
            self._observed("not_a_gesture")
            self._privately(answering, the_help(named))
            return
        if wanted.word == SHUTDOWN and not self._confirmed(who):
            self._privately(answering, confirming(named))
            return
        # **The command's own id, so one answer completes the question that asked it.** Slack's
        # `trigger_id` names this invocation; the envelope's own id stands in where a payload ever
        # arrives without one, because a gesture with no `ref` is one rundesk answers into nothing.
        ref = str(payload.get("trigger_id") or getattr(request, "envelope_id", "") or "")
        if ref:
            self._remember(self.asked, ref, answering)
        self._observed("commanded")
        # **The channel and never a thread.** A command's payload carries no `thread_ts`, so the
        # conversation this names is the one the channel itself keeps — see `docs/guides/slack.md`,
        # which says what that costs a `stop` typed inside a thread. Composed by the one function
        # that composes every conversation here, so a gesture and a message name a place alike.
        record: Dict[str, Any] = {
            "say": wanted.saying,
            "conversation": conversation_of(self.team, channel),
            # The stable id authorization is decided against, in a field of its own, exactly as an
            # arrival carries it: admission is one rule over one list for both.
            "external_place": channel,
            "user": who,
            "ref": ref}
        if wanted.saying == "control":
            record["control"] = wanted.word
        elif wanted.saying == "query":
            record["query"] = wanted.word
        else:
            record["provider"] = wanted.word
            if wanted.alias:
                record["alias"] = wanted.alias
        say(record)

    def _confirmed(self, who: str) -> bool:
        """Whether this is the second ask for something that cannot be undone, inside the window.

        Keyed by member and not by conversation: what is being confirmed is one person's intention,
        and a confirmation somebody else's command could satisfy is not one.
        """
        now = time.monotonic()
        with self.holding:
            asked_at = self.confirming.get(who)
            if asked_at is not None and now - asked_at <= CONFIRM_WITHIN:
                self.confirming.pop(who, None)
                return True
            self._remember(self.confirming, who, now)
        return False

    def _privately(self, answering: str, said: str) -> bool:
        """Say one thing to whoever typed the command, through that command's own response url.

        **Ephemeral every time**, so an answer naming this install's agents, schedules or delegated
        work is read by the person who asked and by nobody else in the channel they asked from.

        **Escaped whole, which a turn's answer deliberately is not** (R-SLK-15). A gesture answer
        is composed by rundesk out of records — a schedule's name, a delegated task's first line —
        and each of those is somewhere somebody else's words are kept rather than a sentence the
        agent wrote, so none of it is anybody deliberately naming anybody and all of it arrives as
        the text it looks like.

        **Nothing is retried and nothing is replaced.** A refusal is reported where it happens and
        answered by making no further call for that piece; `replace_original` is sent false so a
        second piece of one answer is a second message rather than an overwrite of the first.
        """
        try:
            answered = WebhookClient(answering, timeout=CALL_WITHIN).send(
                text=escaped(said), response_type=EPHEMERAL, replace_original=False)
        except Exception as why:           # noqa: BLE001 — a platform boundary
            noted(f"could not answer a slash command privately: {_why_slack_refused(why)}")
            return False
        code = getattr(answered, "status_code", 0)
        if code != 200:
            # The body is Slack's own words about the refusal and may carry the url's state; the
            # code is what tells an expired url from a refused one, and is the whole of what is said.
            noted(f"Slack would not take a private answer to a slash command (HTTP {code})")
            return False
        return True

    def _answered(self, it: Dict[str, Any]) -> None:
        """What rundesk said about a gesture, put back on the command that asked for it.

        **Correlated by `ref` or not delivered at all.** The url is taken out as it is read, so one
        answer completes one command: a record naming a command this run never held — a gateway that
        restarted, a url already spent — reaches nobody rather than the wrong person.

        **Cut here, because rundesk did not cut it.** A gesture answer never went through the turn
        splitter, and Slack takes a bounded number of answers on one command's url — so the pieces
        that fit go out in order and the last one says so when the answer needed more of that
        allowance than there is. An answer beyond it is not silently trimmed.
        """
        with self.holding:
            answering = self.asked.pop(str(it.get("ref") or ""), None)
        if answering is None:
            return
        said = str(it.get("text") or "")
        if not said:
            return
        pieces = answer_pieces(said)
        whole = len(pieces) <= RESPONSES_MOST
        for piece in pieces[:RESPONSES_MOST] if whole else pieces[:RESPONSES_MOST - 1]:
            if not self._privately(answering, piece):
                self._privately(answering, INCOMPLETE)
                return
        if not whole:
            self._privately(answering, TOO_LONG)

    # -- what rundesk says -----------------------------------------------------------------

    def _reading(self) -> None:
        """Everything rundesk says, a line at a time, for as long as it is saying it."""
        try:
            for line in rundesk_says(sys.stdin.buffer):
                try:
                    it = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(it, dict):
                    continue
                try:
                    self._told(it)
                except Exception as why:   # noqa: BLE001 — a delivery boundary
                    # **Said, and then read on.** Swallowing this in silence is how a command that
                    # never happened leaves no trace at all. The loop must not end either: one record
                    # nobody could act on is not a channel going away.
                    cannot_say(traceback.format_exc())
                    noted(f"could not act on {it.get('do')!r}: {type(why).__name__}: {why}", "error")
        except Exception:                  # noqa: BLE001 — see above
            cannot_say(traceback.format_exc())
        finally:
            # Rundesk has stopped speaking, so there is nothing left to carry.
            self.stopping.set()

    def _told(self, it: Dict[str, Any]) -> None:
        """One command, done the way this platform does it — or deliberately not done at all.

        **Four things are read and rendered as nothing, and that is the surface's whole shape.**
        `activity` is the running commentary, `delegation` is work handed to another agent, the
        `cost` on a delivery is what the turn spent, and a delivery marked `remark` is something the
        agent said on the way to its answer rather than the answer. Every one of them is bookkeeping
        about an answer, or a draft of one, rather than the answer itself — and this surface shows a
        person the answer. The first three are named here rather than left to the fallback so that
        nothing writes a line about them either; the fourth is a field on a delivery and is read by
        `_deliver`.

        **`answered` is the one record that is neither shown nor dropped.** It is what rundesk said
        about a gesture, and it goes back privately to whoever typed the command that asked for it —
        so it reaches no channel, which is why answering it costs this surface none of its quiet.
        """
        doing = it.get("do")
        if doing == "deliver":
            self._deliver(it)
        elif doing == "state":
            self._state(it)
        elif doing in ("activity", "delegation"):
            return
        elif doing == "answered":
            self._answered(it)
        elif doing == "stop":
            self.stopping.set()
        else:
            # Kept rather than refused: rundesk may be ahead of this adapter, and a command this does
            # not know is not a channel that has gone wrong.
            noted(f"nothing here does {doing!r}", "info")

    def _addressed(self, aimed: Tuple[str, str]) -> str:
        """The Slack conversation one named destination is written into. `Refused` when it cannot be.

        A place is already a conversation id — a `C`, a `G` or a `D`, which is what an allow list's
        places name. A person is not: the id names *them*, and the conversation they read is opened
        with `conversations.open`, which needs the bot token this side holds and rundesk does not.

        **Opened once and remembered.** A direct conversation does not change, and opening one is a
        round trip on the path of every notice a schedule sends.

        **Refused rather than degraded.** Everything else here that cannot reach the platform falls
        back to something reasonable; there is nothing reasonable for a delivery somebody addressed,
        because every other conversation in reach is one they did not choose.
        """
        kind, named = aimed
        if kind == "place":
            return named
        held = self.opened.get(named)
        if held is not None:
            return held
        try:
            found = self.web.conversations_open(users=named)
        # A platform boundary, like every other broad catch here — and **the only one that carries no
        # `noqa`**, because it is the only one that re-raises. `BLE001` is about a handler that
        # swallows; one that translates and raises on is not blind, so a directive here would be a
        # suppression of nothing. The behaviour is deliberate and unchanged: anything the SDK throws
        # reaches `_final`, which ends the connection on a `401` and leaves every other failure to
        # this delivery alone, and then leaves as a `Refused` so `_deliver` reports `failed` rather
        # than posting somewhere nobody chose.
        except Exception as why:
            self._final(why)
            raise Refused(f"Slack would not open a direct conversation with {named}: "
                          f"{_why_slack_refused(why)}") from why
        where = str((found.get("channel") or {}).get("id") or "")
        if not where:
            raise Refused(f"Slack opened no direct conversation with {named}")
        self.opened[named] = where
        return where

    def _deliver(self, it: Dict[str, Any]) -> None:
        """Post what the agent said and report Slack's own id for it — or say why not.

        **What the turn cost is not written into it.** `cost` arrives on the answer and is read here
        and dropped: a footer under an answer is bookkeeping in front of the person who asked, and
        this surface is deliberately quiet about everything that is not the answer.

        **Nothing is re-split.** Splitting happens once, on rundesk's side, for every platform, and
        text past the limit is rundesk having failed to do it — cutting it quietly here would report
        as whole a delivery that was not.

        **One person may be named and a room may not** (R-SLK-15). The exact markup for a Slack
        member survives, because an agent asked to loop somebody in has to be able to; every wider
        address is escaped, because notifying a room on the agent's behalf is what nobody asked for.

        **A file goes up after the words, because Slack has no call that carries both** (R-SLK-47).
        Discord takes the attachment with the message and can therefore be all-or-none; here the
        message is one call and each upload is another, so the words are posted first and every file
        is verified and uploaded on its own. **What that buys is the failure nobody could act on
        before:** a delivery carrying a file used to be refused outright, so an answer with a chart
        in it posted nothing at all — the whole answer lost for the sake of the attachment, which in
        a direct conversation is the only thing anybody was waiting for.

        **A file that will not go is said where the answer is, in rundesk's own sentence** — and
        the delivery is **reported as failed even though the words landed** (R-SLK-49). Nothing is
        abandoned silently and nothing claims success: the text stays where a person can read it, a
        short line under it names what did not go, the agent's log carries the whole reason, and the
        turn settles as failed — so no completion mark ever stands over a delivery that was asked
        for whole and arrived in part. What makes that honest rather than confusing is the line: a
        person sees the answer, sees what is missing from it, and sees no tick claiming otherwise.

        **Where an answer goes is not what conversation it belongs to** (R-SLK-50). The conversation
        is `place`; the visual target is read off the `reply_to` rundesk carries — the message this
        turn is answering — so one direct conversation can hold several readable exchanges and a
        later message steering the same turn never moves the answer.

        **A delivery marked `remark` is not posted** (R-SLK-10). It is something the agent said on
        the way to its answer, which rundesk says outright rather than leaving this to work out from
        the words — a brain that thinks out loud and then answers would otherwise be two messages
        here for one question, and the second is the only one anybody asked for. Not acknowledged
        either, because acknowledging is for what reached the platform and this never went; nothing
        waits on a remark, and what it costs is one line in the log saying the surface did its job.
        """
        if it.get("remark"):
            self._once("remark", NOT_THE_ANSWER)
            return
        # **Started here and not at the first upload.** What has to fit inside rundesk's wait is
        # this delivery's answer about itself, so everything it does is spent out of one budget.
        started = time.monotonic()
        given = str(it.get("id") or "")
        text = it.get("text") or ""
        carrying = it.get("files") or []
        try:
            if not isinstance(text, str):
                raise Refused("the text to deliver was not text")
            if not isinstance(carrying, list):
                raise Refused("the files to deliver were not a list")
            if len(text) > MAX_TEXT:
                raise Refused(f"{len(text)} characters is past what Slack takes in one message "
                              f"({MAX_TEXT}) — this never re-splits what it is handed, because "
                              f"splitting happens once, on rundesk's side, for every platform")
            if not text.strip() and not carrying:
                raise Refused("there was nothing to deliver: no text, and no file")
            aimed = _aimed_at(it.get("to"))
            if aimed is None:
                _, channel, thread = where_of(it.get("place"))
                thread = self._answer_in(it, str(it.get("place") or ""), thread)
            else:
                # **`to` supersedes `place` and the place is not looked at.** A destination somebody
                # named is not necessarily one this adapter has ever written to, so it has no
                # conversation string of ours — which is exactly why it crosses as an id — and no
                # prompted answer stands in it for `_answer_in` to resolve a target from.
                channel, thread = self._addressed(aimed), ""
            # A thread, where rundesk asked for one and named the message to hang it off. On Slack
            # a reply *is* a thread, so this is `thread_ts` and nothing has to be opened: the name
            # rundesk sent is for a platform that needs one and is deliberately unused here.
            if it.get("threaded") and it.get("reply_to"):
                thread = str(it["reply_to"])
        except (Refused, TypeError, ValueError) as why:
            say({"say": "failed", "id": given, "why": str(why)})
            return

        at = ""
        if text.strip():
            try:
                sent = self.web.chat_postMessage(
                    channel=channel, thread_ts=thread or None,
                    text=escaped_keeping_mentions(text))
            except Exception as why:       # noqa: BLE001 — a platform boundary
                self._final(why)
                failed = {"say": "failed", "id": given,
                          "why": f"Slack would not take it: {_why_slack_refused(why)}"}
                after = _retry_after(why)
                if after is not None:
                    failed["retry_after"] = after
                say(failed)
                return
            at = str(sent.get("ts") or "")
            if at:
                self._remember(self.standing, at, channel)
        if not carrying:
            say({"say": "delivered", "id": given, "external_id": at})
            return

        left_behind = self._uploaded(carrying, channel, thread, started)
        if not left_behind:
            say({"say": "delivered", "id": given, "external_id": at})
            return
        named = ", ".join(name for name, _why in left_behind)
        for name, why in left_behind:
            noted(f"could not attach {name} to the answer in this Slack conversation: {why}",
                  "error")
        # **Failed, and the words stay posted.** This delivery was asked for whole and did not
        # happen whole, so the one honest outcome is the one that leaves no completion mark over
        # it — `providers.answering` reads a refusal here and settles the turn as failed, which
        # takes the 👀 down and puts nothing up. Reporting it delivered would put a tick over an
        # answer with a piece missing, and the piece is the part somebody was waiting for.
        #
        # **Written before the line below, and that ordering is the whole of a bug that was here**
        # (R-SLK-49). Rundesk stops waiting for this record `LANDS_WITHIN` after the delivery went
        # out, and the line is an ordinary `chat_postMessage` — bounded at `CALL_WITHIN`, retried by
        # the SDK — so posting it first spent the rest of the budget on a courtesy nothing waits
        # on and let the record that settles the turn arrive too late to be read.
        say({"say": "failed", "id": given,
             "why": (f"the words were posted and {named} could not be attached"
                     if at else f"this delivery was only files and none of them went: {named}")})
        # **Said where the answer was expected, whichever way this ends.** A person watching a
        # conversation cannot read the agent's log, and a file that quietly never arrived is
        # indistinguishable from one the agent never made.
        self._say_plainly(channel, thread, COULD_NOT_ATTACH.format(named))

    def _uploaded(self, carrying: List[Any], channel: str, thread: str,
                  started: float) -> List[Tuple[str, str]]:
        """Verify and upload each file in turn. Hands back the ones that did not go, and why.

        **One file, verified and then uploaded, before the next is looked at.** The window between
        the check and the send is one call wide that way, and a file replaced while an earlier one
        was going up is caught by its own check rather than sent on the strength of an older one.

        **`files_upload_v2` and nothing else.** Slack retired `files.upload`, and the current path is
        the external-upload exchange the SDK performs behind this one method — an upload URL, the
        bytes, and a completion that shares the file. It is given the snapshot's bytes and never the
        path: what was verified is what goes.

        **Shared into the exact conversation the answer went to**, which is the channel and, where
        the answer is in one, that thread. A direct conversation is a channel id like any other
        here, so an answer in a direct message carries its file into the same place.

        One file refusing is one file: the rest are still tried, because a delivery that gave up on
        the first refusal would leave files behind that would have gone perfectly well.

        **Bounded by a deadline rather than by an admission test** (R-SLK-49). `started` is when
        the delivery was taken up, so the message posted before these is spent out of the same
        budget; what is left of `UPLOADS_WITHIN` is how long each upload is *waited on*, and a file
        with none of it left is not begun at all. The terminal record is therefore written while
        rundesk is still listening for it, however far an upload had got — which is what keeps a
        completion mark off an answer that lost a file.

        **Asking whether a whole upload would fit was not that**, and it is the defect this
        replaced: it bounded when an upload *started* and nothing bounded how long it ran, so one
        slow file answered after the wait had ended and the turn had already been called done.
        """
        left_behind: List[Tuple[str, str]] = []
        for one in carrying:
            if not isinstance(one, dict):
                left_behind.append(("a file", "it was not described as a file at all"))
                continue
            # **Never an empty name.** A record with neither a name nor a path still has to be
            # nameable in the line a person reads, or the sentence is `Could not attach: .`
            named = a_plain_name(one, Path(str(one.get("at") or ""))) or "a file"
            left = UPLOADS_WITHIN - (time.monotonic() - started)
            if left <= 0:
                left_behind.append((named, f"the {UPLOADS_WITHIN:g}s this delivery has to answer "
                                           f"in was spent before this file was reached, so nothing "
                                           f"was uploaded for it"))
                continue
            snapshot = None
            try:
                snapshot, filename = a_verified_file(one)
                # **The bytes are taken here and the snapshot let go of here.** What waits below
                # holds only what was verified, so nothing that has to be closed outlives this
                # loop — see `_uploading`, which may be left running after it.
                blob = snapshot.read()
                snapshot.close()
                snapshot = None
                refused = self._uploading(filename, blob, channel, thread, left)
                if refused:
                    left_behind.append((named, refused))
            except Refused as why:
                left_behind.append((named, str(why)))
            except Exception as why:       # noqa: BLE001 — a backstop, never the expected path
                left_behind.append((named, f"could not attach {named}: "
                                           f"{type(why).__name__}: {why}"))
            finally:
                if snapshot is not None:
                    with contextlib.suppress(Exception):
                        snapshot.close()
        return left_behind

    def _uploading(self, filename: str, blob: bytes, channel: str, thread: str,
                   within: float) -> str:
        """One upload, waited on for `within` and given up on at it. `""` when the file went.

        **A deadline needs somewhere to walk away from**, and a Web API call is not that: the
        vendor client is synchronous, `files_upload_v2` is three requests, and the timeout on the
        one that carries the bytes bounds a socket operation rather than the transfer. So the call
        is made on a worker and this waits on the worker, which is a bound that holds whatever the
        network does.

        **The worker is left running, and that is the honest cost of the deadline.** It is a daemon
        so it can never hold this process open, it holds bytes rather than any file this loop has
        to close, and there is nothing here to cancel it with — Slack may well complete the upload
        after the delivery has been reported as having lost it. So the file may appear in the
        conversation a minute later with no line beside it, and the alternative was calling
        something still in flight a success, which cannot be told from a file that really arrived.
        `AN_UPLOAD_WITHIN` is what stops an abandoned worker holding a stalled socket for ever.

        **A refusal is carried back to this thread rather than acted on inside the worker**, so
        `_final` still ends the adapter for a credential Slack will never accept again — one
        thread decides that, and it is this one.
        """
        outcome: Dict[str, Any] = {}

        def uploading() -> None:
            try:
                self.uploads.files_upload_v2(
                    channel=channel, filename=filename, content=blob,
                    **({"thread_ts": thread} if thread else {}))
            except Exception as why:       # noqa: BLE001 — a platform boundary, carried back below
                outcome["why"] = why

        worker = threading.Thread(target=uploading, name="uploading", daemon=True)
        worker.start()
        worker.join(within)
        if worker.is_alive():
            return (f"the {UPLOADS_WITHIN:g}s this delivery has to answer in was spent while it "
                    f"was still going up, so it was given up on")
        why = outcome.get("why")
        if why is None:
            return ""
        self._final(why)
        return f"Slack would not take it: {_why_slack_refused(why)}"

    def _answer_in(self, it: Dict[str, Any], place: str, thread: str) -> str:
        """Where this delivery belongs: one target for every piece of one prompted answer.

        **Read off `reply_to`, which rundesk composed from the message the turn is for** — so a
        later message said into the same running turn steers what the agent says and never where
        the answer appears (R-SLK-50). In a channel this is the thread the conversation is already
        keyed by and changes nothing.

        **A piece that answers no message reuses what the first piece resolved** (R-SLK-14), for
        that conversation and no other. Rundesk splits a long answer into several deliveries and
        marks only the first as the answer to something, with the files on the last — so without
        this a two-piece direct answer arrives in two places and its file in a third.

        **A later piece is not the only thing that reaches that branch, and this is deliberate
        rather than incidental.** A background continuation carries no `reply_to` and is only marked
        a notice when a schedule fired it, so a non-scheduled one has the same shape as a later
        piece and lands on the last prompted target for its conversation — held for as long as this
        run keeps it, bounded by `LIVE_KEPT`. That is the better of the two readings: what it
        answers belongs to the exchange somebody was having, and the alternative is a sentence
        arriving loose at the root of the direct conversation with nothing above it. A channel is
        unaffected either way, because its conversation carries the thread already.

        **An unprompted notice is never part of that, in either direction.** It neither takes a
        target nor leaves one, so a gateway notice or a schedule's report arriving between two
        pieces of an answer stays flat and moves nothing. **A notice may carry `reply_to` itself** —
        a schedule's report is posted under the announcement that preceded it — and it is still
        answered there and still remembers nothing: what it would have written down is the flat
        conversation, and the next piece of the real answer would then have followed it out of the
        thread it belongs in.

        `thread` is the fallback throughout and is the conversation's own: a message this run never
        saw — one that arrived before this adapter was started — is answered where the conversation
        is rather than nowhere.
        """
        answering = str(it.get("reply_to") or "")
        unprompted = bool(it.get("notice"))
        if answering:
            target = self.replying.get(answering) or thread
            if not unprompted:
                self._remember(self.prompted, place, target)
            return target
        if unprompted:
            return thread
        return self.prompted.get(place) or thread

    def _say_plainly(self, channel: str, thread: str, text: str) -> None:
        """Put one short line where the answer was expected. **Never raises, never acknowledged.**

        This is not a delivery: nothing waits on it and no id is held for it, so a platform that
        refuses it costs one line in the log rather than an answer nobody hears about.
        """
        try:
            self.web.chat_postMessage(channel=channel, thread_ts=thread or None,
                                      text=escaped(text))
        except Exception as why:           # noqa: BLE001 — a platform boundary
            self._final(why)
            noted(f"could not say in Slack what had not been attached: {_why_slack_refused(why)}",
                  "error")

    def _state(self, it: Dict[str, Any]) -> None:
        """Show what rundesk says a turn is doing: a status, a mark, and no opinion of ours.

        **Every state that ends a turn asks for the status back, including one that names no
        message.** A turn refused admission before it existed still raised the indicator, and a
        conversation left loading is the one failure of this mechanism nobody can act on. *Asks*
        rather than *clears*: it is one call, and where the call cannot be made — a rate limit
        standing, this session refused, the mechanism down — nothing is made up for it.
        """
        state = str(it.get("state") or "")
        try:
            _, channel, thread = where_of(it.get("place"))
        except Refused as why:
            noted(str(why))
            return
        named = str(it.get("external_id") or "")
        if state == WORKING:
            self._status(channel, thread, WORKING_STATUS)
            return
        if state in ENDED:
            # **One call, exactly as the way up is.** A session left `processing` is a conversation
            # loading until the next turn there ends, which is worth one call and is not worth
            # holding the next record up for.
            self._status(channel, thread, SETTLED_STATUS)
        mark = MARKS.get(state)
        if named:
            if mark:
                self._mark(channel, named, mark)
            elif state in ENDED:
                # **A turn that was stopped or that failed takes its 👀 down and puts nothing up.**
                # The sentence rundesk delivers for either of them is the news, and a second glyph
                # beside it would be this file having an opinion about a turn it did not run.
                self._unmark(channel, named)

    def _status(self, channel: str, thread: str, status: str) -> bool:
        """Set the agent session's status, which is the only typing this surface shows.

        **One call to Slack, or none. Never two.** Nothing here retries: a status is a courtesy on
        top of a turn that has already been answered, and a second call for it would be this adapter
        deciding that a person waiting on the next record matters less than an indicator. A refusal
        is reported where it happens and is acted on only by making *fewer* calls afterwards.

        **Slack's own mechanism or nothing at all.** `agents.sessions.setStatus` is the current
        method — the older `assistant.threads.setStatus` and the streaming methods are deliberately
        not used — and it needs the app to be declared as an agent in its own app settings, the bot
        to be in the channel, and both a channel and a thread. Where any of that is missing there is
        no indicator, and on no account is a message posted to imitate one: a chat line saying
        *working…* is exactly the exposed activity text this surface exists without.

        **There is no session for a direct message that is not in a thread**, because the method is
        keyed to a thread and a flat direct conversation has none. That is a platform limitation and
        is documented as one; the 👀 on the message is what says it was taken up there.

        **A status Slack does not define is never sent.** Four words exist, and a fifth is refused
        here rather than by spending a round trip learning `invalid_status` — the empty string is the
        one that keeps being reached for, and it belongs to the older method.
        """
        if not thread or status not in EVERY_STATUS:
            return False
        if not self._may_set_status(channel, thread):
            return False
        try:
            self.web.api_call(STATUS_METHOD,
                              json={"channel_id": channel, "thread_ts": thread, "status": status})
        except Exception as why:           # noqa: BLE001 — a platform boundary
            self._final(why)
            self._status_refused(_slack_said(why), _retry_after(why), channel, thread)
            return False
        return True

    def _may_set_status(self, channel: str, thread: str) -> bool:
        """Whether a status call may be made at all — asked before one is, and never after.

        Three ways it may not, and **they are three different scopes on purpose**: the mechanism is
        unavailable to this app, Slack has told this app to stop calling for a while, or this one
        session is refusing. A refusal about one channel must never quiet a different one.
        """
        return (not self.statusless
                and not self._embargoed()
                and _a_session(channel, thread) not in self.sessionless)

    def _embargoed(self) -> bool:
        """Whether Slack's own rate limit is still standing. Clears itself once it has passed.

        **Measured on the monotonic clock**, so the machine's wall clock moving — a daylight change,
        an NTP step — can neither cut an embargo short nor strand one for hours.
        """
        until = self.embargo_until
        if until is None:
            return False
        if time.monotonic() < until:
            return True
        self.embargo_until = None
        return False

    def _status_refused(self, said: str, after: Optional[float],
                        channel: str, thread: str) -> None:
        """What Slack refused a status call with, acted on **only by making fewer calls later**.

        Four outcomes and one call already spent: stand off until Slack's limit has passed, put the
        mechanism down, put this one session down, or say so and change nothing. Not one of them
        makes a second call. `said` is Slack's own word and is not interpreted beyond the two
        published sets above.
        """
        if said == RATE_LIMITED:
            self._rate_limited(after)
        elif said in NO_SESSIONS_AT_ALL:
            self._no_sessions(said)
        elif said in NO_SESSION_HERE:
            self._no_session_here(said, channel, thread)
        else:
            # Not proof of anything. A bad moment on Slack's side, an argument this release has
            # never sent, a word from a version of the method newer than this file — each is one
            # call that failed, said once where it happened, and nothing switched off over it.
            noted(f"Slack would not set an agent session status ({said or 'no reason given'}), so "
                  f"no typing indicator is shown for that turn. Nothing is posted in its place",
                  "warning")

    def _rate_limited(self, after: Optional[float]) -> None:
        """Slack asked this app to stop calling. **Nothing waits; later calls are simply not made.**

        **The embargo is this whole adapter's**, and that is the right scope rather than a
        convenience: one Slack app, one workspace, one method, so a limit on it is a limit on every
        place at once. Keyed to a moment rather than a countdown, so it survives any number of
        records arriving in between, and taken as the later of what stands and what Slack has just
        asked for — a second limit arriving mid-embargo may extend it and must never shorten it.

        **Only a real, positive, finite number is a deadline.** Absent, unreadable, zero, negative,
        an infinity and a NaN are one answer: Slack said nothing this can act on. There is no
        interval to invent — inventing one is how an app ends up calling into a limit it was told
        about — so the optional mechanism is put down until this adapter is started again, which is
        the quietest thing it can do and costs only an indicator.
        """
        if after is None or not math.isfinite(after) or after <= 0:
            self.statusless = True
            noted("Slack rate-limited this app's agent session status and gave no usable "
                  "Retry-After, so no typing indicator is shown until this channel is started "
                  "again. Nothing is posted in its place, and nothing is retried", "warning")
            return
        until = time.monotonic() + after
        standing = self.embargo_until
        self.embargo_until = until if standing is None else max(standing, until)
        noted(f"Slack rate-limited this app's agent session status and asked for {after:g}s, so no "
              f"typing indicator is shown anywhere until that has passed. Nothing is posted in its "
              f"place, and nothing is retried", "warning")

    def _no_sessions(self, said: str) -> None:
        """The mechanism itself is unavailable to this app. Said once, naming what to go and do.

        **Said once without a guard saying so.** Nothing reaches here while `statusless` already
        stands: `_may_set_status` refuses the call, so there is no refusal to classify. A check for
        it would read like the rule and be reachable by nothing — the same shape twice removed from
        this file already.
        """
        self.statusless = True
        noted(f"Slack would not set this app's agent session status ({said}), so no typing indicator "
              f"is shown here — the app has to be declared as an agent in its app settings and "
              f"installed again afterwards, the bot has to be in the channel, and some AI features "
              f"need a paid plan. Nothing is posted in its place", "info")

    def _no_session_here(self, said: str, channel: str, thread: str) -> None:
        """This one channel or thread refuses a session. **Nowhere else is quieted.**

        Written down so the same place is not asked about on every turn, and bounded like everything
        else this holds, because the process runs for weeks.
        """
        # **No guard against being called twice for one place, because there cannot be one.**
        # `_may_set_status` refuses the call once the place is written down here, so this is only
        # ever reached for a place that is not in it yet. A check would have read like the rule and
        # been reachable by nothing.
        self._remember(self.sessionless, _a_session(channel, thread), time.monotonic())
        noted(f"Slack would not set an agent session status in this thread ({said}), so no typing "
              f"indicator is shown there. Every other place is unaffected, and nothing is posted in "
              f"its place", "info")

    def _mark(self, channel: str, at: str, mark: str) -> None:
        """Put the new mark up before taking the old one down, so nothing is ever unmarked.

        A message with no mark for a moment reads as a turn nobody picked up, and the order is the
        only thing that decides which of those somebody sees. If the new one will not go up, the old
        one staying is the failure to prefer.
        """
        standing_in = self.standing.get(at, channel)
        keyed = f"{standing_in}/{at}"
        if self.marks.get(keyed) == mark:
            return
        try:
            self.web.reactions_add(channel=standing_in, timestamp=at, name=mark)
        except Exception as why:           # noqa: BLE001 — a platform boundary
            self._final(why)
            if not _already_marked(why):
                noted(f"could not mark a message with :{mark}:: {_why_slack_refused(why)}")
                return
        standing = self.marks.get(keyed)
        self._remember(self.marks, keyed, mark)
        if standing and standing != mark:
            self._take_down(standing_in, at, standing)

    def _unmark(self, channel: str, at: str) -> None:
        """Take whatever mark is standing off a message, and remember that none is."""
        standing_in = self.standing.get(at, channel)
        keyed = f"{standing_in}/{at}"
        with self.holding:
            standing = self.marks.pop(keyed, "")
        if standing:
            self._take_down(standing_in, at, standing)

    def _take_down(self, channel: str, at: str, mark: str) -> None:
        """Remove one mark. A mark that will not come off is a line and never a failure."""
        try:
            self.web.reactions_remove(channel=channel, timestamp=at, name=mark)
        except Exception as why:           # noqa: BLE001 — a platform boundary
            self._final(why)

    def _remember(self, holding: Dict[str, Any], key: str, value: Any) -> None:
        """Write one thing down, and keep what is held bounded. Oldest first.

        **Bounded because this process runs for weeks**: a map that grows by one per message and
        shrinks by nothing is a leak that shows first on the machine which has been up longest. Under
        the one lock because two kinds of thread write here — see `holding`.
        """
        with self.holding:
            holding[key] = value
            while len(holding) > LIVE_KEPT:
                holding.pop(next(iter(holding)))


def _before(one: str, other: str) -> bool:
    """Whether one Slack timestamp stands before another. `False` for anything unreadable."""
    return _as_a_number(one) < _as_a_number(other)


def _as_a_number(said: str) -> float:
    """A `ts` as the number Slack orders them by. `0.0` for anything that is not one."""
    try:
        return float(said)
    except (TypeError, ValueError):
        return 0.0


def _already_marked(why: Any) -> bool:
    """Whether Slack refused a reaction because it is already there, which is not a failure."""
    return _slack_said(why) == "already_reacted"


def _retry_after(why: Any) -> Optional[float]:
    """How long Slack asked us to wait, where it said. **Absent means nothing to tell you.**"""
    answered = getattr(why, "response", None)
    headers = getattr(answered, "headers", None) or {}
    said = headers.get("Retry-After") or headers.get("retry-after")
    if said is None:
        return None
    try:
        return float(said)
    except (TypeError, ValueError):
        return None


def serving() -> int:
    """Hold the connection open and carry conversations until rundesk ends us."""
    missing = the_library()
    if missing:
        noted(missing, "error")
        return WILL_NOT_FIX
    bot, app = the_tokens()
    trouble = _token_trouble(bot, app)
    if trouble:
        # Said where the gateway's log will show it. A machine keeping an agent up has no terminal
        # and no shell profile, which is the state a channel spends its whole life in.
        noted(trouble, "error")
        return WILL_NOT_FIX
    allow, places = who_may_reach(), which_places()
    if not allow and not places:
        # Both empty authorises nobody, so this would run perfectly and answer no one. Said out loud,
        # because a channel that is deaf by configuration looks exactly like a broken one.
        noted("nothing said who may reach this agent, so nothing said here will be answered",
              "error")
    return Reaching(allow, places).run(bot, app)


def main(argv: List[str]) -> int:
    """The five invocations, and nothing that quietly resembles one of them.

    Matched exactly rather than searched for: an adapter that took a mistyped `--check` for a request
    for its capabilities would answer a question nobody asked and look as though it worked, and one
    that took `--search` for `search` would read a request off an input nothing wrote to.

    **`search` and `fetch` are the two an agent causes**, in the middle of a turn, and both are
    bounded programs of their own rather than words down a hosted channel's pipe — so both work in a
    turn a schedule started, neither takes the channel's claim, and neither displaces a `serve`.
    """
    if argv == ["--capabilities"]:
        return capabilities()
    if argv[:1] == ["--check"]:
        return check(list(argv[1:]))
    if argv == ["search"]:
        return search()
    if argv == ["fetch"]:
        return fetch()
    if argv == ["serve"]:
        return serving()
    cannot_say(f"slack: {' '.join(argv) or 'nothing'} is not one of --capabilities, "
               f"--check [options], search, fetch or serve")
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
