#!/usr/bin/env python3
"""Run every suite in `tests/`, and fail when there are none.

The suites are **found**, not listed, so a file added to `tests/` is run the day it lands. CI calls
this same script rather than keeping a list of its own — a list kept in two places is a list that
disagrees with itself.

**It fails on an empty discovery.** That is not defensiveness. The runner this replaces globbed a
directory that had since moved, matched zero files, and printed `parse OK`; the project lost its only
syntax check and nothing anywhere went red. A check that ran nothing has proved nothing, and must say
so in the one way anybody reads — its exit code.

**Suites run several at a time**, each in an interpreter of its own, because that is what a suite
already is: `support.Isolated` gives every case a scratch root of its own and every guard in
`tests/support.py` — the scrubbed environment, the stand-in supervisor, the closed network — is
per-process, so running eight interpreters is the same isolation eight times rather than a weaker
one shared.

**The longest suite is the run.** Whole files are the unit of parallelism, so no schedule finishes
before the slowest one does, and the work either side of it is free. That is why this starts the
slowest suites first — see `_running_order` — and why a suite that has grown to twice its
neighbours is worth splitting rather than tuning.

    python3 scripts/suites          # every suite
    python3 scripts/suites -q       # only the failures and the summary
    python3 scripts/suites -1       # one at a time, for a suite that only fails under load
"""

import json
import os
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TESTS = ROOT / "tests"

#: A suite that hangs has failed, whatever it would have printed. Generous, because the ceiling is
#: there to end a wedged run rather than to measure anything.
#:
#: **It is a ceiling on a suite under load**, which is what makes the generosity load-bearing rather
#: than decorative: a suite sharing the machine with seven others really does take longer, and one
#: measured three times its own sequential length at sixteen workers.
PATIENCE_SECONDS = 300

#: How many suites are in flight at once.
#:
#: **Threads and never processes.** All this runner does is wait on `subprocess.run`, which holds no
#: lock while it waits — so a thread costs nothing here and a process pool would add a fork and a
#: pickle for each one to do the identical thing.
#:
#: **Fewer than there are cores, on purpose.** A suite is not one process: it starts gateways,
#: adapters and whole `rundesk` commands of its own, so one worker per core oversubscribes the
#: machine and every suite slows down together. Re-measured on sixteen cores: sixteen workers
#: finished no sooner than eight and inflated the sum of the suites' own times by 29 per cent — and
#: a ceiling reached because the machine was busy is a failure nobody can reproduce.
AT_ONCE = min(8, os.cpu_count() or 4)


def found():
    """Every suite, in a settled order. Never a list written here."""
    return sorted(TESTS.glob("test_*.py"))


#: Where the last run's timings are kept, so the next one can start the slow suites first.
#:
#: **Learned rather than written down.** A list of durations kept by hand is a list that disagrees
#: with the suites within a month, and the one thing worse than no ordering is an ordering everybody
#: believes. Under `.scratch/`, which is already ignored, so it is neither an artifact of the
#: repository nor something a checkout has to have: a cold run — CI, or the first run here — simply
#: finds nothing and goes in the order suites were found in, which is what this did before.
REMEMBERED = ROOT / ".scratch" / "suite-seconds.json"


def _remembered():
    """What each suite took last time, by name. Empty on anything unreadable.

    Nothing here is load-bearing: it decides only what starts first. So a file that is missing,
    truncated, from an older set of suites, or written by a different machine costs a little
    scheduling and never a result — which is why it is read without ceremony and never validated.
    """
    try:
        with open(REMEMBERED, encoding="utf-8") as reading:
            said = json.load(reading)
        return {name: float(seconds) for name, seconds in said.items()}
    except (OSError, ValueError, AttributeError, TypeError):
        return {}


def _remember(seconds):
    """Write this run's timings for the next one. A failure to write is not a failure of the run."""
    try:
        REMEMBERED.parent.mkdir(parents=True, exist_ok=True)
        with open(REMEMBERED, "w", encoding="utf-8") as writing:
            json.dump(seconds, writing, indent=1, sort_keys=True)
    except OSError:
        pass


def _running_order(suites, seconds):
    """The order to *start* them in: longest first, and anything unmeasured before all of them.

    **Longest first because the longest suite is the run.** Whole files are the unit of parallelism,
    so a suite that starts last runs alone with seven idle workers beside it, and a run can finish
    no sooner than its slowest suite starts plus however long that suite takes. Starting the long
    ones while there is still short work to fill in behind them is the whole of the difference.

    **A suite nobody has timed goes first**, rather than last. It may be the new slowest one, and
    guessing it is quick is the guess that costs something; guessing it is slow costs nothing but
    its position. This is also what makes a stale file safe — a suite that has since been split or
    renamed is simply unmeasured again.

    Never a filter. Every suite handed in comes back out, which is the property that keeps this from
    being able to reintroduce the empty run below.
    """
    ordered = sorted(suites, key=lambda suite: -seconds.get(suite.name, float("inf")))
    assert len(ordered) == len(suites)
    return ordered


def ran(suite):
    """One suite, in an interpreter of its own. Hands back whether it passed, what it said, and how
    long it took.

    Never prints. **Several of these are in flight at once**, and a function that wrote as it went
    would interleave two suites' output line by line into something nobody can read.

    The duration is measured here because here is where the suite is, and it is what `_remember`
    writes for the next run to start in a better order. It is a timing under load rather than the
    suite's own time alone, which is the right one: it is what the next run will do too.
    """
    began = time.monotonic()
    try:
        # `stdin` is closed on purpose. A command reading standard input because it is "not a
        # terminal" blocks on an open pipe with nothing in it, which never ends and names
        # nothing when it happens.
        ended = subprocess.run(
            [sys.executable, str(suite)],
            cwd=str(ROOT), stdin=subprocess.DEVNULL,
            capture_output=True, text=True, timeout=PATIENCE_SECONDS)
        return ended.returncode == 0, ended.stdout + ended.stderr, time.monotonic() - began
    except subprocess.TimeoutExpired:
        return False, f"exceeded {PATIENCE_SECONDS} seconds", time.monotonic() - began


def main(argv):
    quiet, one_at_a_time = "-q" in argv, "-1" in argv
    suites = found()
    if not suites:
        # **In front of the pool, and it stays there.** A pool handed nothing to do finishes
        # perfectly happily, so a check that had drifted below this line would report a clean run
        # over an empty discovery — which is the exact failure this script exists to have caught.
        print(f"suites: FAILED — no suite found in {TESTS}", file=sys.stderr)
        print("        a run that discovered nothing has proved nothing", file=sys.stderr)
        return 1

    # **Started slowest first, reported in the order they were found.** Those are two different
    # orders and they need to be: the schedule wants the long suites in flight early, while the
    # report is read down the page and diffed against the last one, so it must not move about.
    starting = suites if one_at_a_time else _running_order(suites, _remembered())
    with ThreadPoolExecutor(max_workers=1 if one_at_a_time else AT_ONCE) as pool:
        got = dict(zip(starting, pool.map(ran, starting)))

    if not one_at_a_time:
        # **Only a run under load is worth remembering.** These numbers exist to order the next
        # ordinary run, and a suite timed with the machine to itself is a different measurement —
        # shorter, and shorter by a different amount for each suite. Recording one here would make
        # the file mean two things depending on which flag last wrote it.
        _remember({suite.name: round(seconds, 1) for suite, (_ok, _said, seconds) in got.items()})

    failed = []
    for suite in suites:
        ok, said, _seconds = got[suite]
        print(f"{'ok  ' if ok else 'FAIL'} {suite.name}")
        if not ok:
            failed.append(suite.name)
            print(said.rstrip(), file=sys.stderr)
        elif not quiet:
            print("     " + _counted(said))

    print(f"\nsuites: {len(suites)} run, {len(failed)} failed")
    for name in failed:
        print(f"        FAILED {name}", file=sys.stderr)
    return 1 if failed else 0


def _counted(said: str) -> str:
    """The `Ran N tests` line, which is the only part of a green run worth showing.

    Read out loud because `OK` and `OK (skipped=65)` are the same word to whoever reads a summary,
    and a suite that skipped everything is not a suite that passed.
    """
    for line in said.splitlines():
        if line.startswith("Ran ") or line.startswith("OK ("):
            return line.strip()
    return "said nothing about how many tests it ran"


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
