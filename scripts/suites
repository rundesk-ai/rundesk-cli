#!/usr/bin/env python3
"""Run every suite in `tests/`, and fail when there are none.

The suites are **found**, not listed, so a file added to `tests/` is run the day it lands. CI calls
this same script rather than keeping a list of its own — a list kept in two places is a list that
disagrees with itself.

**It fails on an empty discovery.** That is not defensiveness. The runner this replaces globbed a
directory that had since moved, matched zero files, and printed `parse OK`; the project lost its only
syntax check and nothing anywhere went red. A check that ran nothing has proved nothing, and must say
so in the one way anybody reads — its exit code.

**Suites run several at a time**, each in an interpreter of its own, because that is what a suite
already is: `support.Isolated` gives every case a scratch root of its own and every guard in
`tests/support.py` — the scrubbed environment, the stand-in supervisor, the closed network — is
per-process, so running eight interpreters is the same isolation eight times rather than a weaker
one shared. Measured on sixteen cores: 274 seconds sequential, 48 concurrent.

    python3 scripts/suites          # every suite
    python3 scripts/suites -q       # only the failures and the summary
    python3 scripts/suites -1       # one at a time, for a suite that only fails under load
"""

import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TESTS = ROOT / "tests"

#: A suite that hangs has failed, whatever it would have printed. Generous, because the ceiling is
#: there to end a wedged run rather than to measure anything.
#:
#: **It is a ceiling on a suite under load**, which is what makes the generosity load-bearing rather
#: than decorative: a suite sharing the machine with seven others really does take longer, and one
#: measured three times its own sequential length at sixteen workers.
PATIENCE_SECONDS = 300

#: How many suites are in flight at once.
#:
#: **Threads and never processes.** All this runner does is wait on `subprocess.run`, which holds no
#: lock while it waits — so a thread costs nothing here and a process pool would add a fork and a
#: pickle for each one to do the identical thing.
#:
#: **Fewer than there are cores, on purpose.** A suite is not one process: it starts gateways,
#: adapters and whole `rundesk` commands of its own, so one worker per core oversubscribes the
#: machine and every suite slows down together. Measured, sixteen workers finished *later* than
#: eight and stretched the longest suite by half — and a ceiling reached because the machine was
#: busy is a failure nobody can reproduce.
AT_ONCE = min(8, os.cpu_count() or 4)


def found():
    """Every suite, in a settled order. Never a list written here."""
    return sorted(TESTS.glob("test_*.py"))


def ran(suite):
    """One suite, in an interpreter of its own. Hands back whether it passed and what it said.

    Never prints. **Several of these are in flight at once**, and a function that wrote as it went
    would interleave two suites' output line by line into something nobody can read.
    """
    try:
        # `stdin` is closed on purpose. A command reading standard input because it is "not a
        # terminal" blocks on an open pipe with nothing in it, which never ends and names
        # nothing when it happens.
        ended = subprocess.run(
            [sys.executable, str(suite)],
            cwd=str(ROOT), stdin=subprocess.DEVNULL,
            capture_output=True, text=True, timeout=PATIENCE_SECONDS)
        return ended.returncode == 0, ended.stdout + ended.stderr
    except subprocess.TimeoutExpired:
        return False, f"exceeded {PATIENCE_SECONDS} seconds"


def main(argv):
    quiet, one_at_a_time = "-q" in argv, "-1" in argv
    suites = found()
    if not suites:
        # **In front of the pool, and it stays there.** A pool handed nothing to do finishes
        # perfectly happily, so a check that had drifted below this line would report a clean run
        # over an empty discovery — which is the exact failure this script exists to have caught.
        print(f"suites: FAILED — no suite found in {TESTS}", file=sys.stderr)
        print("        a run that discovered nothing has proved nothing", file=sys.stderr)
        return 1

    with ThreadPoolExecutor(max_workers=1 if one_at_a_time else AT_ONCE) as pool:
        # `map` rather than `as_completed`: this report is read down the page and diffed against the
        # last one, so its order is the order suites were found in, whatever finishes first.
        got = list(pool.map(ran, suites))

    failed = []
    for suite, (ok, said) in zip(suites, got):
        print(f"{'ok  ' if ok else 'FAIL'} {suite.name}")
        if not ok:
            failed.append(suite.name)
            print(said.rstrip(), file=sys.stderr)
        elif not quiet:
            print("     " + _counted(said))

    print(f"\nsuites: {len(suites)} run, {len(failed)} failed")
    for name in failed:
        print(f"        FAILED {name}", file=sys.stderr)
    return 1 if failed else 0


def _counted(said: str) -> str:
    """The `Ran N tests` line, which is the only part of a green run worth showing.

    Read out loud because `OK` and `OK (skipped=65)` are the same word to whoever reads a summary,
    and a suite that skipped everything is not a suite that passed.
    """
    for line in said.splitlines():
        if line.startswith("Ran ") or line.startswith("OK ("):
            return line.strip()
    return "said nothing about how many tests it ran"


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
