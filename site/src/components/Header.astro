---
/**
 * Starlight's header, with the area switcher hung underneath it.
 *
 * The plugin puts the areas at the top of the left sidebar. Moving them into the
 * header makes the two navigations answer different questions in different places:
 * across the top, which area am I in; down the side, where in it. The sidebar copy
 * is hidden in `brand.css` rather than removed, because the plugin still owns
 * marking the current one.
 */
import Default from '@astrojs/starlight/components/Header.astro';

const topics = Astro.locals.starlightSidebarTopics?.topics ?? [];
---

<div class="rd-header">
	<div class="rd-header__bar">
		<Default><slot /></Default>
	</div>
	{
		topics.length > 0 && (
			<nav class="rd-areas" aria-label="Documentation areas">
				<ul>
					{topics.map((topic) => (
						<li>
							<a href={topic.link} aria-current={topic.isCurrent ? 'page' : undefined}>
								{topic.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		)
	}
</div>
