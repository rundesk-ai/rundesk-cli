---
/** The install one-liner, framed as a panel rather than one code block among many. */
const command =
	'curl -fsSL https://github.com/rundesk-ai/rundesk-cli/releases/latest/download/install.sh | bash';
---

<div class="rd-install">
	<code class="rd-install__line"><span class="rd-install__prompt">$</span>{command}</code>
	<button class="rd-install__copy" type="button" data-command={command}>
		<span class="rd-install__copy-label">Copy</span>
	</button>
</div>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.rd-install__copy')) {
		const label = button.querySelector('.rd-install__copy-label');
		button.addEventListener('click', async () => {
			const command = button.dataset.command;
			if (!command || !label) return;
			try {
				await navigator.clipboard.writeText(command);
				label.textContent = 'Copied';
				button.dataset.copied = 'true';
			} catch {
				label.textContent = 'Press ⌘C';
			}
			setTimeout(() => {
				label.textContent = 'Copy';
				delete button.dataset.copied;
			}, 2000);
		});
	}
</script>
