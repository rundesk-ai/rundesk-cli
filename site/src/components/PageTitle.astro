---
/** The page title, with the area it belongs to as an eyebrow above it. */
import Default from '@astrojs/starlight/components/PageTitle.astro';

const current = Astro.locals.starlightSidebarTopics?.topics?.find((topic) => topic.isCurrent);
---

{current && <p class="rd-eyebrow">{current.label}</p>}
<Default><slot /></Default>
