#!/usr/bin/env python3
"""A platform that does not exist, so a stranger's adapter can be driven offline.

Not the stranger's — ours, written afterwards to stand where their platform would.
It answers the four commands their adapter was told about and nothing else, so what
the conformance suite exercises is the *adapter*, not this.

Kept in `platforms/` and never beside the adapter, for the reason the brains directory
exists: an adapter that can find *itself* under the name it looks its platform up by
runs itself, and that copy does the same.
"""
import json
import os
import sys
import time

what = sys.argv[1] if len(sys.argv) > 1 else ""
if what == "check":
    if not os.environ.get("SEMAPHORE_TOKEN"):
        sys.exit(1)
    print(json.dumps({"station": "1180", "name": "the fake station"}))
elif what == "listen":
    print(json.dumps({"kind": "up"}), flush=True)
    said = os.environ.get("FAKE_SAYS")
    if said:
        print(json.dumps({"kind": "message", "from": "2207", "post": said,
                          "at": "8841", "flag": "one"}), flush=True)
    time.sleep(float(os.environ.get("FAKE_FOR") or 3600))
elif what in ("send", "mark"):
    pass
else:
    sys.exit(2)
