#!/usr/bin/env python3
"""
semaphore-channel -- a Rundesk channel adapter for Semaphore.

Semaphore is a chat service whose CLI (`semaphore`) is assumed to be on PATH:

    semaphore listen --station <id>          # one JSON object per line on stdout
    semaphore send   --flag <id> --body <t>  # post a message
    semaphore mark   --post <id> --symbol s  # s in {eyes, tick, cross}
    semaphore check  --station <id>          # exit 0 + {"station","name"} if reachable

Mapping onto Rundesk's contract:

    Rundesk `conversation`  <- Semaphore "flag"    (its word for a thread/room)
    Rundesk `user`          <- Semaphore "from"
    Rundesk `text`          <- Semaphore "post"
    Rundesk `ref`           <- Semaphore "at"      (what a mark attaches to)

Fidelity of this surface: Semaphore has three markers and nothing else. No typing
indicator, no edit, no presence. So:

    state taken     -> mark the asking message `eyes`
    state running   -> nothing (nothing to keep alive; no typing indicator)
    state finished  -> mark `tick`, and post the `answer` when it arrives
    state stopped   -> mark `cross`, post a one-line note
    state failed    -> mark `cross`, post a one-line note with `why`

Work-in-progress commentary (tool / result / think) is posted as ordinary messages,
coalesced into one post every COMMENTARY_SECONDS so a tool-heavy turn does not turn
into fifty messages. The guide's advice for a surface that cannot edit is that it
"posts again instead"; it gives no throttling rule, so the window below is a choice
of mine, not a requirement. See NOTES.md.

Everything not in the specification is marked with a "CHOICE:" comment.
"""

from __future__ import annotations

import json
import os
import queue
import signal
import subprocess
import sys
import threading
import time
from collections import OrderedDict, deque

# --------------------------------------------------------------------------- #
# Constants
# --------------------------------------------------------------------------- #

SEMAPHORE = "semaphore"

# Semaphore's own convention for the credential.
TOKEN_ENV = "SEMAPHORE_TOKEN"

# The three markers Semaphore has, used for the three things worth showing.
MARK_TAKEN = "eyes"
MARK_OK = "tick"
MARK_BAD = "cross"

# CHOICE: the spec documents no maximum body length for `semaphore send`, and the
# body goes on argv, which has a hard OS limit. Split long posts well under any
# plausible ARG_MAX.
MAX_BODY = 3000

# CHOICE: coalesce running commentary into one post at most this often.
COMMENTARY_SECONDS = 5.0

# CHOICE: reconnect backoff for `semaphore listen`. The spec says reconnecting is
# ours and that Rundesk has no opinion, so these numbers are ours.
BACKOFF_START = 1.0
BACKOFF_MAX = 30.0

# CHOICE: how long a message we posted stays suppressible as an echo. Nothing in
# the spec tells us the adapter's own Semaphore user id, so we cannot filter our
# own posts out of `listen` by author. Matching on (flag, text) is the fallback.
ECHO_WINDOW_SECONDS = 120.0

# CHOICE: file names looked for inside RUNDESK_CHANNEL_HOME when the environment
# variable is absent. The spec mandates the fallback but never names the file.
TOKEN_FILES = ("token", "semaphore.token")

# CHOICE: the words that mean a control rather than a message. The spec says both
# controls are "yours to offer however your platform offers things"; Semaphore has
# no buttons or slash commands, so these are plain leading words.
CONTROL_WORDS = {"/stop": "stop", "/forget": "forget"}

_OUT_LOCK = threading.Lock()


# --------------------------------------------------------------------------- #
# Plumbing
# --------------------------------------------------------------------------- #


def emit(record: dict) -> None:
    """One JSON object per line on stdout, flushed as it happens."""
    line = json.dumps(record, ensure_ascii=False)
    with _OUT_LOCK:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()


def log(message: str) -> None:
    """stderr is ours; it is kept and never mistaken for what we reported."""
    sys.stderr.write("semaphore-channel: %s\n" % message)
    sys.stderr.flush()


def find_token(channel_home: str | None) -> tuple[str | None, str]:
    """Look in both places: the environment first, then a file the owner controls.

    Returns (token, where) -- `where` is for the log only, never for `settings`.
    We never write this file; putting a credential on disk is the owner's call.
    """
    value = os.environ.get(TOKEN_ENV)
    if value and value.strip():
        return value.strip(), "environment"

    if channel_home:
        for name in TOKEN_FILES:
            path = os.path.join(channel_home, name)
            try:
                with open(path, "r", encoding="utf-8") as handle:
                    text = handle.read().strip()
            except OSError:
                continue
            if text:
                return text, path

    return None, "nowhere"


def child_env(token: str) -> dict:
    """Environment for the semaphore CLI. The token goes here, never on argv."""
    env = dict(os.environ)
    env[TOKEN_ENV] = token
    return env


def chunk(text: str, limit: int = MAX_BODY) -> list[str]:
    """Split an over-long body, preferring line boundaries."""
    text = text if text is not None else ""
    if len(text) <= limit:
        return [text]

    parts: list[str] = []
    remaining = text
    while len(remaining) > limit:
        cut = remaining.rfind("\n", 0, limit)
        if cut <= 0:
            cut = remaining.rfind(" ", 0, limit)
        if cut <= 0:
            cut = limit
        parts.append(remaining[:cut])
        remaining = remaining[cut:].lstrip("\n")
    if remaining:
        parts.append(remaining)
    return parts


# --------------------------------------------------------------------------- #
# Options
# --------------------------------------------------------------------------- #


def parse_options(argv: list[str]) -> tuple[dict, str | None]:
    """Parse the owner's own options. Rundesk does not parse them; we do.

    Accepts a leading `--` separator because the spec is not explicit about
    whether the separator is stripped before we are handed the rest.
    """
    args = list(argv)
    if args and args[0] == "--":
        args = args[1:]

    settings: dict = {}
    index = 0
    while index < len(args):
        arg = args[index]
        name, _, inline = arg.partition("=")

        if name in ("--station", "-s"):
            if inline:
                value = inline
            else:
                index += 1
                if index >= len(args):
                    return {}, "--station needs a station id"
                value = args[index]
            settings["station"] = value
        else:
            # "were given options you do not understand, say so and say ok: false"
            return {}, "I do not understand the option %r. I take --station <id>." % arg
        index += 1

    if "station" not in settings:
        return {}, "no station given. Pass --station <id>."
    return settings, None


def load_settings(argv: list[str]) -> dict:
    """At run time the settings come back through RUNDESK_SETTINGS.

    CHOICE: fall back to parsing argv, in case a runtime invocation also carries
    the owner's options. The spec only promises RUNDESK_SETTINGS.
    """
    raw = os.environ.get("RUNDESK_SETTINGS")
    if raw:
        try:
            parsed = json.loads(raw)
            if isinstance(parsed, dict) and parsed.get("station"):
                return parsed
            log("RUNDESK_SETTINGS had no station in it; falling back to argv")
        except (TypeError, ValueError) as exc:
            log("RUNDESK_SETTINGS is not JSON (%s); falling back to argv" % exc)

    settings, error = parse_options(argv)
    if error:
        return {}
    return settings


# --------------------------------------------------------------------------- #
# Question one: can you reach it?
# --------------------------------------------------------------------------- #


def run_check(argv: list[str]) -> int:
    """Connect, verify we can see the station, print one JSON object.

    Nothing is written down until we say ok, so this is where a misconfigured
    channel has to be caught.

    CHOICE: we always exit 0, even when ok is false. The spec only prescribes
    exit 0 for the success path; exiting non-zero risks the object we printed
    being ignored, and the object is the whole point.
    """

    def refuse(why: str) -> int:
        emit({"ok": False, "why": why})
        return 0

    settings, error = parse_options(argv)
    if error:
        return refuse(error)

    # RUNDESK_CHANNEL_HOME is promised for the run, not explicitly for --check.
    # Use it if it happens to be here.
    token, where = find_token(os.environ.get("RUNDESK_CHANNEL_HOME"))
    if not token:
        return refuse(
            "no Semaphore token. Export %s, or put the token in a file named "
            "'token' inside the channel's home directory. I will not write that "
            "file for you." % TOKEN_ENV
        )

    station = settings["station"]
    try:
        done = subprocess.run(
            [SEMAPHORE, "check", "--station", station],
            env=child_env(token),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=30,
        )
    except FileNotFoundError:
        return refuse("cannot find the %r command on PATH." % SEMAPHORE)
    except subprocess.TimeoutExpired:
        return refuse("%s check --station %s did not answer within 30s." % (SEMAPHORE, station))
    except OSError as exc:
        return refuse("could not run %r: %s" % (SEMAPHORE, exc))

    if done.returncode != 0:
        detail = (done.stderr or b"").decode("utf-8", "replace").strip()
        return refuse(
            "the token is not good for station %s, or the station is not visible "
            "to it (semaphore check exited %d)%s"
            % (station, done.returncode, (": " + detail) if detail else "")
        )

    name = None
    try:
        payload = json.loads((done.stdout or b"").decode("utf-8", "replace"))
        if isinstance(payload, dict):
            name = payload.get("name")
            # Say what you understood: prefer the id Semaphore itself echoed back.
            station = str(payload.get("station") or station)
    except ValueError:
        # It exited 0, so the credential is good; we just have no human name.
        log("semaphore check exited 0 but did not print JSON I could read")

    # `settings` is what we will be handed back in a year. Normalised, and with
    # no credential in it -- it is written to a file that outlives us.
    resolved = {"station": station}
    if name:
        resolved["name"] = name

    describes = "Semaphore station %s" % station
    if name:
        describes = "%s (%s) on Semaphore" % (name, station)

    log("credential found in %s" % where)
    emit(
        {
            "ok": True,
            "settings": resolved,
            "secret": {"env": TOKEN_ENV},
            "describes": describes,
        }
    )
    return 0


# --------------------------------------------------------------------------- #
# Question two: carry one conversation
# --------------------------------------------------------------------------- #


class Channel:
    def __init__(self, settings: dict, token: str) -> None:
        self.station = str(settings["station"])
        self.token = token
        self.env = child_env(token)

        self.stopping = threading.Event()
        self.outbound: "queue.Queue[tuple | None]" = queue.Queue()

        self.state_lock = threading.Lock()
        # run id -> what a mark for that run attaches to.
        self.run_ref: "OrderedDict[str, str]" = OrderedDict()
        # conversation -> ref of the last message that arrived there, for when a
        # `state` record does not carry one.
        self.last_ref: "OrderedDict[str, str]" = OrderedDict()
        # conversation -> what the brain said it can do, so we only offer what is real.
        self.can: "OrderedDict[str, dict]" = OrderedDict()
        # run id -> {tool id: tool name}, so a `result` can name its tool.
        self.tools: "OrderedDict[str, dict]" = OrderedDict()

        # conversation -> pending commentary lines, flushed on a timer.
        self.pending: "OrderedDict[str, list]" = OrderedDict()
        self.flushed_at = 0.0

        self.echoes: "deque[tuple[float, str, str]]" = deque()

        self.listener: subprocess.Popen | None = None
        self.up = False
        self.down_reported = False

    # -- small bounded maps ------------------------------------------------- #

    @staticmethod
    def _remember(store: OrderedDict, key: str, value, cap: int = 256) -> None:
        store[key] = value
        store.move_to_end(key)
        while len(store) > cap:
            store.popitem(last=False)

    # -- outbound ----------------------------------------------------------- #

    def send(self, flag: str, text: str) -> None:
        for piece in chunk(text):
            if piece.strip():
                self.outbound.put(("send", flag, piece))

    def mark(self, ref: str | None, symbol: str) -> None:
        if ref:
            self.outbound.put(("mark", ref, symbol))

    def _run_cli(self, args: list[str]) -> bool:
        try:
            done = subprocess.run(
                args,
                env=self.env,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                timeout=60,
            )
        except (OSError, subprocess.SubprocessError) as exc:
            log("delivery failed: %s (%s)" % (" ".join(args[:3]), exc))
            return False
        if done.returncode != 0:
            detail = (done.stderr or b"").decode("utf-8", "replace").strip()
            log("delivery failed: %s exited %d: %s" % (" ".join(args[:3]), done.returncode, detail))
            return False
        return True

    def outbound_loop(self) -> None:
        """A delivery that fails must not end the turn it was reporting, so every
        failure here is logged to stderr and swallowed."""
        while True:
            item = self.outbound.get()
            if item is None:
                return
            kind = item[0]
            if kind == "send":
                _, flag, body = item
                self._note_echo(flag, body)
                # NOTE: the body goes on argv because `semaphore send` documents no
                # other way in. That makes message text visible in the process list.
                args = [SEMAPHORE, "send", "--flag", flag, "--body", body]
            else:
                _, ref, symbol = item
                args = [SEMAPHORE, "mark", "--post", ref, "--symbol", symbol]

            if not self._run_cli(args):
                # CHOICE: one retry. The spec is silent on retrying deliveries.
                time.sleep(1.0)
                self._run_cli(args)

    # -- echo suppression --------------------------------------------------- #

    def _note_echo(self, flag: str, body: str) -> None:
        now = time.time()
        with self.state_lock:
            self.echoes.append((now, flag, body))
            while self.echoes and now - self.echoes[0][0] > ECHO_WINDOW_SECONDS:
                self.echoes.popleft()

    def _is_echo(self, flag: str, body: str) -> bool:
        now = time.time()
        with self.state_lock:
            while self.echoes and now - self.echoes[0][0] > ECHO_WINDOW_SECONDS:
                self.echoes.popleft()
            for index, (_, seen_flag, seen_body) in enumerate(self.echoes):
                if seen_flag == flag and seen_body == body:
                    del self.echoes[index]
                    return True
        return False

    # -- commentary --------------------------------------------------------- #

    def commentary(self, conversation: str | None, line: str) -> None:
        if not conversation:
            # Nowhere to post it. The spec shows `conversation` on every record,
            # but does not say it is guaranteed.
            log("commentary with no conversation: %s" % line)
            return
        with self.state_lock:
            self.pending.setdefault(conversation, []).append(line)

    def flush_commentary(self, conversation: str | None = None, force: bool = False) -> None:
        now = time.time()
        with self.state_lock:
            if not force and now - self.flushed_at < COMMENTARY_SECONDS:
                return
            if conversation is None:
                ready = list(self.pending.items())
                self.pending.clear()
            else:
                lines = self.pending.pop(conversation, [])
                ready = [(conversation, lines)] if lines else []
            self.flushed_at = now

        for target, lines in ready:
            if lines:
                self.send(target, "\n".join(lines))

    def commentary_loop(self) -> None:
        while not self.stopping.wait(COMMENTARY_SECONDS / 2):
            self.flush_commentary()

    # -- inbound from Semaphore --------------------------------------------- #

    def listen_loop(self) -> None:
        backoff = BACKOFF_START
        while not self.stopping.is_set():
            try:
                self.listener = subprocess.Popen(
                    [SEMAPHORE, "listen", "--station", self.station],
                    env=self.env,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    bufsize=1,
                )
            except (OSError, subprocess.SubprocessError) as exc:
                log("cannot start %s listen: %s" % (SEMAPHORE, exc))
                self.went_down("cannot start the semaphore client: %s" % exc)
                if self.stopping.wait(backoff):
                    return
                backoff = min(backoff * 2, BACKOFF_MAX)
                continue

            threading.Thread(
                target=self._drain_stderr, args=(self.listener,), daemon=True
            ).start()

            try:
                for line in self.listener.stdout:
                    if self.stopping.is_set():
                        break
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        event = json.loads(line)
                    except ValueError:
                        log("semaphore listen printed a line I cannot read: %.200r" % line)
                        continue
                    if isinstance(event, dict):
                        backoff = BACKOFF_START
                        self.on_semaphore(event)
            except (OSError, ValueError) as exc:
                log("semaphore listen stream broke: %s" % exc)

            code = self.listener.poll()
            self.listener = None
            if self.stopping.is_set():
                return

            self.went_down("semaphore listen ended (exit %s)" % code)
            if self.stopping.wait(backoff):
                return
            backoff = min(backoff * 2, BACKOFF_MAX)

    @staticmethod
    def _drain_stderr(child: subprocess.Popen) -> None:
        try:
            for line in child.stderr:
                text = line.strip()
                if text:
                    log("semaphore listen: %s" % text)
        except (OSError, ValueError):
            pass

    def came_up(self) -> None:
        if not self.up:
            self.up = True
            self.down_reported = False
            emit({"type": "ready"})

    def went_down(self, why: str) -> None:
        """One `gone` per loss, not one per symptom: Semaphore reports a drop with
        a "down" event and then the listen process usually exits as well."""
        if self.down_reported:
            log("still down: %s" % why)
            return
        self.up = False
        self.down_reported = True
        emit({"type": "gone", "why": why})

    def on_semaphore(self, event: dict) -> None:
        kind = event.get("kind")

        if kind == "up":
            self.came_up()
            return

        if kind == "down":
            self.went_down(str(event.get("note") or "the semaphore connection dropped"))
            return

        if kind != "message":
            # Unknown Semaphore event. Not ours to interpret.
            log("ignoring unknown semaphore event %r" % kind)
            return

        # A message implies the connection is up even if we missed the "up".
        self.came_up()

        conversation = event.get("flag")
        user = event.get("from")
        text = event.get("post")
        ref = event.get("at")

        if conversation is None or user is None or text is None:
            log("dropping a malformed semaphore message: %.200r" % event)
            return

        conversation, user, text = str(conversation), str(user), str(text)
        ref = str(ref) if ref is not None else None

        if self._is_echo(conversation, text):
            # Our own post came back on the stream. Nothing in the spec tells us
            # our own Semaphore user id, so this is the only filter available.
            return

        if ref:
            with self.state_lock:
                self._remember(self.last_ref, conversation, ref)

        control = CONTROL_WORDS.get(text.strip().split()[0].lower()) if text.strip() else None
        if control:
            self.on_control(conversation, user, control, ref)
            return

        record = {
            "type": "arrived",
            "conversation": conversation,
            "user": user,
            "text": text,
        }
        if ref:
            record["ref"] = ref
        # `direct` is omitted: Semaphore has no documented notion of a direct
        # message, and the spec does not define what `direct` means.
        emit(record)

    def on_control(self, conversation: str, user: str, control: str, ref: str | None) -> None:
        if control == "stop":
            with self.state_lock:
                can = self.can.get(conversation)
            # Ask what the brain can do before offering it. `can` only arrives
            # with a turn, so an unknown `can` is treated as allowed.
            if can is not None and can.get("steer") is False:
                self.mark(ref, MARK_BAD)
                self.send(conversation, "This agent cannot be interrupted.")
                return

        record = {
            "type": "control",
            "conversation": conversation,
            "user": user,
            "control": control,
        }
        if ref:
            record["ref"] = ref
        emit(record)
        # Acknowledge the gesture only. What the control did comes back as the
        # turn's own outcome, never as this acknowledgement.
        self.mark(ref, MARK_TAKEN)

    # -- inbound from Rundesk ----------------------------------------------- #

    def stdin_loop(self) -> None:
        """Read a line, show what we can of it, keep reading."""
        for line in sys.stdin:
            if self.stopping.is_set():
                return
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except ValueError:
                log("rundesk sent a line I cannot read: %.200r" % line)
                continue
            if not isinstance(record, dict):
                continue
            try:
                self.on_rundesk(record)
            except Exception as exc:  # never let one bad record end the channel
                log("failed to show %r: %s" % (record.get("type"), exc))

    def on_rundesk(self, record: dict) -> None:
        kind = record.get("type")
        conversation = record.get("conversation")
        conversation = str(conversation) if conversation is not None else None
        run = record.get("run")
        run = str(run) if run is not None else None

        if kind == "state":
            self.on_state(record, conversation, run)
        elif kind == "tool":
            name = record.get("name") or "tool"
            did = record.get("did")
            if run is not None:
                with self.state_lock:
                    bucket = self.tools.setdefault(run, {})
                    bucket[str(record.get("id"))] = str(name)
                    self._remember(self.tools, run, bucket)
            # `did` is undocumented; show it verbatim rather than interpret it.
            self.commentary(conversation, "* %s%s" % (name, (" - %s" % did) if did else ""))
        elif kind == "result":
            self.commentary(conversation, self._result_line(record, run))
        elif kind == "think":
            text = str(record.get("text") or "").strip()
            if text:
                self.commentary(conversation, "* (%s)" % self._one_line(text))
        elif kind == "usage":
            # Token counts are not worth a chat message. Kept on stderr instead.
            log("usage run=%s %s" % (run, {k: record.get(k) for k in ("input", "output", "cached")}))
        elif kind == "answer":
            self.flush_commentary(conversation, force=True)
            text = record.get("text")
            if text:
                self.send(conversation, str(text))
        else:
            # A record we do not recognise is kept, not refused -- ours to skip.
            log("ignoring unknown rundesk record %r" % kind)

    def _result_line(self, record: dict, run: str | None) -> str:
        name = "tool"
        if run is not None:
            with self.state_lock:
                name = self.tools.get(run, {}).get(str(record.get("id")), "tool")
        ok = record.get("ok")
        verdict = "ok" if ok else ("failed" if ok is False else "done")
        summary = str(record.get("summary") or "").strip()
        line = "* %s %s" % (name, verdict)
        if summary:
            line += " - %s" % self._one_line(summary)
        return line

    @staticmethod
    def _one_line(text: str, limit: int = 200) -> str:
        text = " ".join(text.split())
        return text if len(text) <= limit else text[: limit - 1] + "…"

    def on_state(self, record: dict, conversation: str | None, run: str | None) -> None:
        """Rundesk decides what state a turn is in; we decide only how it looks."""
        state = record.get("state")
        ref = record.get("ref")
        ref = str(ref) if ref is not None else None

        if ref is None and conversation is not None:
            with self.state_lock:
                ref = self.last_ref.get(conversation)

        if state == "taken":
            can = record.get("can")
            if isinstance(can, dict) and conversation is not None:
                with self.state_lock:
                    self._remember(self.can, conversation, can)
            if run is not None and ref:
                with self.state_lock:
                    self._remember(self.run_ref, run, ref)
            # The first thing that happens, and the one worth showing fastest.
            self.mark(ref, MARK_TAKEN)
            return

        if run is not None and not ref:
            with self.state_lock:
                ref = self.run_ref.get(run)

        if state == "running":
            # Semaphore has no typing indicator and nothing here lapses, so this
            # state has no representation. Fidelity degrades; correctness does not.
            self.flush_commentary(conversation)
            return

        if state == "finished":
            # The answer is posted by the `answer` record, which the spec shows
            # arriving before this one but describes as arriving after. Neither
            # ordering is assumed here.
            self.flush_commentary(conversation, force=True)
            self.mark(ref, MARK_OK)
        elif state == "stopped":
            self.flush_commentary(conversation, force=True)
            self.mark(ref, MARK_BAD)
            if conversation:
                self.send(conversation, "Stopped.")
        elif state == "failed":
            self.flush_commentary(conversation, force=True)
            self.mark(ref, MARK_BAD)
            if conversation:
                why = str(record.get("why") or "").strip()
                self.send(conversation, "Failed%s" % ((": " + self._one_line(why)) if why else "."))
        else:
            log("ignoring unknown state %r" % state)
            return

        if run is not None:
            with self.state_lock:
                self.run_ref.pop(run, None)
                self.tools.pop(run, None)

    # -- lifetime ------------------------------------------------------------ #

    def shutdown(self) -> None:
        if self.stopping.is_set():
            return
        self.stopping.set()
        child = self.listener
        if child and child.poll() is None:
            # Take your children with you.
            try:
                child.terminate()
            except OSError:
                pass
        self.outbound.put(None)

    def run(self) -> int:
        def on_signal(signum, _frame):
            log("signal %d; leaving" % signum)
            self.shutdown()

        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            try:
                signal.signal(sig, on_signal)
            except (ValueError, OSError):
                pass

        workers = [
            threading.Thread(target=self.outbound_loop, name="outbound", daemon=True),
            threading.Thread(target=self.listen_loop, name="listen", daemon=True),
            threading.Thread(target=self.commentary_loop, name="commentary", daemon=True),
        ]
        for worker in workers:
            worker.start()

        # Semaphore has no presence, status or badge, so there is nothing to set
        # when we come up and nothing to clear on the way out.

        try:
            self.stdin_loop()
        except KeyboardInterrupt:
            pass

        # stdin closed: the gateway has gone.
        log("stdin closed; shutting down")
        self.shutdown()
        for worker in workers:
            worker.join(timeout=3.0)
        return 0


# --------------------------------------------------------------------------- #


def main(argv: list[str]) -> int:
    if argv and argv[0] == "--check":
        return run_check(argv[1:])

    settings = load_settings(argv)
    if not settings.get("station"):
        log("no station in RUNDESK_SETTINGS and none on the command line")
        emit({"type": "gone", "why": "this channel has no station configured"})
        return 2

    token, where = find_token(os.environ.get("RUNDESK_CHANNEL_HOME"))
    if not token:
        log(
            "no %s in the environment and no token file in RUNDESK_CHANNEL_HOME. "
            "The machine that keeps an agent up has no shell profile, so the "
            "variable an owner exported at a terminal is not here." % TOKEN_ENV
        )
        emit({"type": "gone", "why": "no Semaphore credential available"})
        return 2

    log(
        "channel=%s agent=%s station=%s credential=%s"
        % (
            os.environ.get("RUNDESK_CHANNEL", "?"),
            os.environ.get("RUNDESK_AGENT", "?"),
            settings["station"],
            where,
        )
    )
    return Channel(settings, token).run()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
