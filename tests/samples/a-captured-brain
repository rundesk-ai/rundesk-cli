#!/usr/bin/env python3
"""Stand in for `codex app-server`, saying exactly what a real one said once.

Reads the capture named in `CAPTURED` and says it back **in the order a real server would**: a reply
waits until there is a request to answer, and everything between replies follows the reply before
it. Printing the whole file at once instead would let a turn finish before the client had finished
its handshake — an ordering no real server can produce, which is a fixture teaching an adapter to
survive something that never happens.

**Replies are matched to requests in order, and carry the id the client actually used.** A capture
was made by some other client that numbered its requests its own way, and a fixture that insisted on
those numbers would be testing that two clients happen to count alike. So the nth reply in the
capture answers the nth request, renumbered to match.

A reply nobody ever asks for is dropped after `GRACE`, because that is what a real server does with
a request it never received: nothing. Blocking for it instead would hang on every capture whose
client did something this one does not.

It never exits on its own. The adapter under test ends this program itself, and one that closed the
pipe underneath it would prove something about a broken pipe rather than about the translation.

This exists so that every reading the codex adapter makes can be checked against a real vendor
stream **with no account, no token and no network anywhere near the suite**, which is both the
repository's rule and a terms one.
"""

import json
import os
import queue
import sys
import threading

#: How long a reply waits for a request to answer before it is dropped. Long enough for a client
#: that is about to ask, short enough that a capture the client outgrew does not hang a suite.
GRACE = 5.0

if "--capabilities" in sys.argv[1:]:
    print('{"tools": true}')
    raise SystemExit(0)

asked: "queue.Queue" = queue.Queue()
ended = threading.Event()


def listened():
    """Every request the client sends, in the order it sends them."""
    for line in sys.stdin:
        try:
            said = json.loads(line)
        except ValueError:
            continue
        if said.get("id") is not None:
            asked.put(said["id"])
    ended.set()


threading.Thread(target=listened, daemon=True).start()

# **Bytes, not text.** A capture may hold a byte that is not valid UTF-8 — a real server relays
# whatever a tool printed — and a replay that decoded it here would fail on this side instead of
# handing the adapter under test the thing it has to survive.
with open(os.environ["CAPTURED"], "rb") as captured:
    for line in captured:
        if not line.strip():
            continue
        try:
            said = json.loads(line)
        except ValueError:
            said = None
        if isinstance(said, dict) and said.get("id") is not None:
            try:
                said["id"] = asked.get(timeout=GRACE)
            except queue.Empty:
                continue
            line = (json.dumps(said) + "\n").encode()
        sys.stdout.buffer.write(line)
        sys.stdout.buffer.flush()

if os.environ.get("THEN_DIE"):
    # A server that fell over: it stops mid-record and its pipe closes, which is what the reader
    # on the other side actually sees. Staying alive instead would test a *wedged* server, which
    # is a different thing and is rundesk's silence window to answer, not the adapter's.
    raise SystemExit(1)

ended.wait()
