#!/usr/bin/env python3
"""gate — everything that has to be true before work here is finished, in one command.

    python3 .knowledge/scripts/gate

The list was kept by hand in three places — `AGENTS.md`, the workflow, and whatever an
agent remembered — and the three had already come apart: four suites ran in CI that the
documented gate never named, so a change could break them and every local check stay
green. So the suites are **found**, not listed: a file added to `tests/` is in the gate
the day it lands, here and in the workflow, which this also checks.

It runs everything rather than stopping at the first failure. A gate you have to run
seven times to learn what is broken is one people stop running. Every check has the same
three-minute ceiling as CI, and a timeout captures Python thread stacks before ending the
check's whole process group.

What it does **not** cover, and says so at the end: a real `./install.sh` and
`./install.sh --uninstall`. That reaches the network and rebuilds the virtualenv this
checkout is running on, which is not something a routine check should do to somebody
without being asked.

Standard library only, and nothing here reaches the network.
"""

from __future__ import annotations

import os
import pathlib
import signal
import subprocess
import sys
import time
from concurrent import futures

ROOT = pathlib.Path(__file__).resolve().parent.parent.parent
KNOWLEDGE = ROOT / ".knowledge"
WORKFLOW = ROOT / ".github" / "workflows" / "build.yml"

#: The interpreter running this one. Never a bare `python3`: the gate has to be able to
#: answer for the environment it was actually asked about, and the two differ on exactly
#: the machine where that matters — one with an install beside the checkout.
PY = sys.executable

#: A check may be slow under load, but it may not own the gate forever. This matches the
#: per-suite CI ceiling: long enough for the measured 40-second floor with substantial
#: headroom, short enough to name a wedged child while the run is still useful.
CHECK_TIMEOUT_SECONDS = 180
ABORT_GRACE_SECONDS = 5


def suites() -> list[pathlib.Path]:
    """Every test file there is, in the order they are named."""
    return sorted((ROOT / "tests").glob("test_*.py"))


def named_by_the_workflow(found: list[pathlib.Path]) -> str | None:
    """Which suites CI never runs, or None when it runs them all.

    CI delegates to the same discovery rule as this gate. A suite added under `tests/`
    therefore runs locally and remotely without a second list to update.
    """
    if not WORKFLOW.is_file():
        return f"there is no {WORKFLOW.relative_to(ROOT)} to check against"
    text = WORKFLOW.read_text(encoding="utf-8")
    runner = KNOWLEDGE / "scripts" / "ci-suites"
    if ".knowledge/scripts/ci-suites" not in text:
        return "the workflow does not invoke the discovering suite runner"
    if not runner.is_file():
        return "the workflow names a suite runner that does not exist"
    source = runner.read_text(encoding="utf-8")
    if 'glob("test_*.py")' not in source:
        return "the CI suite runner does not discover every test_*.py suite"
    return None


def checks() -> list[tuple[str, list[str]]]:
    """Every command the gate runs, in the order a failure is cheapest to read."""
    # `src/migrations/` is here because a step is *found* rather than imported by anything
    # at rest: nothing reads one until an update or a new agent runs it, so a step that does
    # not parse is a failure an owner meets mid-update rather than one the gate meets here.
    parses = (
        "import ast, glob, sys\n"
        "for f in sorted(glob.glob('src/rundesk/*.py') + glob.glob('src/migrations/*.py')\n"
        "                + glob.glob('tests/*.py')):\n"
        "    ast.parse(open(f).read(), f)\n"
    )
    listed: list[tuple[str, list[str]]] = [
        ("every source and test file parses", [PY, "-c", parses]),
        ("the installer is valid shell", ["bash", "-n", str(ROOT / "install.sh")]),
        ("the docs meet the standard", [PY, str(KNOWLEDGE / "scripts" / "doc-lint"), str(KNOWLEDGE)]),
        ("the doc linter still has teeth", [PY, str(KNOWLEDGE / "scripts" / "test_doc_lint.py")]),
        ("every proven requirement names a real test", [PY, str(KNOWLEDGE / "scripts" / "check-evidence")]),
        ("the command's reference still matches the command",
         [PY, str(KNOWLEDGE / "scripts" / "cli-reference"), "--check"]),
    ]
    listed += [(path.stem, [PY, str(path)]) for path in suites()]
    return listed


def run(what: str, argv: list[str]) -> tuple[bool, str, float]:
    """Run one check within a ceiling, taking its whole process group on timeout.

    SIGABRT comes first because Python's faulthandler turns it into the stack evidence
    needed to diagnose a hang. SIGKILL is the backstop for a child or grandchild that
    ignores it. Each check has its own session so neither signal can reach the gate or a
    neighbouring suite.
    """
    began = time.monotonic()
    process = subprocess.Popen(
        argv,
        cwd=str(ROOT),
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        env={**os.environ, "PYTHONFAULTHANDLER": "1"},
        start_new_session=True,
    )
    timed_out = False
    try:
        said, _ = process.communicate(timeout=CHECK_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        timed_out = True
        try:
            os.killpg(process.pid, signal.SIGABRT)
        except ProcessLookupError:
            pass
        try:
            said, _ = process.communicate(timeout=ABORT_GRACE_SECONDS)
        except subprocess.TimeoutExpired:
            said = ""
        # A grandchild may ignore SIGABRT or close the captured pipe before it exits.
        # End the whole group even when the leader already returned.
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        if process.poll() is None or not said:
            try:
                final, _ = process.communicate(timeout=ABORT_GRACE_SECONDS)
                said = final or said
            except subprocess.TimeoutExpired:
                # A descendant that deliberately leaves the process group can retain the
                # output pipe. It is no longer ours to signal by the group id, but it also
                # must not recover an unbounded wait through the cleanup path.
                if process.stdout:
                    process.stdout.close()
                try:
                    process.kill()
                except ProcessLookupError:
                    pass
                process.wait(timeout=ABORT_GRACE_SECONDS)
                said += "\ngate: the timed-out check kept its output pipe open\n"
        said += (
            f"\ngate: {what} exceeded {CHECK_TIMEOUT_SECONDS} seconds; "
            "its process group was ended\n"
        )
    return (not timed_out and process.returncode == 0,
            said or "", time.monotonic() - began)


def _at_once() -> int:
    """How many to run together.

    Two cores left alone on purpose. Several of these suites drive real processes, real
    signals and real waits, and a machine with nothing spare is one where a test measuring
    how long something took measures how busy the machine was instead — which is how a
    suite that passes alone starts failing in a crowd.
    """
    return max(2, min(8, (os.cpu_count() or 4) - 2))


def main() -> int:
    found = suites()
    if not found:
        print("gate: no test files found at all — that cannot be right", file=sys.stderr)
        return 1

    failed: list[str] = []
    drift = named_by_the_workflow(found)
    print(f"{'ok  ' if drift is None else 'FAIL'}  every suite is run by CI too"
          + (f" — {drift}" if drift else ""))
    if drift:
        failed.append("every suite is run by CI too")

    # **At once, because they have nothing to do with each other.** Every suite builds its
    # own scratch directory and redirects every place rundesk resolves, so no two share
    # anything — and the machine running them has sixteen cores and was using one. Run one
    # at a time this took a little over two minutes, of which a single suite was forty
    # seconds; a gate people wait two minutes for is a gate people stop running, which
    # costs far more than it saves.
    #
    # Threads rather than processes: every one of these is `subprocess.run` waiting on a
    # child, which holds no lock while it waits.
    began = time.monotonic()
    listed = checks()
    with futures.ThreadPoolExecutor(max_workers=_at_once()) as pool:
        going = {pool.submit(run, what, argv): what for what, argv in listed}
        # Reported as each finishes rather than in the order they were listed, so a long
        # suite cannot hold back the news that a quick one has already failed.
        for done in futures.as_completed(going):
            what = going[done]
            passed, said, took = done.result()
            print(f"{'ok  ' if passed else 'FAIL'}  {what}  ({took:.1f}s)")
            if not passed:
                failed.append(what)
                # The tail, not the whole of it: a failing suite says far more than fits on
                # a screen, and the part naming what broke is at the end.
                for line in said.strip().splitlines()[-25:]:
                    print(f"        {line}")

    print()
    print(f"      {time.monotonic() - began:.0f}s, {_at_once()} at a time")
    if failed:
        print(f"gate: FAILED — {', '.join(failed)}", file=sys.stderr)
        return 1
    print(f"gate: OK ({len(found)} suites, {len(checks()) - len(found)} other checks) on {PY}")
    print("      still to run by hand:  ./install.sh  &&  ./install.sh --uninstall")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
