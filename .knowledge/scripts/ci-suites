#!/usr/bin/env python3
"""Run every suite in bounded parallel CI shards, keeping one log per suite."""

from __future__ import annotations

import argparse
import os
import pathlib
import signal
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent.parent
LOGS = ROOT / "suite-logs"
SUITE_TIMEOUT_SECONDS = 180
WEIGHTS = {
    "test_install": 50,
    "test_process": 43,
    "test_gateway": 24,
    "test_turn": 17,
    "test_cli": 15,
    "test_channel": 12,
    "test_provider": 9,
    "test_answering": 4,
    "test_store": 4,
    "test_supervisor": 4,
}


def suites() -> list[pathlib.Path]:
    return sorted((ROOT / "tests").glob("test_*.py"))


def _tail(path: pathlib.Path, limit: int = 200_000) -> str:
    with open(path, "rb") as handle:
        handle.seek(0, os.SEEK_END)
        size = handle.tell()
        handle.seek(max(0, size - limit))
        return handle.read().decode("utf-8", "replace")


def run(path: pathlib.Path) -> tuple[str, int, pathlib.Path, bool]:
    log = LOGS / f"{path.stem}.log"
    with open(log, "wb") as output:
        process = subprocess.Popen(
            [sys.executable, "-u", str(path), "-v"],
            cwd=ROOT,
            stdout=output,
            stderr=subprocess.STDOUT,
            env={**os.environ, "PYTHONFAULTHANDLER": "1"},
            start_new_session=True,
        )
        timed_out = False
        try:
            code = process.wait(timeout=SUITE_TIMEOUT_SECONDS)
        except subprocess.TimeoutExpired:
            timed_out = True
            # Preserve the evidence for the hang before terminating the suite.
            os.killpg(process.pid, signal.SIGABRT)
            try:
                code = process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                code = process.wait()
    return path.stem, code, log, timed_out


def sharded(found: list[pathlib.Path], count: int) -> list[list[pathlib.Path]]:
    """Balance measured heavy suites, then place every unknown suite deterministically."""
    groups: list[list[pathlib.Path]] = [[] for _ in range(count)]
    totals = [0] * count
    for path in sorted(found, key=lambda one: (-WEIGHTS.get(one.stem, 1), one.name)):
        chosen = min(range(count), key=lambda number: (totals[number], number))
        groups[chosen].append(path)
        totals[chosen] += WEIGHTS.get(path.stem, 1)
    return groups


def main(argv=None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--shard", type=int, required=True)
    parser.add_argument("--shards", type=int, required=True)
    args = parser.parse_args(argv)
    if args.shards < 1 or args.shard < 0 or args.shard >= args.shards:
        parser.error("--shard must identify one of --shards")
    found = suites()
    if not found:
        print("::error::no test suites were found")
        return 1
    LOGS.mkdir(parents=True, exist_ok=True)
    assigned = sharded(found, args.shards)[args.shard]
    print(f"shard {args.shard + 1}/{args.shards}: "
          + ", ".join(path.stem for path in assigned))
    failed = []
    for path in assigned:
        name, code, log, timed_out = run(path)
        print(f"\n===== {name} =====")
        print(_tail(log))
        if code != 0 or timed_out:
            reason = "timed out" if timed_out else f"exited {code}"
            print(f"::error title={name}::{name} {reason}; see {log.name}")
            failed.append(name)
    if failed:
        print("failed suites: " + ", ".join(sorted(failed)), file=sys.stderr)
        return 1
    print(f"all {len(assigned)} suites in shard {args.shard + 1}/{args.shards} passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
