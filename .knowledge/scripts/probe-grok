#!/usr/bin/env python3
"""Probe the installed Grok CLI against the four things nobody measured.

Evidence, never a CI dependency: the live half reaches a real account and costs real
money, so nothing in the suite runs it. Rerun it when the CLI version moves and write what
changed into `.knowledge/research/2026-07-26-grok-cli-as-a-brain.md`.

    python3 .knowledge/scripts/probe-grok            # everything, including live turns
    python3 .knowledge/scripts/probe-grok --offline  # only what costs nothing

Four questions, and nothing else — the rest of this brain is already measured and
committed at `tests/samples/`. Re-buying it costs money and answers nothing.

**Does a resume round trip carry context?** Asked mechanically rather than by reading a
reply's tone. Turn one is told to offer two candidate words and to end by asking which to
keep; turn two's entire input is "the second one", which names neither. Nothing but
preserved context can resolve it. The control matters as much as the test: the same
second turn is run again in a *fresh* session, and if that one also produces the word,
the probe has proved nothing about resume and said so.

**Is its usage per turn or cumulative?** Three one-word replies on one session. Three
tiny replies cannot legitimately grow, so if the numbers climb the field is the whole
conversation's running total and every turn after the first would be overstated — the
trap Codex set and this brain has never been asked about.

**Does `GROK_HOME` isolate a login?** Point it at an empty directory and see whether the
run fails closed the way a fresh `CODEX_HOME` and a fresh `CLAUDE_CONFIG_DIR` both did.

**Can the prompt stay off the command line?** `--prompt-file` is on this CLI's help and
appears in none of the evidence. What somebody asks their agent is readable through the
process list, so a file that answers the same way is worth having.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
import uuid

GROK = os.environ.get("RUNDESK_GROK_BIN", "grok")

#: The two candidates turn one is told to offer, minted fresh every run.
#:
#: **Both halves of that are load-bearing.** A fixed pair is recoverable from an earlier
#: run of this same probe, because this CLI reads its own past sessions — the first version
#: of this probe used `ZEPHYR`/`PINEAPPLE` and the control turn, in a session that had never
#: heard turn one, answered `PINEAPPLE` anyway and said why: *"No prior context in this
#: session — checking recent sessions for what 'the second one' refers to."* A resume probe
#: without a control would have called that success.
_MINTED = uuid.uuid4().hex[:6].upper()
FIRST, SECOND = f"ZEPHYR-{_MINTED}", f"PINEAPPLE-{_MINTED}"

OFFERING = (
    f"Reply with exactly this and nothing else: I have two candidate codewords, "
    f"{FIRST} and {SECOND}. Which should I keep?"
)
#: Turn two, in full. It names neither word, so a session that has forgotten turn one has
#: nothing to answer from — and is told to say the word rather than agree, because "got it"
#: is not evidence either way.
CHOOSING = "the second one — reply with that codeword and nothing else"

ANSWER_SECONDS = 300.0


def ran(argv, **extra) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True, **extra)


def says(what: str, said: str) -> None:
    print(f"\n{'=' * 78}\n{what}\n{'=' * 78}\n{said.rstrip()}")


def _findable() -> str | None:
    """Where this machine's grok stands, or nothing."""
    return shutil.which(GROK) if os.sep not in GROK else (GROK if os.access(GROK, os.X_OK) else None)


def spoke(said: str) -> dict:
    """One turn's stream, read into the handful of things a probe asks of it.

    Only `text` is collected as the reply. `thought` is one field away from it on the same
    shape, and counting both would report what the model merely considered as what it said.
    """
    reply, thought, ended = [], [], {}
    for line in said.splitlines():
        try:
            one = json.loads(line)
        except ValueError:
            continue
        if not isinstance(one, dict):
            continue
        if one.get("type") == "text":
            reply.append(str(one.get("data") or ""))
        elif one.get("type") == "thought":
            thought.append(str(one.get("data") or ""))
        elif one.get("type") == "end":
            ended = one
    return {"reply": "".join(reply), "thought": "".join(thought), "end": ended}


def turn(where: str, prompt: str, session=None, resume=None, home=None,
         through_a_file=False) -> dict:
    """One headless turn, and what it said.

    `--sandbox` and `--permission-mode` are deliberately absent: both are measured to be
    accepted and to enforce nothing, and a probe that passed them would be asserting a
    limit it does not have.

    `--no-memory` is deliberately present. Without it this CLI answers from conversations
    it was never given, which makes a resume round trip look like it worked when nothing
    was resumed — and makes one agent's turn able to read another's.
    """
    argv = [GROK, "--output-format", "streaming-json", "--no-memory"]
    if session:
        argv += ["--session-id", session]
    if resume:
        argv += ["--resume", resume]
    if through_a_file:
        at = os.path.join(where, "asked.txt")
        with open(at, "w", encoding="utf-8") as f:
            f.write(prompt)
        argv += ["--prompt-file", at]
    else:
        argv += ["-p", prompt]
    said = ran(argv, cwd=where, timeout=ANSWER_SECONDS,
               env={**os.environ, **({"GROK_HOME": home} if home else {})})
    got = spoke(said.stdout)
    got["code"], got["stderr"] = said.returncode, said.stderr
    return got


def offline() -> None:
    """What can be asked without an account, a network or a penny."""
    says("version", ran([GROK, "--version"]).stdout)

    # Recorded rather than assumed: the evidence carried over from the Node build knows
    # only `-p "<prompt>"`, which puts what somebody asked their agent into the process
    # list. If this flag is on the help it is worth a live turn.
    help_said = ran([GROK, "--help"]).stdout
    offers = [one.strip() for one in help_said.splitlines()
              if one.strip().startswith(("--prompt-file", "--rules", "--tools",
                                         "--system-prompt-override", "--sandbox"))]
    says("the flags this build offers that decide an adapter",
         "\n".join(offers) or "(none of them)")

    home = tempfile.mkdtemp(prefix="grok-probe-home-")
    where = tempfile.mkdtemp(prefix="grok-probe-empty-")
    apart = turn(where, "say hi", home=home)
    left = sorted(os.listdir(home))
    says(f"GROK_HOME pointed at an empty {home}",
         f"exit {apart['code']}\n"
         f"reply: {apart['reply'][:400]!r}\n"
         f"stderr: {(apart['stderr'] or '')[:400].rstrip()}\n"
         f"what it wrote into that home: {left or '(nothing at all)'}")
    says("verdict — GROK_HOME", (
        "ISOLATES — a home with no login in it could not carry a turn, which is the\n"
        "isolation working. An agent's private home is empty the first time it reaches\n"
        "this brain, so an adapter says what to run rather than copying a credential in."
        if not apart["reply"].strip() or apart["code"] != 0 else
        "DOES NOT ISOLATE — a home with nothing in it still carried a whole turn, so the\n"
        "login is coming from somewhere this variable does not cover. Two agents pointed\n"
        "at two homes are sharing one sign-in, and nothing says so."))


def carries_context(where: str) -> bool | None:
    """Whether a resumed conversation still knows what the first turn offered."""
    named = str(uuid.uuid4())
    one = turn(where, OFFERING, session=named)
    says("turn one — offering two words", f"{one['reply']!r}\nend: "
         f"{json.dumps(one['end'], sort_keys=True)[:300]}")

    handle = (one["end"].get("sessionId") or named)
    two = turn(where, CHOOSING, resume=handle)
    says("turn two — resumed, and told only 'the second one'", repr(two["reply"]))

    # The control. Without it, "it carried context" and "it guesses that word from
    # nothing" are the same observation.
    apart = turn(where, CHOOSING)
    says("the control — the same second turn, in a session that never heard turn one",
         repr(apart["reply"]))

    resumed, fresh = SECOND in two["reply"].upper(), SECOND in apart["reply"].upper()
    if resumed and not fresh:
        says("verdict — resume", (
            f"CARRIES CONTEXT — the resumed turn answered {SECOND} from an input naming\n"
            f"neither word, and a session that never heard turn one did not. An adapter\n"
            f"can honestly claim `resume`, and the handle is `end.sessionId`."))
        return True
    if resumed and fresh:
        says("verdict — resume", (
            "PROVES NOTHING — the control produced the word too, from a session that was\n"
            "never given it. Something other than the resume handed it over, and until\n"
            "that is closed off this probe cannot tell resume from recall. `--no-memory`\n"
            "is already passed on every turn here and the candidates are minted per run,\n"
            "so if this still fires, find what else is reading the other sessions before\n"
            "claiming `resume` on anything."))
        return None
    says("verdict — resume", (
        "DOES NOT CARRY CONTEXT — the resumed turn could not name what turn one offered.\n"
        "`resume` must be declared false: claiming it costs the next turn its context and\n"
        "nothing says so."))
    return False


def counts_this_turn(where: str) -> None:
    """Three one-word turns on one session, and what each reported it cost."""
    named, handle, counted = str(uuid.uuid4()), None, []
    for word in ("one", "two", "three"):
        asked = f"Reply with the single word: {word}."
        got = turn(where, asked, resume=handle) if handle else turn(where, asked, session=named)
        handle = got["end"].get("sessionId") or handle or named
        counted.append(got["end"].get("usage") or {})

    says("what each turn reported it cost",
         "\n".join(f"turn {n}: {json.dumps(one, sort_keys=True)}"
                   for n, one in enumerate(counted, start=1)))
    out = [int(one.get("output_tokens") or 0) for one in counted]
    climbing = len(out) == 3 and out[0] < out[1] < out[2]
    says("verdict — usage", (
        "CUMULATIVE — output rose on every turn, which three one-word replies cannot do.\n"
        "The field is the conversation's running total, not this turn's, and an adapter\n"
        "has to subtract what it reported last time and keep the total it subtracts from."
        if climbing else
        f"PER TURN — the counts did not climb ({out}). Reporting the field as a turn's\n"
        "cost is honest, and the subtraction Codex needed is not needed here."))


def keeps_the_prompt_off_the_command_line(where: str) -> None:
    """Whether `--prompt-file` answers the way `-p` does."""
    asked = "Reply with the single word: ORANGE."
    through_a_file = turn(where, asked, through_a_file=True)
    says("--prompt-file", f"exit {through_a_file['code']}\n"
         f"reply: {through_a_file['reply']!r}\n"
         f"stderr: {(through_a_file['stderr'] or '')[:300].rstrip()}")
    says("verdict — where the prompt goes", (
        "PROMPT-FILE WORKS — the prompt can be written to a file the adapter owns instead\n"
        "of handed over as a flag value, so what somebody asked their agent stays out of\n"
        "the process list."
        if through_a_file["code"] == 0 and through_a_file["reply"].strip() else
        "FALLS BACK TO -p — the file form did not carry a turn, so the prompt is a flag\n"
        "value and is readable through the process list. Say so rather than hiding it."))


def live() -> int:
    """The three questions that need a real account, and what they settled."""
    where = tempfile.mkdtemp(prefix="grok-probe-work-")
    print(f"probing {GROK} in {where} — this reaches a real account and costs real money")
    carried = carries_context(where)
    counts_this_turn(where)
    keeps_the_prompt_off_the_command_line(where)
    return 0 if carried is not None else 1


def main() -> int:
    if _findable() is None:
        print(f"there is no {GROK} on this machine's path — install the Grok CLI, or "
              f"point RUNDESK_GROK_BIN at where it stands", file=sys.stderr)
        return 2
    offline()
    return 0 if "--offline" in sys.argv else live()


if __name__ == "__main__":
    raise SystemExit(main())
