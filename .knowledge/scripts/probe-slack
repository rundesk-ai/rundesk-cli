#!/usr/bin/env python3
"""The canary: what only a real workspace, real tokens and a pair of human eyes can settle.

**Nothing in the suite reaches Slack, and nothing here is run by the gate.** The fake is the
floor and it holds up every routing, rendering and failure case there is. What it cannot hold
up is what a *person sees* — whether the eyes reaction actually appeared, whether the bot
showed as active, whether the slash command answered inside the three seconds Slack allows.
Those are the rows this walks, and they are ❌ in `prd/channel-slack.md` until somebody has
watched them.

    python3 .knowledge/scripts/probe-slack              # the steps, and where each row is
    python3 .knowledge/scripts/probe-slack --check      # is there anything to probe with

This prints steps rather than driving Slack, and that is the point rather than a shortcut:
every row below is *what a person sees*, so a script that drove the platform and reported
success would be asserting the one thing it cannot observe. Marking a row on a script's
say-so is how a contract comes to disagree with the product.

**Fill in what you saw, not what you expected.** A row you did not actually watch stays ❌.
Half a green column that is true beats a full one that is not.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent

#: Each row this can settle, in the order somebody would naturally hit them, with what to
#: do and what to look for. The `sees` line is the whole test: if it did not happen, the
#: row stays ❌ and what you saw instead is worth writing down.
WALKED = [
    ("R-SLK-15", "the owner is told when the agent comes up and goes down",
     "stop the agent, wait for it, then start it again",
     "a red 'Gateway offline' and then a green 'Gateway online', in your direct messages,"
     " and exactly one of each however many channels the agent has"),
    ("R-SLK-16", "an agent shows as active while its gateway is up",
     "look at the bot in the member list while it is running, then again after stopping it",
     "the green dot on while it is up, and gone within a minute of it going — if it never"
     " goes off, `always_online` is true in the app manifest"),
    ("R-SLK-5", "a message taken up is marked as seen",
     "say anything to it in a direct message",
     "an eyes reaction on your message, before any reply arrives. This carries the weight"
     " Discord splits between a mark and a typing indicator, so a turn with no eyes on it"
     " is a turn that looks like nothing happened"),
    ("R-SLK-11", "a command is answered inside the time Slack allows",
     "type `/rundesk status`, then `/rundesk stop` while a turn is running",
     "an answer only you can see, rather than 'operation timed out'"),
    ("R-SLK-12", "what a command did arrives as the turn's own outcome",
     "the same `/rundesk stop`, and read what comes back",
     "a stopped mark on the turn, never a half-written answer published as the reply"),
    ("R-SLK-14", "writes are paced so Slack does not refuse them",
     "ask for something that runs a dozen tools quickly, in a busy channel",
     "the commentary keeping up, no `ratelimited` in `rundesk logs <agent>`, and nothing"
     " missing from the end of it"),
    ("R-SLK-18", "an answer too long to read is attached as a file",
     "ask for something very long — 'list every requirement in the contracts, in full'",
     "one uploaded `answer.md` with a covering message that still names you, rather than a"
     " dozen numbered fragments"),
    ("R-SLK-19", "a file the agent made is uploaded rather than described",
     "ask it to draw or generate an image",
     "the picture inline in Slack, not a sentence about where it saved one"),
    ("R-SLK-42", "prose reaches Slack in the dialect Slack renders",
     "ask for an answer with bold, a bulleted list, a link and a fenced code block in it",
     "bold that is bold rather than asterisks, a link with words rather than a URL twice,"
     " and a code block whose contents were not rewritten"),
    ("R-SLK-1", "being named in a channel puts the turn in a thread",
     "mention the agent in a channel, then reply inside the thread it answers in",
     "the answer in a thread under your message, and the follow-up answered without"
     " mentioning it again"),
    ("R-CH-16", "a person can restart the agent from the channel they are on",
     "type `/rundesk restart`",
     "the agent going and coming back, and the next thing you say answered"),
    ("R-CH-11", "a channel leaves nothing running once its turn has ended",
     "after a turn ends, run: ps -eo command | grep channels/slack",
     "one adapter per channel and no strays left over from turns"),
]


def channels() -> dict:
    """Every channel every agent on this machine is reachable on Slack through."""
    sys.path.insert(0, str(ROOT / "src"))
    from rundesk import agent as agents           # noqa: PLC0415 — a probe, not a module
    from rundesk import channel                   # noqa: PLC0415

    found = {}
    for name in agents.known():
        for one, it in channel.known(agents.paths(name)["agent"]).items():
            if str(it.get("kind")) == "slack":
                found[f"{name}/{one}"] = it
    return found


def ready() -> int:
    """Whether there is anything here to probe with, said plainly.

    Says which of the two credentials this shell holds and never what is in either. Slack
    needs both — one opens the socket, one calls the API — so "a token is set" is not the
    question worth answering here.
    """
    found = channels()
    if not found:
        print("no slack channel on this machine — add one first:")
        print("  rundesk channels <agent> add slack --kind slack --allow <your U… id>")
        print("  docs/slack.md is the whole path, including where the two tokens come from")
        return 1
    for named, it in found.items():
        wanted = (it.get("secret") or {}).get("env") or []
        wanted = [wanted] if isinstance(wanted, str) else wanted
        held = [one for one in wanted if os.environ.get(one)]
        missing = [one for one in wanted if not os.environ.get(one)]
        print(f"{named:24} {it.get('describes') or it.get('kind')}")
        print(f"{'':24} held here:  {', '.join(held) or 'neither — the gateway has its own'}")
        if missing:
            print(f"{'':24} not here:   {', '.join(missing)}")
    return 0


def main(argv: list[str]) -> int:
    if "--check" in argv:
        return ready()
    if ready() != 0:
        return 1
    print("\n" + "=" * 78)
    print("Walk these against a workspace you own. Watch each one; do not infer it.")
    print("=" * 78)
    for row, what, do, sees in WALKED:
        print(f"\n{row} — {what}")
        print(f"    do    {do}")
        print(f"    see   {sees}")
    print("\n" + "=" * 78)
    print("For each one you actually watched, in .knowledge/prd/channel-slack.md:")
    print("  ❌ -> ✅ and replace the note with what you saw and the date.")
    print("A row you did not watch stays ❌. Half a green column that is true beats a")
    print("full one that is not — and `check-evidence` will hold you to naming a test")
    print("for anything you tick, so a row settled by eye says so in words instead.")
    print(json.dumps({"rows": [row for row, *_ in WALKED]}, indent=None))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
