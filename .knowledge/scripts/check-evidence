#!/usr/bin/env python3
"""check-evidence — the gap `doc-lint` leaves open, closed for this project.

The shipped linter is stack-neutral: it checks that a ✅ row *has* Evidence, never that the
test it names exists. So a plausible-looking name passes forever and the one claim the whole
format rests on quietly becomes untrue.

This has already happened here once — four contracts shipped citing test names copied from a
different repository, every one of them green, none of them real.

    python3 .knowledge/scripts/check-evidence

Standard library only. Fails when a ✅ cites a name no test in `tests/` declares, and warns
when a test file exists that no contract ever cites.
"""

from __future__ import annotations

import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent.parent
TESTS = ROOT / "tests"
HOMES = [ROOT / ".knowledge" / "prd", ROOT / ".knowledge" / "prd-drafts"]

#: `| ✅ | R-NS-1 | the claim | `a test name`, `another` |`
ROW = re.compile(r"^\|\s*(✅|❌)\s*\|\s*(R-[A-Z0-9]+-\d+)\s*\|([^|]*)\|\s*(.*?)\s*\|\s*$")
BACKTICKED = re.compile(r"`([^`]+)`")
TEST_DEF = re.compile(r"^\s*def (test_[a-z0-9_]+)", re.M)


def declared() -> dict[str, str]:
    """Every test this suite declares, by the sentence its name reads as."""
    found: dict[str, str] = {}
    for path in sorted(TESTS.glob("test_*.py")):
        for name in TEST_DEF.findall(path.read_text(encoding="utf-8")):
            found[name[len("test_"):].replace("_", " ")] = path.name
    return found


def main() -> int:
    tests = declared()
    if not tests:
        print("check-evidence: no tests found at all — that cannot be right", file=sys.stderr)
        return 1

    problems: list[str] = []
    cited: set[str] = set()
    rows = green = 0

    for home in HOMES:
        if not home.is_dir():
            continue
        for path in sorted(home.glob("*.md")):
            if path.name == "README.md":
                continue
            for line in path.read_text(encoding="utf-8").split("\n"):
                match = ROW.match(line)
                if not match:
                    continue
                glyph, rid, _claim, evidence = match.groups()
                rows += 1
                names = BACKTICKED.findall(evidence)
                if glyph == "✅":
                    green += 1
                    if not names:
                        problems.append(f"{path.name}: {rid} is ✅ and names no test")
                    for name in names:
                        cited.add(name)
                        if name not in tests:
                            problems.append(f"{path.name}: {rid} cites a test that does not exist — {name!r}")
                else:
                    # A ❌ may point at code, or at nothing. What it must not do is name a
                    # test — that would read as proven while the glyph says otherwise.
                    for name in names:
                        problems.append(f"{path.name}: {rid} is ❌ but names a test — {name!r}")

    for problem in problems:
        print(f"check-evidence: {problem}", file=sys.stderr)
    if problems:
        print(f"\ncheck-evidence: {len(problems)} problem(s)", file=sys.stderr)
        return 1

    untouched = sorted(set(tests) - cited)
    print(f"check-evidence: OK ({rows} rows, {green} proven, {len(tests)} tests, {len(untouched)} uncited)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
