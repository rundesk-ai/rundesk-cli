#!/usr/bin/env python3
"""The canary: what only a real Discord, a real token and a pair of human eyes can settle.

**Nothing in the suite reaches Discord, and nothing here is run by the gate.** The fake
channel is the floor and it holds up every routing and failure case there is. What it
cannot hold up is what a *person sees* — whether the eyes reaction actually appeared,
whether the typing indicator ran for the whole turn, whether the bot showed as online.
Those are the rows this walks, and they are ❌ in `prd/channel-discord.md` until somebody
has watched them.

    python3 .knowledge/scripts/probe-discord              # the steps, and where each row is
    python3 .knowledge/scripts/probe-discord --check      # is there anything to probe with

This prints steps rather than driving Discord, and that is the point rather than a
shortcut: every row below is *what a person sees*, so a script that drove the platform and
reported success would be asserting the one thing it cannot observe. Marking a row on a
script's say-so is how a contract comes to disagree with the product.

**Fill in what you saw, not what you expected.** A row you did not actually watch stays ❌.
Half a green column that is true beats a full one that is not.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent

#: Each row this can settle, in the order somebody would naturally hit them, with what to
#: do and what to look for. The `sees` line is the whole test: if it did not happen, the
#: row stays ❌ and what you saw instead is worth writing down.
WALKED = [
    ("R-DIS-15", "the owner is told when the agent comes up and goes down",
     "stop the agent, wait for it, then start it again",
     "a red 'Gateway offline' and then a green 'Gateway online', in your direct messages"),
    ("R-DIS-16", "an agent shows as online while its gateway is up",
     "look at the member list while it is running, then again after stopping it",
     "the bot online while it is up, and offline within a minute of it going"),
    ("R-DIS-5", "a message taken up is marked as seen",
     "say anything to it in a direct message",
     "an eyes reaction on your message, before any reply arrives"),
    ("R-DIS-6", "the typing indicator runs for as long as the turn does",
     "ask for something slow — 'read every file in your workspace and summarise it'",
     "'<agent> is typing…' for the whole turn, and gone as the reply lands"),
    ("R-DIS-11", "a command is answered inside the time Discord allows",
     "type /stop while a turn is running",
     "an acknowledgement rather than 'The application did not respond'"),
    ("R-DIS-12", "what a command did arrives as the turn's own outcome",
     "the same /stop, and read what comes back",
     "a stopped mark on the turn, never a half-written answer published as the reply"),
    ("R-DIS-18", "an answer too long to read is attached as a file",
     "ask for something very long — 'list every requirement in the contracts, in full'",
     "a file rather than a wall of messages, and nothing silently cut short"),
    ("R-DIS-19", "a file the agent made is uploaded rather than described",
     "ask it to draw or generate an image",
     "the picture in Discord, not a sentence about where it saved one"),
    ("R-DIS-14", "writes are paced so Discord does not refuse them",
     "ask for several long answers in a row, in the same conversation",
     "every one of them arriving, and nothing lost to a rate limit"),
    ("R-CH-16", "a person can restart the agent from the channel they are on",
     "type /restart",
     "the agent going and coming back, and the next thing you say answered"),
    ("R-CH-11", "a channel leaves nothing running once its turn has ended",
     "after a turn ends, run: ps -eo command | grep channels/discord",
     "one adapter per channel and no strays left over from turns"),
]


def channels() -> dict:
    """Every channel every agent on this machine is reachable on."""
    sys.path.insert(0, str(ROOT / "src"))
    from rundesk import agent as agents           # noqa: PLC0415 — a probe, not a module
    from rundesk import channel                   # noqa: PLC0415

    found = {}
    for name in agents.known():
        for one, it in channel.known(agents.paths(name)["agent"]).items():
            if str(it.get("kind")) == "discord":
                found[f"{name}/{one}"] = it
    return found


def ready() -> int:
    """Whether there is anything here to probe with, said plainly."""
    found = channels()
    if not found:
        print("no discord channel on this machine — add one first:")
        print("  rundesk channels <agent> add discord --kind discord --allow <your id>")
        return 1
    for named, it in found.items():
        wanted = (it.get("secret") or {}).get("env") or []
        wanted = [wanted] if isinstance(wanted, str) else wanted
        held = [one for one in wanted if os.environ.get(one)]
        print(f"{named:24} {it.get('describes') or it.get('kind')}")
        print(f"{'':24} token: {', '.join(held) or 'not in this shell — the gateway has its own'}")
    return 0


def main(argv: list[str]) -> int:
    if "--check" in argv:
        return ready()
    if ready() != 0:
        return 1
    print("\n" + "=" * 78)
    print("Walk these against a server you own. Watch each one; do not infer it.")
    print("=" * 78)
    for row, what, do, sees in WALKED:
        print(f"\n{row} — {what}")
        print(f"    do    {do}")
        print(f"    see   {sees}")
    print("\n" + "=" * 78)
    print("For each one you actually watched, in .knowledge/prd/channel-discord.md:")
    print("  ❌ -> ✅ and replace the note with what you saw and the date.")
    print("A row you did not watch stays ❌. Half a green column that is true beats a")
    print("full one that is not — and `check-evidence` will hold you to naming a test")
    print("for anything you tick, so a row settled by eye says so in words instead.")
    print(json.dumps({"rows": [row for row, *_ in WALKED]}, indent=None))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
