#!/usr/bin/env -S python3 -B
"""rundesk — the installable entry point.

This file is the executable the installer symlinks onto your PATH. It resolves its
own real location (`.resolve()` follows the symlink back into the checkout), puts
the bundled `src` on `sys.path`, and hands off to `cli.main`. It owns no logic.
"""

import sys
sys.dont_write_bytecode = True

from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(REPO_ROOT / "src"))

# Anything beyond the standard library lives in the install's own virtualenv, put there by
# install.sh. Added by hand rather than by activating it, so the command works from any
# shell and needs nothing sourced first. Absent is normal: with no dependencies declared,
# the installer makes no virtualenv at all.
for _packages in sorted((REPO_ROOT / ".venv" / "lib").glob("python3.*/site-packages")):
    sys.path.insert(0, str(_packages))

from rundesk.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
