#!/usr/bin/env -S python3 -B
"""The executable an install puts on a PATH. It finds itself, and hands off.

This file owns no logic at all, which is what makes everything below it importable and testable
without it: it resolves where it is, puts `src/` on the path, and calls `cli.main`. `.resolve()`
follows the symlink an install places on a PATH back to the tree it points at, so a checkout and an
installed copy share one layout and one code path.
"""

import os
import sys
from pathlib import Path

# Nothing here writes bytecode. `-B` above covers the interpreter this starts; this covers a caller
# that reached the file some other way.
sys.dont_write_bytecode = True

launcher = Path(__file__).resolve()
app = launcher.parent


def _turn_app():
    """Find the install that owns this provider turn, if one is unambiguously present.

    A provider tool may rebuild a shell's environment from the owner's login context. In that
    case its `RUNDESK_HOME` and `RUNDESK_COMMAND` can name the live install even though the turn's
    own cwd and identity still name a scratch install. The agent home is the one durable boundary
    that survives that rebuild. Only accept the shape Rundesk itself creates, and only while both
    turn markers are present; ordinary terminal overrides remain authoritative.
    """
    agent = os.environ.get("RUNDESK_AGENT", "").strip()
    run = os.environ.get("RUNDESK_RUN", "").strip()
    where = os.environ.get("RUNDESK_CWD", "").strip()
    if not agent or not run or not where:
        return None
    try:
        here = Path(where).expanduser().resolve()
    except OSError:
        return None
    for root in (here, *here.parents):
        installed_app = root / "app"
        if ((installed_app / "rundesk").is_file()
                and (root / "data" / "agents" / agent).is_dir()):
            return installed_app, root
        if (app.name != "app" and (app / "rundesk").is_file()
                and (app / "src" / "rundesk").is_dir()
                and (root / "data" / "agents" / agent).is_dir()):
            return app, root
    return None


turn_app = _turn_app()
if turn_app is not None:
    app, turn_root = turn_app
    os.environ["RUNDESK_HOME"] = str(turn_root)

# An installed launcher is the last reliable identity when a provider tool shell drops the
# environment it was handed. Keep an explicit RUNDESK_HOME override authoritative for scratch and
# test installs; only infer the root from the installed <root>/app/rundesk shape.
elif app.name == "app":
    os.environ.setdefault("RUNDESK_HOME", str(app.parent))

sys.path.insert(0, str(app / "src"))

from rundesk.cli import main  # noqa: E402  — the path insert above is what makes this importable

raise SystemExit(main(sys.argv[1:]))
