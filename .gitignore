# The install's own dependencies, put there by install.sh
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Local environment / credentials — never commit
.env

# OS / editor
.DS_Store
*.swp

# What a CI step captures a suite into, so a leaked process cannot hold the runner open.
suite.log
suite-logs/

# The documentation site's build layer. Nothing here reaches a user's machine —
# install.sh ships a release tarball, not a checkout.
site/node_modules/
site/.astro/

# Copied out of CLI.md, which is itself generated from the parser. Committing it
# would create a third copy of the command surface, free to disagree with the other two.
docs/reference/cli.md
