# The install's own dependencies, put there by install.sh
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Local environment / credentials — never commit
.env

# OS / editor
.DS_Store
*.swp

# What a CI step captures a suite into, so a leaked process cannot hold the runner open.
suite.log
suite-logs/

# Working trees that stand beside the product and are not part of it. Named here so the
# exclusion is deliberate and travels with the repository: untracked and unignored, ~100 MB
# of them sat beside `src/` while the tree reported clean, and `tests/test_install.py` copied
# the lot into its scratch checkout — which is how that suite came to exceed the gate's
# 180-second ceiling for a reason nobody could attribute to anything they had changed.
node_modules/
ui/
site/

# The build this one replaces, kept on the working machine to read while rebuilding and
# deliberately never committed: it is already in this branch's history, so a second copy in
# the tree would be two answers to "what does rundesk do today". Nothing here is imported,
# and every one of these directories goes when Part 1 is finished.
src_old/
tests_old/
docs_old/
.knowledge_old/
old/

# Where `./dev` points a run that must not reach the owner's install.
.scratch/
